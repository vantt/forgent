#!/usr/bin/env node
// .githooks/pre-commit -- git-native hard block for the STR65 main-checkout
// commit-activity beacon (D2/D3, str65-worktree-isolation-enforcement), plus a
// staged-`.fgos/`-deletion guard (tsk-56u) that runs unconditionally. Fires
// for ANY `git commit` against this checkout, regardless of actor (human
// terminal, agent session, or CI) -- not only writes made through fgOS's
// own CLI verbs, per D2. The STR65 lock/branch guards below only actually
// APPLY when this hook is running "at home" -- see hookRunsAtHome below
// (tsk-sir): a linked fgOS worktree (fgos pick's fgw/<id> branch) shares
// this repo's single core.hooksPath setting with its main checkout, so
// this exact file also fires for a commit made entirely inside that
// OTHER, unrelated worktree -- one that writes to its own separate index
// and branch and never touches this checkout's own lock hazard at all
// (see docs/history/main-checkout-lock-worktree-commit-scope/CONTEXT.md
// D1/D2/D7). The staged-`.fgos/`-deletion guard (tsk-56u) is the opposite
// case: it protects exactly that "away from home" worktree, so it is
// never gated by hookRunsAtHome -- see stagedFgosDeletions below.
//
// Installed via `git config core.hooksPath .githooks` (wiring is cell -6's
// job, out of scope here). Lives at <repoRoot>/.githooks/pre-commit and
// imports its always-required dependencies with paths relative to ITS OWN
// location, mirroring the production install layout. Convention checking
// dynamically imports its client only when a scoped staged path exists; a
// copied hook without that optional client warns and continues.
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { execFileSync, spawnSync } from 'node:child_process';
import { resolveActiveHostBin } from '../src/util/host-bin-path.mjs';
import { checkBorrowedDescription, resolveLock, LOCK_FD_ENV } from '../src/holder-lock/index.mjs';
import { runLockRouteSync, ROUTE_CALL_TIMEOUT_MS } from '../src/holder-lock/driver.mjs';
import { readBeacon, judgeBeacon, writeBeacon, DEFAULT_BEACON_WINDOW_MS } from '../src/runner/main-checkout-activity.mjs';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

const HOW_TO_DOC = 'docs/how-to-parallel-lanes.md (workshop root, one level up from repo/)';

// One source of truth; land allowlist changes separately before using them.
const ROOT_FILE_ALLOWLIST = new Set([
  '.gitattributes', '.gitignore', 'AGENTS.md', 'CHANGELOG.md', 'CLAUDE.md',
  'Cargo.lock', 'Cargo.toml', 'LICENSE', 'README.md', 'clippy.toml',
  'install.sh', 'package-lock.json', 'package.json', 'rustfmt.toml',
]);

function rootFileRefusal(committingToplevel) {
  if (!fs.existsSync(path.join(committingToplevel, 'apps/fgos/Cargo.toml'))) return null;
  const git = (args) => execFileSync('git', args, {
    cwd: committingToplevel, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'],
  });
  try {
    const mergeHead = git(['rev-parse', '--git-path', 'MERGE_HEAD']).trim();
    if (fs.existsSync(path.resolve(committingToplevel, mergeHead))) return null;
    const roots = git(['diff', '--cached', '--name-only', '--diff-filter=ACR', '-z'])
      .split('\0').filter((name) => name && !name.includes('/'));
    if (roots.length === 0) return null;

    const hookPath = '.githooks/pre-commit';
    if (git(['diff', '--cached', '--name-only', '--', hookPath]).trim()) {
      // Locate authority only in HEAD, then inspect original diff ranges.
      // Staged comments or decoy declarations cannot hide a changed block.
      let headHook = '';
      try {
        headHook = git(['show', `HEAD:${hookPath}`]);
      } catch (error) {
        if (!(error.status === 128 && /does not exist|exists on disk, but not in/.test(error.stderr?.toString() ?? ''))) throw error;
      }
      const blocks = [...headHook.matchAll(/^const ROOT_FILE_ALLOWLIST = new Set\(\[\n[\s\S]*?^\]\);/gm)];
      const diff = git(['diff', '--cached', '--text', '--no-color', '--no-ext-diff', '--no-textconv', '--unified=0', '--', hookPath]);
      let changed = blocks.length !== 1;
      if (!changed) {
        const block = blocks[0];
        const first = headHook.slice(0, block.index).split('\n').length;
        const last = first + block[0].split('\n').length - 1;
        for (const hunk of diff.matchAll(/^@@ -(\d+)(?:,(\d+))? \+\d+(?:,\d+)? @@/gm)) {
          const start = Number(hunk[1]);
          const count = hunk[2] === undefined ? 1 : Number(hunk[2]);
          if (count === 0 ? start >= first && start < last : start <= last && start + count - 1 >= first) {
            changed = true;
            break;
          }
        }
      }
      // An added mutation/reference can change authority outside the block.
      changed ||= diff.split('\n').some((line) =>
        line.startsWith('+') && !line.startsWith('+++') && line.includes('ROOT_FILE_ALLOWLIST'));
      if (changed) {
        return `commit refused: root allowlist changes cannot accompany new root files (${roots.join(', ')}). Land the allowlist change in a separate commit on main first, then retry the root addition.`;
      }
    }
    const forbidden = roots.filter((name) => !ROOT_FILE_ALLOWLIST.has(name));
    return forbidden.length > 0
      ? `commit refused: new root files outside .githooks/pre-commit's allowlist (${forbidden.join(', ')}). Move scratch files to .fgos/runtime/tmp/ (or /tmp/fgos-work/); place durable files under their owning directory. Legitimate root additions require an allowlist change landed separately on main first.`
      : null;
  } catch (error) {
    return `commit refused: could not safely inspect staged root files (${error.message}). Repair the index or hook inputs and retry.`;
  }
}

// DEFAULT_BEACON_WINDOW_MS is the activity window this hook writes into its
// beacon (overridable via FGOS_MAIN_CHECKOUT_LOCK_TTL_MS).
function resolveTtlMs() {
  const raw = process.env.FGOS_MAIN_CHECKOUT_LOCK_TTL_MS;
  if (raw === undefined) return DEFAULT_BEACON_WINDOW_MS;
  const parsed = Number(raw);
  return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : DEFAULT_BEACON_WINDOW_MS;
}

// The hook is a cold client of the activated host: the lock and the writer
// identity are answered by native routes of the binary `resolveActiveHostBin`
// finds (`fgos internal lock-fd --shared-try`, `fgos identity`), never by lock
// code loaded from this checkout (the in-process door refuses there).
const HOST_CALL_TIMEOUT_MS = 20_000;

function hostStdout(bin, args, cwd) {
  const env = { ...process.env };
  delete env.FGOS_INVOCATION_RECORD_PATH;
  return execFileSync(bin, args, {
    env, cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: HOST_CALL_TIMEOUT_MS, killSignal: 'SIGKILL', maxBuffer: 1024 * 1024, windowsHide: true,
  });
}

function identityData(bin, args, cwd) {
  const stdout = hostStdout(bin, args, cwd);
  const envelope = JSON.parse(stdout);
  if (envelope?.contract !== 'fgos.v1' || envelope.data === null || typeof envelope.data !== 'object') throw new Error(`${bin} ${args[0]} printed an unexpected answer: ${stdout.slice(0, 200)}`);
  return envelope.data;
}

// mainLockVerdict: what the main-checkout mutex says about this commit,
// read once and never waiting (git already holds index.lock while this hook
// runs, and a land takes the mutex before git's index.lock, so waiting here
// could deadlock with it; this is an early check, not exclusion).
//   - 'borrower': fgOS's own commit. git inherited the holder's description
//     at slot 3 (FGOS_LOCK_FD names it) and the host confirms it is the very
//     description holding the lock. A sibling that merely shares the env but
//     opened the lock file itself is not a borrower. Asked before the probe:
//     a borrowed commit runs while the holder holds the lock, so the probe
//     alone would refuse it.
//   - 'held': another process holds the mutex: refuse.
//   - 'free': nobody holds it: an ordinary commit.
// The probe is `fgos internal lock-fd --shared-try` on a fresh description of
// the lock file: one non-blocking shared try, so it never waits on the lock
// and never obstructs a holder; it is a native route (a process boundary the
// hook cannot cross in process), a millisecond, not a Node start. Without a
// host binary no fgOS process can hold the mutex either (every holder runs
// inside a release), so the commit proceeds with a warning; any other failure
// refuses (fail-closed).
function mainLockVerdict(fgosDir, bin) {
  const lockPath = resolveLock('main-checkout', { fgosDir }).v3Path;
  if (process.env[LOCK_FD_ENV]) {
    try {
      if (checkBorrowedDescription(lockPath, { fgosDir }).result === 'borrower') return { kind: 'borrower' };
    } catch {
      // A stale variable (slot 3 not open) or an unusable host: not a borrower; the probe below decides.
    }
  }
  if (!bin) {
    process.stderr.write('warning: the main-checkout lock could not be checked (no fgos host binary found); continuing.\n');
    return { kind: 'free' };
  }
  let fd;
  try {
    fd = fs.openSync(lockPath, fs.constants.O_RDWR);
  } catch (err) {
    // A lock file that does not exist was never taken: nobody holds it.
    return err?.code === 'ENOENT' ? { kind: 'free' } : { kind: 'error', message: err?.message ?? String(err) };
  }
  try {
    const { result, detail } = runLockRouteSync({ bin, args: ['--shared-try'], fd, timeoutMs: ROUTE_CALL_TIMEOUT_MS });
    if (result === 'free' || result === 'held') return { kind: result };
    return { kind: 'error', message: `the lock route answered ${JSON.stringify(result)}${detail ? `: ${detail}` : ''}` };
  } catch (err) {
    return { kind: 'error', message: err?.message ?? String(err) };
  } finally {
    fs.closeSync(fd);
  }
}

function refuse(message) {
  process.stderr.write(`${message}\nSee ${HOW_TO_DOC} for how to work in an isolated worktree/session.\n`);
  process.exit(1);
}

// tsk-sir -- git always runs a hook subprocess with its cwd set to the
// TOPLEVEL of whichever checkout is actually committing (confirmed
// empirically: a probe hook printed its own cwd from both a main checkout
// and a linked worktree sharing that main's hooksPath, and got each
// checkout's own real toplevel back, never the hooksPath directory).
// repoRoot (derived from `__dirname`, i.e. wherever this SCRIPT FILE
// itself physically lives -- wherever core.hooksPath resolved to) is a
// SEPARATE thing from that actual toplevel whenever hooksPath is shared
// across a checkout family (D1/D7). When they match, this file is running
// "at home" -- either the true main checkout, or a self-contained
// worktree that was deliberately given its own independent hooksPath copy
// (bee's --with-companion / fgOS's own "session start" shape, e2e-tested
// separately from fgos pick's linked-worktree shape) -- and every STR65
// guard below should apply, using repoRoot as it always did. When they
// DIFFER, this file is running away from home: invoked for a DIFFERENT
// checkout than the one whose `.fgos`/lock/branch state it would
// otherwise act on -- exactly the fgos-pick shared-hooksPath case -- and
// no STR65 guard below has anything real to protect there. The
// staged-`.fgos/`-deletion guard is the one exception -- see
// stagedFgosDeletions below.
function normalizeFsPath(p) {
  if (!p) return '';
  try {
    return (fs.realpathSync.native ? fs.realpathSync.native(p) : fs.realpathSync(p)).toLowerCase().replaceAll('\\', '/');
  } catch {
    return path.resolve(p).toLowerCase().replaceAll('\\', '/');
  }
}

function hookRunsAtHome(repoRoot, actualToplevel) {
  return normalizeFsPath(actualToplevel) === normalizeFsPath(repoRoot);
}

// STAGED-FGOS-DELETION (tsk-56u): refuses any commit that stages a
// deletion under `.fgos/` -- the git-tracked runner state a linked
// worktree never carries in its own working tree (ADR0020:
// `src/runner/worktree.mjs`'s `createWorktree` always `fs.rmSync`'s the
// checked-out `.fgos/` right after `git worktree add`, without ever
// `git rm`-ing it from the index -- the working tree loses the files but
// the index still has them). A bare `git add -A` inside that worktree
// therefore stages every one of those files as deleted; committing that
// silently destroys the live event log the moment the branch is later
// merged/synced back, and the existing `fgos-write-rejected` check
// (`src/runner/merge.mjs`) only catches this at merge time, not here at
// the moment the destructive commit itself is made.
//
// Runs UNCONDITIONALLY in main() below, never gated by hookRunsAtHome --
// the worktree "away from home" case is exactly where this hazard lives,
// the opposite of the STR65 guards' own scope. Checks the diff against
// `committingToplevel` (the checkout actually running this commit, per
// tsk-sir), never `repoRoot` (wherever this script file itself lives) --
// the two differ precisely in the case this guard exists to catch.
//
// Mirrors merge.mjs's own `fgos-write-rejected` staged-diff filter
// (`git diff --name-only --cached`, `.fgos`/`.fgos/`-prefixed paths) but
// scoped to deletions (`--diff-filter=D`): a worktree can only ever stage
// a `.fgos` DELETION (it was rmSync'd, never re-created), never an
// addition/modification, so narrowing to deletions loses no real coverage
// for this hazard while leaving fgOS's own legitimate `.fgos` writes
// (additions/modifications, made directly by the `fgos` CLI verbs against
// the main checkout) untouched.
function stagedFgosDeletions(committingToplevel) {
  const output = execFileSync(
    'git',
    ['diff', '--cached', '--name-only', '--no-renames', '--diff-filter=D', '-z'],
    { cwd: committingToplevel, encoding: 'utf8' },
  );
  return output
    .split('\0')
    .filter((p) => p !== '')
    .filter((p) => p === '.fgos' || p.startsWith('.fgos/'));
}

// During a merge, a staged `.fgos` path whose index entry equals the incoming side's (absent on both,
// or the same blob), where that side changed it since the merge base, is that side's own change carried in, not a write by this checkout: a branch cut
// before the Event Store cutover that merges main takes main's retired shards and its fence this way.
function fgosPathsOwnedByMergeHead(committingToplevel, paths) {
  if (paths.length === 0) return new Set();
  const git = (args) => execFileSync('git', args, { cwd: committingToplevel, encoding: 'utf8', maxBuffer: 1024 * 1024 * 64 });
  const mergeHeadFile = path.resolve(committingToplevel, git(['rev-parse', '--git-path', 'MERGE_HEAD']).trim());
  if (!fs.existsSync(mergeHeadFile)) return new Set();
  const entries = (text, field) => new Map(text.split('\0').filter(Boolean).map((row) => {
    const tab = row.indexOf('\t');
    return [row.slice(tab + 1), row.slice(0, tab).split(' ')[field]];
  }));
  const index = entries(git(['ls-files', '-s', '-z', '--', '.fgos']), 1);
  // The incoming side must have changed the path itself since the merge base: a path absent on
  // both sides that this branch alone had and deleted by hand is not the incoming side's change.
  const tree = (oid) => entries(git(['ls-tree', '-r', '-z', oid, '--', '.fgos']), 2);
  const heads = fs.readFileSync(mergeHeadFile, 'utf8').split('\n').filter(Boolean)
    .map((oid) => ({ head: tree(oid), base: tree(git(['merge-base', 'HEAD', oid]).trim()) }));
  return new Set(paths.filter((p) => heads.some(({ head, base }) => head.get(p) === index.get(p) && head.get(p) !== base.get(p))));
}

// tsk-5pb -- any staged path under .fgos/ (Added, Modified, Deleted) on a
// worker's fgw/* branch is forbidden. Git manual merge materialization can stage
// a .fgos/* blob as Modified; worker branches must never commit changes under .fgos/.
function stagedFgosChangesOnWorkerBranch(committingToplevel) {
  let branch;
  try {
    branch = execFileSync(
      'git',
      ['symbolic-ref', '--short', '-q', 'HEAD'],
      { cwd: committingToplevel, encoding: 'utf8' },
    ).trim();
  } catch {
    return [];
  }
  if (!/^fgw\//.test(branch)) return [];

  const output = execFileSync(
    'git',
    ['diff', '--cached', '--name-only'],
    { cwd: committingToplevel, encoding: 'utf8' },
  );
  return output
    .split('\n')
    .filter((p) => p !== '')
    .filter((p) => p === '.fgos' || p.startsWith('.fgos/'));
}

// tsk-4hkd -- the main checkout must never sit on a fgw/<id> branch itself;
// that branch belongs in the item's own linked worktree (fgos pick), never
// checked out directly here. git-dir vs git-common-dir tells apart the main
// checkout (both equal) from a linked worktree (its own git-dir nests under
// <main>/.git/worktrees/<name>, so they differ) -- a linked worktree is
// SUPPOSED to live on a fgw/* branch and must stay unaffected by this
// guard. Only ever called once hookRunsAtHome(repoRoot) is true (see
// main()) -- repoRoot here is always the checkout actually committing.
function currentFgwBranchIfMainCheckout(repoRoot) {
  const gitDir = execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-dir'], { cwd: repoRoot, encoding: 'utf8' }).trim();
  const gitCommonDir = execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-common-dir'], { cwd: repoRoot, encoding: 'utf8' }).trim();
  if (gitDir !== gitCommonDir) return null;

  let branch;
  try {
    branch = execFileSync('git', ['symbolic-ref', '--short', '-q', 'HEAD'], { cwd: repoRoot, encoding: 'utf8' }).trim();
  } catch {
    return null; // detached HEAD -- no branch to match, nothing to refuse
  }
  return /^fgw\//.test(branch) ? branch : null;
}

// The Event Store cutover fence is the regular file `.fgos/events`, in the index or in HEAD.
// A migration installed it; once it exists the retired event paths cannot be added back.
function eventFenceExists(cwd) {
  // A directory is legacy Work; only the indexed/HEAD regular-file fence counts.
  const index = execFileSync('git', ['ls-files', '-s', '--', '.fgos/events'], { cwd, encoding: 'utf8' });
  let head = '';
  try {
    head = execFileSync('git', ['ls-tree', 'HEAD', '--', '.fgos/events'], { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
  } catch (err) {
    // Only an unborn HEAD (no commit yet) means "no fence in HEAD"; any other failure leaves the fence state unknown.
    const unborn = spawnSync('git', ['rev-parse', '--verify', '--quiet', 'HEAD'], { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
    if (unborn.status !== 1 || unborn.stdout.trim() !== '') {
      throw Object.assign(new Error(`commit refused: could not read HEAD's tree to look for the event fence (${String(err?.message ?? err).split('\n')[0]}) -- refusing to commit (fail-closed).`), { refusal: true });
    }
  }
  return [index, head].some(text => text.split('\n').some(line => /^100(?:644|755) /.test(line) && line.split('\t')[1] === '.fgos/events'));
}

// Retired event data cannot re-enter the checkout. Only the exact fence is allowed.
function addedEventPathRefusal(cwd) {
  if (!eventFenceExists(cwd)) return null;
  const added = execFileSync('git', ['diff', '--cached', '--name-only', '--no-renames', '--diff-filter=ACRT', '-z'], { cwd, encoding: 'utf8' }).split('\0');
  const forbidden = added.filter(p => p.startsWith('.fgos/events.jsonl') || p.startsWith('.fgos/events/'));
  return forbidden.length ? `commit refused: retired event paths cannot be added: ${forbidden.join(', ')}` : null;
}

// STALE-WORKTREE-INDEX (tsk-1d7, docs/history/stale-worktree-index-guard/
// CONTEXT.md D1/D2): a linked worktree checked out on a `fgw/*` branch can
// go stale when an external process (e.g. `approve`'s leaf->root merge)
// force-moves that branch's ref without ever touching THIS worktree's own
// working tree/index. `HEAD` still reads the new commit correctly (a
// symbolic ref that follows the branch), but files-on-disk + the index are
// still the OLD tree -- a narrowly-staged commit from here would silently
// carry the OLD content of every other tracked file along with it,
// reverting them (this happened for real: commit 2cb6519e).
//
// Read-only, never mutates -- matches src/runner/worktree.mjs's own
// `lastSyncedCommit`/`resyncClaimWorktree` pattern (reflog, not `rev-parse
// HEAD`, which lies once an external `git branch -f` has moved the branch
// ref out from under a symbolic HEAD). Runs UNCONDITIONALLY, same as
// `stagedFgosDeletions` below where it exists -- scoped to `fgw/*`
// branches internally (the "away from home" worktree case this guard
// protects), never gated by `hookRunsAtHome` (the main checkout is
// separately guarded against ever sitting on a `fgw/*` branch at all, by
// `currentFgwBranchIfMainCheckout` below).
function staleWorktreeIndexRefusal(committingToplevel) {
  let branch;
  try {
    branch = execFileSync('git', ['symbolic-ref', '--short', '-q', 'HEAD'], { cwd: committingToplevel, encoding: 'utf8' }).trim();
  } catch {
    return null; // detached HEAD -- no branch this guard scopes to
  }
  if (!/^fgw\//.test(branch)) return null;

  let lastSynced;
  try {
    lastSynced = execFileSync('git', ['reflog', 'show', 'HEAD', '-n', '1', '--format=%H'], { cwd: committingToplevel, encoding: 'utf8' }).trim();
  } catch {
    lastSynced = '';
  }
  if (!lastSynced) {
    return `commit refused: could not read this worktree's own HEAD reflog to determine what commit it was last synced to on "${branch}" -- refusing to commit against an unknown sync point (fail-closed). Inspect this worktree by hand.`;
  }

  let branchTip;
  try {
    branchTip = execFileSync('git', ['rev-parse', branch], { cwd: committingToplevel, encoding: 'utf8' }).trim();
  } catch {
    // tsk-2cl: the branch name itself was already read successfully via
    // symbolic-ref above, so rev-parse failing right after implies a
    // transient ref-read race or on-disk ref corruption -- fail closed,
    // same as an unreadable reflog (above) or a diverged branch (below),
    // rather than silently letting the commit through unguarded.
    return `commit refused: could not read "${branch}"'s current tip via "git rev-parse" -- refusing to commit against an unreadable branch ref (fail-closed). Inspect this worktree by hand.`;
  }
  if (lastSynced === branchTip) return null; // in sync, no-op

  let isAncestor = true;
  try {
    execFileSync('git', ['merge-base', '--is-ancestor', lastSynced, branchTip], { cwd: committingToplevel, encoding: 'utf8' });
  } catch {
    isAncestor = false;
  }
  if (!isAncestor) {
    return `commit refused: this worktree's last-synced commit (${lastSynced}) is not an ancestor of "${branch}"'s current tip (${branchTip}) -- refusing to commit against a diverged index (fail-closed). Inspect this worktree by hand.`;
  }

  return `commit refused: "${branch}" has moved to ${branchTip} since this worktree was last synced (${lastSynced}) -- likely an external force-move (e.g. approve's merge landing a sibling child). This worktree's files/index are stale and a commit right now would silently carry the OLD content of every other tracked file, reverting them. Run "fgos resync-worktree" in this worktree to repair it, then retry the commit.`;
}

// The Git one-door census (packages/git/contracts/mutation-census.v1.json) records a digest of every
// file the one-door scan judges. A commit that stages such a file without the regenerated census would
// leave main's census stale, so the staged digests are compared with the staged census: no scan, no
// build. Commits touching nothing the scan judges, or a repository without a census, pass untouched.
async function censusDriftRefusal(committingToplevel) {
  const git = (args) => execFileSync('git', args, {
    cwd: committingToplevel, encoding: 'utf8', maxBuffer: 256 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'],
  });
  // The committing checkout's own scanner judges its own census: a branch that changes the scan's rules
  // regenerates the census with them, so main's scanner would see drift that is not there. A checkout
  // without one (a probe tree) falls back to the hook's own; a copied hook with neither has nothing to judge by.
  const scanPath = [committingToplevel, path.resolve(__dirname, '..')]
    .map((root) => path.join(root, 'scripts/git-one-door-scan.mjs')).find((file) => fs.existsSync(file));
  if (!scanPath) return null;
  try {
    const { MUTATION_CENSUS_PATH, censusDrift, declaredProduct } = await import(pathToFileURL(scanPath).href);
    // A branch older than this rule ships a scanner without censusDrift: it predates the check, and its drift
    // is still caught when it merges into a tree that has the rule.
    if (typeof censusDrift !== 'function') return null;
    if (!git(['ls-files', '--stage', '--', MUTATION_CENSUS_PATH]).trim()) return null;
    const product = declaredProduct(committingToplevel);
    const staged = git(['diff', '--cached', '--name-only', '--no-renames', '-z']).split('\0')
      .filter((name) => name && (!product || product(name)));
    if (staged.length === 0) return null;
    const changes = new Map(staged.map((name) => {
      let source = null;
      // Decoded as utf8, the very input the scan hashes (readFileSync(..., 'utf8')): bytes would diverge on invalid sequences.
      try { source = git(['cat-file', 'blob', `:${name}`]); } catch { /* deleted from the index */ }
      return [name, source];
    }));
    const drift = censusDrift(JSON.parse(git(['show', `:${MUTATION_CENSUS_PATH}`])), committingToplevel, changes);
    return drift.length === 0 ? null
      : `commit refused: the Git one-door census does not match the staged files (${drift.slice(0, 5).join(', ')}${drift.length > 5 ? `, and ${drift.length - 5} more` : ''}). Run "node scripts/git-one-door-scan.mjs --write-census" and stage ${MUTATION_CENSUS_PATH} (a merge needs a regenerated census, not either side's).`;
  } catch (error) {
    return `commit refused: could not check the Git one-door census against the staged files (${error.message}). Repair the index or the census and retry.`;
  }
}

// A staged config file is checked before it is committed (docs/platform/config/spec.md section 11): a
// file that does not parse stops every verb on every machine that pulls it. `fgos config check` reads
// the working-tree file, not the staged blob (a staged-only check is not built), so the message says so.
// A `fail` finding row that names the project file refuses the commit and names file, position and path, never a value.
// No host binary, a host that predates the verb or any answer that is not a `config check` result is a
// warning: the hook cannot judge the file, which is no reason to block the commit.
const CONFIG_FILES = new Set(['.fgos/config.yaml', '.fgos/config.json']);

function configCheckRefusal(committingToplevel) {
  let staged;
  try {
    staged = execFileSync('git', ['diff', '--cached', '--name-only', '--no-renames', '--diff-filter=ACMR', '-z'], {
      cwd: committingToplevel, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'],
    }).split('\0');
  } catch (error) {
    process.stderr.write(`warning: config check skipped (staged-path-read-error): ${error.message}\n`);
    return null;
  }
  const files = staged.filter((name) => CONFIG_FILES.has(name));
  if (files.length === 0) return null;
  const { bin } = resolveActiveHostBin({ fgosDir: path.join(committingToplevel, '.fgos'), cwd: committingToplevel });
  if (!bin) {
    process.stderr.write(`warning: ${files.join(', ')} was not checked (no fgos host binary found); continuing.\n`);
    return null;
  }
  let data;
  try {
    let stdout;
    try {
      stdout = hostStdout(bin, ['config', 'check'], committingToplevel);
    } catch (error) {
      if (typeof error?.stdout !== 'string' || error.stdout === '') throw error; // no answer: the catch below warns
      stdout = error.stdout; // a failing check exits non-zero and still prints its findings
    }
    data = JSON.parse(stdout)?.data;
    if (!Array.isArray(data?.findings)) throw new Error(`${bin} config check printed an unexpected answer`);
  } catch (error) {
    process.stderr.write(`warning: ${files.join(', ')} was not checked (${String(error?.message ?? error).split('\n')[0].slice(0, 200)}); continuing.\n`);
    return null;
  }
  // Only the rows that name the project file: a machine-level row (an unset token file, say) is no reason to refuse a commit of this file.
  const failing = data.findings.filter((row) => row?.severity === 'fail' && typeof row.file === 'string' && row.file.startsWith('project:'));
  if (failing.length === 0) return null;
  const rows = failing.map((row) => {
    const where = [row.file, row.line, row.column].filter((part) => part !== null && part !== undefined).join(':');
    return `  ${row.row}${where ? ` ${where}` : ''}${row.path ? ` at ${row.path}` : ''}${row.fix ? ` (fix: ${row.fix})` : ''}`;
  });
  return `commit refused: "fgos config check" fails on the working-tree config file (${files.join(', ')} is staged; the check reads the file on disk, not the staged blob):\n${rows.join('\n')}\nRun "fgos config check" to see them and fix the file before committing.`;
}

async function warnOnConventionViolations(committingToplevel) {
  if (!fs.existsSync(path.join(committingToplevel, 'apps/fgos/Cargo.toml'))) return;

  let staged;
  try {
    staged = execFileSync(
      'git',
      ['diff', '--cached', '--name-only', '-z', '--diff-filter=ACR'],
      { cwd: committingToplevel, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] },
    );
  } catch (error) {
    process.stderr.write(`warning: convention check skipped (staged-path-read-error): ${error.message}\n`);
    return;
  }
  const paths = staged
    .split('\0')
    .filter((candidate) => /^plans\/(?:reports|journals)\/[^/]+\.md$/u.test(candidate));
  if (paths.length === 0) return;

  let conventionCheck;
  try {
    ({ conventionCheck } = await import('../src/convention/convention-client.mjs'));
  } catch (error) {
    process.stderr.write(`warning: convention check skipped (client-load-error): ${error.message}\n`);
    return;
  }

  try {
    const result = conventionCheck(paths, { dir: committingToplevel });
    for (const violation of result.violations ?? []) {
      process.stderr.write(`warning: convention ${violation.path}: ${violation.code} ${violation.message}\n`);
    }
  } catch (error) {
    const category = error?.code ?? 'host-exec-error';
    const detail = error?.timedOut ? 'host timed out' : (error?.message ?? 'unknown error');
    process.stderr.write(`warning: convention check skipped (${category}): ${detail}\n`);
  }
}

// The config value only selects an operation. Rust proves the lock, WAL and index.
// WORK removes legacy-event declarations from the native grant check at Event Store cutover.
function scopedGrantAllows(committingToplevel) {
  try {
    const operation = execFileSync('git', ['config', '--get', 'fgos.operationId'], { cwd: committingToplevel, encoding: 'utf8' }).trim();
    if (!operation) return false;
    const { bin } = resolveActiveHostBin({ fgosDir: path.join(committingToplevel, '.fgos'), cwd: committingToplevel });
    if (!bin) return false;
    const verdict = JSON.parse(execFileSync(bin, ['internal', 'git-grant-check', '--protocol', '1', '--operation', operation], { cwd: committingToplevel, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe', 3] }));
    return verdict.protocol === 1 && verdict.result === 'allowed';
  } catch { return false; }
}

async function main() {
  const eventRefusal = addedEventPathRefusal(process.cwd());
  if (eventRefusal) { console.error(eventRefusal); process.exitCode = 1; return; }

  const repoRoot = path.resolve(__dirname, '..');
  const committingToplevel = execFileSync('git', ['rev-parse', '--path-format=absolute', '--show-toplevel'], { encoding: 'utf8' }).trim();

  const staleIndexRefusal = staleWorktreeIndexRefusal(committingToplevel);
  if (staleIndexRefusal) {
    refuse(staleIndexRefusal);
    return;
  }

  const carriedIn = (paths) => fgosPathsOwnedByMergeHead(committingToplevel, paths);
  const stagedDeletions = stagedFgosDeletions(committingToplevel);
  const carriedDeletions = carriedIn(stagedDeletions);
  const fgosDeletions = stagedDeletions.filter((p) => !carriedDeletions.has(p));
  if (fgosDeletions.length > 0 && !scopedGrantAllows(committingToplevel)) {
    refuse(`commit refused: this commit stages a deletion under ".fgos/" (${fgosDeletions.join(', ')}) -- .fgos/ is fgOS's own runner state and must never be committed as deleted. A linked worktree never keeps a working-tree copy of .fgos/ by design (ADR0020); if you ran "git add -A" here, unstage these paths first (e.g. "git restore --staged .fgos").`);
    return;
  }

  const workerChanges = stagedFgosChangesOnWorkerBranch(committingToplevel);
  const carriedChanges = carriedIn(workerChanges);
  const fgosWorkerChanges = workerChanges.filter((p) => !carriedChanges.has(p));
  if (fgosWorkerChanges.length > 0) {
    refuse(`commit refused: this commit on a worker branch stages changes under ".fgos/" (${fgosWorkerChanges.join(', ')}) -- worker branches must never commit changes under .fgos/ (ADR0020). See docs/how-to/fix-fgos-write-rejected-merge-block.md for how to restore these paths before committing.`);
    return;
  }

  const rootRefusal = rootFileRefusal(committingToplevel);
  if (rootRefusal) {
    refuse(rootRefusal);
    return;
  }

  const censusRefusal = await censusDriftRefusal(committingToplevel);
  if (censusRefusal) {
    refuse(censusRefusal);
    return;
  }

  const configRefusal = configCheckRefusal(committingToplevel);
  if (configRefusal) {
    refuse(configRefusal);
    return;
  }

  await warnOnConventionViolations(committingToplevel);

  if (!hookRunsAtHome(repoRoot, committingToplevel)) {
    // A different, unrelated checkout (sharing this repo's core.hooksPath)
    // is committing -- nothing here concerns it, per the header comment.
    process.exit(0);
    return;
  }

  const fgwBranch = currentFgwBranchIfMainCheckout(repoRoot);
  if (fgwBranch) {
    refuse(`commit refused: main checkout is on branch ${fgwBranch} -- checkout back to the default branch and use "fgos pick <id>" for item work.`);
    return;
  }

  const fgosDir = path.join(repoRoot, '.fgos');
  const { bin: hostBin, tried } = resolveActiveHostBin({ fgosDir });
  const lockVerdict = mainLockVerdict(fgosDir, hostBin);
  if (lockVerdict.kind === 'borrower') {
    // fgOS's own commit under the mutex it holds: it neither checks nor
    // writes the activity beacon.
    process.exit(0);
    return;
  }
  if (lockVerdict.kind === 'held') {
    refuse('commit refused: fgOS is writing the main checkout right now (a claim, checkpoint or land) -- retry in a moment.');
    return;
  }
  if (lockVerdict.kind === 'error') {
    refuse(`commit refused: the main-checkout lock could not be checked (${lockVerdict.message}) -- refusing to commit, per fail-closed policy.`);
    return;
  }

  // Commit-activity beacon (main-checkout-activity.mjs): a different
  // session's commit inside its window is refused; the same session, an
  // elapsed window or no beacon passes. A corrupt beacon is only a hint and
  // fails open. This file never takes the main-checkout mutex, so a
  // commit never blocks a claim, land or `fgctl init`.
  let writer;
  if (!hostBin) {
    refuse(`commit refused: cannot resolve the writer identity (host-missing): no fgos host binary found (tried: ${tried.join('; ')}); run through the \`fgos\` command of an activated workspace, or set FGOS_HOST_BIN to a host binary`);
    return;
  }
  try {
    const { id, source } = identityData(hostBin, ['identity', '--json', '--pid', String(process.pid), '--fgos-dir', fgosDir], repoRoot);
    if (typeof source !== 'string' || (typeof id !== 'string' && !Number.isInteger(id))) throw new Error(`${hostBin} identity printed an unexpected answer`);
    writer = { id, source };
  } catch (err) {
    refuse(`commit refused: cannot resolve the writer identity (host-error): ${hostBin} identity failed: ${String(err?.stderr ?? err?.message ?? err).trim().slice(0, 500)}`);
    return;
  }
  const now = Date.now();
  const verdict = judgeBeacon(readBeacon(fgosDir), writer.id, now);
  if (verdict.decision === 'refuse') {
    refuse(`commit refused: another session committed in this checkout ${Math.round(verdict.ageMs / 1000)}s ago and appears to be actively working here (its activity window ends in ${Math.ceil(verdict.remainingMs / 1000)}s).`);
    return;
  }
  if (verdict.reason === 'corrupt') {
    process.stderr.write('warning: the main-checkout activity beacon could not be read; overwriting it.\n');
  }

  // Written last, after every refusal above, so a refused commit never
  // leaves a beacon behind. Git may still fail the commit after this hook;
  // the beacon then stays lit for its window and only delays other writers.
  try {
    writeBeacon(fgosDir, { writer, windowMs: resolveTtlMs(), now });
  } catch (error) {
    process.stderr.write(`warning: could not write the main-checkout activity beacon (${error.message}).\n`);
  }

  process.exit(0);
}

try {
  await main();
} catch (err) {
  if (!err?.refusal) throw err;
  console.error(err.message);
  process.exitCode = 1;
}
