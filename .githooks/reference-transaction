#!/bin/sh
# .githooks/reference-transaction -- documentation-cutover write lease ref guard
# (plan 260925-documentation-authority-unification Phase 8, Step 6b).
#
# Fires for every reference transaction in the repository. Fast-paths when:
# 1. State is not "prepared"
# 2. Ref name does not match target branch (main) or plan branch
# 3. No lease sidecar exists or lease is not held
set -e

# Fast path 1: Only "prepared" state can abort a transaction
if [ "$1" != "prepared" ]; then
  exit 0
fi

# Read all transaction lines from stdin
INPUT=$(cat)
if [ -z "$INPUT" ]; then
  exit 0
fi

# Fast path 2: Only guard target branch (main) and the cutover plan branch
echo "$INPUT" | grep -qE 'refs/heads/(main|plan/260925-documentation-authority-unification)' || exit 0

# Fast path 3: Resolve sidecar path (check cwd, then hook parent, then git common dir)
REPO_ROOT=$(pwd)
SIDECAR="$REPO_ROOT/plans/260925-documentation-authority-unification/reports/phase-08/cutover-write-lease.json"

if [ ! -f "$SIDECAR" ]; then
  HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  MAIN_ROOT=$(cd "$HOOK_DIR/.." && pwd)
  SIDECAR="$MAIN_ROOT/plans/260925-documentation-authority-unification/reports/phase-08/cutover-write-lease.json"
fi

if [ ! -f "$SIDECAR" ]; then
  COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [ -n "$COMMON_DIR" ]; then
    COMMON_ROOT=$(dirname "$COMMON_DIR")
    SIDECAR="$COMMON_ROOT/plans/260925-documentation-authority-unification/reports/phase-08/cutover-write-lease.json"
  fi
fi

if [ ! -f "$SIDECAR" ]; then
  exit 0
fi

# Fast path 4: If sidecar is not in "held" state, allow immediately
if ! grep -q '"state"[[:space:]]*:[[:space:]]*"held"' "$SIDECAR"; then
  exit 0
fi

# Iterate over stdin lines without subshell to ensure exit 1 aborts the script
while read -r old_oid new_oid ref_name; do
  [ -z "$ref_name" ] && continue

  # 1. Plan branch protection: refuse deletion or non-fast-forward
  if [ "$ref_name" = "refs/heads/plan/260925-documentation-authority-unification" ]; then
    if [ "$new_oid" = "0000000000000000000000000000000000000000" ]; then
      echo "reference-transaction refused: cannot delete plan branch while documentation-cutover lease is held." >&2
      exit 1
    fi
    if [ "$old_oid" != "0000000000000000000000000000000000000000" ]; then
      if ! git merge-base --is-ancestor "$old_oid" "$new_oid" 2>/dev/null; then
        echo "reference-transaction refused: non-fast-forward update of plan branch is refused while documentation-cutover lease is held." >&2
        exit 1
      fi
    fi
  fi

  # 2. Target branch protection
  if [ "$ref_name" = "refs/heads/main" ]; then
    if [ "$new_oid" = "0000000000000000000000000000000000000000" ]; then
      echo "reference-transaction refused: cannot delete target branch while documentation-cutover lease is held." >&2
      exit 1
    fi

    if [ "$old_oid" = "0000000000000000000000000000000000000000" ]; then
      CHANGED=$(git diff --name-only 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$new_oid" 2>/dev/null || true)
    else
      CHANGED=$(git diff --name-only "$old_oid" "$new_oid" 2>/dev/null || true)
    fi

    # Check if CHANGED intersects scope
    if echo "$CHANGED" | grep -qE '^(docs(/|$)|AGENTS\.md$|CLAUDE\.md$|core/skills(/|$)|(\.agents/skills|plugins/fgOS/skills)(/|$)|plans/260925-documentation-authority-unification/(transitional-switchboard\.json|reports/phase-08/cutover-write-lease\.json))'; then
      # Check holder token in current worktree or main checkout
      TOKEN_FILE=""
      if [ -f ".fgos/documentation-cutover.token" ]; then
        TOKEN_FILE=".fgos/documentation-cutover.token"
      elif [ -f "$REPO_ROOT/.fgos/documentation-cutover.token" ]; then
        TOKEN_FILE="$REPO_ROOT/.fgos/documentation-cutover.token"
      elif [ -n "$MAIN_ROOT" ] && [ -f "$MAIN_ROOT/.fgos/documentation-cutover.token" ]; then
        TOKEN_FILE="$MAIN_ROOT/.fgos/documentation-cutover.token"
      elif [ -f ".fgos/locks/documentation-cutover.token" ]; then
        TOKEN_FILE=".fgos/locks/documentation-cutover.token"
      fi

      IS_HOLDER=""
      if [ -n "$TOKEN_FILE" ]; then
        TOKEN=$(cat "$TOKEN_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$TOKEN" ]; then
          TOKEN_HASH=$(printf "%s" "$TOKEN" | sha256sum | awk '{print $1}')
          if grep -q "$TOKEN_HASH" "$SIDECAR"; then
            IS_HOLDER="1"
          fi
        fi
      fi

      if [ -z "$IS_HOLDER" ]; then
        echo "reference-transaction refused: reference update touches documentation scope while documentation-cutover write lease is held. Run \"fgos docs-lease status\" or \"fgos docs-lease abandon\"." >&2
        exit 1
      fi
    fi
  fi
done << EOF
$INPUT
EOF
