{
  "enabledPlugins": {
    "dogfood-fixture@fgos-plugins": true,
    "fgOS@fgos-plugins": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/dev-rules-reminder.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/plan-format-kanban.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-state.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "Agent|Task|TodoWrite|TodoRead"
      },
      {
        "hooks": [
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-quota-cache-refresh.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
