          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-output-guardrail.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          },
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/simplify-gate.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-output-guardrail.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          },
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/dev-rules-reminder.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          },
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/simplify-gate.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          },
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-quota-cache-refresh.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "statusLine": {
    "command": "/home/vantt/.local/bin/node /home/vantt/projects/forgentX/.claude/ak-engineer-statusline.cjs",
