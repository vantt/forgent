    "PreCompact": [
      {
        "hooks": [
          {
            "command": "P=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact-capture.cjs\"; [ -f \"$P\" ] || exit 0; exec node \"$P\"",
            "type": "command"
          }
        ],
        "matcher": "*"
