{
  "name": "head-gone",
  "requires": ["fgos.head.state"],
  "window": "own",
  "query": {
    "since": "-30d",
    "kind": ["fgos.head.state"],
    "latest_per": "subject",
    "where_latest": [
      {
        "any": [
          [
            { "field": "fgos.head.state", "op": "eq", "value": "gone" }
          ],
          [
            { "field": "fgos.head.state", "op": "eq", "value": "ended" },
            { "field": "fgos.head.role", "op": "prefix", "value": "head:shaper-" }
          ],
          [
            { "field": "fgos.head.state", "op": "eq", "value": "ended" },
            { "field": "fgos.head.role", "op": "prefix", "value": "head:planner-" }
          ],
          [
            { "field": "fgos.head.state", "op": "eq", "value": "ended" },
            { "field": "fgos.head.role", "op": "prefix", "value": "head:secretary-" }
          ],
          [
            { "field": "fgos.head.state", "op": "eq", "value": "ended" },
            { "field": "fgos.head.role", "op": "prefix", "value": "head:supervisor-" }
          ]
        ]
      }
    ],
    "by": ["subject.id"],
    "agg": ["count", "max:ts"]
  },
  "row": { "kind": "head-gone", "reason": "a head that was live has gone and nothing replaced it", "nextCommand": "fgos supervisor plans" }
}
