{
  "name": "plan-no-progress",
  "requires": ["fgos.plan.status", "fgos.plan.activity", "fgos.run.attempt"],
  "window": "own",
  "query": {
    "kind": ["fgos.plan.status"],
    "where": [
      { "field": "fgos.plan.change", "op": "eq", "value": "status" }
    ],
    "latest_per": "subject",
    "where_latest": [
      { "field": "fgos.plan.to", "op": "eq", "value": "running" }
    ],
    "without": [
      { "kind": ["fgos.plan.activity", "fgos.run.attempt"], "on": "plan", "within": { "param": "minutes", "unit": "m" } }
    ],
    "by": ["subject.id"],
    "agg": ["count", "max:ts"]
  },
  "params": { "minutes": { "configKey": "dispatch.attention.planNoProgressMinutes" } },
  "row": { "kind": "plan-no-progress", "reason": "a running plan has had no commit, board entry or run attempt within the no-progress window", "nextCommand": "fgos supervisor plans" }
}
