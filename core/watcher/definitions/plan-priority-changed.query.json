{
  "name": "plan-priority-changed",
  "requires": ["fgos.plan.status"],
  "query": {
    "kind": ["fgos.plan.status"],
    "where": [
      { "field": "fgos.plan.change", "op": "eq", "value": "priority" }
    ],
    "by": ["subject.id"],
    "agg": ["max:ts"]
  },
  "row": { "kind": "plan-priority-changed", "reason": "a plan's priority changed", "nextCommand": "fgos supervisor plans" }
}
