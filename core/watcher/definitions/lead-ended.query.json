{
  "name": "lead-ended",
  "requires": [
    "fgos.head.state"
  ],
  "query": {
    "kind": [
      "fgos.head.state"
    ],
    "where": [
      {
        "field": "fgos.head.state",
        "op": "eq",
        "value": "retired"
      },
      {
        "any": [
          [
            {
              "field": "fgos.head.role",
              "op": "prefix",
              "value": "head:lead-"
            }
          ],
          [
            {
              "field": "fgos.head.role",
              "op": "prefix",
              "value": "lead:"
            }
          ]
        ]
      }
    ],
    "by": [
      "subject.id"
    ],
    "agg": [
      "max:ts"
    ]
  },
  "row": {
    "kind": "lead-ended",
    "reason": "a lead retired",
    "nextCommand": "fgos supervisor plans"
  }
}
