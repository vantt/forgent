{
  "name": "plan-drafted",
  "requires": [
    "fgos.plan.status"
  ],
  "query": {
    "kind": [
      "fgos.plan.status"
    ],
    "where": [
      {
        "field": "fgos.plan.change",
        "op": "eq",
        "value": "status"
      },
      {
        "field": "fgos.plan.to",
        "op": "eq",
        "value": "draft"
      }
    ],
    "by": [
      "subject.id"
    ],
    "agg": [
      "max:ts"
    ]
  },
  "row": {
    "kind": "plan-drafted",
    "reason": "a plan landed as draft",
    "nextCommand": "fgos supervisor plans"
  }
}
