{
  "name": "lane-freed",
  "requires": ["fgos.run.attempt"],
  "query": {
    "kind": ["fgos.run.attempt"],
    "window_on": "end",
    "latest_per": "subject",
    "by": ["origin.host", "subject.id"],
    "agg": ["max:ts", "span"]
  },
  "row": { "kind": "lane-freed", "reason": "a worker attempt ended and freed a lane on this machine", "nextCommand": "fgos supervisor plans" }
}
