        },
        {
          "level": 2,
          "text": "Additive, not either/or",
          "anchor": "additive-not-eitheror",
          "githubAnchor": "additive-not-eitheror",
          "stableAnchor": "h-993daca11e9e"
        },
        {
          "level": 2,
