        {
          "level": 1,
          "text": "P07.3 + P08.1 — Independent Review (Wave 3)",
          "anchor": "p073-p081-independent-review-wave-3",
          "githubAnchor": "p073-p081-independent-review-wave-3",
          "stableAnchor": "h-c6d711b9b94d"
        },
        {
          "level": 2,
          "text": "Part 1 — What I verified as genuinely correct",
          "anchor": "part-1-what-i-verified-as-genuinely-correct",
          "githubAnchor": "part-1-what-i-verified-as-genuinely-correct",
          "stableAnchor": "h-372aca548348"
        },
        {
          "level": 3,
          "text": "1.1 Terminal-transition authority is genuinely retained (P07.3 priority 1)",
          "anchor": "11-terminal-transition-authority-is-genuinely-retained-p073-priority-1",
          "githubAnchor": "11-terminal-transition-authority-is-genuinely-retained-p073-priority-1",
          "stableAnchor": "h-389f21451b45"
        },
        {
          "level": 3,
          "text": "1.2 The partial-cohort bypass is genuinely fixed in the shipped code (priority 2)",
          "anchor": "12-the-partial-cohort-bypass-is-genuinely-fixed-in-the-shipped-code-priority-2",
          "githubAnchor": "12-the-partial-cohort-bypass-is-genuinely-fixed-in-the-shipped-code-priority-2",
          "stableAnchor": "h-7cc1f156e5f3"
        },
        {
          "level": 3,
          "text": "1.3 The `completion.mode` regression test is real (priority 3)",
          "anchor": "13-the-completionmode-regression-test-is-real-priority-3",
          "githubAnchor": "13-the-completionmode-regression-test-is-real-priority-3",
          "stableAnchor": "h-847010b44689"
        },
        {
          "level": 3,
          "text": "1.4 P08.1's closed enum and Non-Negotiable Deferral compliance (priority 4)",
          "anchor": "14-p081s-closed-enum-and-non-negotiable-deferral-compliance-priority-4",
          "githubAnchor": "14-p081s-closed-enum-and-non-negotiable-deferral-compliance-priority-4",
          "stableAnchor": "h-0863fce19219"
        },
        {
          "level": 3,
          "text": "1.5 P08.1's rejection tests are non-vacuous (priority 5)",
          "anchor": "15-p081s-rejection-tests-are-non-vacuous-priority-5",
          "githubAnchor": "15-p081s-rejection-tests-are-non-vacuous-priority-5",
          "stableAnchor": "h-4d78658581eb"
        },
        {
          "level": 3,
          "text": "1.6 P07.3's replay refusals are real forgeries, not mocks",
          "anchor": "16-p073s-replay-refusals-are-real-forgeries-not-mocks",
          "githubAnchor": "16-p073s-replay-refusals-are-real-forgeries-not-mocks",
