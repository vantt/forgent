        },
        {
          "level": 2,
          "text": "Fix Round (post Reviewer + Red-Team, Wave 3 disposition items 1, 2, 3, 7, 8, 9a, 10a)",
          "anchor": "fix-round-post-reviewer-red-team-wave-3-disposition-items-1-2-3-7-8-9a-10a",
          "githubAnchor": "fix-round-post-reviewer-red-team-wave-3-disposition-items-1-2-3-7-8-9a-10a",
          "stableAnchor": "h-9e8b2f05d956"
        },
        {
          "level": 3,
          "text": "1 (HIGH) — `validateSessionAggregation` no longer accepts a caller-supplied FlowDefinition",
          "anchor": "1-high-validatesessionaggregation-no-longer-accepts-a-caller-supplied-flowdefinition",
          "githubAnchor": "1-high-validatesessionaggregation-no-longer-accepts-a-caller-supplied-flowdefinition",
          "stableAnchor": "h-df7e23956617"
        },
        {
          "level": 3,
          "text": "2 (LOW-MEDIUM) — a single-source aggregation records `no-consensus` instead of throwing",
          "anchor": "2-low-medium-a-single-source-aggregation-records-no-consensus-instead-of-throwing",
          "githubAnchor": "2-low-medium-a-single-source-aggregation-records-no-consensus-instead-of-throwing",
          "stableAnchor": "h-45892c45af70"
        },
        {
          "level": 3,
          "text": "3 (LOW-MEDIUM) — `requiredDisclosures: []` refused at definition time",
          "anchor": "3-low-medium-requireddisclosures-refused-at-definition-time",
          "githubAnchor": "3-low-medium-requireddisclosures-refused-at-definition-time",
          "stableAnchor": "h-2fd303d859b2"
        },
        {
          "level": 3,
          "text": "7 (LOW) — duplicate `sourceOperationRefs` refused at definition time",
