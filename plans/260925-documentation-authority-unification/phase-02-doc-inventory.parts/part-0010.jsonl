      "headings": [
        {
          "level": 1,
          "text": "Review: ADR-007 Decision vs. `enrich-and-validate-contract.mjs`",
          "anchor": "review-adr-007-decision-vs-enrich-and-validate-contractmjs",
          "githubAnchor": "review-adr-007-decision-vs-enrich-and-validate-contractmjs",
          "stableAnchor": "h-1bbc6e1be556"
        },
        {
          "level": 2,
          "text": "Verdict: all four hold. No mismatch found.",
          "anchor": "verdict-all-four-hold-no-mismatch-found",
          "githubAnchor": "verdict-all-four-hold-no-mismatch-found",
          "stableAnchor": "h-830d99908379"
        },
        {
          "level": 3,
          "text": "(a) Pure — no fs/network/store writes",
          "anchor": "a-pure-no-fsnetworkstore-writes",
          "githubAnchor": "a-pure-no-fsnetworkstore-writes",
          "stableAnchor": "h-2e32c9ee1ff7"
        },
        {
          "level": 3,
          "text": "(b) Never selects executor/provider/tier, never touches Work lifecycle",
          "anchor": "b-never-selects-executorprovidertier-never-touches-work-lifecycle",
          "githubAnchor": "b-never-selects-executorprovidertier-never-touches-work-lifecycle",
          "stableAnchor": "h-a3add9ebce11"
        },
        {
          "level": 3,
          "text": "(c) Fail-closed reject when `contract.supports` is not legal for the Work's current stage",
          "anchor": "c-fail-closed-reject-when-contractsupports-is-not-legal-for-the-works-current-stage",
          "githubAnchor": "c-fail-closed-reject-when-contractsupports-is-not-legal-for-the-works-current-stage",
          "stableAnchor": "h-c86594e17a98"
        },
        {
          "level": 3,
          "text": "(d) Only appends to (never replaces) contextRefs/constraints/expectedOutputs",
          "anchor": "d-only-appends-to-never-replaces-contextrefsconstraintsexpectedoutputs",
          "githubAnchor": "d-only-appends-to-never-replaces-contextrefsconstraintsexpectedoutputs",
          "stableAnchor": "h-37f90c3d34dc"
        },
