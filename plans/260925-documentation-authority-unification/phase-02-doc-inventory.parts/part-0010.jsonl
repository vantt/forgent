        },
        {
          "level": 2,
          "text": "Part 2 — Findings",
          "anchor": "part-2-findings",
          "githubAnchor": "part-2-findings",
          "stableAnchor": "h-a7af3c01ca95"
        },
        {
          "level": 3,
          "text": "F1 — MEDIUM — The aggregation terminal gate is opt-in and currently unreachable in production; this makes the trace's headline residual over-weighted",
          "anchor": "f1-medium-the-aggregation-terminal-gate-is-opt-in-and-currently-unreachable-in-production-this-makes-the-traces-headline-residual-over-weighted",
          "githubAnchor": "f1-medium-the-aggregation-terminal-gate-is-opt-in-and-currently-unreachable-in-production-this-makes-the-traces-headline-residual-over-weighted",
          "stableAnchor": "h-001f75658d38"
        },
        {
          "level": 3,
          "text": "F2 — MEDIUM — P08.1's \"real Assignment/Run provenance\" is presence-only, and the gap is not disclosed",
          "anchor": "f2-medium-p081s-real-assignmentrun-provenance-is-presence-only-and-the-gap-is-not-disclosed",
          "githubAnchor": "f2-medium-p081s-real-assignmentrun-provenance-is-presence-only-and-the-gap-is-not-disclosed",
          "stableAnchor": "h-f732341d8009"
        },
        {
          "level": 3,
          "text": "F3 — LOW — Duplicate `sourceOperationRefs` pass definition validation, then throw a foreign error type at runtime",
          "anchor": "f3-low-duplicate-sourceoperationrefs-pass-definition-validation-then-throw-a-foreign-error-type-at-runtime",
          "githubAnchor": "f3-low-duplicate-sourceoperationrefs-pass-definition-validation-then-throw-a-foreign-error-type-at-runtime",
          "stableAnchor": "h-9f1d3fb7879f"
        },
        {
          "level": 3,
          "text": "F4 — LOW — A source operation with zero declared bindings yields an unexplained `no-consensus`",
          "anchor": "f4-low-a-source-operation-with-zero-declared-bindings-yields-an-unexplained-no-consensus",
          "githubAnchor": "f4-low-a-source-operation-with-zero-declared-bindings-yields-an-unexplained-no-consensus",
          "stableAnchor": "h-69d125483e44"
        },
        {
          "level": 3,
          "text": "F5 — LOW — P08.1 lineage checks do not cover anchors or duplicate contribution ids",
          "anchor": "f5-low-p081-lineage-checks-do-not-cover-anchors-or-duplicate-contribution-ids",
          "githubAnchor": "f5-low-p081-lineage-checks-do-not-cover-anchors-or-duplicate-contribution-ids",
          "stableAnchor": "h-156fe8b71260"
        },
        {
          "level": 3,
