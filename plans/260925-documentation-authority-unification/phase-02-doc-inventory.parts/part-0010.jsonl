        },
        {
          "level": 3,
          "text": "1.3 The actual rule",
          "anchor": "13-the-actual-rule",
          "githubAnchor": "13-the-actual-rule",
          "stableAnchor": "h-f08e4bd369e5"
        },
        {
          "level": 3,
          "text": "1.4 A third exclusion, found empirically while running the regression suite",
          "anchor": "14-a-third-exclusion-found-empirically-while-running-the-regression-suite",
