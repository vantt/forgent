      "headings": [
        {
          "level": 1,
          "text": "`node --test` parallelizes per file — so one slow file sets the whole suite's floor",
          "anchor": "node---test-parallelizes-per-file-so-one-slow-file-sets-the-whole-suites-floor",
          "githubAnchor": "node---test-parallelizes-per-file-so-one-slow-file-sets-the-whole-suites-floor",
