        {
          "level": 3,
          "text": "Fix 1 (HIGH) — mechanical R2 enforcement inside `chooseStageOperation` itself, regardless of how `lastRunResult` was populated",
          "anchor": "fix-1-high-mechanical-r2-enforcement-inside-choosestageoperation-itself-regardless-of-how-lastrunresult-was-populated",
          "githubAnchor": "fix-1-high-mechanical-r2-enforcement-inside-choosestageoperation-itself-regardless-of-how-lastrunresult-was-populated",
          "stableAnchor": "h-f3a5678765ce"
        },
        {
          "level": 3,
          "text": "Fix 2 (HIGH) — re-validate the harness-enriched contract before it reaches the frozen Assignment",
          "anchor": "fix-2-high-re-validate-the-harness-enriched-contract-before-it-reaches-the-frozen-assignment",
          "githubAnchor": "fix-2-high-re-validate-the-harness-enriched-contract-before-it-reaches-the-frozen-assignment",
