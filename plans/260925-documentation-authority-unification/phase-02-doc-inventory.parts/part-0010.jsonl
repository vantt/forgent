          "githubAnchor": "6-disposition-coordinator-2026-09-04",
          "stableAnchor": "h-29585f43d29e"
        },
        {
          "level": 2,
          "text": "7. Fix Round 1",
          "anchor": "7-fix-round-1",
          "githubAnchor": "7-fix-round-1",
          "stableAnchor": "h-496518d6737b"
        },
        {
          "level": 3,
          "text": "7.1 HIGH-1 — resolution failures degrade to `definition = null`",
          "anchor": "71-high-1-resolution-failures-degrade-to-definition-null",
          "githubAnchor": "71-high-1-resolution-failures-degrade-to-definition-null",
          "stableAnchor": "h-f502c1075398"
        },
        {
          "level": 3,
          "text": "7.2 HIGH-2 — version drift is refused explicitly, on CLOSE only",
          "anchor": "72-high-2-version-drift-is-refused-explicitly-on-close-only",
          "githubAnchor": "72-high-2-version-drift-is-refused-explicitly-on-close-only",
          "stableAnchor": "h-8166c4a8250b"
        },
        {
          "level": 3,
          "text": "7.3 HIGH-3 — corrected the false \"byte-identical fallback\" claim",
          "anchor": "73-high-3-corrected-the-false-byte-identical-fallback-claim",
          "githubAnchor": "73-high-3-corrected-the-false-byte-identical-fallback-claim",
          "stableAnchor": "h-83d11e0bcf82"
        },
        {
          "level": 3,
          "text": "7.4 HIGH-4 — quorum/close coverage added for all 5 previously-dark protocols",
