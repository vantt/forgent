          "level": 1,
          "text": "Close out a decomposed root item after all its children are done",
          "anchor": "close-out-a-decomposed-root-item-after-all-its-children-are-done",
          "githubAnchor": "close-out-a-decomposed-root-item-after-all-its-children-are-done",
