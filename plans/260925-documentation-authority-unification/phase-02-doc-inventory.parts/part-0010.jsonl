          "stableAnchor": "h-c9abdc6970c3"
        },
        {
          "level": 2,
          "text": "Summary (Fix Round 1)",
          "anchor": "summary-fix-round-1",
          "githubAnchor": "summary-fix-round-1",
          "stableAnchor": "h-80969699dd6e"
        },
        {
          "level": 2,
          "text": "9. Disposition (Fix Round 2, Coordinator, 2026-09-04)",
