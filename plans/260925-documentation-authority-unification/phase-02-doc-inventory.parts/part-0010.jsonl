          "stableAnchor": "h-95cd75801a6d"
        },
        {
          "level": 2,
          "text": "1. Check whether the generic per-tier override already covers you",
          "anchor": "1-check-whether-the-generic-per-tier-override-already-covers-you",
          "githubAnchor": "1-check-whether-the-generic-per-tier-override-already-covers-you",
          "stableAnchor": "h-759a17e5d04b"
        },
        {
          "level": 2,
