          "stableAnchor": "h-60c152e36929"
        },
        {
          "level": 2,
          "text": "PATCH, not PUT — because `fgos edit` is a partial update",
          "anchor": "patch-not-put-because-fgos-edit-is-a-partial-update",
          "githubAnchor": "patch-not-put-because-fgos-edit-is-a-partial-update",
          "stableAnchor": "h-350e082b95aa"
        },
        {
          "level": 2,
          "text": "The accepted-fields list is read from the engine, never re-declared",
          "anchor": "the-accepted-fields-list-is-read-from-the-engine-never-re-declared",
          "githubAnchor": "the-accepted-fields-list-is-read-from-the-engine-never-re-declared",
          "stableAnchor": "h-44d89daaf1d7"
        },
        {
          "level": 2,
          "text": "Validation stays in the engine — the gateway never re-implements it",
          "anchor": "validation-stays-in-the-engine-the-gateway-never-re-implements-it",
          "githubAnchor": "validation-stays-in-the-engine-the-gateway-never-re-implements-it",
