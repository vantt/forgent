          "githubAnchor": "measured-not-assumed",
          "stableAnchor": "h-a6d473ad0beb"
        },
        {
          "level": 2,
          "text": "What shipped — a mechanical split, twice",
          "anchor": "what-shipped-a-mechanical-split-twice",
          "githubAnchor": "what-shipped-a-mechanical-split-twice",
          "stableAnchor": "h-2c37fcd44e6f"
        },
        {
          "level": 2,
          "text": "A latent race the split itself exposed — fixed inline, not deferred",
          "anchor": "a-latent-race-the-split-itself-exposed-fixed-inline-not-deferred",
          "githubAnchor": "a-latent-race-the-split-itself-exposed-fixed-inline-not-deferred",
          "stableAnchor": "h-bb8a407e83a8"
        },
        {
          "level": 2,
          "text": "The verify command's own ceiling needed real recalibration",
          "anchor": "the-verify-commands-own-ceiling-needed-real-recalibration",
          "githubAnchor": "the-verify-commands-own-ceiling-needed-real-recalibration",
          "stableAnchor": "h-255428dd6671"
        },
        {
          "level": 2,
          "text": "Living reproduction case for an unrelated bug",
