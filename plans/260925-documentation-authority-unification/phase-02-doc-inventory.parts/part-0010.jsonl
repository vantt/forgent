          "githubAnchor": "confirmed-live-reproduced-deterministically-twice",
          "stableAnchor": "h-dc6faeeae49a"
        },
        {
          "level": 2,
          "text": "The cost while unfixed, and the workaround used",
          "anchor": "the-cost-while-unfixed-and-the-workaround-used",
          "githubAnchor": "the-cost-while-unfixed-and-the-workaround-used",
          "stableAnchor": "h-ee96a1eafdbf"
        },
        {
          "level": 2,
          "text": "The real fix, landed under `tsk-1ht`",
          "anchor": "the-real-fix-landed-under-tsk-1ht",
          "githubAnchor": "the-real-fix-landed-under-tsk-1ht",
          "stableAnchor": "h-3914d55f61e1"
        },
        {
          "level": 2,
