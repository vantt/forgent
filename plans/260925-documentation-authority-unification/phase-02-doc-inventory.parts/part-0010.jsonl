        },
        {
          "level": 3,
          "text": "Finding: timeout settlement waited on `close`, exposing an escaped-descendant delay (commit `7ed5d2e5`, part 1/3)",
          "anchor": "finding-timeout-settlement-waited-on-close-exposing-an-escaped-descendant-delay-commit-7ed5d2e5-part-13",
          "githubAnchor": "finding-timeout-settlement-waited-on-close-exposing-an-escaped-descendant-delay-commit-7ed5d2e5-part-13",
          "stableAnchor": "h-6ddac4a82605"
        },
        {
          "level": 3,
          "text": "Finding: the calling process's own event loop hung on the pipe even after the promise settled (commit `7ed5d2e5`, part 2/3)",
          "anchor": "finding-the-calling-processs-own-event-loop-hung-on-the-pipe-even-after-the-promise-settled-commit-7ed5d2e5-part-23",
          "githubAnchor": "finding-the-calling-processs-own-event-loop-hung-on-the-pipe-even-after-the-promise-settled-commit-7ed5d2e5-part-23",
          "stableAnchor": "h-c17acb589302"
        },
        {
          "level": 3,
          "text": "Finding: herdr-spawn's own `waitChild` observer was never process-grouped (commit `7ed5d2e5`, part 3/3)",
          "anchor": "finding-herdr-spawns-own-waitchild-observer-was-never-process-grouped-commit-7ed5d2e5-part-33",
          "githubAnchor": "finding-herdr-spawns-own-waitchild-observer-was-never-process-grouped-commit-7ed5d2e5-part-33",
          "stableAnchor": "h-0c59b85b8ca1"
        },
        {
          "level": 3,
          "text": "Finding: echo-stripping missed a second, prompt-prefixed occurrence (commit `9faf8879`)",
          "anchor": "finding-echo-stripping-missed-a-second-prompt-prefixed-occurrence-commit-9faf8879",
          "githubAnchor": "finding-echo-stripping-missed-a-second-prompt-prefixed-occurrence-commit-9faf8879",
          "stableAnchor": "h-e1ee77877269"
        },
        {
          "level": 2,
          "text": "From the commit's own contemporaneous record",
          "anchor": "from-the-commits-own-contemporaneous-record",
          "githubAnchor": "from-the-commits-own-contemporaneous-record",
          "stableAnchor": "h-d97846b7a773"
        },
        {
          "level": 3,
          "text": "`580fe09e` — egress-governance host check was a bypassable substring match",
          "anchor": "580fe09e-egress-governance-host-check-was-a-bypassable-substring-match",
          "githubAnchor": "580fe09e-egress-governance-host-check-was-a-bypassable-substring-match",
          "stableAnchor": "h-ec4932da17b6"
        },
        {
          "level": 3,
          "text": "`2db1fe88` — herdr-spawn pane run was vulnerable to shell command injection",
          "anchor": "2db1fe88-herdr-spawn-pane-run-was-vulnerable-to-shell-command-injection",
          "githubAnchor": "2db1fe88-herdr-spawn-pane-run-was-vulnerable-to-shell-command-injection",
