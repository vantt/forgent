      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "The registry this session's own retrospective synthesis runs on, decided here",
          "anchor": "the-registry-this-sessions-own-retrospective-synthesis-runs-on-decided-here",
          "githubAnchor": "the-registry-this-sessions-own-retrospective-synthesis-runs-on-decided-here",
          "stableAnchor": "h-b7507b53f17b"
        },
        {
          "level": 2,
          "text": "The full spec lives elsewhere — this doc is the narrative, not a duplicate",
          "anchor": "the-full-spec-lives-elsewhere-this-doc-is-the-narrative-not-a-duplicate",
          "githubAnchor": "the-full-spec-lives-elsewhere-this-doc-is-the-narrative-not-a-duplicate",
          "stableAnchor": "h-e9ae0eecc6a3"
        },
        {
          "level": 2,
          "text": "The core reframe: two axes, not one",
          "anchor": "the-core-reframe-two-axes-not-one",
          "githubAnchor": "the-core-reframe-two-axes-not-one",
          "stableAnchor": "h-daaa0d5edd09"
        },
        {
          "level": 2,
          "text": "The registry itself",
          "anchor": "the-registry-itself",
          "githubAnchor": "the-registry-itself",
          "stableAnchor": "h-85c45c2ac798"
        },
        {
          "level": 2,
          "text": "Naming: compound → knowledge",
          "anchor": "naming-compound-knowledge",
          "githubAnchor": "naming-compound-knowledge",
          "stableAnchor": "h-78d1280588da"
        },
        {
          "level": 2,
          "text": "Scope carved out on purpose",
          "anchor": "scope-carved-out-on-purpose",
          "githubAnchor": "scope-carved-out-on-purpose",
          "stableAnchor": "h-cf9f0c559ca9"
        },
        {
          "level": 2,
          "text": "What landed as code: 12 children, this root just decomposed and locked design",
          "anchor": "what-landed-as-code-12-children-this-root-just-decomposed-and-locked-design",
          "githubAnchor": "what-landed-as-code-12-children-this-root-just-decomposed-and-locked-design",
          "stableAnchor": "h-0ec34ac7eb16"
        },
        {
          "level": 3,
          "text": "Child 1 — the domain model itself (`tsk-28x-1`)",
          "anchor": "child-1-the-domain-model-itself-tsk-28x-1",
          "githubAnchor": "child-1-the-domain-model-itself-tsk-28x-1",
          "stableAnchor": "h-645f9f68df12"
        },
        {
          "level": 3,
          "text": "Child 2 — the docPath resolver, aliases only (`tsk-28x-2`)",
          "anchor": "child-2-the-docpath-resolver-aliases-only-tsk-28x-2",
          "githubAnchor": "child-2-the-docpath-resolver-aliases-only-tsk-28x-2",
          "stableAnchor": "h-06be56b2059a"
        },
        {
          "level": 3,
          "text": "Child 3 — the doc-only classifier over the existing 268-document corpus (`tsk-28x-3`)",
          "anchor": "child-3-the-doc-only-classifier-over-the-existing-268-document-corpus-tsk-28x-3",
          "githubAnchor": "child-3-the-doc-only-classifier-over-the-existing-268-document-corpus-tsk-28x-3",
          "stableAnchor": "h-b239e8ae64fd"
        },
        {
          "level": 3,
          "text": "Child 4 — bootstrap the registry from the classifier's output (`tsk-28x-4`)",
          "anchor": "child-4-bootstrap-the-registry-from-the-classifiers-output-tsk-28x-4",
          "githubAnchor": "child-4-bootstrap-the-registry-from-the-classifiers-output-tsk-28x-4",
          "stableAnchor": "h-6d6397e01403"
        },
        {
          "level": 3,
          "text": "Child 5 — the `topic`/`doc` CLI verbs themselves (`tsk-28x-5`)",
          "anchor": "child-5-the-topicdoc-cli-verbs-themselves-tsk-28x-5",
          "githubAnchor": "child-5-the-topicdoc-cli-verbs-themselves-tsk-28x-5",
          "stableAnchor": "h-d1ff0de23dc0"
        },
        {
          "level": 3,
          "text": "Child 6 — the `knowledge attest` gate (`tsk-28x-6`)",
          "anchor": "child-6-the-knowledge-attest-gate-tsk-28x-6",
          "githubAnchor": "child-6-the-knowledge-attest-gate-tsk-28x-6",
          "stableAnchor": "h-f74e7b3b2c24"
        },
        {
          "level": 3,
          "text": "Child 7 — switching real consumers to the resolver, a hard checkpoint (`tsk-28x-7`)",
          "anchor": "child-7-switching-real-consumers-to-the-resolver-a-hard-checkpoint-tsk-28x-7",
          "githubAnchor": "child-7-switching-real-consumers-to-the-resolver-a-hard-checkpoint-tsk-28x-7",
          "stableAnchor": "h-9751f564f710"
        },
        {
          "level": 3,
          "text": "Child 8 — the two projections plus doctor checks (`tsk-28x-8`)",
          "anchor": "child-8-the-two-projections-plus-doctor-checks-tsk-28x-8",
          "githubAnchor": "child-8-the-two-projections-plus-doctor-checks-tsk-28x-8",
          "stableAnchor": "h-18f659dabad1"
        },
        {
          "level": 3,
          "text": "Child 9 — the writer skill itself, renamed to `fgos-coding-knowledge` (`tsk-28x-9`)",
          "anchor": "child-9-the-writer-skill-itself-renamed-to-fgos-coding-knowledge-tsk-28x-9",
          "githubAnchor": "child-9-the-writer-skill-itself-renamed-to-fgos-coding-knowledge-tsk-28x-9",
          "stableAnchor": "h-a9dea99d946c"
        },
        {
          "level": 3,
          "text": "Child 10 — the end-to-end writer canary, a gate on the migration itself (`tsk-28x-10`)",
          "anchor": "child-10-the-end-to-end-writer-canary-a-gate-on-the-migration-itself-tsk-28x-10",
          "githubAnchor": "child-10-the-end-to-end-writer-canary-a-gate-on-the-migration-itself-tsk-28x-10",
          "stableAnchor": "h-51ede8ae3396"
        },
        {
          "level": 3,
          "text": "Child 11 — the real 268-document migration, dry-run first (`tsk-28x-11`)",
          "anchor": "child-11-the-real-268-document-migration-dry-run-first-tsk-28x-11",
          "githubAnchor": "child-11-the-real-268-document-migration-dry-run-first-tsk-28x-11",
          "stableAnchor": "h-9d8e37dc0577"
        },
        {
          "level": 3,
          "text": "Child 12 — deprecating `fgos compound`, the first real use of this repo's own deprecation path (`tsk-28x-12`)",
          "anchor": "child-12-deprecating-fgos-compound-the-first-real-use-of-this-repos-own-deprecation-path-tsk-28x-12",
          "githubAnchor": "child-12-deprecating-fgos-compound-the-first-real-use-of-this-repos-own-deprecation-path-tsk-28x-12",
          "stableAnchor": "h-ae6e2806c732"
        },
        {
          "level": 2,
          "text": "Landing this item hit the same fgos-write-rejected block 3 times",
          "anchor": "landing-this-item-hit-the-same-fgos-write-rejected-block-3-times",
          "githubAnchor": "landing-this-item-hit-the-same-fgos-write-rejected-block-3-times",
          "stableAnchor": "h-3305e08d421a"
        },
        {
          "level": 3,
          "text": "Child 13 — a code-review follow-on found 4 real gaps in lifecycle enforcement (`tsk-3uc`)",
          "anchor": "child-13-a-code-review-follow-on-found-4-real-gaps-in-lifecycle-enforcement-tsk-3uc",
          "githubAnchor": "child-13-a-code-review-follow-on-found-4-real-gaps-in-lifecycle-enforcement-tsk-3uc",
          "stableAnchor": "h-16f969a4fba6"
        },
        {
          "level": 2,
          "text": "The gate went from built to live: `docRegistry.enforce: true` (`tsk-1uj`)",
          "anchor": "the-gate-went-from-built-to-live-docregistryenforce-true-tsk-1uj",
          "githubAnchor": "the-gate-went-from-built-to-live-docregistryenforce-true-tsk-1uj",
          "stableAnchor": "h-4ccf14036802"
        },
        {
          "level": 2,
          "text": "Two bugs the real migration dry-run surfaced before it could apply (`tsk-ozk`)",
          "anchor": "two-bugs-the-real-migration-dry-run-surfaced-before-it-could-apply-tsk-ozk",
          "githubAnchor": "two-bugs-the-real-migration-dry-run-surfaced-before-it-could-apply-tsk-ozk",
          "stableAnchor": "h-a2fcd4514990"
        },
        {
          "level": 2,
          "text": "`tsk-28x-11` built the migration script; `tsk-5mh` is the item that actually ran it live",
          "anchor": "tsk-28x-11-built-the-migration-script-tsk-5mh-is-the-item-that-actually-ran-it-live",
          "githubAnchor": "tsk-28x-11-built-the-migration-script-tsk-5mh-is-the-item-that-actually-ran-it-live",
          "stableAnchor": "h-c7391dd7789b"
        }
