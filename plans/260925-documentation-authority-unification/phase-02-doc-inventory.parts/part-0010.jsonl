      "headings": [
        {
          "level": 1,
          "text": "A real structural deadlock — two guards required two different `.fgos` values, satisfiable by no snapshot at all",
          "anchor": "a-real-structural-deadlock-two-guards-required-two-different-fgos-values-satisfiable-by-no-snapshot-at-all",
          "githubAnchor": "a-real-structural-deadlock-two-guards-required-two-different-fgos-values-satisfiable-by-no-snapshot-at-all",
          "stableAnchor": "h-807d9d70ece7"
        },
        {
          "level": 2,
          "text": "The deadlock, precisely",
          "anchor": "the-deadlock-precisely",
          "githubAnchor": "the-deadlock-precisely",
          "stableAnchor": "h-4d7eb0ae597b"
        },
        {
          "level": 2,
          "text": "What shipped",
          "anchor": "what-shipped",
          "githubAnchor": "what-shipped",
          "stableAnchor": "h-7447da032786"
        },
        {
          "level": 2,
          "text": "Superseded shortly after — not by a revert, but by removing the files from git entirely",
          "anchor": "superseded-shortly-after-not-by-a-revert-but-by-removing-the-files-from-git-entirely",
          "githubAnchor": "superseded-shortly-after-not-by-a-revert-but-by-removing-the-files-from-git-entirely",
          "stableAnchor": "h-2a50d2effac0"
        },
        {
          "level": 2,
          "text": "Still valid and untouched",
          "anchor": "still-valid-and-untouched",
          "githubAnchor": "still-valid-and-untouched",
          "stableAnchor": "h-59e4c1ab6989"
        },
        {
          "level": 2,
          "text": "A same-class gap in the new sharded layout — `tsk-1wk`",
          "anchor": "a-same-class-gap-in-the-new-sharded-layout-tsk-1wk",
          "githubAnchor": "a-same-class-gap-in-the-new-sharded-layout-tsk-1wk",
          "stableAnchor": "h-4d633665b100"
        },
        {
          "level": 2,
          "text": "The deferred half of this item's own original proposal, implemented later — `tsk-4gi`",
          "anchor": "the-deferred-half-of-this-items-own-original-proposal-implemented-later-tsk-4gi",
          "githubAnchor": "the-deferred-half-of-this-items-own-original-proposal-implemented-later-tsk-4gi",
          "stableAnchor": "h-c625a6a6d020"
        },
        {
          "level": 2,
          "text": "The remaining gap `tsk-4gi` couldn't reach — a genuine git *conflict*, not a clean auto-stage",
          "anchor": "the-remaining-gap-tsk-4gi-couldnt-reach-a-genuine-git-conflict-not-a-clean-auto-stage",
          "githubAnchor": "the-remaining-gap-tsk-4gi-couldnt-reach-a-genuine-git-conflict-not-a-clean-auto-stage",
          "stableAnchor": "h-479d5e250213"
        }
