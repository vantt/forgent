        },
        {
          "level": 2,
          "text": "Why this page exists",
          "anchor": "why-this-page-exists",
          "githubAnchor": "why-this-page-exists",
          "stableAnchor": "h-af0e7a4afb4c"
        },
        {
          "level": 2,
          "text": "What a participant is — and isn't",
          "anchor": "what-a-participant-is-and-isnt",
          "githubAnchor": "what-a-participant-is-and-isnt",
          "stableAnchor": "h-5092fb26a8c7"
        },
        {
          "level": 2,
          "text": "The read door and the write door are not symmetric",
