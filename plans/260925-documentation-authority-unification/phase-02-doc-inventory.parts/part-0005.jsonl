      "headings": [
        {
          "level": 1,
          "text": "Group-Thinking Plan Loop — Design Proposal",
          "anchor": "group-thinking-plan-loop-design-proposal",
          "githubAnchor": "group-thinking-plan-loop-design-proposal",
          "stableAnchor": "h-92c18983550b"
        },
        {
          "level": 2,
          "text": "1. Problem statement",
          "anchor": "1-problem-statement",
          "githubAnchor": "1-problem-statement",
          "stableAnchor": "h-9c686021dcb3"
        },
        {
          "level": 2,
          "text": "2. Options considered, and why two were rejected",
          "anchor": "2-options-considered-and-why-two-were-rejected",
          "githubAnchor": "2-options-considered-and-why-two-were-rejected",
          "stableAnchor": "h-e3cf02acdc72"
        },
        {
          "level": 3,
          "text": "Option A — a dynamically-growing meta-FlowDefinition graph",
          "anchor": "option-a-a-dynamically-growing-meta-flowdefinition-graph",
          "githubAnchor": "option-a-a-dynamically-growing-meta-flowdefinition-graph",
          "stableAnchor": "h-5c044d2a43f1"
        },
        {
          "level": 3,
          "text": "Option B — a thin \"plan runner\" with its own persisted plan/cell ledger",
          "anchor": "option-b-a-thin-plan-runner-with-its-own-persisted-plancell-ledger",
          "githubAnchor": "option-b-a-thin-plan-runner-with-its-own-persisted-plancell-ledger",
          "stableAnchor": "h-ece05bdfadbf"
        },
        {
          "level": 3,
          "text": "Option C (accepted, revised) — chained rigid cell-sessions, plan status as a query, Doer/Fixer mutate inside a Lead-owned isolated worktree",
          "anchor": "option-c-accepted-revised-chained-rigid-cell-sessions-plan-status-as-a-query-doerfixer-mutate-inside-a-lead-owned-isolated-worktree",
          "githubAnchor": "option-c-accepted-revised-chained-rigid-cell-sessions-plan-status-as-a-query-doerfixer-mutate-inside-a-lead-owned-isolated-worktree",
          "stableAnchor": "h-c85ab585c6f7"
        },
        {
          "level": 2,
          "text": "3. Accepted design",
          "anchor": "3-accepted-design",
          "githubAnchor": "3-accepted-design",
          "stableAnchor": "h-32784bf9e351"
        },
        {
          "level": 3,
          "text": "3.1 No new protocol kind",
          "anchor": "31-no-new-protocol-kind",
          "githubAnchor": "31-no-new-protocol-kind",
          "stableAnchor": "h-596bfa600d46"
        },
        {
          "level": 3,
          "text": "3.2 Chaining: an id convention, not a new persistence layer",
          "anchor": "32-chaining-an-id-convention-not-a-new-persistence-layer",
          "githubAnchor": "32-chaining-an-id-convention-not-a-new-persistence-layer",
          "stableAnchor": "h-2b151c360ebc"
        },
        {
          "level": 3,
          "text": "3.3 Plan status is a query over the session chain, never a stored object",
          "anchor": "33-plan-status-is-a-query-over-the-session-chain-never-a-stored-object",
          "githubAnchor": "33-plan-status-is-a-query-over-the-session-chain-never-a-stored-object",
          "stableAnchor": "h-47224be0bfff"
        },
        {
          "level": 3,
          "text": "3.4 Mutation: Doer/Fixer work inside a Lead-owned, isolated git worktree — not a read-only session producing a patch artifact",
          "anchor": "34-mutation-doerfixer-work-inside-a-lead-owned-isolated-git-worktree-not-a-read-only-session-producing-a-patch-artifact",
          "githubAnchor": "34-mutation-doerfixer-work-inside-a-lead-owned-isolated-git-worktree-not-a-read-only-session-producing-a-patch-artifact",
          "stableAnchor": "h-1f1cc8ca841b"
        },
        {
          "level": 3,
          "text": "3.5 A real, previously-untested bug found during this design's own investigation",
          "anchor": "35-a-real-previously-untested-bug-found-during-this-designs-own-investigation",
          "githubAnchor": "35-a-real-previously-untested-bug-found-during-this-designs-own-investigation",
          "stableAnchor": "h-3b5ca4b2b242"
        },
        {
          "level": 3,
          "text": "3.6 The Lead's own operating loop",
          "anchor": "36-the-leads-own-operating-loop",
          "githubAnchor": "36-the-leads-own-operating-loop",
          "stableAnchor": "h-7e3d99e4dc13"
        },
        {
          "level": 2,
          "text": "4. Explicitly out of scope for this plan",
          "anchor": "4-explicitly-out-of-scope-for-this-plan",
          "githubAnchor": "4-explicitly-out-of-scope-for-this-plan",
          "stableAnchor": "h-a84f20afa0c8"
        },
        {
          "level": 2,
          "text": "5. Acceptance for this proposal",
          "anchor": "5-acceptance-for-this-proposal",
          "githubAnchor": "5-acceptance-for-this-proposal",
          "stableAnchor": "h-19b4d2ff5d36"
        }
