        },
        {
          "level": 3,
          "text": "`0a373722` — herdr-spawn's temp run-script self-deletes at startup (P2)",
          "anchor": "0a373722-herdr-spawns-temp-run-script-self-deletes-at-startup-p2",
          "githubAnchor": "0a373722-herdr-spawns-temp-run-script-self-deletes-at-startup-p2",
          "stableAnchor": "h-3e162609da2c"
        },
        {
          "level": 3,
          "text": "`e55a1da8` — dispatch adapters resolve on 'close', not 'exit' (stdout-loss race)",
