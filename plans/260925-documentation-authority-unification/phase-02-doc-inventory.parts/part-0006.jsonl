      "path": "docs/knowledge/worker-slot-concept-and-engine-wide-worker-occupancy-ceiling/worker-slot-is-the-engine-owned-occupancy-unit-across-every-launcher.md",
      "sourceId": "src_09813e0c26bc413346e4",
      "sourceDigest": "cf92920a8a721b0bba1b6dc080e89f7f103a65c175d333a5a64d5d0db9383033",
      "blobSha": "384f0ee83c44db018365b873021b5297519ea9df",
