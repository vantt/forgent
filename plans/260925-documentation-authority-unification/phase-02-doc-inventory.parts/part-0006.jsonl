          "level": 1,
          "text": "tsk-4hj-stale-merge-head-misclassified-as-conflict — locked decisions",
          "anchor": "tsk-4hj-stale-merge-head-misclassified-as-conflict-locked-decisions",
          "githubAnchor": "tsk-4hj-stale-merge-head-misclassified-as-conflict-locked-decisions",
