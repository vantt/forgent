          "githubAnchor": "what-consumers-had-to-change",
          "stableAnchor": "h-747355d359f1"
        },
        {
          "level": 2,
          "text": "Explicit non-goals",
          "anchor": "explicit-non-goals",
          "githubAnchor": "explicit-non-goals",
          "stableAnchor": "h-be4ffd7610f5"
        },
        {
          "level": 2,
          "text": "Acceptance bar this item held itself to",
          "anchor": "acceptance-bar-this-item-held-itself-to",
          "githubAnchor": "acceptance-bar-this-item-held-itself-to",
          "stableAnchor": "h-c0d7cb318e03"
        },
        {
          "level": 2,
          "text": "Post-landing audit found one real gap, tracked as its own known-gap header (`tsk-1sl`)",
          "anchor": "post-landing-audit-found-one-real-gap-tracked-as-its-own-known-gap-header-tsk-1sl",
          "githubAnchor": "post-landing-audit-found-one-real-gap-tracked-as-its-own-known-gap-header-tsk-1sl",
          "stableAnchor": "h-14288967fc01"
        },
        {
          "level": 2,
          "text": "Landing hit a same-day flake, resolved via catchup, not a code change",
          "anchor": "landing-hit-a-same-day-flake-resolved-via-catchup-not-a-code-change",
          "githubAnchor": "landing-hit-a-same-day-flake-resolved-via-catchup-not-a-code-change",
          "stableAnchor": "h-b44a823d4f62"
        },
        {
          "level": 2,
          "text": "The prose docs still described the old durable-doing model (`tsk-4kn`)",
          "anchor": "the-prose-docs-still-described-the-old-durable-doing-model-tsk-4kn",
          "githubAnchor": "the-prose-docs-still-described-the-old-durable-doing-model-tsk-4kn",
          "stableAnchor": "h-4297ce0b4985"
        },
