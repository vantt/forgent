          "githubAnchor": "the-boundary-drawn",
          "stableAnchor": "h-1b8b84eada18"
        },
        {
          "level": 2,
          "text": "Six locked design decisions",
          "anchor": "six-locked-design-decisions",
          "githubAnchor": "six-locked-design-decisions",
          "stableAnchor": "h-821cd96242a7"
        },
        {
          "level": 2,
          "text": "What consumers had to change",
