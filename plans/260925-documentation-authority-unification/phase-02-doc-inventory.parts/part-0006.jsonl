      "headings": [
        {
          "level": 1,
          "text": "`doing` was never supposed to be durable history — it was live coordination masquerading as an event",
          "anchor": "doing-was-never-supposed-to-be-durable-history-it-was-live-coordination-masquerading-as-an-event",
          "githubAnchor": "doing-was-never-supposed-to-be-durable-history-it-was-live-coordination-masquerading-as-an-event",
