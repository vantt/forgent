      "sourceDigest": "f91baac1a8063f72d26ad09dc95d224aa3ee1378569995b04a789594a258fae4",
      "blobSha": "05f6f1fc0c2158b7a391ea41b28c844fa93873cd",
      "blobSize": 8998,
      "area": "End-user authoring, index, and knowledge registry",
      "authorityStatus": "non-authority",
