          "stableAnchor": "h-a5622327e840"
        },
        {
          "level": 3,
          "text": "`4cdddae7` — herdr-spawn never passed the resolved executor env into the pane (P1)",
          "anchor": "4cdddae7-herdr-spawn-never-passed-the-resolved-executor-env-into-the-pane-p1",
          "githubAnchor": "4cdddae7-herdr-spawn-never-passed-the-resolved-executor-env-into-the-pane-p1",
          "stableAnchor": "h-c96c2ab91b52"
        },
        {
          "level": 3,
          "text": "`70832531` — herdr-spawn was broken against the real binary in 3 ways (P1, P1, P2)",
          "anchor": "70832531-herdr-spawn-was-broken-against-the-real-binary-in-3-ways-p1-p1-p2",
          "githubAnchor": "70832531-herdr-spawn-was-broken-against-the-real-binary-in-3-ways-p1-p1-p2",
          "stableAnchor": "h-84f10655ea29"
        },
        {
          "level": 3,
          "text": "`56d9dcc5` — DispatchPlan.configured was overloaded with a second meaning (P2)",
          "anchor": "56d9dcc5-dispatchplanconfigured-was-overloaded-with-a-second-meaning-p2",
          "githubAnchor": "56d9dcc5-dispatchplanconfigured-was-overloaded-with-a-second-meaning-p2",
          "stableAnchor": "h-ec35f8f6219e"
        },
        {
          "level": 3,
          "text": "`36a7a076` — herdr-spawn could resolve before the worker truly exits, and misreported observer failures (P1 x2, P2)",
          "anchor": "36a7a076-herdr-spawn-could-resolve-before-the-worker-truly-exits-and-misreported-observer-failures-p1-x2-p2",
