        {
          "level": 1,
          "text": "`fanout-batch` must run backgrounded — and a caller can outlive it",
          "anchor": "fanout-batch-must-run-backgrounded-and-a-caller-can-outlive-it",
          "githubAnchor": "fanout-batch-must-run-backgrounded-and-a-caller-can-outlive-it",
