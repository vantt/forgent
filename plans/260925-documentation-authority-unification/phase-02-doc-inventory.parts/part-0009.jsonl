      "headings": [
        {
          "level": 1,
          "text": "`merge-loop` ran exactly one item then silently stopped continuing — the recurring prompt named the wrong skill",
          "anchor": "merge-loop-ran-exactly-one-item-then-silently-stopped-continuing-the-recurring-prompt-named-the-wrong-skill",
