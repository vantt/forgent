          "githubAnchor": "primary-scrutiny-target-2-medium-runmissionassignments-new-mission-membership-check-protects-only-the-string-id-call-path-the-object-form-path-equally-documented-param-stringobject-assignmentorid-has-zero-mission-ownership-verification",
          "stableAnchor": "h-f843796b995c"
        },
        {
          "level": 3,
          "text": "New finding (not in the dispatch's named scrutiny targets, found via caller sweep) / MEDIUM — this cell's migration to the mission-agnostic inline shape silently reintroduces the exact `cli.mjs` gap P02.4 already fixed as a closed MEDIUM finding",
          "anchor": "new-finding-not-in-the-dispatchs-named-scrutiny-targets-found-via-caller-sweep-medium-this-cells-migration-to-the-mission-agnostic-inline-shape-silently-reintroduces-the-exact-climjs-gap-p024-already-fixed-as-a-closed-medium-finding",
          "githubAnchor": "new-finding-not-in-the-dispatchs-named-scrutiny-targets-found-via-caller-sweep-medium-this-cells-migration-to-the-mission-agnostic-inline-shape-silently-reintroduces-the-exact-climjs-gap-p024-already-fixed-as-a-closed-medium-finding",
          "stableAnchor": "h-064827493527"
        },
        {
          "level": 3,
          "text": "Other checks performed, no findings (LOW/informational only)",
          "anchor": "other-checks-performed-no-findings-lowinformational-only",
          "githubAnchor": "other-checks-performed-no-findings-lowinformational-only",
