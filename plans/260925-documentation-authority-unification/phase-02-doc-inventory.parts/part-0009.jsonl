          "githubAnchor": "5-citations-mostly-accurate-two-real-mismatches",
          "stableAnchor": "h-8d3a7f9c2004"
        },
        {
          "level": 3,
          "text": "6. The disclosed \"no backward edge\" finding — VERIFIED TRUE",
          "anchor": "6-the-disclosed-no-backward-edge-finding-verified-true",
          "githubAnchor": "6-the-disclosed-no-backward-edge-finding-verified-true",
          "stableAnchor": "h-22f45b13beaa"
        },
        {
          "level": 3,
          "text": "7. Known Gaps — accurate",
          "anchor": "7-known-gaps-accurate",
