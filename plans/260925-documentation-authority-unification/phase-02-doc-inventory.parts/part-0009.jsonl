          "stableAnchor": "h-7ca2c0899a8e"
        },
        {
          "level": 2,
          "text": "Root cause: `ScheduleWakeup`'s `prompt` only reloads what it names",
          "anchor": "root-cause-schedulewakeups-prompt-only-reloads-what-it-names",
          "githubAnchor": "root-cause-schedulewakeups-prompt-only-reloads-what-it-names",
          "stableAnchor": "h-9fb0e22cf945"
