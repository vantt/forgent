        },
        {
          "level": 2,
          "text": "Bug 1: Step 3 instructed a plain foreground call",
          "anchor": "bug-1-step-3-instructed-a-plain-foreground-call",
          "githubAnchor": "bug-1-step-3-instructed-a-plain-foreground-call",
          "stableAnchor": "h-bee90da3270b"
        },
        {
          "level": 2,
          "text": "Bug 2: no guidance on how to wait for a backgrounded run",
