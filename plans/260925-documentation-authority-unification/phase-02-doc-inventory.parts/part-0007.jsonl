          "anchor": "design-notes",
          "githubAnchor": "design-notes",
          "stableAnchor": "h-32a65e9d844d"
        },
        {
          "level": 3,
          "text": "`completion.aggregation` is a sibling of `mode`, not a mode value",
          "anchor": "completionaggregation-is-a-sibling-of-mode-not-a-mode-value",
          "githubAnchor": "completionaggregation-is-a-sibling-of-mode-not-a-mode-value",
          "stableAnchor": "h-438b1c1eefb5"
        },
        {
          "level": 3,
          "text": "The evaluator is fed derived evidence, never caller claims",
          "anchor": "the-evaluator-is-fed-derived-evidence-never-caller-claims",
          "githubAnchor": "the-evaluator-is-fed-derived-evidence-never-caller-claims",
          "stableAnchor": "h-529b799b78a5"
        },
        {
          "level": 3,
          "text": "The immutability pin is the settle-report sha256, and staleness is real",
          "anchor": "the-immutability-pin-is-the-settle-report-sha256-and-staleness-is-real",
          "githubAnchor": "the-immutability-pin-is-the-settle-report-sha256-and-staleness-is-real",
          "stableAnchor": "h-5c8f1b6211cc"
        },
        {
          "level": 3,
          "text": "All-of over bindings, at two levels",
          "anchor": "all-of-over-bindings-at-two-levels",
          "githubAnchor": "all-of-over-bindings-at-two-levels",
          "stableAnchor": "h-6dcf5c610425"
        },
        {
          "level": 3,
          "text": "Terminal input is refuse-only",
          "anchor": "terminal-input-is-refuse-only",
          "githubAnchor": "terminal-input-is-refuse-only",
          "stableAnchor": "h-535dd2f3c8f8"
        },
        {
          "level": 3,
          "text": "No vote/score/convergence",
          "anchor": "no-votescoreconvergence",
          "githubAnchor": "no-votescoreconvergence",
          "stableAnchor": "h-3b00810ce95b"
        },
        {
          "level": 2,
          "text": "The forged-aggregate boundary, precisely",
          "anchor": "the-forged-aggregate-boundary-precisely",
          "githubAnchor": "the-forged-aggregate-boundary-precisely",
          "stableAnchor": "h-abcaaa291e17"
        },
        {
          "level": 2,
          "text": "git diff --stat",
          "anchor": "git-diff---stat",
