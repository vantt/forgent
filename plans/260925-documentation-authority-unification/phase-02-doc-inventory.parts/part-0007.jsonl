          "level": 2,
          "text": "Case A — the shape works",
          "anchor": "case-a-the-shape-works",
          "githubAnchor": "case-a-the-shape-works",
          "stableAnchor": "h-79408b28db2a"
        },
        {
          "level": 2,
          "text": "Case B — death is detected, and the pane is kept",
          "anchor": "case-b-death-is-detected-and-the-pane-is-kept",
          "githubAnchor": "case-b-death-is-detected-and-the-pane-is-kept",
          "stableAnchor": "h-fabed45b411e"
        },
        {
          "level": 2,
          "text": "Case C — closing a pane is not cancelling a worker",
          "anchor": "case-c-closing-a-pane-is-not-cancelling-a-worker",
          "githubAnchor": "case-c-closing-a-pane-is-not-cancelling-a-worker",
          "stableAnchor": "h-fcd17f623dff"
        },
        {
          "level": 2,
          "text": "Case D — observing needs no permission",
          "anchor": "case-d-observing-needs-no-permission",
          "githubAnchor": "case-d-observing-needs-no-permission",
          "stableAnchor": "h-a2ab1c5c29a1"
        },
        {
          "level": 2,
          "text": "P1 — does agy honour the contract?",
          "anchor": "p1-does-agy-honour-the-contract",
          "githubAnchor": "p1-does-agy-honour-the-contract",
          "stableAnchor": "h-3f596b7d76c4"
        },
        {
          "level": 2,
          "text": "The escape lane — measured closed",
          "anchor": "the-escape-lane-measured-closed",
          "githubAnchor": "the-escape-lane-measured-closed",
          "stableAnchor": "h-5ac32ea37709"
        },
        {
          "level": 2,
          "text": "Two findings the probes produced by failing first",
          "anchor": "two-findings-the-probes-produced-by-failing-first",
          "githubAnchor": "two-findings-the-probes-produced-by-failing-first",
          "stableAnchor": "h-e56f076be762"
        },
        {
          "level": 2,
          "text": "Still open, stated rather than closed quietly",
          "anchor": "still-open-stated-rather-than-closed-quietly",
          "githubAnchor": "still-open-stated-rather-than-closed-quietly",
          "stableAnchor": "h-79df66e7c8d9"
