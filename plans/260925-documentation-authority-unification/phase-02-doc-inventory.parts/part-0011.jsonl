          "githubAnchor": "then-use---force",
          "stableAnchor": "h-1571c04852a7"
        },
        {
          "level": 2,
          "text": "A second real reason to force: the judge is asking for planning's job, not exploring's",
          "anchor": "a-second-real-reason-to-force-the-judge-is-asking-for-plannings-job-not-explorings",
          "githubAnchor": "a-second-real-reason-to-force-the-judge-is-asking-for-plannings-job-not-explorings",
          "stableAnchor": "h-3f5ead6a5abf"
