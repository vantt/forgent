        {
          "level": 1,
          "text": "Cell P01.1 — CoordinationSession store, schema, events, direct cutover (Phase 01 R1-R4)",
          "anchor": "cell-p011-coordinationsession-store-schema-events-direct-cutover-phase-01-r1-r4",
          "githubAnchor": "cell-p011-coordinationsession-store-schema-events-direct-cutover-phase-01-r1-r4",
          "stableAnchor": "h-258d4eb4c120"
        },
        {
          "level": 2,
          "text": "Requirements",
          "anchor": "requirements",
          "githubAnchor": "requirements",
          "stableAnchor": "h-f5d328743132"
        },
        {
          "level": 2,
          "text": "Proof Matrix",
          "anchor": "proof-matrix",
          "githubAnchor": "proof-matrix",
