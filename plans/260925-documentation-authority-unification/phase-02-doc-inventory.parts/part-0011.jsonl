      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "How fgOS isolates concurrent sessions, and why the event log's write door blocks instead of backing off",
          "anchor": "how-fgos-isolates-concurrent-sessions-and-why-the-event-logs-write-door-blocks-instead-of-backing-off",
          "githubAnchor": "how-fgos-isolates-concurrent-sessions-and-why-the-event-logs-write-door-blocks-instead-of-backing-off",
          "stableAnchor": "h-577f865a2613"
        },
        {
          "level": 2,
          "text": "`.fgos/events.jsonl` is git-tracked, on purpose",
          "anchor": "fgoseventsjsonl-is-git-tracked-on-purpose",
          "githubAnchor": "fgoseventsjsonl-is-git-tracked-on-purpose",
          "stableAnchor": "h-540de6b1fe5e"
        },
        {
          "level": 2,
          "text": "The event log's single write door has to block, not back off",
          "anchor": "the-event-logs-single-write-door-has-to-block-not-back-off",
          "githubAnchor": "the-event-logs-single-write-door-has-to-block-not-back-off",
          "stableAnchor": "h-e238f139f82d"
        },
        {
          "level": 2,
          "text": "A crash mid-operation needs a real kill test, not just a fixture",
          "anchor": "a-crash-mid-operation-needs-a-real-kill-test-not-just-a-fixture",
          "githubAnchor": "a-crash-mid-operation-needs-a-real-kill-test-not-just-a-fixture",
          "stableAnchor": "h-833aa31232d1"
        },
        {
          "level": 2,
          "text": "A two-syscall lock create (open, then write the identity) has an empty-file window an atomic-looking primitive doesn't close",
          "anchor": "a-two-syscall-lock-create-open-then-write-the-identity-has-an-empty-file-window-an-atomic-looking-primitive-doesnt-close",
          "githubAnchor": "a-two-syscall-lock-create-open-then-write-the-identity-has-an-empty-file-window-an-atomic-looking-primitive-doesnt-close",
          "stableAnchor": "h-dfc5b13dc341"
        },
        {
          "level": 2,
          "text": "The same empty-file TOCTOU window, confirmed in `session.mjs`'s sibling lock too",
          "anchor": "the-same-empty-file-toctou-window-confirmed-in-sessionmjss-sibling-lock-too",
          "githubAnchor": "the-same-empty-file-toctou-window-confirmed-in-sessionmjss-sibling-lock-too",
          "stableAnchor": "h-a83c004a5a26"
        },
        {
          "level": 2,
          "text": "Deleting a worktree's tracked copy closes a stale-read hazard, but opens a new-write one",
          "anchor": "deleting-a-worktrees-tracked-copy-closes-a-stale-read-hazard-but-opens-a-new-write-one",
          "githubAnchor": "deleting-a-worktrees-tracked-copy-closes-a-stale-read-hazard-but-opens-a-new-write-one",
          "stableAnchor": "h-9a9b94475b85"
        },
        {
          "level": 2,
          "text": "A comment claiming lock parity with `addWork` didn't match the code (`tsk-1jp`)",
          "anchor": "a-comment-claiming-lock-parity-with-addwork-didnt-match-the-code-tsk-1jp",
          "githubAnchor": "a-comment-claiming-lock-parity-with-addwork-didnt-match-the-code-tsk-1jp",
          "stableAnchor": "h-7968d4549c47"
        },
        {
          "level": 2,
          "text": "The lock-contention regression test itself became a flake, and blamed unrelated items for it (`tsk-3wn`)",
          "anchor": "the-lock-contention-regression-test-itself-became-a-flake-and-blamed-unrelated-items-for-it-tsk-3wn",
          "githubAnchor": "the-lock-contention-regression-test-itself-became-a-flake-and-blamed-unrelated-items-for-it-tsk-3wn",
          "stableAnchor": "h-35a3ad6e3cbc"
        },
        {
          "level": 2,
          "text": "The same load-flake, a third time — and the fix converged on an existing mechanism (`tsk-597`)",
          "anchor": "the-same-load-flake-a-third-time-and-the-fix-converged-on-an-existing-mechanism-tsk-597",
          "githubAnchor": "the-same-load-flake-a-third-time-and-the-fix-converged-on-an-existing-mechanism-tsk-597",
          "stableAnchor": "h-1b7c8f16133a"
        }
