        },
        {
          "level": 2,
          "text": "The recipe",
          "anchor": "the-recipe",
          "githubAnchor": "the-recipe",
          "stableAnchor": "h-553e1651a7fe"
        },
        {
          "level": 2,
          "text": "Why the stash-and-restore shape, not two separate branches or commits",
          "anchor": "why-the-stash-and-restore-shape-not-two-separate-branches-or-commits",
          "githubAnchor": "why-the-stash-and-restore-shape-not-two-separate-branches-or-commits",
          "stableAnchor": "h-59e07931192f"
        },
        {
          "level": 2,
          "text": "Watch out for: running `classifyIronLaw` before committing gives a false \"not required\" negative",
          "anchor": "watch-out-for-running-classifyironlaw-before-committing-gives-a-false-not-required-negative",
          "githubAnchor": "watch-out-for-running-classifyironlaw-before-committing-gives-a-false-not-required-negative",
          "stableAnchor": "h-645ea59a58ea"
        },
        {
          "level": 2,
          "text": "Watch out for: a guard test scoped by `git ls-files` silently skips its own uncommitted files",
          "anchor": "watch-out-for-a-guard-test-scoped-by-git-ls-files-silently-skips-its-own-uncommitted-files",
          "githubAnchor": "watch-out-for-a-guard-test-scoped-by-git-ls-files-silently-skips-its-own-uncommitted-files",
          "stableAnchor": "h-2b17c921d97c"
        },
        {
          "level": 2,
          "text": "Watch out for: a comment-only, behavior-neutral diff has no red state to honestly produce",
          "anchor": "watch-out-for-a-comment-only-behavior-neutral-diff-has-no-red-state-to-honestly-produce",
          "githubAnchor": "watch-out-for-a-comment-only-behavior-neutral-diff-has-no-red-state-to-honestly-produce",
          "stableAnchor": "h-e6c5032f514d"
        },
        {
          "level": 2,
          "text": "Why this survives review even without re-running it",
          "anchor": "why-this-survives-review-even-without-re-running-it",
          "githubAnchor": "why-this-survives-review-even-without-re-running-it",
          "stableAnchor": "h-6f50872bf48b"
        }
