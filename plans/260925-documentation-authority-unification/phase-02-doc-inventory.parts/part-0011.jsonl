      "headings": [
        {
          "level": 1,
          "text": "Why fgOS bin and skill distribution needed a 3-tier self-healing resolution",
          "anchor": "why-fgos-bin-and-skill-distribution-needed-a-3-tier-self-healing-resolution",
          "githubAnchor": "why-fgos-bin-and-skill-distribution-needed-a-3-tier-self-healing-resolution",
          "stableAnchor": "h-9d20958b17c1"
        },
        {
          "level": 2,
          "text": "Two real, silent failures found together (2026-08-13)",
          "anchor": "two-real-silent-failures-found-together-2026-08-13",
          "githubAnchor": "two-real-silent-failures-found-together-2026-08-13",
          "stableAnchor": "h-c0989e222eb9"
        },
        {
          "level": 2,
          "text": "D1/D2: two independent axes, bin and skill distribution",
          "anchor": "d1d2-two-independent-axes-bin-and-skill-distribution",
          "githubAnchor": "d1d2-two-independent-axes-bin-and-skill-distribution",
          "stableAnchor": "h-230d8436c69b"
        },
        {
          "level": 2,
          "text": "D2/D4 landed (`tsk-2qc-1`): the 3-tier resolution with a global-tier config-cache",
          "anchor": "d2d4-landed-tsk-2qc-1-the-3-tier-resolution-with-a-global-tier-config-cache",
          "githubAnchor": "d2d4-landed-tsk-2qc-1-the-3-tier-resolution-with-a-global-tier-config-cache",
          "stableAnchor": "h-9c0aaf9fb5db"
        },
        {
          "level": 2,
          "text": "D3/D4: cache-then-verify, not probe-every-call",
          "anchor": "d3d4-cache-then-verify-not-probe-every-call",
          "githubAnchor": "d3d4-cache-then-verify-not-probe-every-call",
          "stableAnchor": "h-27d7c76ada9c"
        },
        {
          "level": 2,
          "text": "D5: skill materialization stops depending on the `claude` CLI at all",
          "anchor": "d5-skill-materialization-stops-depending-on-the-claude-cli-at-all",
          "githubAnchor": "d5-skill-materialization-stops-depending-on-the-claude-cli-at-all",
          "stableAnchor": "h-69f416fcc1b1"
        },
        {
          "level": 2,
          "text": "D5/D7 landed (`tsk-1qi`): `.claude/skills` becomes generated, `.agents/skills` becomes canonical",
          "anchor": "d5d7-landed-tsk-1qi-claudeskills-becomes-generated-agentsskills-becomes-canonical",
          "githubAnchor": "d5d7-landed-tsk-1qi-claudeskills-becomes-generated-agentsskills-becomes-canonical",
          "stableAnchor": "h-fed50eff5bbf"
        },
        {
          "level": 2,
          "text": "D6/D7: which skills get typed, and how wrappers are generated",
          "anchor": "d6d7-which-skills-get-typed-and-how-wrappers-are-generated",
          "githubAnchor": "d6d7-which-skills-get-typed-and-how-wrappers-are-generated",
          "stableAnchor": "h-d8eaaacabe26"
        },
        {
          "level": 2,
          "text": "D6 rollout (`tsk-424n`): verified empirically on one skill before the other 13",
          "anchor": "d6-rollout-tsk-424n-verified-empirically-on-one-skill-before-the-other-13",
          "githubAnchor": "d6-rollout-tsk-424n-verified-empirically-on-one-skill-before-the-other-13",
          "stableAnchor": "h-5631de433275"
        }
