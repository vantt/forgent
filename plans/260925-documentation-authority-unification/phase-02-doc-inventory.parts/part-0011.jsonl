      "headings": [
        {
          "level": 1,
          "text": "Why `/fgOS:retro-loop` restores the `compound` verb instead of inventing a new one",
          "anchor": "why-fgosretro-loop-restores-the-compound-verb-instead-of-inventing-a-new-one",
          "githubAnchor": "why-fgosretro-loop-restores-the-compound-verb-instead-of-inventing-a-new-one",
          "stableAnchor": "h-9472465097fe"
        },
        {
          "level": 2,
          "text": "The item started as something else entirely",
          "anchor": "the-item-started-as-something-else-entirely",
          "githubAnchor": "the-item-started-as-something-else-entirely",
          "stableAnchor": "h-5edb97d26592"
        },
        {
          "level": 2,
          "text": "The synthesis step it was supposed to wrap didn't actually work",
          "anchor": "the-synthesis-step-it-was-supposed-to-wrap-didnt-actually-work",
          "githubAnchor": "the-synthesis-step-it-was-supposed-to-wrap-didnt-actually-work",
          "stableAnchor": "h-f34d1d2c85de"
        },
        {
          "level": 2,
          "text": "Restoring the removed code, not inventing a replacement",
          "anchor": "restoring-the-removed-code-not-inventing-a-replacement",
          "githubAnchor": "restoring-the-removed-code-not-inventing-a-replacement",
          "stableAnchor": "h-393dc32b8d6f"
        },
        {
          "level": 2,
          "text": "The shape: mirrors `cleanup-loop`, but with `discover-loop`'s stop rules",
          "anchor": "the-shape-mirrors-cleanup-loop-but-with-discover-loops-stop-rules",
          "githubAnchor": "the-shape-mirrors-cleanup-loop-but-with-discover-loops-stop-rules",
          "stableAnchor": "h-7b48ad686af3"
        },
        {
          "level": 2,
          "text": "Proof it actually works",
          "anchor": "proof-it-actually-works",
          "githubAnchor": "proof-it-actually-works",
          "stableAnchor": "h-00d74f348fd0"
        }
      ],
