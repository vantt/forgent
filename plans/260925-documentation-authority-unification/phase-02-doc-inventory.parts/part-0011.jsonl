          "level": 1,
          "text": "Why merge-standardization (`tsk-4j9`) reuses existing mechanisms instead of building new ones",
          "anchor": "why-merge-standardization-tsk-4j9-reuses-existing-mechanisms-instead-of-building-new-ones",
          "githubAnchor": "why-merge-standardization-tsk-4j9-reuses-existing-mechanisms-instead-of-building-new-ones",
          "stableAnchor": "h-d06038a58e35"
        },
        {
          "level": 2,
          "text": "State model: no new \"ready to merge\" state",
          "anchor": "state-model-no-new-ready-to-merge-state",
          "githubAnchor": "state-model-no-new-ready-to-merge-state",
          "stableAnchor": "h-cff58b541c83"
        },
        {
          "level": 2,
          "text": "Ordering: the existing impact ranker, not a new score",
          "anchor": "ordering-the-existing-impact-ranker-not-a-new-score",
          "githubAnchor": "ordering-the-existing-impact-ranker-not-a-new-score",
          "stableAnchor": "h-388ba8ad820a"
        },
        {
          "level": 2,
          "text": "Conflict detection: extract, don't reimplement",
          "anchor": "conflict-detection-extract-dont-reimplement",
          "githubAnchor": "conflict-detection-extract-dont-reimplement",
          "stableAnchor": "h-2ad4ac6c9049"
        },
        {
          "level": 2,
          "text": "`merge next` drives the existing merge gate, never a parallel one",
          "anchor": "merge-next-drives-the-existing-merge-gate-never-a-parallel-one",
          "githubAnchor": "merge-next-drives-the-existing-merge-gate-never-a-parallel-one",
          "stableAnchor": "h-51b93db6da6e"
        },
        {
          "level": 2,
          "text": "Where reuse meets a safety gate it must not weaken",
          "anchor": "where-reuse-meets-a-safety-gate-it-must-not-weaken",
          "githubAnchor": "where-reuse-meets-a-safety-gate-it-must-not-weaken",
          "stableAnchor": "h-3cd922e80677"
        },
        {
          "level": 2,
          "text": "The general shape",
          "anchor": "the-general-shape",
          "githubAnchor": "the-general-shape",
          "stableAnchor": "h-b01e62a44e89"
        }
      ],
