          "level": 1,
          "text": "Why `decompose`'s skip-and-advance is narrower than `discovery`'s",
          "anchor": "why-decomposes-skip-and-advance-is-narrower-than-discoverys",
          "githubAnchor": "why-decomposes-skip-and-advance-is-narrower-than-discoverys",
          "stableAnchor": "h-e1a97c16bcc6"
        },
        {
          "level": 2,
          "text": "Why a literal port would be unsafe",
          "anchor": "why-a-literal-port-would-be-unsafe",
          "githubAnchor": "why-a-literal-port-would-be-unsafe",
          "stableAnchor": "h-b3fc76f9e878"
        },
        {
          "level": 2,
          "text": "The one condition narrow enough to be provably safe",
          "anchor": "the-one-condition-narrow-enough-to-be-provably-safe",
          "githubAnchor": "the-one-condition-narrow-enough-to-be-provably-safe",
          "stableAnchor": "h-27ad47555177"
        },
        {
          "level": 2,
          "text": "Real verify, read from the approve record — closing a second gap",
          "anchor": "real-verify-read-from-the-approve-record-closing-a-second-gap",
          "githubAnchor": "real-verify-read-from-the-approve-record-closing-a-second-gap",
          "stableAnchor": "h-260a1eb9e7d3"
        },
        {
          "level": 2,
          "text": "Re-entrancy: the same fix applies to an interrupted retry",
          "anchor": "re-entrancy-the-same-fix-applies-to-an-interrupted-retry",
          "githubAnchor": "re-entrancy-the-same-fix-applies-to-an-interrupted-retry",
          "stableAnchor": "h-8bd1b708345c"
        },
        {
          "level": 2,
          "text": "Follow-up (`tsk-3ev`): the code is correct, but nothing warned a hand-driving session about it",
          "anchor": "follow-up-tsk-3ev-the-code-is-correct-but-nothing-warned-a-hand-driving-session-about-it",
          "githubAnchor": "follow-up-tsk-3ev-the-code-is-correct-but-nothing-warned-a-hand-driving-session-about-it",
