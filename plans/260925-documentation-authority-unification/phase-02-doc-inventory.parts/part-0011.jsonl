      "headings": [
        {
          "level": 1,
          "text": "Why a clean `npm test` run missed 16 edge gaps after the lifecycle rebuild",
          "anchor": "why-a-clean-npm-test-run-missed-16-edge-gaps-after-the-lifecycle-rebuild",
