        },
        {
          "level": 3,
          "text": "Confirmed correct (verified, not assumed)",
          "anchor": "confirmed-correct-verified-not-assumed",
          "githubAnchor": "confirmed-correct-verified-not-assumed",
          "stableAnchor": "h-8413906caf02"
        },
        {
          "level": 3,
          "text": "Coordinator Disposition",
          "anchor": "coordinator-disposition",
