      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "P05.1 red-team report — independent adversarial pass on the hard conformance and recovery proof",
          "anchor": "p051-red-team-report-independent-adversarial-pass-on-the-hard-conformance-and-recovery-proof",
          "githubAnchor": "p051-red-team-report-independent-adversarial-pass-on-the-hard-conformance-and-recovery-proof",
          "stableAnchor": "h-eadb56fe14f4"
        },
        {
          "level": 2,
          "text": "Environment",
          "anchor": "environment",
          "githubAnchor": "environment",
          "stableAnchor": "h-e372a26d6413"
        },
        {
          "level": 2,
          "text": "Scorecard",
          "anchor": "scorecard",
          "githubAnchor": "scorecard",
          "stableAnchor": "h-63294b9dd346"
        },
        {
          "level": 2,
          "text": "What genuinely holds",
          "anchor": "what-genuinely-holds",
          "githubAnchor": "what-genuinely-holds",
          "stableAnchor": "h-ec3193c1705f"
        },
        {
          "level": 2,
          "text": "Findings",
          "anchor": "findings",
          "githubAnchor": "findings",
          "stableAnchor": "h-6b9142a59694"
        },
        {
          "level": 3,
          "text": "F1 (high) — RunResult provenance is read from an unauthenticated file, not from the dispatch that happened",
          "anchor": "f1-high-runresult-provenance-is-read-from-an-unauthenticated-file-not-from-the-dispatch-that-happened",
          "githubAnchor": "f1-high-runresult-provenance-is-read-from-an-unauthenticated-file-not-from-the-dispatch-that-happened",
          "stableAnchor": "h-4ff4f273dafc"
        },
        {
          "level": 3,
          "text": "F2 (high) — the documented crash workaround can permanently poison an assignment (RT-14 + RT-15)",
          "anchor": "f2-high-the-documented-crash-workaround-can-permanently-poison-an-assignment-rt-14-rt-15",
          "githubAnchor": "f2-high-the-documented-crash-workaround-can-permanently-poison-an-assignment-rt-14-rt-15",
          "stableAnchor": "h-54fd2c93b6dc"
        },
        {
          "level": 3,
          "text": "F3 (high) — a crash during the event-log append leaves the session completely unreadable (RT-16)",
          "anchor": "f3-high-a-crash-during-the-event-log-append-leaves-the-session-completely-unreadable-rt-16",
          "githubAnchor": "f3-high-a-crash-during-the-event-log-append-leaves-the-session-completely-unreadable-rt-16",
          "stableAnchor": "h-159b8e369eb5"
        },
        {
          "level": 3,
          "text": "F4 (high) — a fabricated `result.json` bypasses the stale claim entirely (RT-17)",
          "anchor": "f4-high-a-fabricated-resultjson-bypasses-the-stale-claim-entirely-rt-17",
          "githubAnchor": "f4-high-a-fabricated-resultjson-bypasses-the-stale-claim-entirely-rt-17",
          "stableAnchor": "h-eb5cc953b87c"
        },
        {
          "level": 3,
          "text": "F5 (high) — the bounded dialogue reopen has no enforced link to a human turn (RT-18)",
          "anchor": "f5-high-the-bounded-dialogue-reopen-has-no-enforced-link-to-a-human-turn-rt-18",
          "githubAnchor": "f5-high-the-bounded-dialogue-reopen-has-no-enforced-link-to-a-human-turn-rt-18",
          "stableAnchor": "h-ee8efb4b7c14"
        },
        {
          "level": 3,
          "text": "F6 (high) — `aggregateBounds` on a resumed request is silently discarded, both directions (RT-10)",
          "anchor": "f6-high-aggregatebounds-on-a-resumed-request-is-silently-discarded-both-directions-rt-10",
          "githubAnchor": "f6-high-aggregatebounds-on-a-resumed-request-is-silently-discarded-both-directions-rt-10",
          "stableAnchor": "h-84359b472655"
        },
        {
          "level": 3,
          "text": "F7 (medium) — the event log is not tamper-evident (RT-05, RT-06)",
          "anchor": "f7-medium-the-event-log-is-not-tamper-evident-rt-05-rt-06",
          "githubAnchor": "f7-medium-the-event-log-is-not-tamper-evident-rt-05-rt-06",
          "stableAnchor": "h-d85d110addf6"
        },
        {
          "level": 3,
          "text": "F8 (medium) — controlled reveal is prompt-scoped, not process-scoped (RT-08)",
          "anchor": "f8-medium-controlled-reveal-is-prompt-scoped-not-process-scoped-rt-08",
          "githubAnchor": "f8-medium-controlled-reveal-is-prompt-scoped-not-process-scoped-rt-08",
          "stableAnchor": "h-3470b5bc5f53"
        },
        {
          "level": 3,
          "text": "F9 (low, informational) — `maxRounds` and `maxAssignments` are the same counter",
          "anchor": "f9-low-informational-maxrounds-and-maxassignments-are-the-same-counter",
          "githubAnchor": "f9-low-informational-maxrounds-and-maxassignments-are-the-same-counter",
          "stableAnchor": "h-f6a7a4f7775a"
        },
        {
          "level": 2,
          "text": "Assessment of the Doer's cell",
          "anchor": "assessment-of-the-doers-cell",
          "githubAnchor": "assessment-of-the-doers-cell",
          "stableAnchor": "h-6259d35f5979"
        },
        {
          "level": 2,
          "text": "Recommendations",
          "anchor": "recommendations",
          "githubAnchor": "recommendations",
          "stableAnchor": "h-47e49b33b3de"
        },
        {
          "level": 2,
          "text": "Unresolved questions",
          "anchor": "unresolved-questions",
          "githubAnchor": "unresolved-questions",
          "stableAnchor": "h-28298df04c26"
        }
      ],
