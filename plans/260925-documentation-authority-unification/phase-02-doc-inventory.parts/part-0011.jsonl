        {
          "level": 2,
          "text": "NEW-HIGH-A — Version drift now makes `fgos coordination show` silently report a completed actor as `missing`. This is a regression against pre-fix HEAD, not pre-existing laxness.",
          "anchor": "new-high-a-version-drift-now-makes-fgos-coordination-show-silently-report-a-completed-actor-as-missing-this-is-a-regression-against-pre-fix-head-not-pre-existing-laxness",
          "githubAnchor": "new-high-a-version-drift-now-makes-fgos-coordination-show-silently-report-a-completed-actor-as-missing-this-is-a-regression-against-pre-fix-head-not-pre-existing-laxness",
          "stableAnchor": "h-ffe042f0122f"
        },
        {
          "level": 2,
          "text": "NEW-HIGH-B — MEDIUM-5's new regression test is a phantom: reverting the fix it is named for leaves it green",
          "anchor": "new-high-b-medium-5s-new-regression-test-is-a-phantom-reverting-the-fix-it-is-named-for-leaves-it-green",
          "githubAnchor": "new-high-b-medium-5s-new-regression-test-is-a-phantom-reverting-the-fix-it-is-named-for-leaves-it-green",
          "stableAnchor": "h-b350292961c2"
        },
        {
          "level": 2,
          "text": "NEW-MEDIUM-C — MEDIUM-5's fix designates the aggregation actor by graph array order, with no check that the choice is unambiguous",
          "anchor": "new-medium-c-medium-5s-fix-designates-the-aggregation-actor-by-graph-array-order-with-no-check-that-the-choice-is-unambiguous",
          "githubAnchor": "new-medium-c-medium-5s-fix-designates-the-aggregation-actor-by-graph-array-order-with-no-check-that-the-choice-is-unambiguous",
          "stableAnchor": "h-c2025cf5a3fb"
        },
        {
          "level": 2,
          "text": "NEW-LOW-D — the second half of the predecessor's MEDIUM-5 was dropped by `§6` and is not recorded in Gaps",
          "anchor": "new-low-d-the-second-half-of-the-predecessors-medium-5-was-dropped-by-6-and-is-not-recorded-in-gaps",
          "githubAnchor": "new-low-d-the-second-half-of-the-predecessors-medium-5-was-dropped-by-6-and-is-not-recorded-in-gaps",
          "stableAnchor": "h-d455a169d6db"
