      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Worker slot is the engine-owned occupancy unit across every launcher",
          "anchor": "worker-slot-is-the-engine-owned-occupancy-unit-across-every-launcher",
          "githubAnchor": "worker-slot-is-the-engine-owned-occupancy-unit-across-every-launcher",
          "stableAnchor": "h-1fc6d4b9e363"
        },
        {
          "level": 2,
          "text": "The unit: a worker slot, not \"capacity\"",
          "anchor": "the-unit-a-worker-slot-not-capacity",
          "githubAnchor": "the-unit-a-worker-slot-not-capacity",
          "stableAnchor": "h-b1bf6427efd3"
        },
        {
          "level": 2,
          "text": "Occupancy is engine state, never tool/label state",
          "anchor": "occupancy-is-engine-state-never-toollabel-state",
          "githubAnchor": "occupancy-is-engine-state-never-toollabel-state",
          "stableAnchor": "h-2acc47fa7ed2"
        },
        {
          "level": 2,
          "text": "Rename and the slot concept ship as one feature",
          "anchor": "rename-and-the-slot-concept-ship-as-one-feature",
          "githubAnchor": "rename-and-the-slot-concept-ship-as-one-feature",
          "stableAnchor": "h-328867a7087c"
        },
        {
          "level": 2,
          "text": "Two lanes: execution and a permanently reserved admin seat",
          "anchor": "two-lanes-execution-and-a-permanently-reserved-admin-seat",
          "githubAnchor": "two-lanes-execution-and-a-permanently-reserved-admin-seat",
          "stableAnchor": "h-85ccf04c1546"
        },
        {
          "level": 2,
          "text": "The unifying shape is a ceiling gate, not a global ranker",
          "anchor": "the-unifying-shape-is-a-ceiling-gate-not-a-global-ranker",
          "githubAnchor": "the-unifying-shape-is-a-ceiling-gate-not-a-global-ranker",
          "stableAnchor": "h-76e893251f35"
        },
        {
          "level": 2,
          "text": "Counted per work-item, with a small, non-cumulative overflow allowance",
          "anchor": "counted-per-work-item-with-a-small-non-cumulative-overflow-allowance",
          "githubAnchor": "counted-per-work-item-with-a-small-non-cumulative-overflow-allowance",
          "stableAnchor": "h-9076c4bd2e19"
        },
        {
          "level": 2,
          "text": "The label mechanism: a capability-gated helper skill, not an adapter poll loop",
          "anchor": "the-label-mechanism-a-capability-gated-helper-skill-not-an-adapter-poll-loop",
          "githubAnchor": "the-label-mechanism-a-capability-gated-helper-skill-not-an-adapter-poll-loop",
          "stableAnchor": "h-c4072d4bf897"
        },
        {
          "level": 2,
          "text": "A finished pane is reusable without asking, and the driver's report lands on the item",
          "anchor": "a-finished-pane-is-reusable-without-asking-and-the-drivers-report-lands-on-the-item",
          "githubAnchor": "a-finished-pane-is-reusable-without-asking-and-the-drivers-report-lands-on-the-item",
          "stableAnchor": "h-c885be902728"
        },
        {
          "level": 2,
          "text": "The herdr-plugin adapter: reuse by polling the engine, never a pane label",
          "anchor": "the-herdr-plugin-adapter-reuse-by-polling-the-engine-never-a-pane-label",
          "githubAnchor": "the-herdr-plugin-adapter-reuse-by-polling-the-engine-never-a-pane-label",
          "stableAnchor": "h-64e335a9acb0"
        },
        {
          "level": 2,
          "text": "`fgos-runner` and `fgos-fanout` close out the three-launcher set",
          "anchor": "fgos-runner-and-fgos-fanout-close-out-the-three-launcher-set",
          "githubAnchor": "fgos-runner-and-fgos-fanout-close-out-the-three-launcher-set",
          "stableAnchor": "h-4a863f96978e"
        },
        {
          "level": 2,
          "text": "What actually happened building this",
          "anchor": "what-actually-happened-building-this",
          "githubAnchor": "what-actually-happened-building-this",
          "stableAnchor": "h-a640efca89b2"
        },
        {
          "level": 2,
          "text": "Post-merge gaps a review found after the four-way split landed (`tsk-1oz`)",
          "anchor": "post-merge-gaps-a-review-found-after-the-four-way-split-landed-tsk-1oz",
          "githubAnchor": "post-merge-gaps-a-review-found-after-the-four-way-split-landed-tsk-1oz",
          "stableAnchor": "h-858e2f679d14"
        },
        {
          "level": 2,
          "text": "A second review round: the runner/fanout half of the same ceiling (`tsk-qrs`)",
          "anchor": "a-second-review-round-the-runnerfanout-half-of-the-same-ceiling-tsk-qrs",
          "githubAnchor": "a-second-review-round-the-runnerfanout-half-of-the-same-ceiling-tsk-qrs",
          "stableAnchor": "h-246efd0b5cc4"
        },
        {
          "level": 2,
          "text": "An unarmed ceiling (F0's own fix) silently zeroed fgos-fanout's batch (`tsk-nwz`)",
          "anchor": "an-unarmed-ceiling-f0s-own-fix-silently-zeroed-fgos-fanouts-batch-tsk-nwz",
          "githubAnchor": "an-unarmed-ceiling-f0s-own-fix-silently-zeroed-fgos-fanouts-batch-tsk-nwz",
          "stableAnchor": "h-10d14df5dde4"
        },
        {
          "level": 2,
          "text": "Two more engine gaps: stuck-past-ceiling reclaim, and a phantom report id (`tsk-37t`)",
          "anchor": "two-more-engine-gaps-stuck-past-ceiling-reclaim-and-a-phantom-report-id-tsk-37t",
          "githubAnchor": "two-more-engine-gaps-stuck-past-ceiling-reclaim-and-a-phantom-report-id-tsk-37t",
          "stableAnchor": "h-594c5a85b318"
        },
        {
          "level": 2,
          "text": "Related",
          "anchor": "related",
          "githubAnchor": "related",
          "stableAnchor": "h-2f61183f7dde"
        }
