        {
          "level": 2,
          "text": "Case A — the shape works",
          "anchor": "case-a-the-shape-works",
          "githubAnchor": "case-a-the-shape-works",
          "stableAnchor": "h-79408b28db2a"
        },
        {
          "level": 2,
          "text": "Case B — death is detected, and the pane is kept",
