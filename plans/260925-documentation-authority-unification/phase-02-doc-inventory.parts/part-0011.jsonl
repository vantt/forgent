      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Why `checkMergeStillResolves` can false-positive after a root branch prune",
          "anchor": "why-checkmergestillresolves-can-false-positive-after-a-root-branch-prune",
          "githubAnchor": "why-checkmergestillresolves-can-false-positive-after-a-root-branch-prune",
          "stableAnchor": "h-8c1c01b53127"
        },
        {
          "level": 2,
          "text": "The mechanism",
          "anchor": "the-mechanism",
          "githubAnchor": "the-mechanism",
          "stableAnchor": "h-7a4195642aa1"
        },
        {
          "level": 2,
          "text": "Real-world confirmation (tsk-577)",
          "anchor": "real-world-confirmation-tsk-577",
          "githubAnchor": "real-world-confirmation-tsk-577",
          "stableAnchor": "h-64734d31177e"
        },
        {
          "level": 2,
          "text": "The fix stays ancestry-based, not content-based",
          "anchor": "the-fix-stays-ancestry-based-not-content-based",
          "githubAnchor": "the-fix-stays-ancestry-based-not-content-based",
          "stableAnchor": "h-8bf54d400a02"
        },
        {
          "level": 2,
          "text": "A third case (`tsk-3ft`): a genuine TRUE positive — the branch itself was reset, not pruned",
          "anchor": "a-third-case-tsk-3ft-a-genuine-true-positive-the-branch-itself-was-reset-not-pruned",
          "githubAnchor": "a-third-case-tsk-3ft-a-genuine-true-positive-the-branch-itself-was-reset-not-pruned",
          "stableAnchor": "h-35edf49f96cb"
        },
        {
          "level": 2,
          "text": "A fourth case (`tsk-psb`): the check picks the wrong sha entirely, for any decomposed parent, deterministically",
          "anchor": "a-fourth-case-tsk-psb-the-check-picks-the-wrong-sha-entirely-for-any-decomposed-parent-deterministically",
          "githubAnchor": "a-fourth-case-tsk-psb-the-check-picks-the-wrong-sha-entirely-for-any-decomposed-parent-deterministically",
          "stableAnchor": "h-a3a1c1957d48"
        },
        {
          "level": 2,
          "text": "A fifth case (`tsk-5j0`): a decomposed ROOT's own branch was never checked against `main` at all",
          "anchor": "a-fifth-case-tsk-5j0-a-decomposed-roots-own-branch-was-never-checked-against-main-at-all",
          "githubAnchor": "a-fifth-case-tsk-5j0-a-decomposed-roots-own-branch-was-never-checked-against-main-at-all",
          "stableAnchor": "h-b9cd6dc0c879"
        },
        {
          "level": 2,
          "text": "The rebased-not-pruned case (`tsk-2q8`) — content landed, ancestry sha didn't",
          "anchor": "the-rebased-not-pruned-case-tsk-2q8-content-landed-ancestry-sha-didnt",
          "githubAnchor": "the-rebased-not-pruned-case-tsk-2q8-content-landed-ancestry-sha-didnt",
          "stableAnchor": "h-cf3c6add53e4"
        },
        {
          "level": 2,
          "text": "A found-but-separate gap: old victims of an already-fixed false positive stay stuck",
          "anchor": "a-found-but-separate-gap-old-victims-of-an-already-fixed-false-positive-stay-stuck",
          "githubAnchor": "a-found-but-separate-gap-old-victims-of-an-already-fixed-false-positive-stay-stuck",
          "stableAnchor": "h-3779c71e0ab3"
        },
        {
          "level": 2,
          "text": "The recheck sweep, split off as its own item (`tsk-597z`)",
          "anchor": "the-recheck-sweep-split-off-as-its-own-item-tsk-597z",
          "githubAnchor": "the-recheck-sweep-split-off-as-its-own-item-tsk-597z",
          "stableAnchor": "h-83329496030f"
        },
        {
          "level": 2,
          "text": "A fourth gap: canceled/`wontfix` children were never skipped (`tsk-4bh`)",
          "anchor": "a-fourth-gap-canceledwontfix-children-were-never-skipped-tsk-4bh",
          "githubAnchor": "a-fourth-gap-canceledwontfix-children-were-never-skipped-tsk-4bh",
          "stableAnchor": "h-396247e900f5"
        }
      ],
