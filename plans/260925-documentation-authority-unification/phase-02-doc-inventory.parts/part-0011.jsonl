      "headings": [
        {
          "level": 1,
          "text": "Add a single-item `--id` filter to an existing `list`-style verb",
          "anchor": "add-a-single-item---id-filter-to-an-existing-list-style-verb",
          "githubAnchor": "add-a-single-item---id-filter-to-an-existing-list-style-verb",
          "stableAnchor": "h-342e08f104ca"
        },
        {
          "level": 2,
          "text": "1. Confirm the antipattern is real before designing the fix",
          "anchor": "1-confirm-the-antipattern-is-real-before-designing-the-fix",
          "githubAnchor": "1-confirm-the-antipattern-is-real-before-designing-the-fix",
          "stableAnchor": "h-d5a302ef18b0"
        },
        {
          "level": 2,
          "text": "2. Reuse the nearest existing narrowing-flag precedent, don't add a verb",
          "anchor": "2-reuse-the-nearest-existing-narrowing-flag-precedent-dont-add-a-verb",
          "githubAnchor": "2-reuse-the-nearest-existing-narrowing-flag-precedent-dont-add-a-verb",
          "stableAnchor": "h-924a9a2c5d1e"
        },
        {
          "level": 2,
          "text": "3. Match the id-lookup shape every other id-based verb already uses",
          "anchor": "3-match-the-id-lookup-shape-every-other-id-based-verb-already-uses",
          "githubAnchor": "3-match-the-id-lookup-shape-every-other-id-based-verb-already-uses",
          "stableAnchor": "h-8bdeb5a497a8"
        },
        {
          "level": 2,
          "text": "4. Rewire the actual motivating call site, don't leave the flag unused",
          "anchor": "4-rewire-the-actual-motivating-call-site-dont-leave-the-flag-unused",
          "githubAnchor": "4-rewire-the-actual-motivating-call-site-dont-leave-the-flag-unused",
          "stableAnchor": "h-9d8137d9608c"
        },
        {
          "level": 2,
          "text": "5. Scope out sibling call sites that need the full list for a different reason",
          "anchor": "5-scope-out-sibling-call-sites-that-need-the-full-list-for-a-different-reason",
          "githubAnchor": "5-scope-out-sibling-call-sites-that-need-the-full-list-for-a-different-reason",
          "stableAnchor": "h-5386ba82cfb8"
        },
        {
          "level": 2,
          "text": "Update (`tsk-2u9`): \"scoped to one item\" meant `work`, not every section",
          "anchor": "update-tsk-2u9-scoped-to-one-item-meant-work-not-every-section",
          "githubAnchor": "update-tsk-2u9-scoped-to-one-item-meant-work-not-every-section",
          "stableAnchor": "h-b20d75fae983"
        },
        {
          "level": 2,
          "text": "6. Test both the bypass behavior and the not-found shape",
          "anchor": "6-test-both-the-bypass-behavior-and-the-not-found-shape",
          "githubAnchor": "6-test-both-the-bypass-behavior-and-the-not-found-shape",
          "stableAnchor": "h-4260c80bfa04"
        }
      ],
