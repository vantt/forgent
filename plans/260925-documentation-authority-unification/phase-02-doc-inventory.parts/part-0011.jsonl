          "level": 1,
          "text": "Why herdr cockpit stacked worker launches into one pane",
          "anchor": "why-herdr-cockpit-stacked-worker-launches-into-one-pane",
          "githubAnchor": "why-herdr-cockpit-stacked-worker-launches-into-one-pane",
          "stableAnchor": "h-3e98e1247ed0"
        },
        {
          "level": 2,
          "text": "Defect 1: a reused pane was retired on its previous occupant's stale label",
          "anchor": "defect-1-a-reused-pane-was-retired-on-its-previous-occupants-stale-label",
          "githubAnchor": "defect-1-a-reused-pane-was-retired-on-its-previous-occupants-stale-label",
          "stableAnchor": "h-f6807be605ac"
        },
        {
          "level": 2,
          "text": "Defect 2: auto-discover had no boot-window guard",
          "anchor": "defect-2-auto-discover-had-no-boot-window-guard",
          "githubAnchor": "defect-2-auto-discover-had-no-boot-window-guard",
          "stableAnchor": "h-f6be2f70a541"
        },
        {
          "level": 2,
          "text": "Defect 3: split out as a real product decision, not a mechanical fix",
          "anchor": "defect-3-split-out-as-a-real-product-decision-not-a-mechanical-fix",
          "githubAnchor": "defect-3-split-out-as-a-real-product-decision-not-a-mechanical-fix",
          "stableAnchor": "h-83c4c33562c4"
        },
        {
          "level": 3,
          "text": "Why defect 3 could not reuse defects 1/2's own fix pattern",
          "anchor": "why-defect-3-could-not-reuse-defects-12s-own-fix-pattern",
          "githubAnchor": "why-defect-3-could-not-reuse-defects-12s-own-fix-pattern",
          "stableAnchor": "h-a85d1188dcc7"
        },
        {
          "level": 2,
          "text": "The common root: guards trusting a label's presence over its freshness",
          "anchor": "the-common-root-guards-trusting-a-labels-presence-over-its-freshness",
          "githubAnchor": "the-common-root-guards-trusting-a-labels-presence-over-its-freshness",
          "stableAnchor": "h-b3c6c3642b39"
        }
