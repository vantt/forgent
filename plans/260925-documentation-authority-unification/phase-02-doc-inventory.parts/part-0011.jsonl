          "githubAnchor": "3-what-this-recommendation-costs",
          "stableAnchor": "h-0a59278ff141"
        },
        {
          "level": 2,
          "text": "4. Surviving dissent — attributed, unresolved",
          "anchor": "4-surviving-dissent-attributed-unresolved",
          "githubAnchor": "4-surviving-dissent-attributed-unresolved",
          "stableAnchor": "h-58ed6b334099"
        },
        {
          "level": 3,
          "text": "Attack 1 — \"Stay Thin\" Reversibility Illusion (architecture-critic; HIGH decision impact) — **LIVE**",
          "anchor": "attack-1-stay-thin-reversibility-illusion-architecture-critic-high-decision-impact-live",
          "githubAnchor": "attack-1-stay-thin-reversibility-illusion-architecture-critic-high-decision-impact-live",
          "stableAnchor": "h-9667b4355d63"
        },
        {
          "level": 3,
          "text": "Attack 3 — Punishing the Architecture for Succeeding (architecture-critic; HIGH decision impact, FLIPS Proposal 2) — **LIVE**",
          "anchor": "attack-3-punishing-the-architecture-for-succeeding-architecture-critic-high-decision-impact-flips-proposal-2-live",
          "githubAnchor": "attack-3-punishing-the-architecture-for-succeeding-architecture-critic-high-decision-impact-flips-proposal-2-live",
          "stableAnchor": "h-b9041c0903a7"
        },
        {
          "level": 3,
          "text": "Attack 5 — Sequencing (architecture-critic; MODERATE) — **adopted, and I am telling you I adopted it**",
          "anchor": "attack-5-sequencing-architecture-critic-moderate-adopted-and-i-am-telling-you-i-adopted-it",
          "githubAnchor": "attack-5-sequencing-architecture-critic-moderate-adopted-and-i-am-telling-you-i-adopted-it",
          "stableAnchor": "h-d237600f1f41"
        },
        {
          "level": 3,
          "text": "Attack 4 (LOW) — noted, no bearing",
          "anchor": "attack-4-low-noted-no-bearing",
          "githubAnchor": "attack-4-low-noted-no-bearing",
          "stableAnchor": "h-8bcd29c6c5b6"
        },
        {
          "level": 3,
          "text": "Attack 2 (MODERATE) — folded into the recommendation, not disposed of",
          "anchor": "attack-2-moderate-folded-into-the-recommendation-not-disposed-of",
          "githubAnchor": "attack-2-moderate-folded-into-the-recommendation-not-disposed-of",
          "stableAnchor": "h-860a11960332"
        },
        {
          "level": 2,
          "text": "5. Unchecked falsification criteria",
          "anchor": "5-unchecked-falsification-criteria",
          "githubAnchor": "5-unchecked-falsification-criteria",
          "stableAnchor": "h-f01e2cc10eb6"
