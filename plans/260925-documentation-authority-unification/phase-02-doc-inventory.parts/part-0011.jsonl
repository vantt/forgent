        },
        {
          "level": 2,
          "text": "Commands",
          "anchor": "commands",
          "githubAnchor": "commands",
          "stableAnchor": "h-5591f6bc2e72"
        },
        {
          "level": 2,
          "text": "Doer Judgment Calls",
          "anchor": "doer-judgment-calls",
