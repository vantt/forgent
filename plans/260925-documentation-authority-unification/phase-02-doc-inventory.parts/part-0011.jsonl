      "headings": [
        {
          "level": 1,
          "text": "Why merge's ephemeral worktree checks out a scratch ref, not the real branch name",
          "anchor": "why-merges-ephemeral-worktree-checks-out-a-scratch-ref-not-the-real-branch-name",
          "githubAnchor": "why-merges-ephemeral-worktree-checks-out-a-scratch-ref-not-the-real-branch-name",
          "stableAnchor": "h-a99dfe66774d"
        },
        {
          "level": 2,
          "text": "The repro",
          "anchor": "the-repro",
          "githubAnchor": "the-repro",
          "stableAnchor": "h-e4d7689e51fb"
        },
        {
          "level": 2,
          "text": "Root cause: `git` allows only one checkout per branch, and the merge machinery reused the wrong one",
          "anchor": "root-cause-git-allows-only-one-checkout-per-branch-and-the-merge-machinery-reused-the-wrong-one",
          "githubAnchor": "root-cause-git-allows-only-one-checkout-per-branch-and-the-merge-machinery-reused-the-wrong-one",
          "stableAnchor": "h-416913c9f450"
        },
        {
          "level": 2,
          "text": "Why `git` forced this collision in the first place",
          "anchor": "why-git-forced-this-collision-in-the-first-place",
          "githubAnchor": "why-git-forced-this-collision-in-the-first-place",
          "stableAnchor": "h-e0c6c8fca999"
        },
        {
          "level": 2,
          "text": "The fix: stop needing a literal checkout of the real branch name",
          "anchor": "the-fix-stop-needing-a-literal-checkout-of-the-real-branch-name",
          "githubAnchor": "the-fix-stop-needing-a-literal-checkout-of-the-real-branch-name",
          "stableAnchor": "h-29588c3a9798"
        },
        {
          "level": 2,
          "text": "Why the two obvious alternatives were rejected",
          "anchor": "why-the-two-obvious-alternatives-were-rejected",
          "githubAnchor": "why-the-two-obvious-alternatives-were-rejected",
          "stableAnchor": "h-5c4147c18b09"
        },
        {
          "level": 2,
          "text": "Scope: fixed at the shared primitive, not per call site",
          "anchor": "scope-fixed-at-the-shared-primitive-not-per-call-site",
          "githubAnchor": "scope-fixed-at-the-shared-primitive-not-per-call-site",
          "stableAnchor": "h-7315d28020e2"
        },
        {
          "level": 2,
          "text": "Second-order regression (`tsk-46a`): the fix traded a loud failure for a silent one under concurrency",
          "anchor": "second-order-regression-tsk-46a-the-fix-traded-a-loud-failure-for-a-silent-one-under-concurrency",
          "githubAnchor": "second-order-regression-tsk-46a-the-fix-traded-a-loud-failure-for-a-silent-one-under-concurrency",
          "stableAnchor": "h-4993e286e7cc"
        },
        {
          "level": 2,
          "text": "Third-order effect (`tsk-2cd`): the final `git branch -f` never resyncs a root's own long-lived claim worktree",
          "anchor": "third-order-effect-tsk-2cd-the-final-git-branch--f-never-resyncs-a-roots-own-long-lived-claim-worktree",
          "githubAnchor": "third-order-effect-tsk-2cd-the-final-git-branch--f-never-resyncs-a-roots-own-long-lived-claim-worktree",
          "stableAnchor": "h-1f745c132920"
        }
      ],
