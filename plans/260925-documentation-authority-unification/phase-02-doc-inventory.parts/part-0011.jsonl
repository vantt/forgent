      "headings": [
        {
          "level": 1,
          "text": "Walking a heavy fgOS item through exploring, a 3-child split, and done",
          "anchor": "walking-a-heavy-fgos-item-through-exploring-a-3-child-split-and-done",
          "githubAnchor": "walking-a-heavy-fgos-item-through-exploring-a-3-child-split-and-done",
          "stableAnchor": "h-70759bd55379"
        },
        {
          "level": 2,
          "text": "1. Claim and orient",
          "anchor": "1-claim-and-orient",
          "githubAnchor": "1-claim-and-orient",
          "stableAnchor": "h-4ff3a6c1a7c0"
        },
        {
          "level": 2,
          "text": "2. Explore: lock decisions before shaping anything",
          "anchor": "2-explore-lock-decisions-before-shaping-anything",
          "githubAnchor": "2-explore-lock-decisions-before-shaping-anything",
          "stableAnchor": "h-c8068e3f1594"
        },
        {
          "level": 2,
          "text": "3. Plan: shape the work, then let the engine's own judgment check it",
          "anchor": "3-plan-shape-the-work-then-let-the-engines-own-judgment-check-it",
          "githubAnchor": "3-plan-shape-the-work-then-let-the-engines-own-judgment-check-it",
          "stableAnchor": "h-6eaa4a59936b"
        },
        {
          "level": 2,
          "text": "4. Validate: prove the plan against reality before executing",
          "anchor": "4-validate-prove-the-plan-against-reality-before-executing",
          "githubAnchor": "4-validate-prove-the-plan-against-reality-before-executing",
          "stableAnchor": "h-c116f578f4e1"
        },
        {
          "level": 2,
          "text": "5. Execute each child: `take`, not `pick`",
          "anchor": "5-execute-each-child-take-not-pick",
          "githubAnchor": "5-execute-each-child-take-not-pick",
          "stableAnchor": "h-a342879448ec"
        },
        {
          "level": 2,
          "text": "6. Merge, then synthesize at `retrospective`, before `done`",
          "anchor": "6-merge-then-synthesize-at-retrospective-before-done",
          "githubAnchor": "6-merge-then-synthesize-at-retrospective-before-done",
          "stableAnchor": "h-b7371b37a7ef"
        },
        {
          "level": 2,
          "text": "7. Watch for your own doc changing what your own tests assume",
          "anchor": "7-watch-for-your-own-doc-changing-what-your-own-tests-assume",
          "githubAnchor": "7-watch-for-your-own-doc-changing-what-your-own-tests-assume",
          "stableAnchor": "h-476724f7a0b4"
        },
        {
          "level": 2,
          "text": "8. The parent closes itself once every child is resolved",
          "anchor": "8-the-parent-closes-itself-once-every-child-is-resolved",
          "githubAnchor": "8-the-parent-closes-itself-once-every-child-is-resolved",
          "stableAnchor": "h-1e015f91aafe"
        },
        {
          "level": 2,
          "text": "Related",
          "anchor": "related",
          "githubAnchor": "related",
          "stableAnchor": "h-8efc82ef40ed"
        }
      ],
