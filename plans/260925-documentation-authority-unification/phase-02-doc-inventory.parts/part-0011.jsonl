          "level": 1,
          "text": "P07.3 + P08.1 — Independent Red-Team",
          "anchor": "p073-p081-independent-red-team",
          "githubAnchor": "p073-p081-independent-red-team",
          "stableAnchor": "h-20b74507bec3"
        },
        {
          "level": 2,
          "text": "Attack 1 — Terminal-transition authority bypass",
          "anchor": "attack-1-terminal-transition-authority-bypass",
          "githubAnchor": "attack-1-terminal-transition-authority-bypass",
          "stableAnchor": "h-bfcd4cc557fa"
        },
        {
          "level": 2,
          "text": "Attack 2 — Re-attempt the partial-cohort bypass",
          "anchor": "attack-2-re-attempt-the-partial-cohort-bypass",
          "githubAnchor": "attack-2-re-attempt-the-partial-cohort-bypass",
          "stableAnchor": "h-02f401914b10"
        },
        {
          "level": 2,
          "text": "Attack 3 — The disclosed raw-store-door forgery gap",
          "anchor": "attack-3-the-disclosed-raw-store-door-forgery-gap",
          "githubAnchor": "attack-3-the-disclosed-raw-store-door-forgery-gap",
          "stableAnchor": "h-0657eb4856b6"
        },
        {
          "level": 3,
          "text": "Finding 1 (HIGH) — `validateSessionAggregation` trusts a caller-supplied FlowDefinition",
          "anchor": "finding-1-high-validatesessionaggregation-trusts-a-caller-supplied-flowdefinition",
          "githubAnchor": "finding-1-high-validatesessionaggregation-trusts-a-caller-supplied-flowdefinition",
          "stableAnchor": "h-e157a5740fa4"
        },
        {
          "level": 3,
          "text": "Finding 1b (LOW-MEDIUM) — a single-source aggregation throws instead of recording `no-consensus`",
          "anchor": "finding-1b-low-medium-a-single-source-aggregation-throws-instead-of-recording-no-consensus",
          "githubAnchor": "finding-1b-low-medium-a-single-source-aggregation-throws-instead-of-recording-no-consensus",
          "stableAnchor": "h-4d68b676d216"
        },
        {
          "level": 3,
          "text": "Finding 1c (LOW-MEDIUM) — schema accepts `requiredDisclosures: []`; the evaluator throws on it",
          "anchor": "finding-1c-low-medium-schema-accepts-requireddisclosures-the-evaluator-throws-on-it",
          "githubAnchor": "finding-1c-low-medium-schema-accepts-requireddisclosures-the-evaluator-throws-on-it",
          "stableAnchor": "h-60a6e9856913"
        },
        {
          "level": 3,
          "text": "Verified in the Doer's favor",
          "anchor": "verified-in-the-doers-favor",
          "githubAnchor": "verified-in-the-doers-favor",
          "stableAnchor": "h-1af6431e26b7"
        },
        {
          "level": 2,
          "text": "Attack 4 — P08.1's contribution model",
          "anchor": "attack-4-p081s-contribution-model",
          "githubAnchor": "attack-4-p081s-contribution-model",
          "stableAnchor": "h-be3f3d5886f5"
        },
        {
          "level": 3,
          "text": "Finding 2 (MEDIUM) — the \"real provenance\" requirement is presence-only, with no channel to make it real",
          "anchor": "finding-2-medium-the-real-provenance-requirement-is-presence-only-with-no-channel-to-make-it-real",
          "githubAnchor": "finding-2-medium-the-real-provenance-requirement-is-presence-only-with-no-channel-to-make-it-real",
          "stableAnchor": "h-e63ba7242d71"
        },
        {
          "level": 3,
          "text": "Finding 3 (MEDIUM) — \"right type, wrong operation\": `operationRef` is unbound to provenance",
          "anchor": "finding-3-medium-right-type-wrong-operation-operationref-is-unbound-to-provenance",
          "githubAnchor": "finding-3-medium-right-type-wrong-operation-operationref-is-unbound-to-provenance",
          "stableAnchor": "h-77db7c0b28de"
        },
        {
