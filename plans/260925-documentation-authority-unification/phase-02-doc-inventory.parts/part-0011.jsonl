      "headings": [
        {
          "level": 1,
          "text": "Audit: loại-hình công việc + hệ đặt tên/đánh mã",
          "anchor": "audit-loại-hình-công-việc-hệ-đặt-tênđánh-mã",
          "githubAnchor": "audit-loại-hình-công-việc-hệ-đặt-tênđánh-mã",
          "stableAnchor": "h-3d1b27b8fe75"
        },
        {
          "level": 2,
          "text": "Bối cảnh (STR47)",
          "anchor": "bối-cảnh-str47",
          "githubAnchor": "bối-cảnh-str47",
          "stableAnchor": "h-d36d46e689d0"
        },
        {
          "level": 2,
          "text": "1 · Bảng inventory (13 hệ — 6 của fgOS, 7 của bee)",
          "anchor": "1-bảng-inventory-13-hệ-6-của-fgos-7-của-bee",
          "githubAnchor": "1-bảng-inventory-13-hệ-6-của-fgos-7-của-bee",
          "stableAnchor": "h-ae3bcdc2eaa9"
        },
        {
          "level": 3,
          "text": "fgOS (sản phẩm — vĩnh viễn, đã migrate)",
          "anchor": "fgos-sản-phẩm-vĩnh-viễn-đã-migrate",
          "githubAnchor": "fgos-sản-phẩm-vĩnh-viễn-đã-migrate",
          "stableAnchor": "h-689b9cc57863"
        },
        {
          "level": 3,
          "text": "bee (xưởng — giàn giáo tạm, giữ nguyên)",
          "anchor": "bee-xưởng-giàn-giáo-tạm-giữ-nguyên",
          "githubAnchor": "bee-xưởng-giàn-giáo-tạm-giữ-nguyên",
          "stableAnchor": "h-3167b4de8d13"
        },
        {
          "level": 2,
          "text": "1b · Chú giải tiền tố (prefix → chữ đầy đủ)",
          "anchor": "1b-chú-giải-tiền-tố-prefix-chữ-đầy-đủ",
          "githubAnchor": "1b-chú-giải-tiền-tố-prefix-chữ-đầy-đủ",
          "stableAnchor": "h-79c49b6ea314"
        },
        {
          "level": 2,
          "text": "2 · Vì sao mỗi lựa chọn — 3 bằng chứng quyết định (không phải cảm tính)",
          "anchor": "2-vì-sao-mỗi-lựa-chọn-3-bằng-chứng-quyết-định-không-phải-cảm-tính",
          "githubAnchor": "2-vì-sao-mỗi-lựa-chọn-3-bằng-chứng-quyết-định-không-phải-cảm-tính",
          "stableAnchor": "h-16ee5063874d"
        },
        {
          "level": 2,
          "text": "3 · Nguyên tắc dùng khi cân nhắc đổi định dạng",
          "anchor": "3-nguyên-tắc-dùng-khi-cân-nhắc-đổi-định-dạng",
          "githubAnchor": "3-nguyên-tắc-dùng-khi-cân-nhắc-đổi-định-dạng",
          "stableAnchor": "h-7932968155a2"
        },
        {
          "level": 2,
          "text": "4 · Trạng thái quyết định theo từng hệ (chốt — xem `docs/decisions/0017-dong-audit-he-id-ten-goi.md`)",
          "anchor": "4-trạng-thái-quyết-định-theo-từng-hệ-chốt-xem-docsdecisions0017-dong-audit-he-id-ten-goimd",
          "githubAnchor": "4-trạng-thái-quyết-định-theo-từng-hệ-chốt-xem-docsdecisions0017-dong-audit-he-id-ten-goimd",
          "stableAnchor": "h-a8f151bd4ea2"
        },
        {
          "level": 2,
          "text": "5 · #7 D-hex và #8 D-local — của lĩnh vực gì, ai dùng, và luật citation chốt",
