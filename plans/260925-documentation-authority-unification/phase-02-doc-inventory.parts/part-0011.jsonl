      "headings": [
        {
          "level": 1,
          "text": "Why planning and validating collapsed into one co-adjustment gate",
          "anchor": "why-planning-and-validating-collapsed-into-one-co-adjustment-gate",
          "githubAnchor": "why-planning-and-validating-collapsed-into-one-co-adjustment-gate",
          "stableAnchor": "h-bbe7a36a436b"
        },
        {
          "level": 2,
          "text": "The problem, observed live",
          "anchor": "the-problem-observed-live",
          "githubAnchor": "the-problem-observed-live",
          "stableAnchor": "h-ba4c36b1fa25"
        },
        {
          "level": 2,
          "text": "D1: exactly one gate, moved to validating, right before materialize",
          "anchor": "d1-exactly-one-gate-moved-to-validating-right-before-materialize",
          "githubAnchor": "d1-exactly-one-gate-moved-to-validating-right-before-materialize",
          "stableAnchor": "h-7de6a1a92ee8"
        },
        {
          "level": 2,
          "text": "The two-tier default-to-silence criterion (D3/D4/D5)",
          "anchor": "the-two-tier-default-to-silence-criterion-d3d4d5",
          "githubAnchor": "the-two-tier-default-to-silence-criterion-d3d4d5",
          "stableAnchor": "h-521522be74d2"
        },
        {
          "level": 2,
          "text": "D6: exactly three mechanical ask-triggers, nothing softer",
          "anchor": "d6-exactly-three-mechanical-ask-triggers-nothing-softer",
          "githubAnchor": "d6-exactly-three-mechanical-ask-triggers-nothing-softer",
          "stableAnchor": "h-9070c434096d"
        },
        {
          "level": 2,
          "text": "D7: materialize moves after the gate, through the existing engine door",
          "anchor": "d7-materialize-moves-after-the-gate-through-the-existing-engine-door",
          "githubAnchor": "d7-materialize-moves-after-the-gate-through-the-existing-engine-door",
          "stableAnchor": "h-eab7190aedfe"
        },
        {
          "level": 2,
          "text": "D8-D11: what this supersedes in `gate-bypass`",
          "anchor": "d8-d11-what-this-supersedes-in-gate-bypass",
          "githubAnchor": "d8-d11-what-this-supersedes-in-gate-bypass",
          "stableAnchor": "h-4bc2f94603f9"
        },
        {
          "level": 2,
          "text": "D12: the shape of a question, when one is actually needed",
          "anchor": "d12-the-shape-of-a-question-when-one-is-actually-needed",
          "githubAnchor": "d12-the-shape-of-a-question-when-one-is-actually-needed",
          "stableAnchor": "h-e6c037f3b982"
        },
        {
          "level": 2,
          "text": "Post-merge prose sync (`tsk-2tk`)",
          "anchor": "post-merge-prose-sync-tsk-2tk",
          "githubAnchor": "post-merge-prose-sync-tsk-2tk",
          "stableAnchor": "h-0c7b01c28a46"
        },
        {
          "level": 2,
          "text": "Two coverage gaps closed after the redesign (`tsk-blk`)",
          "anchor": "two-coverage-gaps-closed-after-the-redesign-tsk-blk",
          "githubAnchor": "two-coverage-gaps-closed-after-the-redesign-tsk-blk",
          "stableAnchor": "h-2474bd1a8513"
        },
        {
          "level": 2,
          "text": "Closing the door on new `planApprove` records (`tsk-4vz`)",
          "anchor": "closing-the-door-on-new-planapprove-records-tsk-4vz",
          "githubAnchor": "closing-the-door-on-new-planapprove-records-tsk-4vz",
          "stableAnchor": "h-865d590a1c8d"
        },
        {
          "level": 2,
          "text": "The fail-closed catch swallowed too much (`tsk-13s`)",
          "anchor": "the-fail-closed-catch-swallowed-too-much-tsk-13s",
          "githubAnchor": "the-fail-closed-catch-swallowed-too-much-tsk-13s",
          "stableAnchor": "h-771e3a34fef0"
        },
        {
          "level": 2,
          "text": "D14: a hand-back from planning to exploring must leave a real trail",
          "anchor": "d14-a-hand-back-from-planning-to-exploring-must-leave-a-real-trail",
          "githubAnchor": "d14-a-hand-back-from-planning-to-exploring-must-leave-a-real-trail",
          "stableAnchor": "h-7a64efd26a5a"
        }
      ],
