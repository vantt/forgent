          "stableAnchor": "h-ddfe1c7d4c69"
        },
        {
          "level": 2,
          "text": "Attack 1 — the real fixture's window gate",
          "anchor": "attack-1-the-real-fixtures-window-gate",
          "githubAnchor": "attack-1-the-real-fixtures-window-gate",
          "stableAnchor": "h-86212c07dbef"
        },
        {
          "level": 3,
          "text": "FINDING 1 (Medium) — a raw `actor-replaced` event collapses the cohort and opens the window on half the work",
          "anchor": "finding-1-medium-a-raw-actor-replaced-event-collapses-the-cohort-and-opens-the-window-on-half-the-work",
          "githubAnchor": "finding-1-medium-a-raw-actor-replaced-event-collapses-the-cohort-and-opens-the-window-on-half-the-work",
          "stableAnchor": "h-411c1964c6f6"
        },
        {
          "level": 2,
          "text": "Attack 2 — is Limitation 3 (\"runtime-inert for `required` bindings\") true?",
          "anchor": "attack-2-is-limitation-3-runtime-inert-for-required-bindings-true",
          "githubAnchor": "attack-2-is-limitation-3-runtime-inert-for-required-bindings-true",
          "stableAnchor": "h-4e8e88cb1dfa"
        },
        {
          "level": 2,
          "text": "Attack 3 — the promoted text's specific factual claims",
          "anchor": "attack-3-the-promoted-texts-specific-factual-claims",
          "githubAnchor": "attack-3-the-promoted-texts-specific-factual-claims",
          "stableAnchor": "h-e4ae9c66db67"
        },
        {
          "level": 3,
          "text": "FINDING 2 (Low–Medium) — \"the sole door\" / \"satisfy no window source at all\" is contradicted by the file's own residual 40 lines later",
          "anchor": "finding-2-lowmedium-the-sole-door-satisfy-no-window-source-at-all-is-contradicted-by-the-files-own-residual-40-lines-later",
          "githubAnchor": "finding-2-lowmedium-the-sole-door-satisfy-no-window-source-at-all-is-contradicted-by-the-files-own-residual-40-lines-later",
          "stableAnchor": "h-21b70b6dc403"
        },
        {
          "level": 2,
          "text": "Attack 4 — same actor, two nodes (the claimed residual)",
          "anchor": "attack-4-same-actor-two-nodes-the-claimed-residual",
          "githubAnchor": "attack-4-same-actor-two-nodes-the-claimed-residual",
          "stableAnchor": "h-d5bab9eac12c"
        },
        {
          "level": 2,
          "text": "Attack 5 — regression / shared-state interaction with the ungated fixture",
          "anchor": "attack-5-regression-shared-state-interaction-with-the-ungated-fixture",
          "githubAnchor": "attack-5-regression-shared-state-interaction-with-the-ungated-fixture",
          "stableAnchor": "h-664dbbbc6f88"
        },
        {
          "level": 2,
          "text": "Attack 6 — would the promoted text mislead a P07.3+/P08+/P09+ implementer?",
          "anchor": "attack-6-would-the-promoted-text-mislead-a-p073p08p09-implementer",
          "githubAnchor": "attack-6-would-the-promoted-text-mislead-a-p073p08p09-implementer",
          "stableAnchor": "h-fa95068a6fe2"
        },
        {
          "level": 3,
          "text": "FINDING 3 (Low, but it is a factual inversion) — a Required Negative Test asserts the opposite of the behaviour",
          "anchor": "finding-3-low-but-it-is-a-factual-inversion-a-required-negative-test-asserts-the-opposite-of-the-behaviour",
          "githubAnchor": "finding-3-low-but-it-is-a-factual-inversion-a-required-negative-test-asserts-the-opposite-of-the-behaviour",
          "stableAnchor": "h-8da952514425"
