        },
        {
          "level": 2,
          "text": "1. Recommendation (one)",
          "anchor": "1-recommendation-one",
          "githubAnchor": "1-recommendation-one",
          "stableAnchor": "h-3782899ced20"
        },
        {
          "level": 3,
          "text": "What this is chosen *against*",
          "anchor": "what-this-is-chosen-against",
          "githubAnchor": "what-this-is-chosen-against",
          "stableAnchor": "h-23b03627f7e5"
        },
        {
          "level": 2,
          "text": "2. What the recommendation rests on — per claim",
