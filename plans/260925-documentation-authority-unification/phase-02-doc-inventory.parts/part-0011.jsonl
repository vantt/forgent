      "headings": [
        {
          "level": 1,
          "text": "Why concurrency tests batch processes instead of relying on a fixed lock timeout",
          "anchor": "why-concurrency-tests-batch-processes-instead-of-relying-on-a-fixed-lock-timeout",
          "githubAnchor": "why-concurrency-tests-batch-processes-instead-of-relying-on-a-fixed-lock-timeout",
          "stableAnchor": "h-e9722e727c3f"
        },
        {
          "level": 2,
          "text": "Confirming this was standing fragility, not a regression",
          "anchor": "confirming-this-was-standing-fragility-not-a-regression",
          "githubAnchor": "confirming-this-was-standing-fragility-not-a-regression",
          "stableAnchor": "h-2250639abc41"
        },
        {
          "level": 2,
          "text": "Why \"just a flaky test\" undersells the real cost",
          "anchor": "why-just-a-flaky-test-undersells-the-real-cost",
          "githubAnchor": "why-just-a-flaky-test-undersells-the-real-cost",
          "stableAnchor": "h-7ef4f07082e5"
        },
        {
          "level": 2,
          "text": "The fix: reduce peak contention, not stretch the timeout",
          "anchor": "the-fix-reduce-peak-contention-not-stretch-the-timeout",
          "githubAnchor": "the-fix-reduce-peak-contention-not-stretch-the-timeout",
          "stableAnchor": "h-d6ee58df9228"
        },
        {
          "level": 2,
          "text": "Why this direction over a bigger timeout",
          "anchor": "why-this-direction-over-a-bigger-timeout",
          "githubAnchor": "why-this-direction-over-a-bigger-timeout",
          "stableAnchor": "h-31fcdbe7d89a"
        },
        {
          "level": 2,
          "text": "Follow-up: the task id itself didn't belong in the comments (`tsk-2va`)",
          "anchor": "follow-up-the-task-id-itself-didnt-belong-in-the-comments-tsk-2va",
          "githubAnchor": "follow-up-the-task-id-itself-didnt-belong-in-the-comments-tsk-2va",
          "stableAnchor": "h-3345b03c8f6c"
        }
