      "path": "docs/platform/agent-coordination/vision.md",
      "sourceId": "src_179354588fa80c93ddf715b82a255451",
      "identityStatus": "carried-forward",
      "sourceDigest": "a52dfb00bc993981bbad948098d8d5e7632bbdd3f04bc66192dab34d1eb8ef10",
      "blobSha": "42f83743eb859eaec70314cd13632960b57dd66e",
      "blobSize": 17087,
      "area": "Platform documentation (unmapped candidate)",
      "authorityStatus": "candidate",
      "fileClass": "maintained-authority",
      "corpus": "platform-authority",
      "switchboardSource": "directory-heuristic",
      "gap": true,
      "documentType": null,
      "claimKind": "unclassified",
      "headingCount": 35,
      "unheadedBlockCount": 65,
      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Agent Coordination Foundation Vision",
          "anchor": "agent-coordination-foundation-vision",
          "githubAnchor": "agent-coordination-foundation-vision",
          "stableAnchor": "h-0c4b7de40cf9"
        },
        {
          "level": 2,
          "text": "Authority And Reading Rule",
          "anchor": "authority-and-reading-rule",
          "githubAnchor": "authority-and-reading-rule",
          "stableAnchor": "h-59cac70d8123"
        },
        {
          "level": 2,
          "text": "Vision",
          "anchor": "vision",
          "githubAnchor": "vision",
          "stableAnchor": "h-d842d2492705"
        },
        {
          "level": 2,
          "text": "Problems This Vision Resolves",
          "anchor": "problems-this-vision-resolves",
          "githubAnchor": "problems-this-vision-resolves",
          "stableAnchor": "h-5251bf50bfc1"
        },
        {
          "level": 3,
          "text": "1. Coordination Has Been Too Closely Identified With Work",
          "anchor": "1-coordination-has-been-too-closely-identified-with-work",
          "githubAnchor": "1-coordination-has-been-too-closely-identified-with-work",
          "stableAnchor": "h-b00377fb58a6"
        },
        {
          "level": 3,
          "text": "2. Planning Currently Over-Materializes Work",
          "anchor": "2-planning-currently-over-materializes-work",
          "githubAnchor": "2-planning-currently-over-materializes-work",
          "stableAnchor": "h-cafd1981c176"
        },
        {
          "level": 3,
          "text": "3. Standalone Coordination Borrows Coding Workflow Structure",
          "anchor": "3-standalone-coordination-borrows-coding-workflow-structure",
          "githubAnchor": "3-standalone-coordination-borrows-coding-workflow-structure",
          "stableAnchor": "h-2916d875edea"
        },
        {
          "level": 3,
          "text": "4. Predeclared Structure Has Been Treated As Universally Mandatory",
          "anchor": "4-predeclared-structure-has-been-treated-as-universally-mandatory",
          "githubAnchor": "4-predeclared-structure-has-been-treated-as-universally-mandatory",
          "stableAnchor": "h-6cf5a11579b1"
        },
        {
          "level": 3,
          "text": "5. Generic And Domain-Specific Planning Concerns Are Mixed",
          "anchor": "5-generic-and-domain-specific-planning-concerns-are-mixed",
          "githubAnchor": "5-generic-and-domain-specific-planning-concerns-are-mixed",
          "stableAnchor": "h-1477eace644c"
        },
        {
          "level": 3,
          "text": "6. The Two Unsafe Extremes",
          "anchor": "6-the-two-unsafe-extremes",
          "githubAnchor": "6-the-two-unsafe-extremes",
          "stableAnchor": "h-3c9046feddc4"
        },
        {
          "level": 2,
          "text": "Accepted Vision Decisions",
          "anchor": "accepted-vision-decisions",
          "githubAnchor": "accepted-vision-decisions",
          "stableAnchor": "h-ae3f37e54448"
        },
        {
          "level": 3,
          "text": "V-001: Agent Coordination Is A Foundation Layer",
          "anchor": "v-001-agent-coordination-is-a-foundation-layer",
          "githubAnchor": "v-001-agent-coordination-is-a-foundation-layer",
          "stableAnchor": "h-cb2a02b857c5"
        },
        {
          "level": 3,
          "text": "V-002: Work Is Optional Integration, Not System Identity",
          "anchor": "v-002-work-is-optional-integration-not-system-identity",
          "githubAnchor": "v-002-work-is-optional-integration-not-system-identity",
          "stableAnchor": "h-4f580ee2e920"
        },
        {
          "level": 3,
          "text": "V-003: A Predeclared Workflow Or Protocol Is Optional",
          "anchor": "v-003-a-predeclared-workflow-or-protocol-is-optional",
          "githubAnchor": "v-003-a-predeclared-workflow-or-protocol-is-optional",
          "stableAnchor": "h-3542ebac8cbf"
        },
        {
          "level": 3,
          "text": "V-004: Runtime Execution Contracts Are Mandatory",
          "anchor": "v-004-runtime-execution-contracts-are-mandatory",
          "githubAnchor": "v-004-runtime-execution-contracts-are-mandatory",
          "stableAnchor": "h-56985c944c57"
        },
        {
          "level": 3,
          "text": "V-005: Agents Own Adaptive Reasoning; The Foundation Owns Authority",
          "anchor": "v-005-agents-own-adaptive-reasoning-the-foundation-owns-authority",
          "githubAnchor": "v-005-agents-own-adaptive-reasoning-the-foundation-owns-authority",
          "stableAnchor": "h-023a564ec42b"
        },
        {
          "level": 3,
          "text": "V-006: Planning Is Pluggable And Composable",
          "anchor": "v-006-planning-is-pluggable-and-composable",
          "githubAnchor": "v-006-planning-is-pluggable-and-composable",
          "stableAnchor": "h-1f571db7dea2"
        },
        {
          "level": 3,
          "text": "V-007: Dispatch Is A Primary Foundation Capability",
          "anchor": "v-007-dispatch-is-a-primary-foundation-capability",
          "githubAnchor": "v-007-dispatch-is-a-primary-foundation-capability",
          "stableAnchor": "h-0d46fe39f232"
        },
        {
          "level": 3,
          "text": "V-008: Domain And Organization Augmentation Creates Differentiation",
          "anchor": "v-008-domain-and-organization-augmentation-creates-differentiation",
          "githubAnchor": "v-008-domain-and-organization-augmentation-creates-differentiation",
          "stableAnchor": "h-c9094782cc70"
        },
        {
          "level": 3,
          "text": "V-009: Runtime Graphs May Be Trivial, Dynamic, Or Declared",
          "anchor": "v-009-runtime-graphs-may-be-trivial-dynamic-or-declared",
          "githubAnchor": "v-009-runtime-graphs-may-be-trivial-dynamic-or-declared",
          "stableAnchor": "h-ed3adccc32c7"
        },
        {
          "level": 3,
          "text": "V-010: Evidence And Provenance Survive Every Profile",
          "anchor": "v-010-evidence-and-provenance-survive-every-profile",
          "githubAnchor": "v-010-evidence-and-provenance-survive-every-profile",
          "stableAnchor": "h-495adfb48ea0"
        },
        {
          "level": 3,
          "text": "V-011: The Foundation Core Stays Small",
          "anchor": "v-011-the-foundation-core-stays-small",
          "githubAnchor": "v-011-the-foundation-core-stays-small",
          "stableAnchor": "h-f9377f564b66"
        },
        {
          "level": 3,
