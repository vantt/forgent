      "headings": [
        {
          "level": 1,
          "text": "Why splitting test files hits a floor, and why narrowing verify never helped",
          "anchor": "why-splitting-test-files-hits-a-floor-and-why-narrowing-verify-never-helped",
          "githubAnchor": "why-splitting-test-files-hits-a-floor-and-why-narrowing-verify-never-helped",
          "stableAnchor": "h-a96f160164a3"
        },
        {
          "level": 2,
          "text": "`node --test` parallelizes by file, so one file sets the floor",
          "anchor": "node---test-parallelizes-by-file-so-one-file-sets-the-floor",
          "githubAnchor": "node---test-parallelizes-by-file-so-one-file-sets-the-floor",
          "stableAnchor": "h-d15422bbb70d"
        },
        {
          "level": 2,
          "text": "Consequence: narrowing verify scope cannot make verify faster",
          "anchor": "consequence-narrowing-verify-scope-cannot-make-verify-faster",
          "githubAnchor": "consequence-narrowing-verify-scope-cannot-make-verify-faster",
          "stableAnchor": "h-a278e500e6ac"
        },
        {
          "level": 2,
          "text": "The measurement that decided whether the plan was real, before any code moved",
          "anchor": "the-measurement-that-decided-whether-the-plan-was-real-before-any-code-moved",
          "githubAnchor": "the-measurement-that-decided-whether-the-plan-was-real-before-any-code-moved",
          "stableAnchor": "h-ae76e2b7400a"
        },
        {
          "level": 2,
          "text": "Split by measured cost — not by test count, and not by topic",
          "anchor": "split-by-measured-cost-not-by-test-count-and-not-by-topic",
          "githubAnchor": "split-by-measured-cost-not-by-test-count-and-not-by-topic",
          "stableAnchor": "h-981654afff7e"
        },
        {
          "level": 2,
          "text": "Mechanical splitting worked, then stopped working at ~50s",
          "anchor": "mechanical-splitting-worked-then-stopped-working-at-50s",
          "githubAnchor": "mechanical-splitting-worked-then-stopped-working-at-50s",
          "stableAnchor": "h-3b7baba9c12f"
        },
        {
          "level": 2,
          "text": "The obvious next step was tried, measured, and was wrong",
          "anchor": "the-obvious-next-step-was-tried-measured-and-was-wrong",
          "githubAnchor": "the-obvious-next-step-was-tried-measured-and-was-wrong",
          "stableAnchor": "h-1b9d0966c4b2"
        },
        {
          "level": 2,
          "text": "The floor was not structural — it was 10 tests shelling out to a real CLI",
          "anchor": "the-floor-was-not-structural-it-was-10-tests-shelling-out-to-a-real-cli",
          "githubAnchor": "the-floor-was-not-structural-it-was-10-tests-shelling-out-to-a-real-cli",
          "stableAnchor": "h-2b5854907e4b"
        },
        {
          "level": 3,
          "text": "This was never only a speed bug",
          "anchor": "this-was-never-only-a-speed-bug",
          "githubAnchor": "this-was-never-only-a-speed-bug",
          "stableAnchor": "h-b09fff9bbc00"
        },
        {
          "level": 3,
          "text": "Measured result",
          "anchor": "measured-result",
          "githubAnchor": "measured-result",
          "stableAnchor": "h-22d7d97e3f2e"
        },
        {
          "level": 3,
          "text": "A wall-clock saving is not a CPU saving",
          "anchor": "a-wall-clock-saving-is-not-a-cpu-saving",
          "githubAnchor": "a-wall-clock-saving-is-not-a-cpu-saving",
          "stableAnchor": "h-fcb42b719083"
        },
        {
          "level": 2,
          "text": "Why the acceptance threshold became relative instead of absolute",
          "anchor": "why-the-acceptance-threshold-became-relative-instead-of-absolute",
          "githubAnchor": "why-the-acceptance-threshold-became-relative-instead-of-absolute",
          "stableAnchor": "h-65bbd4312e0b"
        },
        {
          "level": 2,
          "text": "A measurement inside a verify must prove it is a number",
          "anchor": "a-measurement-inside-a-verify-must-prove-it-is-a-number",
          "githubAnchor": "a-measurement-inside-a-verify-must-prove-it-is-a-number",
          "stableAnchor": "h-41edf9167527"
        }
      ],
