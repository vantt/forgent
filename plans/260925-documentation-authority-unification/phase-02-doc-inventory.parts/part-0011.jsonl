          "stableAnchor": "h-857824463984"
        },
        {
          "level": 2,
          "text": "Five real bugs nobody knew about yet",
          "anchor": "five-real-bugs-nobody-knew-about-yet",
          "githubAnchor": "five-real-bugs-nobody-knew-about-yet",
          "stableAnchor": "h-33f4cd2e829b"
        },
        {
          "level": 2,
          "text": "Seven structural instabilities — the reason this will recur",
          "anchor": "seven-structural-instabilities-the-reason-this-will-recur",
          "githubAnchor": "seven-structural-instabilities-the-reason-this-will-recur",
          "stableAnchor": "h-d8e90a23c9ba"
        },
        {
          "level": 2,
          "text": "The nine-child remediation, ranked by the audit's own leverage order",
          "anchor": "the-nine-child-remediation-ranked-by-the-audits-own-leverage-order",
          "githubAnchor": "the-nine-child-remediation-ranked-by-the-audits-own-leverage-order",
          "stableAnchor": "h-a240a7e3cfcb"
        },
        {
          "level": 2,
          "text": "The general lesson",
          "anchor": "the-general-lesson",
          "githubAnchor": "the-general-lesson",
          "stableAnchor": "h-c20fd5d9835d"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-2el` closed the entry-point prose gap (F1d/F1f/F1g/F3)",
          "anchor": "confirmed-tsk-2el-closed-the-entry-point-prose-gap-f1df1ff1gf3",
          "githubAnchor": "confirmed-tsk-2el-closed-the-entry-point-prose-gap-f1df1ff1gf3",
          "stableAnchor": "h-18c885b18dd9"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-3zi` fixed the Rust dashboard's blind spot (F1e)",
          "anchor": "confirmed-tsk-3zi-fixed-the-rust-dashboards-blind-spot-f1e",
          "githubAnchor": "confirmed-tsk-3zi-fixed-the-rust-dashboards-blind-spot-f1e",
          "stableAnchor": "h-4ded224e3a4e"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-31lz` closed the false-pass settlement gate (F1c)",
          "anchor": "confirmed-tsk-31lz-closed-the-false-pass-settlement-gate-f1c",
          "githubAnchor": "confirmed-tsk-31lz-closed-the-false-pass-settlement-gate-f1c",
          "stableAnchor": "h-4b01c4156bc5"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-64h` closed B2 and B3 together",
          "anchor": "confirmed-tsk-64h-closed-b2-and-b3-together",
          "githubAnchor": "confirmed-tsk-64h-closed-b2-and-b3-together",
          "stableAnchor": "h-cbc89d2c4d22"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-2t3` fixed the silently-wrong entropy metric (F5)",
          "anchor": "confirmed-tsk-2t3-fixed-the-silently-wrong-entropy-metric-f5",
          "githubAnchor": "confirmed-tsk-2t3-fixed-the-silently-wrong-entropy-metric-f5",
          "stableAnchor": "h-f28d632412b1"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-q88` closed the CHANGELOG gap (F4)",
          "anchor": "confirmed-tsk-q88-closed-the-changelog-gap-f4",
          "githubAnchor": "confirmed-tsk-q88-closed-the-changelog-gap-f4",
          "stableAnchor": "h-5cabacf9e62b"
        },
        {
          "level": 2,
          "text": "`tsk-5eq`: the batch's largest piece, and the one deliberate non-fix inside it",
          "anchor": "tsk-5eq-the-batchs-largest-piece-and-the-one-deliberate-non-fix-inside-it",
          "githubAnchor": "tsk-5eq-the-batchs-largest-piece-and-the-one-deliberate-non-fix-inside-it",
          "stableAnchor": "h-df8abeb4a499"
        },
        {
          "level": 2,
          "text": "Confirmed: `tsk-19m` closed the interactive/headless capability gap (B7)",
          "anchor": "confirmed-tsk-19m-closed-the-interactiveheadless-capability-gap-b7",
          "githubAnchor": "confirmed-tsk-19m-closed-the-interactiveheadless-capability-gap-b7",
          "stableAnchor": "h-856779abd196"
        }
