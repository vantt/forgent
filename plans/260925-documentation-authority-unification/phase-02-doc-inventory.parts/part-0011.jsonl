      "headings": [
        {
          "level": 1,
          "text": "Add a stateful fgOS verb-group with a local status overlay",
          "anchor": "add-a-stateful-fgos-verb-group-with-a-local-status-overlay",
          "githubAnchor": "add-a-stateful-fgos-verb-group-with-a-local-status-overlay",
          "stableAnchor": "h-bbe4c0ce1110"
        },
        {
          "level": 2,
          "text": "1. Split \"team decision\" from \"fact about this machine\" before writing any code",
          "anchor": "1-split-team-decision-from-fact-about-this-machine-before-writing-any-code",
          "githubAnchor": "1-split-team-decision-from-fact-about-this-machine-before-writing-any-code",
          "stableAnchor": "h-c82c78e9a22f"
        },
        {
          "level": 2,
          "text": "2. Keep validation pure and separate from the write door",
          "anchor": "2-keep-validation-pure-and-separate-from-the-write-door",
          "githubAnchor": "2-keep-validation-pure-and-separate-from-the-write-door",
          "stableAnchor": "h-de01061d92e9"
        },
        {
          "level": 2,
          "text": "3. Resolve presence by scanning disk, never by shelling out",
          "anchor": "3-resolve-presence-by-scanning-disk-never-by-shelling-out",
          "githubAnchor": "3-resolve-presence-by-scanning-disk-never-by-shelling-out",
          "stableAnchor": "h-98918d56fa3a"
        },
        {
          "level": 2,
          "text": "4. Add a doctor check that reports posture, never fails on an empty registry",
          "anchor": "4-add-a-doctor-check-that-reports-posture-never-fails-on-an-empty-registry",
          "githubAnchor": "4-add-a-doctor-check-that-reports-posture-never-fails-on-an-empty-registry",
          "stableAnchor": "h-402335390dee"
        },
        {
          "level": 2,
          "text": "5. Port the full enum, don't trim it to today's known users",
          "anchor": "5-port-the-full-enum-dont-trim-it-to-todays-known-users",
          "githubAnchor": "5-port-the-full-enum-dont-trim-it-to-todays-known-users",
          "stableAnchor": "h-17dd838dcac9"
        },
        {
          "level": 2,
          "text": "6. Pre-seed real data instead of shipping an empty registry, if a concrete consumer already exists",
          "anchor": "6-pre-seed-real-data-instead-of-shipping-an-empty-registry-if-a-concrete-consumer-already-exists",
          "githubAnchor": "6-pre-seed-real-data-instead-of-shipping-an-empty-registry-if-a-concrete-consumer-already-exists",
          "stableAnchor": "h-5c73360e9e6c"
        },
        {
          "level": 2,
          "text": "7. Test at both layers, plus the fold path",
          "anchor": "7-test-at-both-layers-plus-the-fold-path",
          "githubAnchor": "7-test-at-both-layers-plus-the-fold-path",
          "stableAnchor": "h-e5ff27512cc7"
        },
        {
          "level": 2,
          "text": "Iron Law note",
          "anchor": "iron-law-note",
          "githubAnchor": "iron-law-note",
          "stableAnchor": "h-08b74549fd75"
        }
      ],
