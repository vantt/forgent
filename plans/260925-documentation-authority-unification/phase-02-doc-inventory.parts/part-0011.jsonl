      "headings": [
        {
          "level": 1,
          "text": "Why auto-launched herdr panes must be labeled before spawning `claude`, unlike person-triggered ones",
          "anchor": "why-auto-launched-herdr-panes-must-be-labeled-before-spawning-claude-unlike-person-triggered-ones",
          "githubAnchor": "why-auto-launched-herdr-panes-must-be-labeled-before-spawning-claude-unlike-person-triggered-ones",
          "stableAnchor": "h-dbc63b1d49a4"
        },
        {
          "level": 2,
          "text": "Why the same ordering breaks for an unattended, auto-launched pane",
          "anchor": "why-the-same-ordering-breaks-for-an-unattended-auto-launched-pane",
          "githubAnchor": "why-the-same-ordering-breaks-for-an-unattended-auto-launched-pane",
          "stableAnchor": "h-54cf6250161a"
        },
        {
          "level": 2,
          "text": "The fix: label first, then spawn",
          "anchor": "the-fix-label-first-then-spawn",
          "githubAnchor": "the-fix-label-first-then-spawn",
          "stableAnchor": "h-aa4eb91ce2a9"
        },
        {
          "level": 2,
          "text": "The label namespace itself needed a second guard",
          "anchor": "the-label-namespace-itself-needed-a-second-guard",
          "githubAnchor": "the-label-namespace-itself-needed-a-second-guard",
          "stableAnchor": "h-e1596ac69ab3"
        },
        {
          "level": 2,
          "text": "Failures are swallowed, not surfaced, by design",
          "anchor": "failures-are-swallowed-not-surfaced-by-design",
          "githubAnchor": "failures-are-swallowed-not-surfaced-by-design",
          "stableAnchor": "h-273be9d3226b"
        },
        {
          "level": 2,
          "text": "A sibling launcher needed new trait methods, not the same ones (`tsk-57q`)",
          "anchor": "a-sibling-launcher-needed-new-trait-methods-not-the-same-ones-tsk-57q",
          "githubAnchor": "a-sibling-launcher-needed-new-trait-methods-not-the-same-ones-tsk-57q",
          "stableAnchor": "h-75807c20c47f"
        },
        {
          "level": 2,
          "text": "The two mechanisms collapsed back into one (`tsk-3fk`)",
          "anchor": "the-two-mechanisms-collapsed-back-into-one-tsk-3fk",
          "githubAnchor": "the-two-mechanisms-collapsed-back-into-one-tsk-3fk",
          "stableAnchor": "h-0644332adca0"
        },
        {
          "level": 3,
          "text": "The mutual exclusion was an artifact of the fixed slot",
          "anchor": "the-mutual-exclusion-was-an-artifact-of-the-fixed-slot",
          "githubAnchor": "the-mutual-exclusion-was-an-artifact-of-the-fixed-slot",
          "stableAnchor": "h-2a2ba2ec8f2e"
        },
        {
          "level": 3,
          "text": "Closing a pane stopped conflicting with the layout",
          "anchor": "closing-a-pane-stopped-conflicting-with-the-layout",
          "githubAnchor": "closing-a-pane-stopped-conflicting-with-the-layout",
          "stableAnchor": "h-f9961b3b8ffc"
        },
        {
          "level": 3,
          "text": "A cap, and rewritten tests",
          "anchor": "a-cap-and-rewritten-tests",
          "githubAnchor": "a-cap-and-rewritten-tests",
          "stableAnchor": "h-689d07b45bf7"
        },
        {
          "level": 2,
          "text": "Related",
          "anchor": "related",
          "githubAnchor": "related",
          "stableAnchor": "h-c2663a791f71"
        }
