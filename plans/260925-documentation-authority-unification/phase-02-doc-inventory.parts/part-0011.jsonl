      "headings": [
        {
          "level": 1,
          "text": "Launch claude in a new herdr pane from a plugin",
          "anchor": "launch-claude-in-a-new-herdr-pane-from-a-plugin",
          "githubAnchor": "launch-claude-in-a-new-herdr-pane-from-a-plugin",
          "stableAnchor": "h-6c3b9f53ae39"
        },
        {
          "level": 2,
          "text": "1. A manifest `[[actions]]` entry cannot carry per-row selection",
          "anchor": "1-a-manifest-actions-entry-cannot-carry-per-row-selection",
          "githubAnchor": "1-a-manifest-actions-entry-cannot-carry-per-row-selection",
          "stableAnchor": "h-a73b53cafdf5"
        },
        {
          "level": 2,
          "text": "2. The real two-call sequence: `pane split` then `pane run`",
          "anchor": "2-the-real-two-call-sequence-pane-split-then-pane-run",
          "githubAnchor": "2-the-real-two-call-sequence-pane-split-then-pane-run",
          "stableAnchor": "h-a23cfff5b2dd"
        },
        {
          "level": 2,
          "text": "2b. Pin the model explicitly — the launched session won't inherit yours",
          "anchor": "2b-pin-the-model-explicitly-the-launched-session-wont-inherit-yours",
          "githubAnchor": "2b-pin-the-model-explicitly-the-launched-session-wont-inherit-yours",
          "stableAnchor": "h-0502cceae1c0"
        },
        {
          "level": 2,
          "text": "3. Re-validate any id before it's typed into a pane",
          "anchor": "3-re-validate-any-id-before-its-typed-into-a-pane",
          "githubAnchor": "3-re-validate-any-id-before-its-typed-into-a-pane",
          "stableAnchor": "h-c5cfe1047566"
        },
        {
          "level": 2,
          "text": "4. Parse the new pane's id from the real response shape, fixture-tested",
          "anchor": "4-parse-the-new-panes-id-from-the-real-response-shape-fixture-tested",
          "githubAnchor": "4-parse-the-new-panes-id-from-the-real-response-shape-fixture-tested",
          "stableAnchor": "h-f9ef782d1f08"
        },
        {
          "level": 2,
          "text": "5. Smoke-test the real mechanism without spawning a nested agent",
          "anchor": "5-smoke-test-the-real-mechanism-without-spawning-a-nested-agent",
          "githubAnchor": "5-smoke-test-the-real-mechanism-without-spawning-a-nested-agent",
          "stableAnchor": "h-506569530a55"
        }
      ],
