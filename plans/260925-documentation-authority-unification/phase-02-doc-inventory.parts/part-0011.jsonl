        },
        {
          "level": 2,
          "text": "Red-Team",
          "anchor": "red-team",
          "githubAnchor": "red-team",
          "stableAnchor": "h-83a46623100c"
        },
        {
          "level": 3,
          "text": "HIGH — the deferred MEDIUM is not a theoretical concurrency edge case: two genuinely-simultaneous `--contract` invocations under the same writer identity collide and silently discard one caller's real request, exactly reproducing the just-fixed HIGH's false-success shape",
          "anchor": "high-the-deferred-medium-is-not-a-theoretical-concurrency-edge-case-two-genuinely-simultaneous---contract-invocations-under-the-same-writer-identity-collide-and-silently-discard-one-callers-real-request-exactly-reproducing-the-just-fixed-highs-false-success-shape",
          "githubAnchor": "high-the-deferred-medium-is-not-a-theoretical-concurrency-edge-case-two-genuinely-simultaneous---contract-invocations-under-the-same-writer-identity-collide-and-silently-discard-one-callers-real-request-exactly-reproducing-the-just-fixed-highs-false-success-shape",
          "stableAnchor": "h-eef319982bd5"
        },
        {
