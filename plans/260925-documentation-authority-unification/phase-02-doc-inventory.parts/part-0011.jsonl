      "headings": [
        {
          "level": 1,
          "text": "Why `agy` dispatch needed `--new-project`, and still isn't fully reliable",
          "anchor": "why-agy-dispatch-needed---new-project-and-still-isnt-fully-reliable",
          "githubAnchor": "why-agy-dispatch-needed---new-project-and-still-isnt-fully-reliable",
          "stableAnchor": "h-1a1dad6171ed"
        },
        {
          "level": 2,
          "text": "The incident: real cross-branch contamination, not a hypothetical",
          "anchor": "the-incident-real-cross-branch-contamination-not-a-hypothetical",
          "githubAnchor": "the-incident-real-cross-branch-contamination-not-a-hypothetical",
          "stableAnchor": "h-3edc309d4100"
        },
        {
          "level": 2,
          "text": "Root cause: `agy` resumes its own tracked project, ignoring the spawned `cwd`",
          "anchor": "root-cause-agy-resumes-its-own-tracked-project-ignoring-the-spawned-cwd",
          "githubAnchor": "root-cause-agy-resumes-its-own-tracked-project-ignoring-the-spawned-cwd",
          "stableAnchor": "h-1ed35745971a"
        },
        {
          "level": 2,
          "text": "The fix didn't make `agy` fully reliable — a second, different failure mode followed",
          "anchor": "the-fix-didnt-make-agy-fully-reliable-a-second-different-failure-mode-followed",
          "githubAnchor": "the-fix-didnt-make-agy-fully-reliable-a-second-different-failure-mode-followed",
          "stableAnchor": "h-1335ca4407fd"
        },
        {
          "level": 2,
          "text": "What this means for anyone dispatching to `agy`",
          "anchor": "what-this-means-for-anyone-dispatching-to-agy",
          "githubAnchor": "what-this-means-for-anyone-dispatching-to-agy",
          "stableAnchor": "h-9a384daf44ae"
        },
        {
          "level": 2,
          "text": "The second failure mode's root cause found (`tsk-1up`)",
          "anchor": "the-second-failure-modes-root-cause-found-tsk-1up",
          "githubAnchor": "the-second-failure-modes-root-cause-found-tsk-1up",
          "stableAnchor": "h-b34efba883af"
        },
        {
          "level": 2,
          "text": "Source",
          "anchor": "source",
          "githubAnchor": "source",
          "stableAnchor": "h-862e1c0060f7"
        }
      ],
