          "text": "P10-KERNEL-FIX — Red-Team Recheck of Fix Round 1",
          "anchor": "p10-kernel-fix-red-team-recheck-of-fix-round-1",
          "githubAnchor": "p10-kernel-fix-red-team-recheck-of-fix-round-1",
