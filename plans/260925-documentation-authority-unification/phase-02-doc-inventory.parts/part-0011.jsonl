          "githubAnchor": "the-bug-confirmed-live-before-the-fix",
          "stableAnchor": "h-475326d3c680"
        },
        {
          "level": 2,
          "text": "The fix: caller claims first, the driver's own rule already expects that",
          "anchor": "the-fix-caller-claims-first-the-drivers-own-rule-already-expects-that",
          "githubAnchor": "the-fix-caller-claims-first-the-drivers-own-rule-already-expects-that",
          "stableAnchor": "h-15f31dabe236"
        },
        {
          "level": 2,
          "text": "Not a fresh problem — the same class of bug, deliberately deferred once already",
          "anchor": "not-a-fresh-problem-the-same-class-of-bug-deliberately-deferred-once-already",
          "githubAnchor": "not-a-fresh-problem-the-same-class-of-bug-deliberately-deferred-once-already",
          "stableAnchor": "h-2e75ac9b30b1"
        },
        {
          "level": 2,
          "text": "The accepted cost: advisory noise, not a correctness break",
          "anchor": "the-accepted-cost-advisory-noise-not-a-correctness-break",
          "githubAnchor": "the-accepted-cost-advisory-noise-not-a-correctness-break",
          "stableAnchor": "h-7484c352a1e3"
        },
        {
          "level": 2,
          "text": "Outcome",
          "anchor": "outcome",
          "githubAnchor": "outcome",
          "stableAnchor": "h-d2840ea2c451"
        }
      ],
