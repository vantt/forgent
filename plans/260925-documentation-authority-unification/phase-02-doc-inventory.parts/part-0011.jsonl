          "githubAnchor": "high-a-second---contract-invocation-against-the-same-workwriter-silently-discards-the-callers-new-contract-and-re-executes-the-stale-first-one",
          "stableAnchor": "h-1396f86169ce"
        },
        {
          "level": 3,
          "text": "Fix Round 1",
          "anchor": "fix-round-1",
          "githubAnchor": "fix-round-1",
          "stableAnchor": "h-158b89478b3a"
        },
        {
          "level": 4,
          "text": "Reviewer recheck (material-fix recheck, master-coordinator.md step F.5)",
          "anchor": "reviewer-recheck-material-fix-recheck-master-coordinatormd-step-f5",
