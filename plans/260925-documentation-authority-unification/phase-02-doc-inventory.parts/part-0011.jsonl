      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Why the Iron Law gate only fires at the trunk boundary",
          "anchor": "why-the-iron-law-gate-only-fires-at-the-trunk-boundary",
          "githubAnchor": "why-the-iron-law-gate-only-fires-at-the-trunk-boundary",
          "stableAnchor": "h-0817eb19700b"
        },
        {
          "level": 2,
          "text": "D1: the gate only runs where a person actually needs to decide",
          "anchor": "d1-the-gate-only-runs-where-a-person-actually-needs-to-decide",
          "githubAnchor": "d1-the-gate-only-runs-where-a-person-actually-needs-to-decide",
          "stableAnchor": "h-dd5fe574b116"
        },
        {
          "level": 2,
          "text": "D2: the person decides, the agent operates",
          "anchor": "d2-the-person-decides-the-agent-operates",
          "githubAnchor": "d2-the-person-decides-the-agent-operates",
          "stableAnchor": "h-70930e7d5541"
        },
        {
          "level": 2,
          "text": "D3/D7: `ask`/`warn`, a dedicated config key, never folded into `gateBypass`",
          "anchor": "d3d7-askwarn-a-dedicated-config-key-never-folded-into-gatebypass",
          "githubAnchor": "d3d7-askwarn-a-dedicated-config-key-never-folded-into-gatebypass",
          "stableAnchor": "h-3f20a82c3ed9"
        },
        {
          "level": 2,
          "text": "D4: no bypass field on the work item itself",
          "anchor": "d4-no-bypass-field-on-the-work-item-itself",
          "githubAnchor": "d4-no-bypass-field-on-the-work-item-itself",
          "stableAnchor": "h-f8cef31bf6a4"
        },
        {
          "level": 2,
          "text": "D5: a blocked item never blocks anything else",
          "anchor": "d5-a-blocked-item-never-blocks-anything-else",
          "githubAnchor": "d5-a-blocked-item-never-blocks-anything-else",
          "stableAnchor": "h-24b809f6b20a"
        },
        {
          "level": 2,
          "text": "D6: the keyword-matching half was carved out entirely",
          "anchor": "d6-the-keyword-matching-half-was-carved-out-entirely",
          "githubAnchor": "d6-the-keyword-matching-half-was-carved-out-entirely",
          "stableAnchor": "h-8bc02a9cdbea"
        },
        {
          "level": 2,
          "text": "D8: a `warn`-level skip leaves a real, machine-tagged trail",
          "anchor": "d8-a-warn-level-skip-leaves-a-real-machine-tagged-trail",
          "githubAnchor": "d8-a-warn-level-skip-leaves-a-real-machine-tagged-trail",
          "stableAnchor": "h-58ce197b6b80"
        },
        {
          "level": 2,
          "text": "D5 landed (`tsk-1y6-3`): `merge-loop`/`merge-next` skip and continue, then batch-report",
          "anchor": "d5-landed-tsk-1y6-3-merge-loopmerge-next-skip-and-continue-then-batch-report",
          "githubAnchor": "d5-landed-tsk-1y6-3-merge-loopmerge-next-skip-and-continue-then-batch-report",
          "stableAnchor": "h-26cb0bfd6f58"
        },
        {
          "level": 2,
          "text": "Closing paperwork (`tsk-1y6-4`)",
          "anchor": "closing-paperwork-tsk-1y6-4",
          "githubAnchor": "closing-paperwork-tsk-1y6-4",
          "stableAnchor": "h-165660a0a6cd"
        },
        {
          "level": 2,
          "text": "D9: one `/fgOS:approve` skill, not two",
          "anchor": "d9-one-fgosapprove-skill-not-two",
          "githubAnchor": "d9-one-fgosapprove-skill-not-two",
          "stableAnchor": "h-91193bba2433"
        }
      ],
