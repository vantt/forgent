      "headings": [
        {
          "level": 1,
          "text": "Why judgeDiscovery/judgeDecompose run a second, independent judge pass on `verify`",
          "anchor": "why-judgediscoveryjudgedecompose-run-a-second-independent-judge-pass-on-verify",
