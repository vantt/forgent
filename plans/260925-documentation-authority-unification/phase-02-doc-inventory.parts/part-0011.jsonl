      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Why `mergeTree` groups by parent and sorts recursively by `blocks`",
          "anchor": "why-mergetree-groups-by-parent-and-sorts-recursively-by-blocks",
          "githubAnchor": "why-mergetree-groups-by-parent-and-sorts-recursively-by-blocks",
          "stableAnchor": "h-6f2073b556a9"
        },
        {
          "level": 2,
          "text": "Only one execution model exists — the tree reflects that, not a new mechanism",
          "anchor": "only-one-execution-model-exists-the-tree-reflects-that-not-a-new-mechanism",
          "githubAnchor": "only-one-execution-model-exists-the-tree-reflects-that-not-a-new-mechanism",
          "stableAnchor": "h-3a3d377a7ab9"
        },
        {
          "level": 2,
          "text": "The tree includes every bucket, not just `ready`",
          "anchor": "the-tree-includes-every-bucket-not-just-ready",
          "githubAnchor": "the-tree-includes-every-bucket-not-just-ready",
          "stableAnchor": "h-45b9e9e9ef8c"
        },
        {
          "level": 2,
          "text": "Bottleneck-priority sort is recursive, not top-level-only",
          "anchor": "bottleneck-priority-sort-is-recursive-not-top-level-only",
          "githubAnchor": "bottleneck-priority-sort-is-recursive-not-top-level-only",
          "stableAnchor": "h-0faea8c11605"
        },
        {
          "level": 2,
