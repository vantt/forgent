          "stableAnchor": "h-ccb84146ca3c"
        },
        {
          "level": 3,
          "text": "MEDIUM — no exclusive-create claim for the built Assignment (concurrent-race variant of the HIGH above)",
          "anchor": "medium-no-exclusive-create-claim-for-the-built-assignment-concurrent-race-variant-of-the-high-above",
          "githubAnchor": "medium-no-exclusive-create-claim-for-the-built-assignment-concurrent-race-variant-of-the-high-above",
          "stableAnchor": "h-ffbd74bc9ab1"
        },
        {
          "level": 3,
          "text": "LOW — Gaps item resolved, not a bug: `caller.writerId` \"only when absent\" is safe",
          "anchor": "low-gaps-item-resolved-not-a-bug-callerwriterid-only-when-absent-is-safe",
          "githubAnchor": "low-gaps-item-resolved-not-a-bug-callerwriterid-only-when-absent-is-safe",
          "stableAnchor": "h-14bf0e2a4dab"
        },
        {
          "level": 3,
          "text": "LOW — informational: unreadable-but-existing `--contract` file (the Doer's second Gaps question)",
          "anchor": "low-informational-unreadable-but-existing---contract-file-the-doers-second-gaps-question",
          "githubAnchor": "low-informational-unreadable-but-existing---contract-file-the-doers-second-gaps-question",
