      "claimKind": "unclassified",
      "headingCount": 11,
      "unheadedBlockCount": 30,
      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Why discover-loop's pool ordering and stop rules diverge from merge-loop's",
          "anchor": "why-discover-loops-pool-ordering-and-stop-rules-diverge-from-merge-loops",
          "githubAnchor": "why-discover-loops-pool-ordering-and-stop-rules-diverge-from-merge-loops",
          "stableAnchor": "h-6769fd27b89b"
        },
        {
          "level": 2,
          "text": "No existing pool function to reuse",
          "anchor": "no-existing-pool-function-to-reuse",
          "githubAnchor": "no-existing-pool-function-to-reuse",
          "stableAnchor": "h-1d93153f2416"
        },
        {
          "level": 2,
          "text": "Two different sort orders for the two sub-pools",
          "anchor": "two-different-sort-orders-for-the-two-sub-pools",
          "githubAnchor": "two-different-sort-orders-for-the-two-sub-pools",
          "stableAnchor": "h-519402bf39e9"
        },
        {
          "level": 2,
          "text": "Only `status:todo` items are eligible",
          "anchor": "only-statustodo-items-are-eligible",
          "githubAnchor": "only-statustodo-items-are-eligible",
          "stableAnchor": "h-934f6b692b3b"
        },
        {
          "level": 2,
          "text": "Eligibility also requires deps-readiness, or the picker hands back an id nobody can claim",
          "anchor": "eligibility-also-requires-deps-readiness-or-the-picker-hands-back-an-id-nobody-can-claim",
          "githubAnchor": "eligibility-also-requires-deps-readiness-or-the-picker-hands-back-an-id-nobody-can-claim",
          "stableAnchor": "h-c7bcd1970444"
        },
        {
          "level": 2,
          "text": "Stop rules — deliberately not \"same item blocked twice\"",
          "anchor": "stop-rules-deliberately-not-same-item-blocked-twice",
          "githubAnchor": "stop-rules-deliberately-not-same-item-blocked-twice",
          "stableAnchor": "h-b8808833c359"
        },
        {
          "level": 2,
          "text": "The lock-timeout signal broke silently when discover-next stopped being a CLI subprocess, then was restored end-to-end",
          "anchor": "the-lock-timeout-signal-broke-silently-when-discover-next-stopped-being-a-cli-subprocess-then-was-restored-end-to-end",
          "githubAnchor": "the-lock-timeout-signal-broke-silently-when-discover-next-stopped-being-a-cli-subprocess-then-was-restored-end-to-end",
          "stableAnchor": "h-2194be78766e"
        },
        {
          "level": 2,
          "text": "The loop never auto-chains past discover/decompose",
          "anchor": "the-loop-never-auto-chains-past-discoverdecompose",
          "githubAnchor": "the-loop-never-auto-chains-past-discoverdecompose",
          "stableAnchor": "h-18ea12a0f53b"
        },
        {
          "level": 2,
          "text": "No worktree/branch/merge machinery needed",
          "anchor": "no-worktreebranchmerge-machinery-needed",
          "githubAnchor": "no-worktreebranchmerge-machinery-needed",
          "stableAnchor": "h-32e8c028d0e0"
        },
        {
          "level": 2,
          "text": "Two independent judge layers, no coupling logic needed",
          "anchor": "two-independent-judge-layers-no-coupling-logic-needed",
          "githubAnchor": "two-independent-judge-layers-no-coupling-logic-needed",
          "stableAnchor": "h-e774851b5228"
        },
        {
          "level": 2,
          "text": "Herdr pane rename stayed deferred",
          "anchor": "herdr-pane-rename-stayed-deferred",
          "githubAnchor": "herdr-pane-rename-stayed-deferred",
          "stableAnchor": "h-59975919f3ed"
        }
      ],
