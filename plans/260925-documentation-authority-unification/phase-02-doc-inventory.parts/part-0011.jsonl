        {
          "level": 3,
          "text": "MEDIUM-1 — Dual-shape `buildAssignment()` dispatcher accepts ambiguous input silently instead of rejecting it",
          "anchor": "medium-1-dual-shape-buildassignment-dispatcher-accepts-ambiguous-input-silently-instead-of-rejecting-it",
          "githubAnchor": "medium-1-dual-shape-buildassignment-dispatcher-accepts-ambiguous-input-silently-instead-of-rejecting-it",
          "stableAnchor": "h-0848d56ffadb"
        },
        {
          "level": 3,
          "text": "MEDIUM-2 — `caller.writerId` is accepted as an arbitrary caller-supplied string with zero format/provenance verification",
          "anchor": "medium-2-callerwriterid-is-accepted-as-an-arbitrary-caller-supplied-string-with-zero-formatprovenance-verification",
          "githubAnchor": "medium-2-callerwriterid-is-accepted-as-an-arbitrary-caller-supplied-string-with-zero-formatprovenance-verification",
          "stableAnchor": "h-8493b2da97cf"
        },
        {
          "level": 3,
          "text": "LOW-1 — `KNOWN_MUTATING_OPS`/`READ_ONLY_OPS` promoted from call-scoped to shared exported module singletons",
          "anchor": "low-1-known_mutating_opsread_only_ops-promoted-from-call-scoped-to-shared-exported-module-singletons",
          "githubAnchor": "low-1-known_mutating_opsread_only_ops-promoted-from-call-scoped-to-shared-exported-module-singletons",
          "stableAnchor": "h-aefcca4d136f"
        },
        {
          "level": 3,
          "text": "LOW-2 — `isReadOnlyAssignment()`'s untouched `workId === null` heuristic will also catch every inline Assignment once R8 wires a live caller",
          "anchor": "low-2-isreadonlyassignments-untouched-workid-null-heuristic-will-also-catch-every-inline-assignment-once-r8-wires-a-live-caller",
          "githubAnchor": "low-2-isreadonlyassignments-untouched-workid-null-heuristic-will-also-catch-every-inline-assignment-once-r8-wires-a-live-caller",
          "stableAnchor": "h-65c49dd6eea7"
        },
        {
          "level": 3,
          "text": "Confirmed clean (primary scrutiny targets, verified rather than assumed)",
          "anchor": "confirmed-clean-primary-scrutiny-targets-verified-rather-than-assumed",
          "githubAnchor": "confirmed-clean-primary-scrutiny-targets-verified-rather-than-assumed",
          "stableAnchor": "h-a8f3ace2ffd3"
