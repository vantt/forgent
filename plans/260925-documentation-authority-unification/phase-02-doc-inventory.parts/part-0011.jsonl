      "headings": [
        {
          "level": 1,
          "text": "Why `mergeTree` groups by parent and sorts recursively by `blocks`",
          "anchor": "why-mergetree-groups-by-parent-and-sorts-recursively-by-blocks",
          "githubAnchor": "why-mergetree-groups-by-parent-and-sorts-recursively-by-blocks",
          "stableAnchor": "h-6f2073b556a9"
        },
        {
          "level": 2,
          "text": "Only one execution model exists — the tree reflects that, not a new mechanism",
          "anchor": "only-one-execution-model-exists-the-tree-reflects-that-not-a-new-mechanism",
          "githubAnchor": "only-one-execution-model-exists-the-tree-reflects-that-not-a-new-mechanism",
          "stableAnchor": "h-3a3d377a7ab9"
        },
        {
          "level": 2,
          "text": "The tree includes every bucket, not just `ready`",
          "anchor": "the-tree-includes-every-bucket-not-just-ready",
          "githubAnchor": "the-tree-includes-every-bucket-not-just-ready",
          "stableAnchor": "h-45b9e9e9ef8c"
        },
        {
          "level": 2,
          "text": "Bottleneck-priority sort is recursive, not top-level-only",
          "anchor": "bottleneck-priority-sort-is-recursive-not-top-level-only",
          "githubAnchor": "bottleneck-priority-sort-is-recursive-not-top-level-only",
          "stableAnchor": "h-0faea8c11605"
        },
        {
          "level": 2,
          "text": "Why the sort/tree logic lives in JS, never in herdr-plugin's Rust rendering",
          "anchor": "why-the-sorttree-logic-lives-in-js-never-in-herdr-plugins-rust-rendering",
          "githubAnchor": "why-the-sorttree-logic-lives-in-js-never-in-herdr-plugins-rust-rendering",
          "stableAnchor": "h-c576597c7dd9"
        },
        {
          "level": 2,
          "text": "`blockedOnSync` needed real wiring, not just a bare id",
          "anchor": "blockedonsync-needed-real-wiring-not-just-a-bare-id",
          "githubAnchor": "blockedonsync-needed-real-wiring-not-just-a-bare-id",
          "stableAnchor": "h-e4d172f68032"
        },
        {
          "level": 2,
          "text": "What stayed unchanged on purpose",
          "anchor": "what-stayed-unchanged-on-purpose",
          "githubAnchor": "what-stayed-unchanged-on-purpose",
          "stableAnchor": "h-e45a8f1123bc"
        },
        {
          "level": 2,
          "text": "Why herdr-plugin's Rust side only parses and paints the tree, never re-sorts it",
          "anchor": "why-herdr-plugins-rust-side-only-parses-and-paints-the-tree-never-re-sorts-it",
          "githubAnchor": "why-herdr-plugins-rust-side-only-parses-and-paints-the-tree-never-re-sorts-it",
          "stableAnchor": "h-bcc8b53f06d4"
        },
        {
          "level": 2,
          "text": "Related",
          "anchor": "related",
          "githubAnchor": "related",
          "stableAnchor": "h-d2c8407e7fcf"
        }
