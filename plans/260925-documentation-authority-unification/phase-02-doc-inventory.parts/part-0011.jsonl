        },
        {
          "level": 2,
          "text": "Method",
          "anchor": "method",
          "githubAnchor": "method",
          "stableAnchor": "h-8684f168cd19"
        },
        {
          "level": 2,
          "text": "HIGH-1 — Quorum read+close now hard-fails when protocol resolution fails, and the thrown type is not caught by any caller",
          "anchor": "high-1-quorum-readclose-now-hard-fails-when-protocol-resolution-fails-and-the-thrown-type-is-not-caught-by-any-caller",
          "githubAnchor": "high-1-quorum-readclose-now-hard-fails-when-protocol-resolution-fails-and-the-thrown-type-is-not-caught-by-any-caller",
          "stableAnchor": "h-0342f57e91b3"
        },
        {
          "level": 2,
          "text": "HIGH-2 — Version drift silently flips a completed actor to `missing`; the session becomes permanently unclosable",
          "anchor": "high-2-version-drift-silently-flips-a-completed-actor-to-missing-the-session-becomes-permanently-unclosable",
          "githubAnchor": "high-2-version-drift-silently-flips-a-completed-actor-to-missing-the-session-becomes-permanently-unclosable",
          "stableAnchor": "h-74330ad8c646"
        },
        {
          "level": 2,
          "text": "HIGH-3 — The report's central \"byte-for-byte unchanged\" claim is false",
          "anchor": "high-3-the-reports-central-byte-for-byte-unchanged-claim-is-false",
          "githubAnchor": "high-3-the-reports-central-byte-for-byte-unchanged-claim-is-false",
          "stableAnchor": "h-03c9069af730"
        },
        {
          "level": 2,
          "text": "HIGH-4 — Fixture cross-check missed 5 of 8 affected protocols, and the green suite is structurally blind to them",
          "anchor": "high-4-fixture-cross-check-missed-5-of-8-affected-protocols-and-the-green-suite-is-structurally-blind-to-them",
          "githubAnchor": "high-4-fixture-cross-check-missed-5-of-8-affected-protocols-and-the-green-suite-is-structurally-blind-to-them",
          "stableAnchor": "h-73037f8f4000"
        },
        {
          "level": 2,
          "text": "MEDIUM-5 — The aggregation exclusion is keyed on operation-id alone, and is unconditional on an aggregation actually existing",
          "anchor": "medium-5-the-aggregation-exclusion-is-keyed-on-operation-id-alone-and-is-unconditional-on-an-aggregation-actually-existing",
          "githubAnchor": "medium-5-the-aggregation-exclusion-is-keyed-on-operation-id-alone-and-is-unconditional-on-an-aggregation-actually-existing",
          "stableAnchor": "h-fda16325476f"
        },
        {
          "level": 2,
          "text": "MEDIUM-6 — Same operation id at two graph nodes is deduped: the original bug survives for the \"repeated operation across rounds\" shape",
          "anchor": "medium-6-same-operation-id-at-two-graph-nodes-is-deduped-the-original-bug-survives-for-the-repeated-operation-across-rounds-shape",
          "githubAnchor": "medium-6-same-operation-id-at-two-graph-nodes-is-deduped-the-original-bug-survives-for-the-repeated-operation-across-rounds-shape",
          "stableAnchor": "h-c91a6990732d"
        },
        {
          "level": 2,
          "text": "MEDIUM-7 — Uncached full-registry discovery added to a per-request hot path",
          "anchor": "medium-7-uncached-full-registry-discovery-added-to-a-per-request-hot-path",
          "githubAnchor": "medium-7-uncached-full-registry-discovery-added-to-a-per-request-hot-path",
          "stableAnchor": "h-3a6ed71dab67"
        },
        {
          "level": 2,
          "text": "LOW-8 — Liveness: a gated driver-authorized binding behind an unopenable window is a hard deadlock",
          "anchor": "low-8-liveness-a-gated-driver-authorized-binding-behind-an-unopenable-window-is-a-hard-deadlock",
          "githubAnchor": "low-8-liveness-a-gated-driver-authorized-binding-behind-an-unopenable-window-is-a-hard-deadlock",
          "stableAnchor": "h-1e058871fe7e"
        },
        {
          "level": 2,
          "text": "INFO-9 — Scope discipline on `test/verbs/coordination-aggregation-surface.test.mjs`",
          "anchor": "info-9-scope-discipline-on-testverbscoordination-aggregation-surfacetestmjs",
          "githubAnchor": "info-9-scope-discipline-on-testverbscoordination-aggregation-surfacetestmjs",
