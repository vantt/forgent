      "headings": [
        {
          "level": 1,
          "text": "How to use the `fgos-architecture-panel` skill",
          "anchor": "how-to-use-the-fgos-architecture-panel-skill",
          "githubAnchor": "how-to-use-the-fgos-architecture-panel-skill",
          "stableAnchor": "h-d61436cd4edb"
        },
        {
          "level": 2,
          "text": "You never write a request file yourself",
          "anchor": "you-never-write-a-request-file-yourself",
          "githubAnchor": "you-never-write-a-request-file-yourself",
          "stableAnchor": "h-6e8ca2d1f855"
        },
        {
          "level": 2,
          "text": "The platform's default round cap is too low for this protocol — raise it",
          "anchor": "the-platforms-default-round-cap-is-too-low-for-this-protocol-raise-it",
          "githubAnchor": "the-platforms-default-round-cap-is-too-low-for-this-protocol-raise-it",
          "stableAnchor": "h-3e8b1d210668"
        },
        {
          "level": 2,
          "text": "`actors[]` is per-call — it does not persist across a resumed session",
          "anchor": "actors-is-per-call-it-does-not-persist-across-a-resumed-session",
          "githubAnchor": "actors-is-per-call-it-does-not-persist-across-a-resumed-session",
          "stableAnchor": "h-6c507c0ff3eb"
        },
        {
          "level": 2,
          "text": "Do you need to know the CLI at all?",
          "anchor": "do-you-need-to-know-the-cli-at-all",
          "githubAnchor": "do-you-need-to-know-the-cli-at-all",
          "stableAnchor": "h-0ac4e7b2ced6"
        },
        {
          "level": 2,
          "text": "What you'll see, phase by phase",
          "anchor": "what-youll-see-phase-by-phase",
          "githubAnchor": "what-youll-see-phase-by-phase",
          "stableAnchor": "h-c2078a00f15c"
        },
        {
          "level": 2,
          "text": "Decision Dialogue — how you keep talking after the explanation lands",
          "anchor": "decision-dialogue-how-you-keep-talking-after-the-explanation-lands",
          "githubAnchor": "decision-dialogue-how-you-keep-talking-after-the-explanation-lands",
          "stableAnchor": "h-dc4f6ec02d83"
        },
        {
          "level": 2,
          "text": "Resuming a session later — proven, not asserted",
          "anchor": "resuming-a-session-later-proven-not-asserted",
          "githubAnchor": "resuming-a-session-later-proven-not-asserted",
          "stableAnchor": "h-82b3ec4ec6f2"
        },
        {
          "level": 2,
          "text": "Do you need a new use-case or CLI verb for any of this?",
          "anchor": "do-you-need-a-new-use-case-or-cli-verb-for-any-of-this",
          "githubAnchor": "do-you-need-a-new-use-case-or-cli-verb-for-any-of-this",
          "stableAnchor": "h-09c84b777d70"
        },
        {
          "level": 2,
          "text": "Executor roster — never one collapsed provider",
          "anchor": "executor-roster-never-one-collapsed-provider",
          "githubAnchor": "executor-roster-never-one-collapsed-provider",
          "stableAnchor": "h-fd56abb3f664"
        },
        {
          "level": 2,
          "text": "Related",
          "anchor": "related",
          "githubAnchor": "related",
          "stableAnchor": "h-43a8e8fc8f7d"
        }
