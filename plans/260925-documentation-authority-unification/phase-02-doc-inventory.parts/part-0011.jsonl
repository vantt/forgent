      "headings": [
        {
          "level": 1,
          "text": "Poll fgOS CLI data from a Rust plugin",
          "anchor": "poll-fgos-cli-data-from-a-rust-plugin",
          "githubAnchor": "poll-fgos-cli-data-from-a-rust-plugin",
          "stableAnchor": "h-ba29258c0752"
        },
        {
          "level": 2,
          "text": "1. Never spawn the `fgos` shell function",
          "anchor": "1-never-spawn-the-fgos-shell-function",
          "githubAnchor": "1-never-spawn-the-fgos-shell-function",
          "stableAnchor": "h-a4ba7c9991ef"
        },
        {
          "level": 2,
          "text": "2. Resolve the repo root the same way every fgOS skill does",
          "anchor": "2-resolve-the-repo-root-the-same-way-every-fgos-skill-does",
          "githubAnchor": "2-resolve-the-repo-root-the-same-way-every-fgos-skill-does",
          "stableAnchor": "h-8c38150a4e37"
        },
        {
          "level": 2,
          "text": "3. Parse only the envelope shape you actually need",
          "anchor": "3-parse-only-the-envelope-shape-you-actually-need",
          "githubAnchor": "3-parse-only-the-envelope-shape-you-actually-need",
          "stableAnchor": "h-e187dcba7e64"
        },
        {
          "level": 2,
          "text": "4. Test parsing against fixture JSON, never a live CLI call",
          "anchor": "4-test-parsing-against-fixture-json-never-a-live-cli-call",
          "githubAnchor": "4-test-parsing-against-fixture-json-never-a-live-cli-call",
          "stableAnchor": "h-9eea4e59faaa"
        },
        {
          "level": 2,
          "text": "5. A poll failure must never blank an already-populated screen",
          "anchor": "5-a-poll-failure-must-never-blank-an-already-populated-screen",
          "githubAnchor": "5-a-poll-failure-must-never-blank-an-already-populated-screen",
          "stableAnchor": "h-5f078e309efe"
        },
        {
          "level": 2,
          "text": "6. A single-threaded ratatui loop can still poll on an interval",
          "anchor": "6-a-single-threaded-ratatui-loop-can-still-poll-on-an-interval",
          "githubAnchor": "6-a-single-threaded-ratatui-loop-can-still-poll-on-an-interval",
          "stableAnchor": "h-972cfc09de13"
        }
      ],
