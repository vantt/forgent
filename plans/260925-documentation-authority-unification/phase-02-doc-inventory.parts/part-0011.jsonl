          "githubAnchor": "1-what-this-cell-was-asked-to-prove-and-what-it-actually-found",
          "stableAnchor": "h-93f36e893015"
        },
        {
          "level": 3,
          "text": "Gap 1 — no step kind reaches `linkSessionContribution` at all",
          "anchor": "gap-1-no-step-kind-reaches-linksessioncontribution-at-all",
          "githubAnchor": "gap-1-no-step-kind-reaches-linksessioncontribution-at-all",
          "stableAnchor": "h-c4fe074df532"
        },
