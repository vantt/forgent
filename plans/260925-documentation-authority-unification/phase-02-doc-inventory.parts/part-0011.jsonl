          "stableAnchor": "h-ae3f37e54448"
        },
        {
          "level": 3,
          "text": "V-001: Agent Coordination Is A Foundation Layer",
          "anchor": "v-001-agent-coordination-is-a-foundation-layer",
          "githubAnchor": "v-001-agent-coordination-is-a-foundation-layer",
          "stableAnchor": "h-cb2a02b857c5"
        },
        {
          "level": 3,
          "text": "V-002: Work Is Optional Integration, Not System Identity",
