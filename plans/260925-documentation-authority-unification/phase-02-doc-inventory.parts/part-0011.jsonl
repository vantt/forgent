          "level": 2,
          "text": "The other hard rule this item enforced: never edit the superseded doc's body",
          "anchor": "the-other-hard-rule-this-item-enforced-never-edit-the-superseded-docs-body",
          "githubAnchor": "the-other-hard-rule-this-item-enforced-never-edit-the-superseded-docs-body",
          "stableAnchor": "h-d20a1efea416"
        },
        {
          "level": 2,
          "text": "The list broke a checker that assumed a scalar (`tsk-18t`)",
          "anchor": "the-list-broke-a-checker-that-assumed-a-scalar-tsk-18t",
          "githubAnchor": "the-list-broke-a-checker-that-assumed-a-scalar-tsk-18t",
          "stableAnchor": "h-67a0a153e870"
        },
        {
          "level": 2,
          "text": "The twice-superseded record's own index row was still missing (`tsk-55h`)",
          "anchor": "the-twice-superseded-records-own-index-row-was-still-missing-tsk-55h",
          "githubAnchor": "the-twice-superseded-records-own-index-row-was-still-missing-tsk-55h",
          "stableAnchor": "h-482421b8345a"
        },
        {
          "level": 2,
          "text": "A `supersedes:` target can be a capture hash, not just a decision id (`tsk-55h`)",
          "anchor": "a-supersedes-target-can-be-a-capture-hash-not-just-a-decision-id-tsk-55h",
          "githubAnchor": "a-supersedes-target-can-be-a-capture-hash-not-just-a-decision-id-tsk-55h",
          "stableAnchor": "h-afff0f40dc0e"
        },
        {
          "level": 2,
          "text": "Related",
          "anchor": "related",
          "githubAnchor": "related",
          "stableAnchor": "h-0fa05ca0a2f8"
        }
