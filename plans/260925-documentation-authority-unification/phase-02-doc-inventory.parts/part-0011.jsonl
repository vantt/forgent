      "identityStatus": "carried-forward",
      "sourceDigest": "8e5f3014ed36106cfa16d4d2416d6be4c8e2798e7b465d11e8295e5a4371545b",
      "blobSha": "dba1bcba6987a4798b06bbdc75666d53cdf7a2d9",
      "blobSize": 6934,
      "area": "End-user authoring, index, and knowledge registry",
      "authorityStatus": "non-authority",
      "fileClass": "maintained-authority",
      "corpus": "user-knowledge",
      "switchboardSource": "scopedRoute",
      "gap": false,
      "documentType": null,
      "claimKind": "unclassified",
      "headingCount": 10,
      "unheadedBlockCount": 31,
      "mixedFileBlockCount": 0,
      "headings": [
        {
          "level": 1,
          "text": "Scaffold and link a herdr plugin",
          "anchor": "scaffold-and-link-a-herdr-plugin",
          "githubAnchor": "scaffold-and-link-a-herdr-plugin",
          "stableAnchor": "h-5a64b68088e3"
        },
        {
          "level": 2,
          "text": "1. Put the crate at the repo top level, not under `plugins/`",
          "anchor": "1-put-the-crate-at-the-repo-top-level-not-under-plugins",
          "githubAnchor": "1-put-the-crate-at-the-repo-top-level-not-under-plugins",
          "stableAnchor": "h-56d10b4969a3"
        },
        {
          "level": 2,
          "text": "2. First slice: mock data only, no external polling",
          "anchor": "2-first-slice-mock-data-only-no-external-polling",
          "githubAnchor": "2-first-slice-mock-data-only-no-external-polling",
          "stableAnchor": "h-108fe539ae70"
        },
        {
          "level": 2,
          "text": "3. Match the host application's own dependency versions",
          "anchor": "3-match-the-host-applications-own-dependency-versions",
          "githubAnchor": "3-match-the-host-applications-own-dependency-versions",
          "stableAnchor": "h-0f2dab59399d"
        },
        {
          "level": 2,
          "text": "4. Give the crate both a lib and a bin target",
          "anchor": "4-give-the-crate-both-a-lib-and-a-bin-target",
          "githubAnchor": "4-give-the-crate-both-a-lib-and-a-bin-target",
          "stableAnchor": "h-54b01fd1520c"
        },
        {
          "level": 2,
          "text": "5. Watch the `Backend::Error` vs `io::Error` mismatch",
          "anchor": "5-watch-the-backenderror-vs-ioerror-mismatch",
          "githubAnchor": "5-watch-the-backenderror-vs-ioerror-mismatch",
          "stableAnchor": "h-559450efee03"
        },
        {
          "level": 2,
          "text": "6. Prove the render doesn't panic with `TestBackend`",
          "anchor": "6-prove-the-render-doesnt-panic-with-testbackend",
          "githubAnchor": "6-prove-the-render-doesnt-panic-with-testbackend",
          "stableAnchor": "h-e38c24a97985"
        },
        {
          "level": 2,
          "text": "7. Write the manifest's `[[panes]]` command as `sh -c \"$HERDR_PLUGIN_ROOT/...\"`, never a bare relative path",
          "anchor": "7-write-the-manifests-panes-command-as-sh--c-herdr_plugin_root-never-a-bare-relative-path",
          "githubAnchor": "7-write-the-manifests-panes-command-as-sh--c-herdr_plugin_root-never-a-bare-relative-path",
          "stableAnchor": "h-3ae63db4820d"
        },
        {
          "level": 2,
          "text": "8. Build, test, link, then actually open the pane",
          "anchor": "8-build-test-link-then-actually-open-the-pane",
          "githubAnchor": "8-build-test-link-then-actually-open-the-pane",
          "stableAnchor": "h-6c5616d668df"
        },
        {
          "level": 2,
          "text": "Ignore the build output directory",
          "anchor": "ignore-the-build-output-directory",
          "githubAnchor": "ignore-the-build-output-directory",
          "stableAnchor": "h-f336b5cb7149"
        }
      ],
