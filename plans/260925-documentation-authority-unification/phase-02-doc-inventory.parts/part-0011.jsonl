          "anchor": "what-changed",
          "githubAnchor": "what-changed",
          "stableAnchor": "h-40028adff8c7"
        },
        {
          "level": 2,
          "text": "The formula (`src/state/priority-formula.mjs`, pure)",
          "anchor": "the-formula-srcstatepriority-formulamjs-pure",
          "githubAnchor": "the-formula-srcstatepriority-formulamjs-pure",
          "stableAnchor": "h-80e93d337f0c"
        },
        {
          "level": 2,
          "text": "Two compute points",
          "anchor": "two-compute-points",
          "githubAnchor": "two-compute-points",
          "stableAnchor": "h-ae01ec40e285"
        },
        {
          "level": 2,
          "text": "`risksGate` gains an independent blast-radius gate (Phase C)",
          "anchor": "risksgate-gains-an-independent-blast-radius-gate-phase-c",
          "githubAnchor": "risksgate-gains-an-independent-blast-radius-gate-phase-c",
          "stableAnchor": "h-308e1df9734b"
        },
        {
          "level": 2,
          "text": "Real capture (this item's own outcome/settlement, per `fgos check tsk-4y5`)",
          "anchor": "real-capture-this-items-own-outcomesettlement-per-fgos-check-tsk-4y5",
          "githubAnchor": "real-capture-this-items-own-outcomesettlement-per-fgos-check-tsk-4y5",
          "stableAnchor": "h-79354f225247"
        },
        {
          "level": 2,
          "text": "Real-world finding: two of three axes were nearly degenerate in practice (`tsk-4hb`)",
          "anchor": "real-world-finding-two-of-three-axes-were-nearly-degenerate-in-practice-tsk-4hb",
          "githubAnchor": "real-world-finding-two-of-three-axes-were-nearly-degenerate-in-practice-tsk-4hb",
          "stableAnchor": "h-9297c3839e7e"
        },
        {
          "level": 2,
          "text": "Real-world finding: 69% of scored items collapsed to the worst priority value (`tsk-1r3`)",
          "anchor": "real-world-finding-69-of-scored-items-collapsed-to-the-worst-priority-value-tsk-1r3",
