        {
          "level": 1,
          "text": "Why a retired stage name sometimes keeps a drain-only alias",
          "anchor": "why-a-retired-stage-name-sometimes-keeps-a-drain-only-alias",
          "githubAnchor": "why-a-retired-stage-name-sometimes-keeps-a-drain-only-alias",
          "stableAnchor": "h-7bd87d32ff77"
        },
        {
          "level": 2,
          "text": "The two options, and what decides between them",
          "anchor": "the-two-options-and-what-decides-between-them",
          "githubAnchor": "the-two-options-and-what-decides-between-them",
          "stableAnchor": "h-cd8f6c77fd53"
        },
        {
          "level": 2,
          "text": "Why the missing `stepMap` entry is the right lever",
          "anchor": "why-the-missing-stepmap-entry-is-the-right-lever",
          "githubAnchor": "why-the-missing-stepmap-entry-is-the-right-lever",
          "stableAnchor": "h-2525ea62522b"
        },
        {
          "level": 2,
          "text": "The opposite call, on the same kind of change",
          "anchor": "the-opposite-call-on-the-same-kind-of-change",
          "githubAnchor": "the-opposite-call-on-the-same-kind-of-change",
          "stableAnchor": "h-405aa0810530"
        },
        {
          "level": 3,
          "text": "Why `clarify` had somewhere to migrate *to*",
          "anchor": "why-clarify-had-somewhere-to-migrate-to",
          "githubAnchor": "why-clarify-had-somewhere-to-migrate-to",
          "stableAnchor": "h-e098ca1adb41"
        },
        {
          "level": 3,
          "text": "The forcing reason: domain has to be known before a stage does",
          "anchor": "the-forcing-reason-domain-has-to-be-known-before-a-stage-does",
          "githubAnchor": "the-forcing-reason-domain-has-to-be-known-before-a-stage-does",
          "stableAnchor": "h-b1e04727bef8"
        },
        {
          "level": 2,
          "text": "Verdict values are not stage names",
          "anchor": "verdict-values-are-not-stage-names",
          "githubAnchor": "verdict-values-are-not-stage-names",
          "stableAnchor": "h-58f589596f5a"
        },
        {
          "level": 2,
          "text": "Which skills take a domain prefix, and which never do",
          "anchor": "which-skills-take-a-domain-prefix-and-which-never-do",
          "githubAnchor": "which-skills-take-a-domain-prefix-and-which-never-do",
          "stableAnchor": "h-2000525cda23"
        },
        {
          "level": 2,
          "text": "The same alias policy governs spec-doc prose, not just code",
          "anchor": "the-same-alias-policy-governs-spec-doc-prose-not-just-code",
          "githubAnchor": "the-same-alias-policy-governs-spec-doc-prose-not-just-code",
          "stableAnchor": "h-883a5c34a7bf"
        }
      ],
