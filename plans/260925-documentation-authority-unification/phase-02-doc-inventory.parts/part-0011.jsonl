      "headings": [
        {
          "level": 1,
          "text": "Why skill prose had to match the worktree-isolated environment it runs in",
          "anchor": "why-skill-prose-had-to-match-the-worktree-isolated-environment-it-runs-in",
          "githubAnchor": "why-skill-prose-had-to-match-the-worktree-isolated-environment-it-runs-in",
          "stableAnchor": "h-c752bf5b3259"
        },
        {
          "level": 2,
          "text": "Friction 1: `approve` refuses to run from where `pick` just put the session",
          "anchor": "friction-1-approve-refuses-to-run-from-where-pick-just-put-the-session",
          "githubAnchor": "friction-1-approve-refuses-to-run-from-where-pick-just-put-the-session",
          "stableAnchor": "h-4d7575fdc3aa"
        },
        {
          "level": 2,
          "text": "Friction 2: the harness's own worktree-isolation guard refuses the exact command shape four skills prescribed",
          "anchor": "friction-2-the-harnesss-own-worktree-isolation-guard-refuses-the-exact-command-shape-four-skills-prescribed",
          "githubAnchor": "friction-2-the-harnesss-own-worktree-isolation-guard-refuses-the-exact-command-shape-four-skills-prescribed",
          "stableAnchor": "h-56460b8f3cd9"
        },
        {
          "level": 2,
          "text": "Why both frictions share one root cause",
          "anchor": "why-both-frictions-share-one-root-cause",
          "githubAnchor": "why-both-frictions-share-one-root-cause",
          "stableAnchor": "h-5cca0fabaeda"
        },
        {
          "level": 2,
          "text": "Scope boundary: related items, deliberately not merged in",
          "anchor": "scope-boundary-related-items-deliberately-not-merged-in",
          "githubAnchor": "scope-boundary-related-items-deliberately-not-merged-in",
          "stableAnchor": "h-1d1def43629d"
        }
      ],
