          "githubAnchor": "10-info-red-team-5e-the-disposition-value-enum-stated-as-a-modeling-choice",
          "stableAnchor": "h-651fbc00c225"
        },
        {
          "level": 3,
          "text": "11. Documentation only (Red-Team 2b) — the definition-pinning residual is WORSE at this door",
          "anchor": "11-documentation-only-red-team-2b-the-definition-pinning-residual-is-worse-at-this-door",
          "githubAnchor": "11-documentation-only-red-team-2b-the-definition-pinning-residual-is-worse-at-this-door",
