      "headings": [
        {
          "level": 1,
          "text": "Why `fgos add` items landed permanently at stage `executing`, with no path back",
          "anchor": "why-fgos-add-items-landed-permanently-at-stage-executing-with-no-path-back",
          "githubAnchor": "why-fgos-add-items-landed-permanently-at-stage-executing-with-no-path-back",
          "stableAnchor": "h-ea327cdd3077"
        },
        {
          "level": 2,
          "text": "The mechanism",
          "anchor": "the-mechanism",
          "githubAnchor": "the-mechanism",
          "stableAnchor": "h-4df84d2a201e"
        },
        {
          "level": 2,
          "text": "Why this wasn't a rare edge case",
          "anchor": "why-this-wasnt-a-rare-edge-case",
          "githubAnchor": "why-this-wasnt-a-rare-edge-case",
          "stableAnchor": "h-2cc76b294f7f"
        },
        {
          "level": 2,
          "text": "The fix: change the default going forward, never add a back-edge",
          "anchor": "the-fix-change-the-default-going-forward-never-add-a-back-edge",
          "githubAnchor": "the-fix-change-the-default-going-forward-never-add-a-back-edge",
          "stableAnchor": "h-426641d37852"
        },
        {
          "level": 2,
          "text": "Why a back-edge was considered and rejected",
          "anchor": "why-a-back-edge-was-considered-and-rejected",
          "githubAnchor": "why-a-back-edge-was-considered-and-rejected",
          "stableAnchor": "h-4cb958a43264"
        },
        {
          "level": 2,
          "text": "Scoping the one-time fix down further: only 1 of 26 items actually qualified",
          "anchor": "scoping-the-one-time-fix-down-further-only-1-of-26-items-actually-qualified",
          "githubAnchor": "scoping-the-one-time-fix-down-further-only-1-of-26-items-actually-qualified",
          "stableAnchor": "h-2836bc008fa1"
        },
        {
          "level": 2,
          "text": "A related but distinct gap (`tsk-4zj`): even a correctly-defaulted stage was invisible on read",
          "anchor": "a-related-but-distinct-gap-tsk-4zj-even-a-correctly-defaulted-stage-was-invisible-on-read",
          "githubAnchor": "a-related-but-distinct-gap-tsk-4zj-even-a-correctly-defaulted-stage-was-invisible-on-read",
          "stableAnchor": "h-e8f4777fb78b"
        }
