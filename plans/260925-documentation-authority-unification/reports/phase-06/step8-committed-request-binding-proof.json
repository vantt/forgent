  "reproduction": "import fs from 'node:fs';import assert from 'node:assert/strict';import crypto from 'node:crypto';import {execFileSync as exec} from 'node:child_process';\nconst root=process.cwd(),R='plans/260925-documentation-authority-unification/reports/phase-06/',read=p=>JSON.parse(fs.readFileSync(p)),request=read(R+'review-request-261015-1526-specs-ui-reworks-main-recarry.md.json'),gen=await import(root+'/scripts/generate-doc-inventory.mjs'),cache=new Map(),sha=s=>crypto.createHash('sha256').update(s).digest('hex');\nfunction units(p){if(!cache.has(p)){const text=exec('git',['show','7854cff84:'+p],{encoding:'utf8',maxBuffer:20e6}),ls=text.split('\\n'),heads=[],us=p.endsWith('.md')?gen.extractMarkdownConservationUnits(text):gen.extractMixedFileConservationUnit(p,text);cache.set(p,us.map((u,i)=>{if(u.unitKind==='heading')while(heads.length&&heads.at(-1).level>=u.level)heads.pop();const ancestry=heads.map(h=>h.title);if(u.unitKind==='heading')heads.push(u);return {...u,ancestry,text:ls.slice(u.startLine-1,u.endLine).join('\\n').trim(),sectionText:ls.slice(u.startLine-1,u.unitKind==='heading'?(us.slice(i+1).find(o=>o.unitKind==='heading')?.startLine-1||ls.length):u.endLine).join('\\n').trim()};}));}return cache.get(p);}\nconst results=[];for(const [p,digest]of Object.entries(request.docsSHA256)){assert.equal(sha(fs.readFileSync(p)),digest);assert.equal(sha(exec('git',['show','7854cff84:'+p],{maxBuffer:20e6})),digest);}\nfor(const e of request.entries){const result={entryId:e.entryId,channel:e.channel};if(e.decision){const s=read(e.shard),d=[...s.claims||[],...s.registryGaps||[]].find(d=>d.claimId===e.entryId);assert.deepEqual(d,e.decision);const u=units(d.targetOwner).find(u=>u.anchor===d.targetAnchor);assert(u,e.entryId);assert.equal(u.textDigest,d.targetUnitDigest);if(d.targetAncestry)assert.deepEqual(u.ancestry,d.targetAncestry);if(e.afterTarget){assert.equal(u.text,e.afterTarget.text);assert.equal(u.textDigest,e.afterTarget.textDigest);if(e.afterTarget.sectionText)assert.equal(u.sectionText,e.afterTarget.sectionText);}if(e.channel!=='predecessor-accounting-rebinding'){const source=units(e.sourcePath).find(u=>u.anchor===e.sourceAnchor);assert(source);assert.equal(source.textDigest,e.sourceDigest);}result.currentDecisionAndTextEqual=true;}\nif(e.channel==='changed-target-unit'){const u=units(e.path).find(u=>u.anchor===e.anchor);assert(u);assert.equal(u.textDigest,e.afterDigest);assert.equal(u.text,e.after.text);if(e.after.sectionText)assert.equal(u.sectionText,e.after.sectionText);result.currentChangedUnitEqual=true;}results.push(result);}\nfs.writeFileSync(R+'step8-committed-request-binding-proof.json',JSON.stringify({contentCommit:'7854cff84d8bcb67075d4f9c09cd0b6d04808ff4',count:results.length,docsSHA256Equal:true,allShownCurrentDecisionAndTargetTextEqual:true,entries:results,reproduction:fs.readFileSync('/tmp/fgos-work/step8-7854cff84/bindings.mjs','utf8')},null,2)+'\\n');console.log('PASS',results.length);\n"
