  "cacheHelperSource": "import fs from 'node:fs';import v8 from 'node:v8';import crypto from 'node:crypto';import assert from 'node:assert/strict';\nconst dir='/tmp/fgos-work/step9-native-cache/';\nexport function save(inv){fs.mkdirSync(dir,{recursive:true});const manifest={version:1,commit:inv.commit,fields:[]};let n=0;for(const [key,value]of Object.entries(inv)){const chunks=[];const values=Array.isArray(value)?Array.from({length:Math.ceil(value.length/256)},(_,i)=>value.slice(i*256,(i+1)*256)):[value];for(const part of values){const file=String(n++)+'.bin';let bytes=v8.serialize(part);fs.writeFileSync(dir+file,bytes);chunks.push({file,bytes:bytes.length,sha256:crypto.createHash('sha256').update(bytes).digest('hex')});bytes=null;if(chunks.length%8===0)global.gc?.();}manifest.fields.push({key,array:Array.isArray(value),length:Array.isArray(value)?value.length:null,chunks});global.gc?.();}fs.writeFileSync(dir+'manifest.json',JSON.stringify(manifest));return manifest;}\nexport function load(fields=null){const manifest=JSON.parse(fs.readFileSync(dir+'manifest.json')),inv={};for(const f of manifest.fields){if(fields&&!fields.includes(f.key))continue;if(f.array)inv[f.key]=[];for(const c of f.chunks){let bytes=fs.readFileSync(dir+c.file);assert.equal(bytes.length,c.bytes);assert.equal(crypto.createHash('sha256').update(bytes).digest('hex'),c.sha256);const part=v8.deserialize(bytes);bytes=null;if(f.array)inv[f.key].push(...part);else inv[f.key]=part;if(Number(c.file.split('.')[0])%2048===0)global.gc?.();}if(f.array)assert.equal(inv[f.key].length,f.length);global.gc?.();}return inv;}\n",
