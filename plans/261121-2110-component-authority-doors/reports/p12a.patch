+            Some("--root given more than once")
+        );
+        // A repeated switch keeps every use, so the stray word between them is still refused.
+        assert_eq!(
+            refused(&["--workspace-only", "junk", "--workspace-only"]).as_deref(),
+            Some("unknown argument junk")
+        );
+    }
