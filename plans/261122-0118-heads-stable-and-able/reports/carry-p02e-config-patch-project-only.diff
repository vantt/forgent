 }
+
+#[test]
+fn patch_project_only_proof() {
+    let fixture = common::fixture("scope.v1.json");
+    let schema_files = files(&fixture["cases"][0]["input"]["schemas"], true);
+    let schemas = Schemas::parse(&refs(&schema_files)).unwrap();
+    let rows = fixture["patch-project-only"]
+        .as_array()
+        .expect("patch-project-only array in scope.v1.json");
+    assert_eq!(rows.len(), 4);
+    for row in rows {
+        let id = row["id"].as_str().unwrap();
+        let why = row["why"].as_str().unwrap();
+        let path_text = row["path"].as_str().unwrap();
+        let global = row["global"].as_bool().unwrap();
+        let want = row["expect"].as_str();
+
+        let path = fgos_yaml_doc::path::parse_path(path_text).unwrap();
+        let got = if global {
+            Some("patch-project-only")
+        } else {
+            let target = match schemas.resolve(&path) {
+                Some(node) => match (node.file, node.scope) {
+                    ("accounts", _) => SourceKind::Accounts,
+                    (_, "global-only") => SourceKind::Global,
+                    _ => SourceKind::Project,
+                },
+                None => SourceKind::Project,
+            };
+            if target != SourceKind::Project {
+                Some("patch-project-only")
+            } else {
+                None
+            }
+        };
+
+        assert_eq!(got, want, "{id}: {why}");
+    }
+}
