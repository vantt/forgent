+                .unwrap_or(target_branch)
+        );
+        let mut worktrees = Vec::new();
+        let mut cursor = None;
+        loop {
+            match self.ports.git.list_worktrees(self.ports.repo, cursor, 4096) {
+                Ok(page) => {
+                    worktrees.extend(page.entries);
+                    if page.complete {
+                        break;
+                    }
+                    cursor = page.next_cursor;
+                }
+                Err(_) => break,
+            }
