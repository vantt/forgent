+                let wt_path = Path::new(&wt_path_str);
+                match remove(wt_path, &target_ref) {
+                    Ok(()) => {
+                        outcome.worktrees_removed.push(wt_path_str);
+                    }
+                    Err(code) => {
+                        outcome.worktrees_kept.push(KeptWorktree {
+                            path: wt_path_str,
+                            code,
+                        });
+                    }
