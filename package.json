{
  "name": "forgent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fgos": "bin/fgos.mjs",
    "fgos-runner": "bin/fgos-runner.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "core",
    "domains",
    ".agents",
    "README.md",
    "LICENSE",
    "docs/how-to",
    "docs/explanation",
    "docs/enduser-docs-index.json"
  ],
  "scripts": {
    "test": "FGOS_DISABLE_OPPORTUNISTIC_CHECKS=1 node --test 'test/**/*.test.mjs'",
    "setup:hooks": "node scripts/install-git-hooks.mjs",
    "cli": "node bin/fgos.mjs",
    "build:skills": "node scripts/build-skill-wrappers.mjs"
  },
  "exports": {
    "./state/porting": "./src/state/porting.mjs",
    "./state/porting-store": "./src/state/porting-store.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
