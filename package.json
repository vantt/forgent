{
  "name": "forgent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fgos": "bin/fgos.mjs",
    "fgos-runner": "bin/fgos-runner.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "core",
    "domains",
    ".agents",
    "README.md",
    "LICENSE",
    "docs/how-to",
    "docs/explanation",
    "docs/enduser-docs-index.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:select:plan": "node scripts/test-select.mjs",
    "test:select:compare": "node scripts/test-select-compare.mjs",
    "test:select:mutate": "node scripts/test-select-mutate.mjs",
    "test:select:promote": "node scripts/test-select-promote.mjs",
    "test:select:coverage-map": "node scripts/test-select-coverage-map.mjs",
    "test:ownership:lint": "node scripts/test-ownership-lint.mjs",
    "test:canary": "node scripts/run-test-canary.mjs",
    "test:related": "node scripts/test-select.mjs",
    "test:related:shadow": "node scripts/test-select.mjs --shadow",
    "release:check": "node scripts/prepare-release.mjs --dry-run",
    "release:prepare": "node scripts/prepare-release.mjs",
    "setup:hooks": "node scripts/install-git-hooks.mjs",
    "cli": "node bin/fgos.mjs",
    "build:skills": "node scripts/build-skill-wrappers.mjs"
  },
  "exports": {
    "./state/porting": "./src/state/porting.mjs",
    "./state/porting-store": "./src/state/porting-store.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
