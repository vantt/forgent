{
  "contract": "convention.rules.v1",
  "errorCodes": [
    "invalid-kind",
    "invalid-type",
    "invalid-slug",
    "invalid-at",
    "invalid-plan-dir",
    "invalid-rule-shape",
    "pattern-mismatch",
    "invalid-timestamp",
    "wrong-location",
    "unknown-kind",
    "invalid-path"
  ],
  "rules": [
    {
      "id": "report",
      "kind": "report",
      "shape": "name-template",
      "template": "{type}-{YYMMDD-HHMM}-{slug}.md",
      "roots": ["plans/reports/"],
      "planRootTemplate": "plans/{plan}/reports/",
      "scope": ["plans/reports/*.md"],
      "posture": "warn",
      "cutoff": "3faf81996",
      "compatibility": ["suffix-report", "type-GH-number"],
      "canonical": false,
      "metadataExempt": true,
      "generated": false,
      "requiredMetadataFields": []
    },
    {
      "id": "plan",
      "kind": "plan",
      "shape": "name-template",
      "template": "{YYMMDD-HHMM}-{slug}",
      "roots": ["plans/"],
      "scope": [],
      "posture": "warn",
      "cutoff": "3faf81996",
      "compatibility": [],
      "canonical": false,
      "metadataExempt": true,
      "generated": false,
      "requiredMetadataFields": []
    },
    {
      "id": "journal",
      "kind": "journal",
      "shape": "name-template",
      "template": "journal-{YYMMDD-HHMM}-{slug}.md",
      "roots": ["plans/journals/"],
      "scope": ["plans/journals/*.md"],
      "posture": "warn",
      "cutoff": "3faf81996",
      "compatibility": ["YYYY-MM-DD-slug"],
      "canonical": false,
      "metadataExempt": true,
      "generated": false,
      "requiredMetadataFields": []
    },
    {
      "id": "fixture-singleton",
      "kind": "fixture-singleton",
      "shape": "placement-glob",
      "glob": "fixtures/<area>/spec.md",
      "cardinality": "singleton",
      "roots": ["fixtures/"],
      "scope": ["fixtures/**"],
      "posture": "warn",
      "compatibility": [],
      "canonical": false,
      "metadataExempt": true,
      "generated": false,
      "requiredMetadataFields": []
    },
    {
      "id": "fixture-collection",
      "kind": "fixture-collection",
      "shape": "placement-glob",
      "glob": "fixtures/<area>/contracts/**",
      "cardinality": "collection",
      "roots": ["fixtures/"],
      "scope": ["fixtures/**"],
      "posture": "warn",
      "compatibility": [],
      "canonical": false,
      "metadataExempt": true,
      "generated": false,
      "requiredMetadataFields": []
    }
  ],
  "identifiers": [
    {
      "id": "seat-id",
      "description": "A seat id names a directory and a ref segment of a unit run, so it is a short lowercase slug and never a name the run layout or the runner itself uses.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "maxLength": 40,
      "reserved": ["runs", "outbox", "inbox", "inputs", "unit-control", "control", "sync", "verify", "verifier"]
    },
    {
      "id": "workflow-name",
      "description": "A packaged workflow's name is also its directory name.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "maxLength": 64,
      "reserved": []
    },
    {
      "id": "agent-name",
      "description": "A persona's name is also the name inside its file name.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "maxLength": 64,
      "reserved": []
    },
    {
      "id": "machine-handle",
      "description": "A machine's human handle, the part after @ in every session handle; derived from the machine id or chosen as an alias. Composition (<cli>-<suffix>@<handle>) is Identity's, not Convention's.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "maxLength": 40,
      "reserved": []
    },
    {
      "id": "project-handle",
      "description": "A project's human handle, chosen once when the project id is minted (default: the slug of the folder name); the part before @ in a clone name. Never an id: two projects may share one.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "maxLength": 40,
      "reserved": []
    },
    {
      "id": "session-suffix",
      "description": "The 4-character base32 suffix of a session handle, derived from the hash of the local session id.",
      "first": "abcdefghijklmnopqrstuvwxyz234567",
      "rest": "abcdefghijklmnopqrstuvwxyz234567",
      "maxLength": 4,
      "reserved": []
    },
    {
      "id": "work-item-id",
      "description": "A work item id, also a branch and directory segment: `tsk-<10 base32>` when minted by Identity (docs/platform/identity/spec.md, section 4a); child items append `-<n>`, and older ids of other lengths keep replaying. Only the character set and the 30-character bound are checked here.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "maxLength": 30,
      "reserved": []
    },
    {
      "id": "lane-id",
      "description": "A program lane id, the part after `lead:` in a role alias (`lead:MAIL`); the `lead:` prefix is Identity's, not Convention's.",
      "first": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      "rest": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-",
      "maxLength": 16,
      "reserved": []
    },
    {
      "id": "backlog-id",
      "description": "A new backlog row id: `p-<10 base32>` when minted by Identity (docs/platform/identity/spec.md, section 4a). Rows written earlier (`p-<8 hex>`, `STR27`, `wf-...`) keep their ids.",
      "first": "abcdefghijklmnopqrstuvwxyz",
      "rest": "abcdefghijklmnopqrstuvwxyz234567-",
      "maxLength": 12,
      "reserved": []
    }
  ],
  "definitionFiles": [
    {
      "id": "workflow-file",
      "description": "A packaged workflow is a directory <name>/ holding wf.<name>.yaml; its own personas sit beside it.",
      "prefix": "wf.",
      "suffix": ".yaml",
      "nameIdentifier": "workflow-name"
    },
    {
      "id": "agent-file",
      "description": "A persona file inside a packaged workflow's directory.",
      "prefix": "agent.",
      "suffix": ".yaml",
      "nameIdentifier": "agent-name"
    }
  ]
}
