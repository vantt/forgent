{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fgos.invalid/event-store/seal.v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "machineId",
        "origin",
        "stream",
        "scope",
        "firstSeq",
        "lastSeq",
        "count",
        "sha256"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "seal"
        },
        "machineId": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "project",
            "local",
            "branch"
          ]
        },
        "firstSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lastSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "machineId",
        "parents"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "merge"
        },
        "machineId": {
          "type": "string",
          "minLength": 1
        },
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fromCommit",
        "treeOfFgosEvents"
      ],
      "properties": {
        "kind": {
          "const": "legacy"
        },
        "fromCommit": {
          "type": "string",
          "minLength": 1
        },
        "treeOfFgosEvents": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
