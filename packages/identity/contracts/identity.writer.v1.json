{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "identity.writer.request",
  "x-outcomeVersion": "1.1.0",
  "title": "Identity writer request v1",
  "description": "Who is the writer of the calling process. The env variables are tried in envOrder; a value counts only when trimmed, non-empty, at most maxIdLength characters and matching idPattern. Without a usable env id the rule walks the caller's ancestors: the highest one holding a controlling tty, else the caller's session id, else the caller pid itself (source unresolved).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "fgosDir": {
      "type": "string"
    }
  },
  "x-envOrder": [
    "FGOS_SESSION_ID",
    "CODEX_THREAD_ID",
    "PI_SESSION_ID",
    "CLAUDE_CODE_SESSION_ID"
  ],
  "x-idPattern": "^[A-Za-z0-9._-]+$",
  "x-maxIdLength": 200,
  "x-registryFile": "sessions.json",
  "definitions": {
    "machine": {
      "description": "This machine, when its id was minted (fgos doctor --fix); null otherwise. Bare identity never mints and never fails on a missing id.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "handle"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "handle": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$"
            }
          }
        }
      ]
    },
    "session": {
      "description": "This session's full id <machine-id>/<local id> and handle <cli>-<4 chars>@<machine-handle>; null when the machine id is missing or the caller cannot be told from any other (source unresolved).",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "handle"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "handle": {
              "type": "string"
            }
          }
        }
      ]
    },
    "outcome": {
      "$id": "identity.writer.outcome",
      "title": "Identity writer outcome v1.1 (machine and session are additive and optional)",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "source": {
              "enum": [
                "registry",
                "env"
              ]
            },
            "machine": {
              "$ref": "#/definitions/machine"
            },
            "session": {
              "$ref": "#/definitions/session"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "enum": [
                "pid",
                "unresolved"
              ]
            },
            "machine": {
              "$ref": "#/definitions/machine"
            },
            "session": {
              "$ref": "#/definitions/session"
            }
          }
        }
      ]
    }
  }
}
