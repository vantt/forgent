{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "identity.writer.request",
  "x-outcomeVersion": "1.1.0",
  "title": "Identity writer request v1",
  "description": "Who is the writer of the calling process. The env variables are tried in envOrder; a value counts only when trimmed, non-empty, at most maxIdLength characters and matching idPattern. Without a usable env id the rule walks the caller's ancestors: the highest one holding a controlling tty, else the caller's session id, else the caller pid itself (source unresolved).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "fgosDir": {
      "type": "string"
    }
  },
  "x-envOrder": [
    "FGOS_SESSION_ID",
    "CODEX_THREAD_ID",
    "PI_SESSION_ID",
    "CLAUDE_CODE_SESSION_ID"
  ],
  "x-idPattern": "^[A-Za-z0-9._-]+$",
  "x-maxIdLength": 200,
  "x-registryFile": "sessions.json",
  "x-sessionRegistry": {
    "description": "The rows of .fgos/sessions.json that `fgos session` writes and lists (apps/fgos/src/wiring/session.rs) and this rule reads (one field, sessionId, to confirm an env id). The file is a JSON array written two-space with a trailing newline; `list` answers the array as it is, a summary row projects the six summaryFields. A file that is not JSON or not an array is refused by `session` (fail closed) and confirms nothing here (fail soft). Both readers run every row below.",
    "rowFields": [
      "sessionId",
      "worktreePath",
      "itemId",
      "startCommit",
      "pid",
      "record",
      "startedAt"
    ],
    "summaryFields": [
      "sessionId",
      "worktreePath",
      "itemId",
      "startCommit",
      "pid",
      "startedAt"
    ],
    "rows": [
      {
        "name": "no file",
        "registry": {
          "absent": true
        },
        "list": [],
        "summary": [],
        "confirms": [],
        "rejects": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      {
        "name": "empty array",
        "registry": {
          "text": "[]\n"
        },
        "list": [],
        "summary": [],
        "confirms": [],
        "rejects": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      {
        "name": "two sessions, one bound to an item",
        "registry": {
          "text": "[\n  {\n    \"sessionId\": \"11111111-1111-4111-8111-111111111111\",\n    \"worktreePath\": \"/tmp/fgos-sessions/11111111-1111-4111-8111-111111111111-AbC123\",\n    \"itemId\": null,\n    \"startCommit\": \"0123456789abcdef0123456789abcdef01234567\",\n    \"pid\": 4242,\n    \"record\": {\n      \"host\": \"fixture-host\",\n      \"bootId\": \"boot-1\",\n      \"pidNs\": \"pid:[4026531836]\",\n      \"pid\": 4242,\n      \"startTime\": \"123456\"\n    },\n    \"startedAt\": \"2026-11-15T03:00:00.000Z\"\n  },\n  {\n    \"sessionId\": \"22222222-2222-4222-8222-222222222222\",\n    \"worktreePath\": \"/tmp/fgos-sessions/22222222-2222-4222-8222-222222222222-AbC123\",\n    \"itemId\": \"tsk-abc\",\n    \"startCommit\": \"0123456789abcdef0123456789abcdef01234567\",\n    \"pid\": 4243,\n    \"record\": {\n      \"host\": \"fixture-host\",\n      \"bootId\": \"boot-1\",\n      \"pidNs\": \"pid:[4026531836]\",\n      \"pid\": 4243,\n      \"startTime\": \"123456\"\n    },\n    \"startedAt\": \"2026-11-15T03:00:01.000Z\"\n  }\n]\n"
        },
        "list": [
          {
            "sessionId": "11111111-1111-4111-8111-111111111111",
            "worktreePath": "/tmp/fgos-sessions/11111111-1111-4111-8111-111111111111-AbC123",
            "itemId": null,
            "startCommit": "0123456789abcdef0123456789abcdef01234567",
            "pid": 4242,
            "record": {
              "host": "fixture-host",
              "bootId": "boot-1",
              "pidNs": "pid:[4026531836]",
              "pid": 4242,
              "startTime": "123456"
            },
            "startedAt": "2026-11-15T03:00:00.000Z"
          },
          {
            "sessionId": "22222222-2222-4222-8222-222222222222",
            "worktreePath": "/tmp/fgos-sessions/22222222-2222-4222-8222-222222222222-AbC123",
            "itemId": "tsk-abc",
            "startCommit": "0123456789abcdef0123456789abcdef01234567",
            "pid": 4243,
            "record": {
              "host": "fixture-host",
              "bootId": "boot-1",
              "pidNs": "pid:[4026531836]",
              "pid": 4243,
              "startTime": "123456"
            },
            "startedAt": "2026-11-15T03:00:01.000Z"
          }
        ],
        "summary": [
          {
            "sessionId": "11111111-1111-4111-8111-111111111111",
            "worktreePath": "/tmp/fgos-sessions/11111111-1111-4111-8111-111111111111-AbC123",
            "itemId": null,
            "startCommit": "0123456789abcdef0123456789abcdef01234567",
            "pid": 4242,
            "startedAt": "2026-11-15T03:00:00.000Z"
          },
          {
            "sessionId": "22222222-2222-4222-8222-222222222222",
            "worktreePath": "/tmp/fgos-sessions/22222222-2222-4222-8222-222222222222-AbC123",
            "itemId": "tsk-abc",
            "startCommit": "0123456789abcdef0123456789abcdef01234567",
            "pid": 4243,
            "startedAt": "2026-11-15T03:00:01.000Z"
          }
        ],
        "confirms": [
          "11111111-1111-4111-8111-111111111111",
          "22222222-2222-4222-8222-222222222222"
        ],
        "rejects": [
          "33333333-3333-4333-8333-333333333333"
        ]
      },
      {
        "name": "not JSON",
        "registry": {
          "text": "{bad"
        },
        "list": {
          "refused": "not-json"
        },
        "confirms": [],
        "rejects": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      {
        "name": "a JSON object, not an array",
        "registry": {
          "text": "{}"
        },
        "list": {
          "refused": "not-array"
        },
        "confirms": [],
        "rejects": [
          "11111111-1111-4111-8111-111111111111"
        ]
      }
    ]
  },
  "definitions": {
    "machine": {
      "description": "This machine, when its id was minted (fgos doctor --fix); null otherwise. Bare identity never mints and never fails on a missing id.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "handle"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "handle": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$"
            }
          }
        }
      ]
    },
    "session": {
      "description": "This session's full id <machine-id>/<local id> and handle <cli>-<4 chars>@<machine-handle>; null when the machine id is missing or the caller cannot be told from any other (source unresolved).",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "handle"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "handle": {
              "type": "string"
            }
          }
        }
      ]
    },
    "outcome": {
      "$id": "identity.writer.outcome",
      "title": "Identity writer outcome v1.1 (machine and session are additive and optional)",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "source": {
              "enum": [
                "registry",
                "env"
              ]
            },
            "machine": {
              "$ref": "#/definitions/machine"
            },
            "session": {
              "$ref": "#/definitions/session"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "enum": [
                "pid",
                "unresolved"
              ]
            },
            "machine": {
              "$ref": "#/definitions/machine"
            },
            "session": {
              "$ref": "#/definitions/session"
            }
          }
        }
      ]
    }
  }
}
