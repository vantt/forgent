{
  "contract": "agent-hooks.v1",
  "note": "Small data the hook table needs: the attempt-id prefix the generated omp/pi extension tests for, the shim path, the mailbox hook timeout and the rows for a project that opted in. The replay vectors are in rust/tests/goldens/agent-hooks-vectors.json. packages/identity/rust/tests/attempt_writer_id.rs pins attemptIdPrefix to the identity crate.",
  "attemptIdPrefix": "att-",
  "shimRelative": ".fgos/installation/bin/fgos",
  "mailboxHookTimeoutSec": 10,
  "rowsMailboxOn": {
    "claude": [
      {
        "cli": "claude",
        "kind": "dispatch-decide",
        "event": "PreToolUse",
        "matcher": "Agent|Task",
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" hook dispatch-decide"
      },
      {
        "cli": "claude",
        "kind": "decision-question",
        "event": "PreToolUse",
        "matcher": "AskUserQuestion",
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" hook decision-question"
      },
      {
        "cli": "claude",
        "kind": "main-checkout-delete-guard",
        "event": "PreToolUse",
        "matcher": "Bash",
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; P=$(cat); case \"$P\" in *\"xargs\"*|*\"clean\"*|*\"-delete\"*|*\"eval\"*|*\"bash\"*|*\"zsh\"*|*\"dash\"*|*\"ksh\"*|*[!A-Za-z0-9]rm*|*\\\\[bfnrt]rm*|*[!A-Za-z0-9]sh*|*\\\\[bfnrt]sh*) printf \"%s\" \"$P\" | \"$S\" hook main-checkout-delete-guard;; esac"
      },
      {
        "cli": "claude",
        "kind": "mailbox",
        "args": "--cli claude --event stop",
        "event": "Stop",
        "matcher": null,
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" hook mailbox --cli claude --event stop || true",
        "timeout": 10
      },
      {
        "cli": "claude",
        "kind": "mailbox",
        "args": "--cli claude --event post-tool-use",
        "event": "PostToolUse",
        "matcher": "*",
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" hook mailbox --cli claude --event post-tool-use || true",
        "timeout": 10
      },
      {
        "cli": "claude",
        "kind": "session-rotation",
        "args": "--event stop",
        "event": "Stop",
        "matcher": null,
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" hook session-rotation --event stop || true",
        "timeout": 80
      },
      {
        "cli": "claude",
        "kind": "session-register",
        "event": "SessionStart",
        "matcher": null,
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" identity session --register >/dev/null || true",
        "timeout": 10
      },
      {
        "cli": "claude",
        "kind": "session-rotation",
        "args": "--event session-start",
        "event": "SessionStart",
        "matcher": null,
        "command": "S=\"${CLAUDE_PROJECT_DIR}/.fgos/installation/bin/fgos\"; [ -x \"$S\" ] || exit 0; \"$S\" hook session-rotation --event session-start || true",
        "timeout": 10
      }
    ],
    "codex": [
      {
        "cli": "codex",
        "kind": "session-register",
        "event": "SessionStart",
        "matcher": null,
        "command": "'<ROOT>/.fgos/installation/bin/fgos' identity session --register >/dev/null || true",
        "timeout": 10
      },
      {
        "cli": "codex",
        "kind": "dispatch-decide",
        "event": "PreToolUse",
        "matcher": ".*",
        "command": "'<ROOT>/.fgos/installation/bin/fgos' hook dispatch-decide"
      },
      {
        "cli": "codex",
        "kind": "decision-question",
        "event": "PreToolUse",
        "matcher": "RequestUserInput|ask.*",
        "command": "'<ROOT>/.fgos/installation/bin/fgos' hook decision-question"
      },
      {
        "cli": "codex",
        "kind": "main-checkout-delete-guard",
        "event": "PreToolUse",
        "matcher": "^(Bash|shell|exec_command|local_shell)$",
        "command": "/bin/sh -c 'S=$1; [ -x \"$S\" ] || exit 0; P=$(cat); case \"$P\" in *\"xargs\"*|*\"clean\"*|*\"-delete\"*|*\"eval\"*|*\"bash\"*|*\"zsh\"*|*\"dash\"*|*\"ksh\"*|*[!A-Za-z0-9]rm*|*\\\\[bfnrt]rm*|*[!A-Za-z0-9]sh*|*\\\\[bfnrt]sh*) printf \"%s\" \"$P\" | \"$S\" hook main-checkout-delete-guard;; esac' sh '<ROOT>/.fgos/installation/bin/fgos'"
      },
      {
        "cli": "codex",
        "kind": "mailbox",
        "args": "--cli codex --event stop",
        "event": "Stop",
        "matcher": null,
        "command": "'<ROOT>/.fgos/installation/bin/fgos' hook mailbox --cli codex --event stop",
        "timeout": 10
      },
      {
        "cli": "codex",
        "kind": "mailbox",
        "args": "--cli codex --event post-tool-use",
        "event": "PostToolUse",
        "matcher": null,
        "command": "'<ROOT>/.fgos/installation/bin/fgos' hook mailbox --cli codex --event post-tool-use",
        "timeout": 10
      }
    ],
    "agy": [
      {
        "cli": "agy",
        "kind": "session-register",
        "event": "SessionStart",
        "group": "fgos-session-register",
        "flat": true,
        "command": "'<ROOT>/.fgos/installation/bin/fgos' identity session --register >/dev/null || true",
        "timeout": 10
      },
      {
        "cli": "agy",
        "kind": "dispatch-decide",
        "event": "PreToolUse",
        "group": "fgos-dispatch-guard",
        "matcher": ".*",
        "command": "'<ROOT>/.fgos/installation/bin/fgos' hook dispatch-decide --format=agy",
        "timeout": 10
      },
      {
        "cli": "agy",
        "kind": "decision-question",
        "event": "PreToolUse",
        "group": "fgos-decision-guard",
        "matcher": "ask.*|AskUserQuestion",
        "command": "'<ROOT>/.fgos/installation/bin/fgos' hook decision-question --format=agy",
        "timeout": 10
      },
      {
        "cli": "agy",
        "kind": "main-checkout-delete-guard",
        "event": "PreToolUse",
        "group": "fgos-delete-guard",
        "matcher": "run_command",
        "command": "/bin/sh -c 'S=$1; [ -x \"$S\" ] || { printf \"%s\\n\" \"{\\\"decision\\\":\\\"allow\\\"}\"; exit 0; }; P=$(cat); case \"$P\" in *\"xargs\"*|*\"clean\"*|*\"-delete\"*|*\"eval\"*|*\"bash\"*|*\"zsh\"*|*\"dash\"*|*\"ksh\"*|*[!A-Za-z0-9]rm*|*\\\\[bfnrt]rm*|*[!A-Za-z0-9]sh*|*\\\\[bfnrt]sh*) printf \"%s\" \"$P\" | \"$S\" hook main-checkout-delete-guard --format=agy;; *) printf \"%s\\n\" \"{\\\"decision\\\":\\\"allow\\\"}\";; esac' sh '<ROOT>/.fgos/installation/bin/fgos'",
        "timeout": 10
      }
    ]
  }
}
