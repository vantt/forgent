{
  "contract": "delete-guard-prefilter.v1",
  "note": "The keyword list the main-checkout delete guard judges (substrings anywhere, words only at the start of a word). agent_hooks.rs renders the shell case patterns and the JavaScript regular expression of the omp and pi extensions from it; regExpSource, caseGlobs and vectors were recorded from the earlier Node renderer and pin both the Rust renderer and test/git/main-checkout-delete-guard.test.mjs, which reads substrings and words from here.",
  "substrings": [
    "xargs",
    "clean",
    "-delete",
    "eval",
    "bash",
    "zsh",
    "dash",
    "ksh"
  ],
  "words": [
    "rm",
    "sh"
  ],
  "regExpSource": "xargs|clean|\\-delete|eval|bash|zsh|dash|ksh|(?:^|[^A-Za-z0-9])(?:rm|sh)",
  "caseGlobs": "*\"xargs\"*|*\"clean\"*|*\"-delete\"*|*\"eval\"*|*\"bash\"*|*\"zsh\"*|*\"dash\"*|*\"ksh\"*|*[!A-Za-z0-9]rm*|*\\\\[bfnrt]rm*|*[!A-Za-z0-9]sh*|*\\\\[bfnrt]sh*",
  "vectors": [
    {
      "command": "rm -rf /tmp/x",
      "matches": true
    },
    {
      "command": "ls -la",
      "matches": false
    },
    {
      "command": "sudo rm x",
      "matches": true
    },
    {
      "command": "echo permission_mode",
      "matches": false
    },
    {
      "command": "git clean -fdx",
      "matches": true
    },
    {
      "command": "find . -delete",
      "matches": true
    },
    {
      "command": "xargs rm",
      "matches": true
    },
    {
      "command": "bash -c \"x\"",
      "matches": true
    },
    {
      "command": "echo \"a\nsh b\"",
      "matches": true
    },
    {
      "command": "zsh",
      "matches": true
    },
    {
      "command": "eval \"$x\"",
      "matches": true
    },
    {
      "command": "cat a | dash",
      "matches": true
    },
    {
      "command": "ksh x",
      "matches": true
    },
    {
      "command": "echo harmless",
      "matches": false
    },
    {
      "command": "printf shell",
      "matches": true
    },
    {
      "command": "confirm",
      "matches": false
    },
    {
      "command": "ash",
      "matches": false
    },
    {
      "command": "r\"m\" x",
      "matches": false
    }
  ]
}
