      "pushRefs",
      "inspectRemote"
    ],
    "Recovery": [
      "inspectOperation",
      "listPending",
      "reconcile"
    ],
    "Publication": [
      "writeBlob",
      "writeTree",
      "writeCommit",
      "readRef",
      "readObject",
      "walkCommits",
      "compareAndSwap",
      "fetchRefs",
      "pushRefs"
    ]
  },
  "publicationExtensions": {
    "writeCommit": "explicit author and committer dates",
    "walkCommits": "caller stop set, ordered parents, tree, bounded opaque continuation",
    "compareAndSwap": "expected and next are independently Absent or Oid",
    "pushRefs": [
      "accepted",
      "rejected-non-fast-forward",
      "rejected-other",
      "remote-outcome-unknown"
    ],
    "remote": "explicit RemoteGrant with pinned effective URL; bounded borrowed transport; mirror refs installed by no-dereference exact-old CAS"
  },
  "inspectFacts": [
    "configuredFetchRefspecs",
    "pushRefspecs",
    "remoteUrl",
    "configValue(fgos.machineId)",
    "gitFloorVerdict",
    "fetchMappingProvenance"
  ],
  "publicationAuthority": "HolderAuthority takes an exclusive mutable borrow of an acquired opaque event-seal Handle; !Sync; validate before Intent and every child; no fd input",
  "publicationRecovery": [
    "recover",
    "supersede",
    "release_pin_and_compact"
  ]
}
