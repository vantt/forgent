 "custodyHeld": [
  {
   "name": "a worktree that does not exist is held by nobody",
   "holders": {
    "kind": "none"
   },
   "expect": false
  },
  {
   "name": "a lock file never created is held by nobody",
   "holders": {
    "kind": "none"
   },
   "expect": false
  },
  {
   "name": "a listed holder holds custody",
   "holders": {
    "kind": "listed",
    "pids": [
     4242
    ]
   },
   "expect": true
  },
  {
   "name": "an empty holder list is no custody",
   "holders": {
    "kind": "listed",
    "pids": []
   },
   "expect": false
  },
  {
   "name": "a platform that cannot list reads free as no custody",
   "holders": {
    "kind": "unlisted",
    "free": true
   },
   "expect": false
  },
  {
   "name": "a platform that cannot list reads anything but free as held",
   "holders": {
    "kind": "unlisted",
    "free": false
   },
   "expect": true
  }
 ]
