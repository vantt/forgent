 "judgeUnitRun": [
  {
   "name": "an id that is not a plain path is unsafe",
   "unitRunId": "../x",
   "caseId": "case-1",
   "unless": [],
   "standing": {
    "kind": "unsafe"
   },
   "expect": {
    "keep": "unsafe-path",
    "blocks": true
   }
  },
  {
   "name": "a plain id that is a link is a link",
   "unitRunId": "a-link",
   "caseId": "case-1",
   "unless": [],
   "standing": {
    "kind": "unsafe-link"
   },
   "expect": {
    "keep": "link",
    "blocks": true
   }
  },
  {
