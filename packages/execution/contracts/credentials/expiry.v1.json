{
 "version": "credentials-expiry.v1",
 "about": "readCredentialExpiry per layout, the layout chosen for a credential source, loginLifeProblem, and the refresh-ahead windows",
 "constants": {
  "defaultRefreshAheadMinThresholdMs": 3600000,
  "codexRefreshIntervalMs": 691200000,
  "renewalCooldownMs": 1800000,
  "maxPendingCopies": 5,
  "stagingMinAgeMs": 600000
 },
 "windows": [
  {
   "probeTimeoutMs": 0,
   "expected": 3600000
  },
  {
   "probeTimeoutMs": 1000,
   "expected": 3600000
  },
  {
   "probeTimeoutMs": 1800000,
   "expected": 3600000
  },
  {
   "probeTimeoutMs": 3300000,
   "expected": 3600000
  },
  {
   "probeTimeoutMs": 3600000,
   "expected": 3900000
  },
  {
   "probeTimeoutMs": 7200000,
   "expected": 7500000
  }
 ],
 "expiry": [
  {
   "id": "pi-ms-and-seconds",
   "layout": "pi-auth-json",
   "files": {
    "auth.json": "{\n  \"openai-codex\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"r1\",\n    \"expires\": 1780318800000\n  },\n  \"xai\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"r2\",\n    \"expires\": 1780322400\n  },\n  \"manual\": {\n    \"type\": \"api_key\",\n    \"key\": \"k\"\n  }\n}\n"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "openai-codex",
      "expiresMs": 1780318800000,
      "dueMs": 1780318800000
     },
     {
      "key": "xai",
      "expiresMs": 1780322400000,
      "dueMs": 1780322400000
     }
    ]
   }
  },
  {
   "id": "pi-no-oauth-entry",
   "layout": "pi-auth-json",
   "files": {
    "auth.json": "{\n  \"manual\": {\n    \"type\": \"api_key\",\n    \"key\": \"k\"\n  }\n}\n"
   },
   "expected": {
    "ok": false,
    "code": "unexpected-shape"
   }
  },
  {
   "id": "pi-array-shape",
   "layout": "pi-auth-json",
   "files": {
    "auth.json": "[1,2]"
   },
   "expected": {
    "ok": false,
    "code": "unexpected-shape"
   }
  },
  {
   "id": "pi-corrupt-json",
   "layout": "pi-auth-json",
   "files": {
    "auth.json": "{\"openai-codex\": {"
   },
   "expected": {
    "ok": false,
    "code": "unreadable-json"
   }
  },
  {
   "id": "pi-missing-file",
   "layout": "pi-auth-json",
   "files": {},
   "expected": {
    "ok": false,
    "code": "missing-file"
   }
  },
  {
   "id": "codex-token-exp-earlier-than-age",
   "layout": "codex-auth-json",
   "files": {
    "auth.json": "{\n  \"tokens\": {\n    \"access_token\": \"eyJhbGciOiJub25lIn0.eyJleHAiOjE3ODAzMTg4MDAsImh0dHBzOi8vYXBpLm9wZW5haS5jb20vYXV0aCI6eyJjaGF0Z3B0X2FjY291bnRfaWQiOiJhY2N0LTEifX0.c2ln\",\n    \"refresh_token\": \"cr1\"\n  },\n  \"last_refresh\": \"2026-06-01T11:00:00Z\"\n}\n"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "codex",
      "expiresMs": 1780318800000,
      "dueMs": 1780318800000
     }
    ]
   }
  },
  {
   "id": "codex-age-earlier-than-token-exp",
   "layout": "codex-auth-json",
   "files": {
    "auth.json": "{\n  \"tokens\": {\n    \"access_token\": \"eyJhbGciOiJub25lIn0.eyJleHAiOjE3ODI5MDcyMDAsImh0dHBzOi8vYXBpLm9wZW5haS5jb20vYXV0aCI6eyJjaGF0Z3B0X2FjY291bnRfaWQiOiJhY2N0LTEifX0.c2ln\",\n    \"refresh_token\": \"cr1\"\n  },\n  \"last_refresh\": \"2026-05-20T00:00:00Z\"\n}\n"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "codex",
      "expiresMs": 1782907200000,
      "dueMs": 1779926400000
     }
    ]
   }
  },
  {
   "id": "codex-opaque-token-uses-age",
   "layout": "codex-auth-json",
   "files": {
    "auth.json": "{\"tokens\":{\"access_token\":\"opaque\",\"refresh_token\":\"cr1\"},\"last_refresh\":\"2026-06-01T11:00:00Z\"}\n"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "codex",
      "expiresMs": 1781002800000,
      "dueMs": 1781002800000
     }
    ]
   }
  },
  {
   "id": "codex-opaque-token-no-age",
   "layout": "codex-auth-json",
   "files": {
    "auth.json": "{\"tokens\":{\"access_token\":\"opaque\"}}"
   },
   "expected": {
    "ok": false,
    "code": "unexpected-shape"
   }
  },
  {
   "id": "codex-no-tokens",
   "layout": "codex-auth-json",
   "files": {
    "auth.json": "{}"
   },
   "expected": {
    "ok": false,
    "code": "unexpected-shape"
   }
  },
  {
   "id": "claude-config-ms",
   "layout": "claude-config-credentials-json",
   "files": {
    ".credentials.json": "{\"claudeAiOauth\":{\"accessToken\":\"a\",\"refreshToken\":\"cl1\",\"expiresAt\":1780326000000}}"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "claudeAiOauth",
      "expiresMs": 1780326000000,
      "dueMs": 1780326000000
     }
    ]
   }
  },
  {
   "id": "claude-config-seconds",
   "layout": "claude-config-credentials-json",
   "files": {
    ".credentials.json": "{\"claudeAiOauth\":{\"accessToken\":\"a\",\"refreshToken\":\"cl1\",\"expiresAt\":1780326000}}"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "claudeAiOauth",
      "expiresMs": 1780326000000,
      "dueMs": 1780326000000
     }
    ]
   }
  },
  {
   "id": "claude-home-nested",
   "layout": "claude-credentials-json",
   "files": {
    ".claude/.credentials.json": "{\"claudeAiOauth\":{\"accessToken\":\"a\",\"refreshToken\":\"cl1\",\"expiresAt\":1780329600000}}"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "key": "claudeAiOauth",
      "expiresMs": 1780329600000,
      "dueMs": 1780329600000
     }
    ]
   }
  },
  {
   "id": "claude-no-oauth",
   "layout": "claude-config-credentials-json",
   "files": {
    ".credentials.json": "{\"other\":1}"
   },
   "expected": {
    "ok": false,
    "code": "unexpected-shape"
   }
  },
  {
   "id": "omp-without-sqlite",
   "layout": "omp-agent-db",
   "files": {
    "agent.db": "not a database"
   },
   "expected": {
    "ok": false,
    "code": "sqlite-unavailable"
   }
  },
  {
   "id": "omp-missing-store",
   "layout": "omp-agent-db",
   "files": {},
   "expected": {
    "ok": false,
    "code": "missing-file"
   }
  },
  {
   "id": "unknown-layout",
   "layout": "no-such-layout",
   "files": {},
   "expected": {
    "ok": false,
    "code": "unknown-layout"
   }
  }
 ],
 "layouts": [
  {
   "id": "codex-home",
   "source": {
    "kind": "codex-home",
    "home": "/h"
   },
   "expected": "codex-auth-json"
  },
  {
   "id": "omp-before-pi",
   "source": {
    "kind": "home-files",
    "home": "/h",
    "files": [
     "auth.json",
     "agent.db"
    ]
   },
   "expected": "omp-agent-db"
  },
  {
   "id": "pi",
   "source": {
    "kind": "home-files",
    "home": "/h",
    "files": [
     "auth.json"
    ]
   },
   "expected": "pi-auth-json"
  },
  {
   "id": "claude-config",
   "source": {
    "kind": "home-files",
    "home": "/h",
    "files": [
     ".credentials.json"
    ]
   },
   "expected": "claude-config-credentials-json"
  },
  {
   "id": "claude-home",
   "source": {
    "kind": "home-files",
    "home": "/h",
    "files": [
     ".claude/.credentials.json"
    ]
   },
   "expected": "claude-credentials-json"
  },
  {
   "id": "unrelated-files",
   "source": {
    "kind": "home-files",
    "home": "/h",
    "files": [
     "other.json"
    ]
   },
   "expected": null
  },
  {
   "id": "unknown-kind",
   "source": {
    "kind": "env",
    "home": "/h"
   },
   "expected": null
  },
  {
   "id": "no-source",
   "source": null,
   "expected": null
  }
 ],
 "life": [
  {
   "id": "claude-life-short",
   "layout": "claude-config-credentials-json",
   "files": {
    ".credentials.json": "{\"claudeAiOauth\":{\"accessToken\":\"a\",\"refreshToken\":\"cl1\",\"expiresAt\":1780315800000}}"
   },
   "timeoutMs": 1800000,
   "now": 1780315200000,
   "expected": "login-expires-before-seat-timeout: the login has 10 min of access-token life left and the seat may run 30 min, so the seat would refresh it inside its home"
  },
  {
   "id": "claude-life-enough",
   "layout": "claude-config-credentials-json",
   "files": {
    ".credentials.json": "{\"claudeAiOauth\":{\"accessToken\":\"a\",\"refreshToken\":\"cl1\",\"expiresAt\":1780322400000}}"
   },
   "timeoutMs": 1800000,
   "now": 1780315200000,
   "expected": null
  },
  {
   "id": "claude-already-expired",
   "layout": "claude-config-credentials-json",
   "files": {
    ".credentials.json": "{\"claudeAiOauth\":{\"accessToken\":\"a\",\"refreshToken\":\"cl1\",\"expiresAt\":1780311600000}}"
   },
   "timeoutMs": 1800000,
   "now": 1780315200000,
   "expected": "login-expires-before-seat-timeout: the login has 0 min of access-token life left and the seat may run 30 min, so the seat would refresh it inside its home"
  },
  {
   "id": "pi-never-judged",
   "layout": "pi-auth-json",
   "files": {
    "auth.json": "{\n  \"openai-codex\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"r1\",\n    \"expires\": 1780315201000\n  }\n}\n"
   },
   "timeoutMs": 1800000,
   "now": 1780315200000,
   "expected": null
  }
 ]
}
