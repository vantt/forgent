{
 "version": "credentials-write-back.v1",
 "about": "credentialWriteBackTarget choice, and writeBackRenewedCredential: its status, the copy staged beside the source (same file names, same bytes) and how the retained-copy listing reads it",
 "targets": [
  {
   "id": "codex-home",
   "args": {
    "provider": "openai",
    "accountId": "a1",
    "credentialSource": {
     "kind": "codex-home",
     "home": "/home/o/.codex"
    },
    "runtimeDir": "/var/run/fgos"
   },
   "expected": {
    "provider": "openai",
    "accountId": "a1",
    "kind": "codex-home",
    "home": "/home/o/.codex",
    "layout": "codex-auth-json",
    "runtimeDir": "/var/run/fgos"
   }
  },
  {
   "id": "per-cli-store",
   "args": {
    "provider": "openai",
    "accountId": "a1",
    "credentialSource": {
     "kind": "home-files",
     "home": "/home/o/.pi",
     "files": [
      "auth.json"
     ],
     "cli": "pi"
    },
    "runtimeDir": "/var/run/fgos"
   },
   "expected": {
    "provider": "openai",
    "accountId": "a1",
    "kind": "home-files",
    "home": "/home/o/.pi",
    "layout": "pi-auth-json",
    "runtimeDir": "/var/run/fgos",
    "store": "pi"
   }
  },
  {
   "id": "unsafe-account-id",
   "args": {
    "provider": "openai",
    "accountId": "../x",
    "credentialSource": {
     "kind": "codex-home",
     "home": "/home/o/.codex"
    },
    "runtimeDir": "/var/run/fgos"
   },
   "expected": null
  },
  {
   "id": "unsafe-cli-key",
   "args": {
    "provider": "openai",
    "accountId": "a1",
    "credentialSource": {
     "kind": "home-files",
     "home": "/h",
     "files": [
      "auth.json"
     ],
     "cli": "../pi"
    },
    "runtimeDir": "/var/run/fgos"
   },
   "expected": null
  },
  {
   "id": "relative-home",
   "args": {
    "provider": "openai",
    "accountId": "a1",
    "credentialSource": {
     "kind": "codex-home",
     "home": "relative/home"
    },
    "runtimeDir": "/var/run/fgos"
   },
   "expected": null
  },
  {
   "id": "relative-runtime-dir",
   "args": {
    "provider": "openai",
    "accountId": "a1",
    "credentialSource": {
     "kind": "codex-home",
     "home": "/h"
    },
    "runtimeDir": "run"
   },
   "expected": null
  },
  {
   "id": "unsupported-layout",
   "args": {
    "provider": "openai",
    "accountId": "a1",
    "credentialSource": {
     "kind": "home-files",
     "home": "/h",
     "files": [
      "x"
     ]
    },
    "runtimeDir": "/var/run/fgos"
   },
   "expected": null
  }
 ],
 "cases": [
  {
   "id": "newer-login-is-staged-not-applied",
   "layout": "pi-auth-json",
   "provider": "openai-codex",
   "source": {
    "auth.json": "{\n  \"openai-codex\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"old\",\n    \"expires\": 1780318800000\n  }\n}\n"
   },
   "home": {
    "auth.json": "{\n  \"openai-codex\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"new\",\n    \"expires\": 1780333200000\n  }\n}\n"
   },
   "store": null,
   "now": 1780315200000,
   "expected": {
    "result": {
     "status": "staged"
    },
    "staged": [
     {
      "name": "001780315200000-agent-<hex8>",
      "files": {
       "auth.json": "{\n  \"openai-codex\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"new\",\n    \"expires\": 1780333200000\n  }\n}\n"
      }
     }
    ],
    "retained": [
     {
      "provider": "openai-codex",
      "accountId": "acct",
      "kind": "agent",
      "stranded": false
     }
    ]
   }
  },
  {
   "id": "identical-files-are-not-newer",
   "layout": "pi-auth-json",
   "provider": "openai-codex",
   "source": {
