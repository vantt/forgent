   },
   "home": {
    "auth.json": "{\n  \"openai-codex\": {\n    \"type\": \"oauth\",\n    \"access\": \"access\",\n    \"refresh\": \"same\",\n    \"expires\": 1780318800000\n  }\n}\n"
   },
