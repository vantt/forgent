  {
   "id": "echo-secret-value-is-redacted-in-the-display-form",
   "why": "spec 9 and acceptance 15: the in-process value carries it, the display form never does",
   "input": {
    "kind": "render",
    "files": {
     "home/.fgos/config.yaml": [
      "vault:",
      "  token: SENTINEL-578b5c72dc4e",
      "  ref: SENTINEL-e60caea63367",
      "  port: 7"
     ]
    },
    "sentinels": [
     "SENTINEL-578b5c72dc4e"
    ],
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "redacted": [
     "vault.token"
    ],
    "kept": {
     "vault.port": 7
    }
   }
  },
  {
   "id": "echo-reason-with-a-line-break",
   "why": "spec 7 and 9: a refused reason is not echoed",
   "input": {
    "kind": "write",
    "files": {
     "project/.fgos/config.yaml": [
      "limits:",
      "  count: 8"
     ]
    },
    "sentinels": [
     "SENTINEL-c29a80b21ead",
     "SENTINEL-8f062d15a4f4"
    ],
    "edits": [
     {
      "set": "limits.count",
      "value": 9
     }
    ],
    "reason": "SENTINEL-c29a80b21ead\n@fgos:why [x] SENTINEL-8f062d15a4f4",
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "code": "config-comment-reason-required"
   }
  },
