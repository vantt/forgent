{
 "version": 1,
 "about": "No error, finding or display form echoes a value (docs/platform/config/spec.md section 9). Each case lays files out as the snapshot fixture does, puts two sentinels beside the fault (kind `snapshot`, `write` or `render`) and checks that the Display, Debug and pretty-Debug of every refusal, and the display form of a snapshot, contain no byte of either. A line holding @PAD@ is filled with `pad` letters. Expect: code (a refusal), or redacted (paths shown as <redacted>) and kept (paths shown as stored).",
 "schemas": {
  "vault": [
   "type: object",
   "properties:",
   "  token: {type: string, x-fgos-sensitivity: secret-value}",
   "  ref: {type: string, x-fgos-sensitivity: secret-reference}",
   "  port: {type: integer}"
  ],
  "gateway": [
   "type: object",
   "x-fgos-scope: global-only",
   "properties:",
   "  token: {type: string, x-fgos-sensitivity: secret-value}"
  ],
  "limits": [
   "type: object",
   "properties:",
   "  count: {type: integer, minimum: 1}"
  ],
  "gateBypass": [
   "type: object",
   "properties:",
   "  level: {type: string, enum: [off, light, standard, heavy]}"
  ],
  "accounts": [
   "type: object",
   "x-fgos-file: accounts",
   "additionalProperties:",
   "  type: object",
   "  properties:",
   "    login: {type: string, x-fgos-sensitivity: secret-reference}"
  ]
 },
 "standard": {},
 "cases": [
  {
   "id": "echo-syntax-error-next-to-an-account-entry",
   "why": "spec 9: the break sits beside an account entry in accounts.yaml",
   "input": {
    "kind": "snapshot",
    "files": {
     "home/.fgos/private/accounts.yaml": [
      "accounts:",
      "  pool:",
      "    login: SENTINEL-eee65f53e942",
      "  broken: [{t}"
     ]
    },
    "sentinels": [
     "SENTINEL-eee65f53e942",
     "SENTINEL-1ce50211670e"
    ],
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "code": "config-parse"
   }
  },
  {
   "id": "echo-type-mismatch-beside-a-global-secret",
   "why": "spec 9: the wrong value and its neighbour are both sentinels",
   "input": {
    "kind": "snapshot",
    "files": {
     "home/.fgos/config.yaml": [
      "vault:",
      "  token: SENTINEL-ae679f02e8d2",
      "  port: SENTINEL-8a79023c39c2"
     ]
    },
    "sentinels": [
     "SENTINEL-ae679f02e8d2",
     "SENTINEL-8a79023c39c2"
    ],
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "code": "config-schema"
   }
  },
