{
 "version": 1,
 "about": "Owning cases of the write transaction (docs/platform/config/spec.md sections 6 and 7). Shared `schemas` and `standard` apply to every case. A case lays files out as the snapshot fixture does (project/, main/, home/.fgos/); input: target (project|global|accounts), class, expected (current|absent|stale), edits ({set,value}|{unset}), reason, ack, writer, modes (path to mode), links (path to link target). Expect: code or yaml (a refusal; every file stays byte-identical and no file appears), keyword, files (path to the lines after), applied [path, unset], notices [id, path], writer_id, modes, no_lock, no_dir.",
 "schemas": {
  "gateBypass": [
   "type: object",
   "description: Gate bypass settings.",
   "properties:",
   "  level: {type: string, enum: [off, light, standard, heavy], description: Gate bypass level for agent work.}"
  ],
  "limits": [
   "type: object",
   "properties:",
   "  count: {type: integer, minimum: 1, description: Parallel runs.}",
   "  tags: {type: array, items: {type: string}}",
   "  nested: {type: object, properties: {deep: {type: integer}}}",
   "  other: {type: object}"
  ],
  "gateway": [
   "type: object",
   "x-fgos-scope: global-only",
   "properties:",
   "  port: {type: integer}"
  ],
  "accounts": [
   "type: object",
   "x-fgos-file: accounts",
   "additionalProperties:",
   "  type: object",
   "  properties:",
   "    login: {type: string}"
  ],
  "labels": [
   "type: object",
   "additionalProperties: {type: [string, 'null']}"
  ]
 },
 "standard": {
  "gateBypass": [
   "gateBypass:",
   "  level: off"
  ],
  "limits": [
   "limits:",
   "  count: 4"
  ]
 },
 "cases": [
  {
   "id": "write-new-file-header-doc-why",
   "why": "spec 6 and 7: a missing file starts with the header; a new key carries doc then why with the writer as actor",
   "input": {
    "files": {},
    "edits": [
     {
      "set": "gateBypass.level",
      "value": "light"
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    },
    "expected": "absent"
   },
   "expect": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] dogfood repo, lighter gates.",
      "  level: light"
     ]
    },
    "writer_id": "vantt"
   }
  },
  {
   "id": "write-new-key-keeps-the-notes-of-its-neighbour",
   "why": "spec 7: a new key goes in with its block and every other line stays",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "limits:",
      "  # keep this low",
      "  count: 8"
     ]
    },
    "edits": [
     {
      "set": "limits.tags",
      "value": [
       "a"
      ]
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "files": {
     "project/.fgos/config.yaml": [
      "limits:",
      "  # keep this low",
      "  count: 8",
      "  # @fgos:why [vantt] dogfood repo, lighter gates.",
      "  tags:",
      "    - a"
     ]
    }
   }
  },
  {
   "id": "write-changed-key-replaces-why-keeps-doc-and-notes",
   "why": "spec 7: the why is replaced, the doc line and free notes stay in order",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass:",
      "  # @fgos:doc old doc",
      "  # @fgos:why [old] earlier reason",
      "  # Remember to reset",
      "  level: light"
     ]
    },
    "edits": [
     {
      "set": "gateBypass.level",
      "value": "heavy"
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass:",
      "  # @fgos:doc old doc",
      "  # @fgos:why [vantt] dogfood repo, lighter gates.",
      "  # Remember to reset",
      "  level: heavy"
     ]
    }
   }
  },
  {
   "id": "write-one-deep-value-changes-only-its-bytes",
   "why": "acceptance 2: every other byte, comments and spacing included, is identical",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "# a free note",
      "limits:   # trailing",
      "  count: 3",
      "  nested:",
      "    # @fgos:why [vantt] dogfood repo, lighter gates.",
      "    deep:   7   # inline",
      "  other: {x: 1}"
     ]
    },
    "edits": [
     {
      "set": "limits.nested.deep",
      "value": 9
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "# a free note",
      "limits:   # trailing",
      "  count: 3",
      "  nested:",
      "    # @fgos:why [vantt] dogfood repo, lighter gates.",
      "    deep:   9   # inline",
      "  other: {x: 1}"
     ]
    }
   }
  },
  {
   "id": "write-redundant-set-on-a-missing-key-is-a-notice",
   "why": "D14: a value equal to the standard is not written",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "limits:",
      "  count: 8"
     ]
    },
    "edits": [
     {
      "set": "gateBypass.level",
      "value": "off"
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "files": {
     "project/.fgos/config.yaml": [
      "limits:",
      "  count: 8"
     ]
    },
    "applied": [],
    "notices": [
     [
      "redundant-noop",
      "gateBypass.level"
     ]
    ]
   }
  },
  {
   "id": "write-redundant-set-on-a-present-key-becomes-unset",
   "why": "D14: the key goes back to inheriting the standard",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass:",
      "  # @fgos:why [old] earlier",
      "  level: light",
      "limits:",
      "  count: 8"
     ]
    },
    "edits": [
     {
      "set": "gateBypass.level",
      "value": "off"
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    },
    "ack": true
   },
   "expect": {
    "applied": [
     [
      "gateBypass.level",
      true
     ]
    ],
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass: {}",
      "limits:",
      "  count: 8"
     ]
    }
   }
  },
  {
   "id": "write-unset-of-a-key-with-a-why-needs-acknowledgement",
   "why": "spec 7: dropping a why is a comment loss the door must ask about",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass:",
      "  # @fgos:why [old] earlier",
      "  level: light"
     ]
    },
    "edits": [
     {
      "unset": "gateBypass.level"
     }
    ],
    "reason": "dogfood repo, lighter gates.",
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "yaml": "comment-would-be-lost"
   }
  },
  {
   "id": "write-unset-with-acknowledgement-removes-the-key-and-its-block",
   "why": "spec 7: acknowledged loss",
   "input": {
    "files": {
