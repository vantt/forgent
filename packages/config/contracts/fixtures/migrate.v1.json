      "  \"gateBypass\": {",
      "    \"level\": \"light\"",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "report": {
     "dropped_out_of_scope": [
      "gateway.port",
      "gateway.token"
     ],
     "kept": [
      "gateBypass.level"
     ]
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  level: light"
     ]
    }
   }
  },
  {
   "id": "migrate-refuses-a-global-only-value-that-differs",
   "why": "D14: a value only the global file may hold is never promoted or dropped silently",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"gateway\": {",
      "    \"port\": 9999",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "code": "config-key-out-of-scope",
    "paths": [
     "gateway.port"
    ],
    "absent": [
     "9999"
    ]
   }
  },
  {
   "id": "migrate-refuses-an-account-pool-in-the-project-file",
   "why": "spec 3/13: the pool belongs in the accounts file; the migration never moves it into the project file",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"accounts\": {",
      "    \"a\": {",
      "      \"login\": \"x\"",
      "    }",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "code": "config-key-in-wrong-file"
   }
  },
  {
   "id": "migrate-drops-a-comment-equal-to-the-schema-render",
   "why": "D15: a $comment the doc lines already say is not repeated as a note",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"runner\": {",
      "    \"$comment\": [",
      "      \"Tier ladder.\",",
