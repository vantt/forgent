{
 "version": 1,
 "about": "Owning cases of the project migration's decisions (docs/platform/config/spec.md section 13). Shared `schemas` and `standard`. A case lays files out as the snapshot fixture does (project/.fgos/config.json holds the legacy file; home/.fgos/config.yaml the machine's global file); input: files, accept (--accept-machine-overrides), dry_run, writer. Expect: absent (text no report or refusal may contain), code, paths (the path of each refusal), keyword (a refusal; every file stays byte-identical), or report (lists the report must hold, compared exactly) and files (path to the lines after). A written run also has its backup checked against the original bytes.",
 "schemas": {
  "gateBypass": [
   "type: object",
   "description: Gate bypass settings.",
   "properties:",
   "  level: {type: string, enum: [off, light, standard, heavy], description: Gate bypass level for agent work.}"
  ],
  "limits": [
   "type: object",
   "properties:",
   "  count: {type: integer, minimum: 1, description: Parallel runs.}",
   "  tags: {type: array, items: {type: string}}",
   "  nested: {type: object, properties: {deep: {type: integer}}}",
   "  other: {type: object}"
  ],
  "gateway": [
   "type: object",
   "x-fgos-scope: global-only",
   "properties:",
   "  port: {type: integer}",
   "  token: {type: [string, 'null'], x-fgos-file: token}"
  ],
  "accounts": [
   "type: object",
   "x-fgos-file: accounts",
   "additionalProperties:",
   "  type: object",
   "  properties:",
   "    login: {type: string}"
  ],
  "labels": [
   "type: object",
   "additionalProperties: {type: [string, 'null']}"
  ],
  "runner": [
   "type: object",
   "description: |",
   "  Tier ladder.",
   "  Second line.",
   "properties:",
   "  maxTier: {type: string, enum: [low, high]}"
  ],
  "rep": [
   "type: object",
   "x-fgos-merge: replace",
   "properties:",
   "  a: {type: integer}",
   "  b: {type: integer}"
  ]
 },
 "standard": {
  "gateBypass": [
   "gateBypass:",
   "  level: off"
  ],
  "limits": [
   "limits:",
   "  count: 4"
  ],
  "gateway": [
   "gateway:",
   "  port: 4170"
  ],
  "rep": [
   "rep:",
   "  a: 1"
  ]
 },
 "cases": [
  {
   "id": "migrate-keeps-a-value-with-doc-and-migrate-why",
   "why": "spec 13: every value kept carries its doc lines and a [migrate] reason after the writer id",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"gateBypass\": {",
      "    \"level\": \"light\"",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "report": {
     "kept": [
      "gateBypass.level"
     ],
     "dropped_redundant": []
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  level: light"
     ],
     "project/.fgos/config.json": [
      "moved to .fgos/config.yaml; upgrade fgOS"
     ]
    }
   }
  },
  {
   "id": "migrate-drops-a-value-equal-to-the-standard",
   "why": "spec 13/3: a value the standard holds is not carried over, and is listed",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"limits\": {",
      "    \"count\": 4",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "report": {
     "kept": [],
     "dropped_redundant": [
      "limits.count"
     ]
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      ""
     ],
     "project/.fgos/config.json": [
      "moved to .fgos/config.yaml; upgrade fgOS"
     ]
    }
   }
  },
  {
   "id": "migrate-keeps-file-order-and-drops-only-equal-leaves",
   "why": "spec 13: the other values keep the order of the file",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"limits\": {",
      "    \"tags\": [",
      "      \"a\"",
      "    ],",
      "    \"count\": 4,",
      "    \"nested\": {",
      "      \"deep\": 2",
      "    }",
      "  },",
      "  \"gateBypass\": {",
      "    \"level\": \"light\"",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "report": {
     "kept": [
      "limits.tags",
      "limits.nested.deep",
      "gateBypass.level"
     ],
     "dropped_redundant": [
      "limits.count"
     ]
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "limits:",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  tags:",
      "    - a",
      "  nested:",
      "    # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "    deep: 2",
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  level: light"
     ]
    }
   }
  },
  {
   "id": "migrate-drops-the-retired-key-and-the-map-it-empties",
   "why": "spec 13/10: lock.predecessorKillWaitMs is gone from every release; its map goes with it",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"lock\": {",
      "    \"predecessorKillWaitMs\": 2000",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "report": {
     "dropped_retired": [
      "lock.predecessorKillWaitMs"
     ],
     "kept": []
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      ""
     ]
    }
   }
  },
  {
   "id": "migrate-keeps-siblings-of-the-retired-key-as-unknown",
   "why": "spec 13: unknown sections are kept",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"lock\": {",
      "    \"predecessorKillWaitMs\": 2000,",
      "    \"other\": 2",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
