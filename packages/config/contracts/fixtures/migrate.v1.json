     ],
     "kept": [
      "lock.other"
     ],
     "unknown_kept": [
      "lock.other"
     ]
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "lock:",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  other: 2"
     ]
    }
   }
  },
  {
   "id": "migrate-keeps-an-unknown-section-with-its-reason",
   "why": "spec 13: unknown sections are kept",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"extra\": {",
      "    \"flag\": true",
      "  }",
      "}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "report": {
     "kept": [
      "extra.flag"
     ],
     "unknown_kept": [
      "extra.flag"
     ]
    },
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:v1",
      "# see: fgos config standard",
      "",
      "extra:",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  flag: true"
     ]
    }
   }
  },
  {
   "id": "migrate-drops-a-global-only-value-equal-to-the-standard-or-null",
   "why": "D14: gateway.port equal to the standard and gateway.token null leave the project file",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{",
      "  \"gateway\": {",
      "    \"port\": 4170,",
