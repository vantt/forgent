  {
   "id": "grammar-block-changed",
   "why": "the doc and notes stay, the why is replaced",
   "input": {
    "kind": "changed_block",
    "existing": [
     "@fgos:doc Old doc.",
     "@fgos:why [bob] old reason",
     "Remember to reset.",
     "second note"
    ],
    "writer": {
     "pid": 7
    },
    "reason": "new reason"
   },
   "expect": {
    "lines": [
     "@fgos:doc Old doc.",
     "@fgos:why [7] new reason",
     "Remember to reset.",
     "second note"
    ]
   }
  },
  {
   "id": "grammar-block-changed-no-why",
   "why": "a note-only block gains a why above its notes",
   "input": {
    "kind": "changed_block",
    "existing": [
     "a note"
    ],
    "writer": {
     "pid": 7
    },
    "reason": "r1"
   },
   "expect": {
    "lines": [
     "@fgos:why [7] r1",
     "a note"
    ]
   }
  },
  {
   "id": "grammar-block-changed-duplicate-why",
   "why": "a second hand-typed why is a note, not grammar",
   "input": {
    "kind": "changed_block",
    "existing": [
     "@fgos:why [a] one",
     "@fgos:why [b] two"
    ],
    "writer": {
     "pid": 7
    },
    "reason": "r1"
   },
   "expect": {
    "lines": [
     "@fgos:why [7] r1",
     "@fgos:why [b] two"
    ]
   }
  },
  {
   "id": "grammar-parse-well-formed",
   "why": "spec 7 table",
   "input": {
    "kind": "parse",
    "existing": [
     "@fgos:doc Old doc.",
     "@fgos:why [bob] old reason",
     "Remember to reset.",
     "second note"
    ]
   },
   "expect": {
    "doc": "@fgos:doc Old doc.",
    "why": [
     "bob",
     "old reason"
    ],
    "free": [
     "Remember to reset.",
     "second note"
    ]
   }
  },
  {
