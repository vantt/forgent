  {
   "id": "grammar-doc-enum-default",
   "why": "spec 7: the doc line comes from the schema node",
   "input": {
    "kind": "doc",
    "node": {
     "description": "Gate bypass level for agent work.",
     "enum": [
      "off",
      "light",
      "standard",
      "heavy"
     ],
     "default": "off"
    }
   },
   "expect": {
    "line": "@fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off."
   }
  },
  {
   "id": "grammar-doc-bounds",
   "why": "spec 7: the doc line comes from the schema node",
   "input": {
    "kind": "doc",
    "node": {
     "description": "Retry count",
     "minimum": 0,
     "maximum": 5,
     "default": 2
    }
   },
   "expect": {
    "line": "@fgos:doc Retry count. Minimum: 0. Maximum: 5. Default: 2."
   }
  },
  {
