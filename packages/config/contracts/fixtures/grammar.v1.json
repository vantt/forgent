   "id": "grammar-block-new",
   "why": "spec 7: doc then why",
   "input": {
    "kind": "new_block",
    "node": {
     "description": "Gate bypass level for agent work.",
     "enum": [
      "off",
      "light",
      "standard",
      "heavy"
     ],
     "default": "off"
    },
    "writer": {
     "session": "vantt"
    },
    "reason": "dogfood"
   },
   "expect": {
    "lines": [
     "@fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
     "@fgos:why [vantt] dogfood"
    ]
   }
  },
