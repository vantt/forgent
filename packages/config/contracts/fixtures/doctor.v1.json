      "gateBypass"
     ],
     [
      "config-comment-missing-doc",
      "global:config.yaml",
      "gateBypass.level"
     ],
     [
      "config-comment-missing-why",
      "global:config.yaml",
      "gateBypass.level"
     ]
    ]
   }
  },
  {
