     [
      "config-redundant-value",
      "project:config.yaml",
      "gateBypass.level"
     ],
     [
      "config-redundant-value",
      "project:config.yaml",
      "limits.count"
     ]
    ],
    "details": {
     "config-redundant-value gateBypass.level": "plain",
     "config-redundant-value limits.count": "needs-acknowledgement"
    }
   }
  },
  {
   "id": "a-broken-project-does-not-hide-the-global-file",
   "why": "D20: each source is judged on its own",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass: [unclosed"
     ],
     "home/.fgos/config.yaml": [
      "gateBypass:",
      "  level: heavy"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
