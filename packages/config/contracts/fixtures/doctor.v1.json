{
 "version": 1,
 "about": "Owning cases of the findings engine (docs/platform/config/spec.md sections 7, 11, 13) and of the repairs. Shared `schemas` and `standard`. Input: files (as the snapshot fixture), facts ({modes: [file, expected, actual], machine_files, destinations: [path, absent|equal|different]}), stale and fresh (files whose mtime is set 40 and 1 days before `now`), fix (fix ids to apply) and ack. Expect for a check: rows ([row, file, path] triples, compared as sets), details (`row path` to detail, the last word of it), fixes (row to fix id), severity (row to [doctor, check]), absent (text no finding may contain). Expect for a fix: applied ([fix id, path]), files (after), code (a refusal's rule or id); the repair is run twice and the second run must apply nothing.",
 "schemas": {
  "gateBypass": [
   "type: object",
   "description: Gate bypass settings.",
   "properties:",
   "  level: {type: string, enum: [off, light, standard, heavy], description: Gate bypass level for agent work.}"
  ],
  "limits": [
   "type: object",
   "properties:",
   "  count: {type: integer, minimum: 1, description: Parallel runs.}"
  ],
  "gateway": [
   "type: object",
   "x-fgos-scope: global-only",
   "properties:",
   "  port: {type: integer}"
  ],
  "accounts": [
   "type: object",
   "x-fgos-file: accounts",
   "additionalProperties:",
   "  type: object",
   "  properties:",
   "    login: {type: string}"
  ],
  "labels": [
   "type: object",
   "additionalProperties: {type: [string, 'null']}"
  ]
 },
 "standard": {
  "gateBypass": [
   "gateBypass:",
   "  level: off"
  ],
  "limits": [
   "limits:",
   "  count: 4"
  ],
  "gateway": [
   "gateway:",
   "  port: 4170"
  ]
 },
 "cases": [
  {
   "id": "clean-file-has-no-finding",
   "why": "a rendered file with a reason on its value",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] dogfood repo.",
      "  level: light"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": []
   }
  },
  {
   "id": "unparseable-file-is-config-parse",
   "why": "spec 11: strict-config refuses it, with its position",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass: [unclosed"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-parse",
      "project:config.yaml",
      null
     ]
    ]
   }
  },
  {
   "id": "schema-violation-is-config-schema",
   "why": "spec 11: the value breaks the section schema",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] dogfood repo.",
      "  level: bogus"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-schema",
      "project:config.yaml",
      "gateBypass.level"
     ]
    ]
   }
  },
  {
   "id": "both-files-is-legacy-shadowed",
   "why": "spec 5/11: config.yaml and config.json together",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] dogfood repo.",
      "  level: light"
     ],
     "project/.fgos/config.json": [
      "{\"gateBypass\": {\"level\": \"light\"}}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-legacy-shadowed",
      ".fgos/config.json",
      null
     ]
    ]
   }
  },
  {
   "id": "legacy-json-reports-only-its-format",
   "why": "D19: a JSON file has no comments, so it has no doc, reason or note rows",
   "input": {
    "files": {
     "project/.fgos/config.json": [
      "{\"gateBypass\": {\"level\": \"light\"}, \"extra\": 1}"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-format-legacy-json",
      "project:config.json",
      null
     ]
    ]
   }
  },
  {
   "id": "missing-doc-and-drifted-doc",
   "why": "spec 7/11: both rows offer refresh-docs; doctor warns, check fails on drift",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass:",
      "  # @fgos:doc Old wording.",
      "  # @fgos:why [vantt] dogfood repo.",
      "  level: light"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-comment-missing-doc",
      "project:config.yaml",
      "gateBypass"
     ],
     [
      "config-doc-drift",
      "project:config.yaml",
      "gateBypass.level"
     ]
    ],
    "severity": {
     "config-doc-drift": [
      "warn",
      "fail"
     ],
     "config-comment-missing-doc": [
      "warn",
      "warn"
     ],
     "config-schema": [
      "fail",
      "fail"
     ]
    }
   }
  },
  {
   "id": "value-without-a-reason-and-migrated-reason",
   "why": "spec 7/13: a value with no why warns; a [migrate] why is listed until replaced",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  level: light",
      "limits:",
      "  # @fgos:doc Parallel runs. Minimum: 1. Default: 4.",
      "  # @fgos:why [vantt] [migrate] carried over from config.json, reason never recorded",
      "  count: 8"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-comment-missing-why",
