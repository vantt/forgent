  {
   "id": "a-pool-in-the-global-file-is-a-wrong-file-row-with-a-copy-fix",
   "why": "spec 11/13: no destination yet, so it fails and offers the copy",
   "input": {
    "files": {
     "home/.fgos/config.yaml": [
      "accounts:",
      "  a:",
      "    login: x"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-key-in-wrong-file",
      "global:config.yaml",
      "accounts"
     ]
    ],
    "fixes": {
     "config-key-in-wrong-file": "copy-to-destination"
    },
    "details": {
     "config-key-in-wrong-file accounts": "destination-absent"
    }
   }
  },
  {
   "id": "a-pool-already-in-its-destination-is-a-warning-with-no-fix",
