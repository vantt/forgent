      "extra"
     ]
    ]
   }
  },
  {
   "id": "redundant-value-says-whether-a-note-would-go",
   "why": "spec 11: equal to the standard; a note on it needs the acknowledgement",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  level: off",
      "limits:",
      "  # @fgos:doc Parallel runs. Minimum: 1. Default: 4.",
      "  # @fgos:why [vantt] dogfood repo.",
      "  count: 4"
     ]
