{
 "version": 1,
 "about": "Owning cases of the findings engine (docs/platform/config/spec.md sections 7, 11, 13) and of the repairs. Shared `schemas` and `standard`. Input: files (as the snapshot fixture), machine (`bare`: no private directory or token; every other case gets a healthy machine), modes (file under the global directory to the mode set before the check), class, stale and fresh (files whose mtime is set 40 and 1 days before `now`), fix (fix ids to apply) and ack. Expect for a check: rows ([row, file, path] triples, compared as sets), details (`row path` to detail, the last word of it), fixes (row to fix id), severity (row to [doctor, check]), absent (text no finding may contain). Expect for a fix: applied ([fix id, path]), files (after), absent (paths that must be gone), modes (path to mode after), code (a refusal's rule or id); the repair is run twice and the second run must apply nothing.",
 "schemas": {
  "gateBypass": [
   "type: object",
   "description: Gate bypass settings.",
   "properties:",
   "  level: {type: string, enum: [off, light, standard, heavy], description: Gate bypass level for agent work.}"
  ],
  "limits": [
   "type: object",
   "properties:",
   "  count: {type: integer, minimum: 1, description: Parallel runs.}"
  ],
  "gateway": [
   "type: object",
   "x-fgos-scope: global-only",
   "properties:",
   "  port: {type: integer}"
  ],
  "accounts": [
   "type: object",
   "x-fgos-file: accounts",
   "additionalProperties:",
   "  type: object",
   "  properties:",
   "    login: {type: string}"
  ],
  "labels": [
   "type: object",
   "additionalProperties: {type: [string, 'null']}"
  ],
  "mixed": [
   "type: object",
   "x-fgos-merge: deep",
   "additionalProperties: {}"
  ]
 },
 "standard": {
  "gateBypass": [
   "gateBypass:",
   "  level: off"
  ],
  "limits": [
   "limits:",
   "  count: 4"
  ],
  "gateway": [
   "gateway:",
   "  port: 4170"
  ]
 },
 "cases": [
  {
   "id": "clean-file-has-no-finding",
   "why": "a rendered file with a reason on its value",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "# @fgos:doc Gate bypass settings.",
      "gateBypass:",
      "  # @fgos:doc Gate bypass level for agent work. Values: off | light | standard | heavy. Default: off.",
      "  # @fgos:why [vantt] dogfood repo.",
      "  level: light"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": []
   }
  },
  {
   "id": "unparseable-file-is-config-parse",
   "why": "spec 11: strict-config refuses it, with its position",
   "input": {
    "files": {
     "project/.fgos/config.yaml": [
      "gateBypass: [unclosed"
     ]
    },
    "writer": {
     "session": "vantt"
    }
   },
   "expect": {
    "rows": [
     [
      "config-parse",
      "project:config.yaml",
      null
     ]
    ]
   }
  },
  {
   "id": "schema-violation-is-config-schema",
   "why": "spec 11: the value breaks the section schema",
