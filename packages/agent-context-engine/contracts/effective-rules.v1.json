{
  "contract": "agent-context-engine-effective-rules.v1",
  "description": "The compiled, checked rule set ACE hands to ASC (file .fgos/instructions/effective/rules.json). digest = sha256 hex of the canonical JSON (keys sorted, no whitespace, UTF-8) of the rules array. A reader recomputes it and refuses on mismatch.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "whenKeysVersion",
      "digest",
      "rules"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "whenKeysVersion": {
        "type": "integer",
        "description": "version of when-keys.v2.json the set was checked against"
      },
      "digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "rules": {
        "type": "array",
        "description": "In-force rules in composition order: kind order, then scope breadth, then specificity, then authority (platform, component, domain), then source path, then id.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "owner",
            "kind",
            "scope",
            "specificity",
            "body",
            "sources",
            "when"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "law",
                "boundary",
                "procedure",
                "host-adapter",
                "preference"
              ]
            },
            "scope": {
              "type": "string"
            },
            "specificity": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "description": "repo-relative path of the unit file"
              }
            },
            "when": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
