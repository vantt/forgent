{
  "contract": { "id": "lock-registry", "version": 1 },
  "description": "One row per lock. Rust and Node read this file; it is the only list of which locks exist and in which order they may be taken. v3Path is relative to <fgosDir>/locks/, <lockRoot>/ or <runDir>/ as written.",
  "ranks": {
    "10": { "kinds": ["lease"], "note": "runner, gateway" },
    "15": { "kinds": ["lease"], "note": "attempt" },
    "20": { "kinds": ["mutex"], "note": "merge-slot--<target>" },
    "30": { "kinds": ["lease"], "note": "dispatch cwd" },
    "40": { "kinds": ["mutex"], "note": "worktree-admin" },
    "50": { "kinds": ["mutex"], "note": "main checkout" },
    "55": { "kinds": [], "note": "git index.lock: outside fgOS, no registry row; the hook tries rank 50 once" },
    "58": { "kinds": ["mutex"], "note": "event-seal" },
    "60": { "kinds": ["hot-mutex"], "note": "hot state (events + claims)" },
    "70": { "kinds": ["mutex"], "note": "event-append" },
    "80": { "kinds": ["mutex", "lease"], "note": "leaves: sessions, advance, reconcile, recovery, observe, provider account, activation, install, full-suite" }
  },
  "locks": [
    {
      "name": "gateway",
      "kind": "lease",
      "scope": "repo",
      "rank": 10,
      "v3Path": "<fgosDir>/locks/gateway.lock",
      "owner": "4.2",
      "note": "v1 source: src/runner/gateway-control.mjs LOCK_FILE"
    },
    {
      "name": "runner",
      "kind": "lease",
      "scope": "repo",
      "rank": 10,
      "v3Path": "<fgosDir>/locks/runner.lock",
      "owner": "4.2",
      "note": "v1 source: src/runner/loop.mjs LOCK_FILE"
    },
    {
      "name": "documentation-cutover",
      "kind": "lease",
      "scope": "repo",
      "rank": 10,
      "v3Path": "<fgosDir>/locks/documentation-cutover.lock",
      "owner": "documentation",
      "note": "documentation cutover write lease; public acquire API only (D8)"
    },
    {
      "name": "sessions",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/sessions.lock",
      "owner": "4.2",
      "note": "v1 source: src/runner/session.mjs SESSIONS_LOCK"
    },
    {
      "name": "advance",
      "kind": "mutex",
      "scope": "run",
      "rank": 80,
      "v3Path": "<workflowRunDir>/locks/advance.lock",
      "owner": "4.2",
      "note": "v1 source: src/workflow/runner.mjs ADVANCE_LOCK_FILE"
    },
    {
      "name": "reconcile",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/reconcile.lock",
      "owner": "4.2",
      "note": "v1 source: src/runner/dispatch/reconciliation-planner.mjs localLock"
    },
    {
      "name": "recovery",
      "kind": "mutex",
      "scope": "run",
      "rank": 80,
      "v3Path": "<runDir>/locks/recovery.lock",
      "owner": "4.2",
      "note": "Dispatch recovery uses its runDir; Git recovery reuses this entry with runDir=<common>/fgos/git. v1 source: src/verbs/dispatch/recover.mjs withRunLock"
    },
    {
      "name": "full-suite",
      "kind": "lease",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/full-suite.lock",
      "owner": "4.2",
      "note": "v1 source: scripts/lib/full-suite-queue.mjs DEFAULT_LOCK_PATH"
    },
    {
      "name": "provider-account",
      "kind": "mutex",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/provider-account/<provider>/<account>.lock",
      "owner": "4.2",
      "note": "v1 source: src/runner/dispatch/provider-capacity.mjs tryAcquireAccountLock"
    },
    {
      "name": "provider-state",
      "kind": "mutex",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/provider-state.lock",
      "owner": "4.2",
      "note": "v1 source: src/runner/dispatch/provider-capacity.mjs state lock"
    },
    {
      "name": "dispatch-cwd",
      "kind": "lease",
      "scope": "repo",
      "rank": 30,
      "v3Path": "<fgosDir>/locks/dispatch-cwd--<cwdDevIno>.lock",
      "owner": "4.2",
      "note": "v3 key <cwdDevIno> is dev-ino of the cwd after realpath, so every spelling of one directory (symlinks included) names one lock. v1 source: src/runner/main-checkout-lock.mjs dispatchLockFile"
    },
    {
      "name": "main-checkout",
      "kind": "mutex",
      "scope": "repo",
      "rank": 50,
      "v3Path": "<fgosDir>/locks/main-checkout.lock",
      "owner": "4.3",
      "note": "v1 source: src/runner/main-checkout-lock.mjs; borrowed by git children through contracts/main-checkout-borrow.v1.json"
    },
    {
      "name": "merge-slot",
      "kind": "mutex",
      "scope": "repo",
      "rank": 20,
      "v3Path": "<fgosDir>/locks/merge-slot--<ref>.lock",
      "owner": "4.3",
      "note": "<ref> is encodeURIComponent(target ref), as v1 mergeSlotLockFile in src/runner/main-checkout-lock.mjs writes it"
    },
    {
      "name": "state",
      "kind": "hot-mutex",
      "scope": "repo",
      "rank": 60,
      "v3Path": "<fgosDir>/locks/state.reclaim.lock",
      "owner": "4.3",
      "note": "events and claims merge into one hot mutex; v3Path is the kernel lock that serialises cleanup of a dead holder, the hot record itself is <fgosDir>/locks/state.hot (contracts/hot-lock.v1.json)"
    },
    {
      "name": "porting-events",
      "kind": "hot-mutex",
      "scope": "repo",
      "rank": 60,
      "v3Path": "<fgosDir>/locks/porting-events.reclaim.lock",
      "owner": "4.3",
      "note": "v1 source: src/state/porting-store.mjs"
    },
    {
      "name": "worktree-admin",
      "kind": "mutex",
      "scope": "repo",
      "rank": 40,
      "v3Path": "<fgosDir>/locks/worktree-admin.lock",
      "owner": "4.3",
      "note": "new lock, no v1 predecessor"
    },
    {
      "name": "activation",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/activation-v2.lock",
      "owner": "4.4",
      "note": "fgctl places the old v3 fence under both activation locks at first git-wal-v1 activation; the 4.4 fence remains"
    },
    {
      "name": "install",
      "kind": "mutex",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/install.lock",
      "owner": "4.4",
      "note": "v1 source: packages/distribution/rust/src/store.rs InstallLockGuard; <stateRoot> is the machine release store root and <lockRoot> is <stateRoot>/locks"
    },
    {
      "name": "observe",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/observe.lock",
      "owner": "4.4",
      "note": "v1 source: packages/observe/rust/src/store_lock.rs acquire_store_lock"
    },
    {
      "name": "attempt",
      "kind": "lease",
      "scope": "run",
      "rank": 15,
      "v3Path": "<runDir>/runs/<NN>/attempt.lock",
      "owner": "6.2",
      "note": "new lock; the file lives in the run directory and is removed with the run"
    },
    {
      "name": "event-seal",
      "kind": "mutex",
      "scope": "repo",
      "rank": 58,
      "v3Path": "<eventOpenRoot>/locks/event-seal.lock",
      "owner": "event-store"
    },
    {
      "name": "event-append",
      "kind": "mutex",
      "scope": "repo",
      "rank": 70,
      "v3Path": "<eventOpenRoot>/locks/event-append.lock",
      "owner": "event-store"
    },
    {
      "name": "repo-config",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/repo-config.lock",
      "owner": "git"
    }
  ]
}
