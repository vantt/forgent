{
  "contract": { "id": "lock-registry", "version": 1 },
  "description": "One row per lock. Rust and Node read this file; it is the only list of which locks exist, in which order they may be taken, and which fence the cutover places for them. v3Path is relative to <fgosDir>/locks/, <lockRoot>/ or <runDir>/ as written. v1Path is the legacy location (repo-relative, `.fgos/...`, or absolute pattern); v1 code is checked by running it from the track's base commit, because the v1 code is deleted by the cutover.",
  "ranks": {
    "10": { "kinds": ["lease"], "note": "runner, gateway" },
    "15": { "kinds": ["lease"], "note": "attempt" },
    "20": { "kinds": ["mutex"], "note": "merge-slot--<target>" },
    "30": { "kinds": ["lease"], "note": "dispatch cwd" },
    "40": { "kinds": ["mutex"], "note": "worktree-admin" },
    "50": { "kinds": ["mutex"], "note": "main checkout" },
    "55": { "kinds": [], "note": "git index.lock: outside fgOS, no registry row; the hook tries rank 50 once" },
    "60": { "kinds": ["hot-mutex"], "note": "hot state (events + claims)" },
    "80": { "kinds": ["mutex", "lease"], "note": "leaves: sessions, advance, reconcile, recovery, observe, provider account, activation, install, full-suite" }
  },
  "locks": [
    {
      "name": "gateway",
      "kind": "lease",
      "scope": "repo",
      "rank": 10,
      "v3Path": "<fgosDir>/locks/gateway.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/gateway.lock",
      "fence": "tombstone",
      "owner": "4.2",
      "note": "v1 source: src/runner/gateway-control.mjs LOCK_FILE"
    },
    {
      "name": "runner",
      "kind": "lease",
      "scope": "repo",
      "rank": 10,
      "v3Path": "<fgosDir>/locks/runner.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/runner.lock",
      "fence": "tombstone",
      "owner": "4.2",
      "note": "v1 source: src/runner/loop.mjs LOCK_FILE"
    },
    {
      "name": "sessions",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/sessions.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/sessions.lock",
      "fence": "tombstone",
      "owner": "4.2",
      "note": "v1 source: src/runner/session.mjs SESSIONS_LOCK"
    },
    {
      "name": "advance",
      "kind": "mutex",
      "scope": "run",
      "rank": 80,
      "v3Path": "<workflowRunDir>/advance.lock",
      "v1Shape": "file-wx",
      "v1Path": ".fgos/workflow-runs/<id>/advance.lock",
      "fence": "tombstone",
      "fenceNote": "every run that exists at cutover; not placed lazily",
      "owner": "4.2",
      "note": "v1 source: src/workflow/runner.mjs ADVANCE_LOCK_FILE"
    },
    {
      "name": "reconcile",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": "<fgosDir>/locks/reconcile.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/dispatch/reconcile.lock",
      "fence": "tombstone",
      "owner": "4.2",
      "note": "v1 source: src/runner/dispatch/reconciliation-planner.mjs localLock"
    },
    {
      "name": "recovery",
      "kind": "mutex",
      "scope": "run",
      "rank": 80,
      "v3Path": "<runDir>/recovery.lock",
      "v1Shape": "file-wx",
      "v1Path": "<runDir>/.recovery.lock",
      "fence": "tombstone",
      "fenceNote": "every run that exists at cutover; not placed lazily",
      "owner": "4.2",
      "note": "v1 source: src/verbs/dispatch/recover.mjs withRunLock"
    },
    {
      "name": "full-suite",
      "kind": "lease",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/full-suite.lock",
      "v1Shape": "file-wx",
      "v1Path": "<os.tmpdir()>/fgos-full-suite.lock",
      "fence": "none",
      "fenceNote": "a tombstone makes the old branch's queue loop forever (scripts/lib/full-suite-queue.mjs); without a fence an old branch only runs the suite unqueued, which is harmless",
      "owner": "4.2",
      "note": "v1 source: scripts/lib/full-suite-queue.mjs DEFAULT_LOCK_PATH"
    },
    {
      "name": "provider-account",
      "kind": "mutex",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/provider-account/<provider>/<account>.lock",
      "v1Shape": "ledger-dir",
      "v1Path": "~/.fgos/runtime/provider-capacity/account-locks/<provider>/<account>/lock/",
      "fence": "blocking-generation",
      "fenceNote": "every account that exists at cutover; a tombstone does not stop a generation ledger",
      "owner": "4.2",
      "note": "v1 source: src/runner/dispatch/provider-capacity.mjs tryAcquireAccountLock"
    },
    {
      "name": "provider-state",
      "kind": "mutex",
      "scope": "machine",
      "rank": 80,
      "v3Path": "<lockRoot>/provider-state.lock",
      "v1Shape": "ledger-dir",
      "v1Path": "~/.fgos/runtime/provider-capacity/state-lock/",
      "fence": "blocking-generation",
      "owner": "4.2",
      "note": "v1 source: src/runner/dispatch/provider-capacity.mjs state lock"
    },
    {
      "name": "dispatch-cwd",
      "kind": "lease",
      "scope": "repo",
      "rank": 30,
      "v3Path": "<fgosDir>/locks/dispatch--<encodeURIComponent(cwd)>.lock",
      "v1Shape": "file-by-cwd",
      "v1Path": ".fgos/dispatch--<encodeURIComponent(cwd)>.lock",
      "fence": "tombstone",
      "fenceNote": "both the path.resolve form and the realpath form, for every worktree and claim that exists at cutover; scope stays fgosDir",
      "owner": "4.2",
      "note": "v1 source: src/runner/main-checkout-lock.mjs dispatchLockFile"
    },
    {
      "name": "main-checkout",
      "kind": "mutex",
      "scope": "repo",
      "rank": 50,
      "v3Path": "<fgosDir>/locks/main-checkout.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/main-checkout.lock",
      "fence": "tombstone",
      "owner": "4.3"
    },
    {
      "name": "merge-slot",
      "kind": "mutex",
      "scope": "repo",
      "rank": 20,
      "v3Path": "<fgosDir>/locks/merge-slot--<ref>.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/merge-slot--<ref>.lock",
      "fence": "tombstone",
      "owner": "4.3"
    },
    {
      "name": "state",
      "kind": "hot-mutex",
      "scope": "repo",
      "rank": 60,
      "v3Path": "<fgosDir>/locks/state.lock",
      "v1Shape": "file-link",
      "v1Path": [".fgos/events.lock", ".fgos/runtime/claims.lock"],
      "fence": "tombstone",
      "owner": "4.3",
      "note": "events and claims merge into one hot mutex"
    },
    {
      "name": "porting-events",
      "kind": "hot-mutex",
      "scope": "repo",
      "rank": 60,
      "v3Path": "<fgosDir>/locks/porting-events.lock",
      "v1Shape": "file-link",
      "v1Path": ".fgos/porting/events.lock",
      "fence": "tombstone",
      "owner": "4.3",
      "note": "v1 source: src/state/porting-store.mjs"
    },
    {
      "name": "worktree-admin",
      "kind": "mutex",
      "scope": "repo",
      "rank": 40,
      "v3Path": "<fgosDir>/locks/worktree-admin.lock",
      "v1Shape": null,
      "v1Path": null,
      "fence": null,
      "owner": "4.3",
      "note": "new lock, no v1 predecessor"
    },
    {
      "name": "activation",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": null,
      "v1Shape": null,
      "v1Path": "packages/distribution/rust/src/init.rs",
      "fence": null,
      "fenceNote": "per the 4.4 plan",
      "owner": "4.4",
      "note": "Rust-owned; scope and path are fixed by the 4.4 plan"
    },
    {
      "name": "install",
      "kind": "mutex",
      "scope": "machine",
      "rank": 80,
      "v3Path": null,
      "v1Shape": null,
      "v1Path": "packages/distribution/rust/src/store.rs",
      "fence": null,
      "fenceNote": "per the 4.4 plan",
      "owner": "4.4",
      "note": "Rust-owned; scope and path are fixed by the 4.4 plan"
    },
    {
      "name": "observe",
      "kind": "mutex",
      "scope": "repo",
      "rank": 80,
      "v3Path": null,
      "v1Shape": null,
      "v1Path": "packages/observe/rust/src/store_lock.rs",
      "fence": null,
      "fenceNote": "per the 4.4 plan",
      "owner": "4.4",
      "note": "Rust-owned; scope and path are fixed by the 4.4 plan"
    },
    {
      "name": "attempt",
      "kind": "lease",
      "scope": "run",
      "rank": 15,
      "v3Path": "<runDir>/runs/<NN>/attempt.lock",
      "v1Shape": null,
      "v1Path": null,
      "fence": null,
      "owner": "6.2",
      "note": "new lock; the file lives in the run directory and is removed with the run"
    }
  ]
}
