    { "name": "all-allowed-punctuation", "attemptId": "A.b_C-9", "writerId": "att-A.b_C-9" },
    { "name": "longest-valid", "attemptId": "{196 x a}", "writerId": "{att- + 196 x a}", "expand": { "char": "a", "count": 196 } },
    { "name": "one-over", "attemptId": "{197 x a}", "error": "invalid-attempt-id", "expand": { "char": "a", "count": 197 } },
    { "name": "empty", "attemptId": "", "error": "invalid-attempt-id" },
