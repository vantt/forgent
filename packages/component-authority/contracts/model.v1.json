{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fgos.invalid/component-authority/model.v1.json",
  "title": "fgOS Component Authority Model Schema v1",
  "description": "Defines the single structural model of layers, components, decision kinds, doors, contracts, and files. Each model file validates against its own def (components.json items: #/$defs/component, decision-kinds.json items: #/$defs/decisionKind, doors/*.json: #/$defs/door, contracts.json items: #/$defs/contract, layers.json: #/$defs/layers, files.json: #/$defs/files).",
  "$defs": {
    "layers": {
      "type": "object",
      "required": ["layers", "rules", "domains", "tierNames"],
      "additionalProperties": false,
      "properties": {
        "contract": { "type": "string" },
        "layers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tierNames": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tierExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "tier", "reason"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "tier": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "canonical",
        "aliases",
        "meaning",
        "layer",
        "tier",
        "paths",
        "owns",
        "mustNotOwn",
        "spec",
        "source",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "canonical": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meaning": { "type": "string" },
        "parent": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["entry", "use-case", "infra", "domain", "kernel"]
        },
        "tier": { "type": "integer", "minimum": 0, "maximum": 9 },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "layer": {
                "type": "string",
                "enum": ["entry", "use-case", "infra", "domain", "kernel"]
              },
              "tier": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        },
        "owns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mustNotOwn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "spec": { "type": "string" },
        "source": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["live", "designed", "planned", "draft", "retired"]
        }
      }
    },
    "decisionKind": {
      "type": "object",
      "required": ["id", "canonical", "aliases", "meaning", "owner", "narrative"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "canonical": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meaning": { "type": "string" },
        "owner": { "type": "string" },
        "narrative": { "type": "string" }
      }
    },
    "door": {
      "type": "object",
      "required": ["job", "kind", "patterns", "allowed"],
      "additionalProperties": false,
      "properties": {
        "job": { "type": "string" },
        "kind": { "type": "string" },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string" },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string" },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "reason": { "type": "string" },
        "retiredBy": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["id", "canonical", "aliases", "meaning", "provider", "consumers", "evidence", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "canonical": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meaning": { "type": "string" },
        "provider": { "type": "string" },
        "consumers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "guards": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "version": {
          "anyOf": [
            { "type": "string" },
            { "type": "integer" }
          ]
        },
        "path": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["live", "designed", "planned"]
        }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
