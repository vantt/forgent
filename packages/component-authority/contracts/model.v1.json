{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fgos.invalid/component-authority/model.v1.json",
  "title": "fgOS Component Authority Model Schema v1",
  "description": "Defines the single structural model of layers, components, decision kinds, doors, and contracts. Each model file validates against its own def (components.yaml items: #/$defs/component, decision-kinds.yaml items: #/$defs/decisionKind, doors/*.yaml: #/$defs/door, contracts.yaml items: #/$defs/contract, layers.yaml: #/$defs/layers).",
  "$defs": {
    "layers": {
      "type": "object",
      "required": ["layers", "rules", "domains", "tierNames"],
      "additionalProperties": false,
      "properties": {
        "contract": { "type": "string" },
        "layers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tierNames": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tierExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "tier", "reason"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "tier": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "canonical",
        "aliases",
        "meaning",
        "layer",
        "tier",
        "paths",
        "owns",
        "mustNotOwn",
        "spec",
        "source",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "canonical": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meaning": { "type": "string" },
        "parent": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["entry", "use-case", "infra", "domain", "kernel"]
        },
        "tier": { "type": "integer", "minimum": 0, "maximum": 9 },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "layer": {
                "type": "string",
                "enum": ["entry", "use-case", "infra", "domain", "kernel"]
              },
              "tier": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        },
        "owns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mustNotOwn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "spec": { "type": "string" },
        "source": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["live", "designed", "planned", "draft", "retired"]
        },
        "reason": { "type": "string" }
      }
    },
    "decisionKind": {
      "type": "object",
      "required": ["id", "canonical", "aliases", "meaning", "owner", "narrative"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "canonical": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meaning": { "type": "string" },
        "owner": { "type": "string" },
        "narrative": { "type": "string" },
        "readFirst": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Read-first cell override: repo-relative path with optional #anchor. When set, the governance holder view uses this instead of deriving the portal from the owner component."
        },
        "facts": {
          "description": "Optional Facts-and-RULs cell override: one path (with optional #anchor) or an array of them. When set, the governance holder view uses these instead of deriving specs from the owner and its children.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        }
      }
    },
    "door": {
      "type": "object",
      "required": ["job", "kind", "severity", "patterns", "allowed"],
      "additionalProperties": false,
      "properties": {
        "job": { "type": "string" },
        "kind": { "type": "string" },
        "severity": {
          "description": "high: a live twin or copy that decides a live answer which can disagree; medium: a live side that only asks the owner, or live named debt that decides nothing differently; low: a twin reached only by dead code, or a row with no debt and no twin.",
          "enum": ["high", "medium", "low"]
        },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "names": {
          "description": "Canonical name plus aliases of the job; matched as whole identifiers on code tokens only.",
          "type": "array",
          "items": { "type": "string" }
        },
        "primitives": {
          "description": "Regex sources of the calls or imports that do the job; matched on code tokens only.",
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string" },
                  "count": { "type": "integer", "minimum": 0, "description": "Most matches the file may hold; one more fails." },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string" },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "reason": { "type": "string" },
        "retiredBy": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["id", "canonical", "aliases", "meaning", "provider", "consumers", "evidence", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "canonical": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meaning": { "type": "string" },
        "reason": { "type": "string" },
        "provider": { "type": "string" },
        "consumers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "guards": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ]
        },
        "version": {
          "anyOf": [
            { "type": "string" },
            { "type": "integer" }
          ]
        },
        "path": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["live", "designed", "planned"]
        }
      }
    }
  }
}
