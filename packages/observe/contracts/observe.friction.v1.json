{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "observe.friction.v1",
  "title": "Observe Friction Shard Event Contract v1",
  "description": "Schema for append-only friction records stored in .fgos/observe/friction/<writerId>.jsonl.",
  "oneOf": [
    {
      "title": "FrictionRecorded",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "ts",
        "subject",
        "layer",
        "errorClass",
        "disposition",
        "detail",
        "producer",
        "caller"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1,
          "description": "Contract version."
        },
        "type": {
          "type": "string",
          "const": "friction-recorded",
          "description": "Event type discriminator."
        },
        "ts": {
          "type": "string",
          "description": "ISO 8601 timestamp."
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["run", "session", "executor", "case", "work"]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "layer": {
          "type": "string",
          "enum": [
            "verification",
            "state",
            "environment",
            "docs",
            "spec",
            "context",
            "task",
            "task-spec",
            "executor",
            "attestation"
          ]
        },
        "errorClass": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": ["advisory", "blocked", "parked", "halted"]
        },
        "detail": {
          "type": "string"
        },
        "attempts": {
          "type": ["integer", "null"]
        },
        "docType": {
          "type": ["string", "null"],
          "enum": ["tutorial", "how-to", "reference", "explanation", null]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "caller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid"],
          "properties": {
            "pid": { "type": "integer" },
            "sessionId": { "type": "string" }
          }
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "seq"],
          "properties": {
            "src": { "type": "string" },
            "seq": { "type": "integer" }
          }
        }
      }
    },
    {
      "title": "FrictionResolved",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "ts", "subject", "reason", "by", "caller"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "friction-resolved"
        },
        "ts": {
          "type": "string"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["run", "session", "executor", "case", "work"]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reason": {
          "type": "string",
          "enum": ["answer", "done", "wontfix", "clarify-pass", "migrated"]
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "caller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid"],
          "properties": {
            "pid": { "type": "integer" },
            "sessionId": { "type": "string" }
          }
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "seq"],
          "properties": {
            "src": { "type": "string" },
            "seq": { "type": "integer" }
          }
        }
      }
    },
    {
      "title": "MigrationMarker",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from", "count", "resolved", "ts"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "migration"
        },
        "from": {
          "type": "string",
          "const": "work.friction"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string"
        }
      }
    }
  ]
}
