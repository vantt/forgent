{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "observe.case.v1",
  "title": "Observe Case Journal Event Contract v1",
  "description": "Schema for append-only case lifecycle journal events stored in .fgos/observe/cases/<writerId>.jsonl.",
  "oneOf": [
    {
      "title": "CaseOpened",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "ts", "name", "project", "harness"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1,
          "description": "Contract version."
        },
        "type": {
          "type": "string",
          "const": "case-opened",
          "description": "Lifecycle transition type."
        },
        "ts": {
          "type": "string",
          "description": "ISO 8601 timestamp of case open."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier / name of the case."
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Project name or identifier."
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "description": "Harness name or identifier."
        },
        "task": {
          "type": "string",
          "description": "Optional task description or task identifier."
        },
        "headAtOpen": {
          "type": "string",
          "description": "Optional git HEAD sha at the time the case was opened."
        }
      }
    },
    {
      "title": "CaseClosed",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "ts", "name", "interventions", "verdict"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1,
          "description": "Contract version."
        },
        "type": {
          "type": "string",
          "const": "case-closed",
          "description": "Lifecycle transition type."
        },
        "ts": {
          "type": "string",
          "description": "ISO 8601 timestamp of case close."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the case being closed."
        },
        "interventions": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of manual interventions during the case."
        },
        "verdict": {
          "type": "string",
          "minLength": 1,
          "description": "Final verdict of the case (e.g. success, failure, aborted)."
        },
        "note": {
          "type": "string",
          "description": "Optional final commentary or notes."
        },
        "items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Work item IDs resolved or touched during the case."
        },
        "sessions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Coordination session IDs involved in the case."
        },
        "headAtClose": {
          "type": "string",
          "description": "Optional git HEAD sha at the time the case was closed."
        }
      }
    }
  ]
}
