{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coordination-session.read.v1",
  "title": "Historic Coordination Session Read Contract for Observe v1",
  "description": "Defines the subset of fields Observe reads from historic .fgos/coordination/sessions/<sessionId>/events.jsonl and session.json. The coordination engine is retired and writes no new sessions; this contract keeps the data it already wrote readable.",
  "type": "object",
  "properties": {
    "sessionEvents": {
      "type": "object",
      "description": "Fields read from events.jsonl lines.",
      "required": [
        "type",
        "ts"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session-opened",
            "assignment-created",
            "result-linked",
            "driver-disposition-recorded",
            "session-completed",
            "session-partial",
            "session-failed",
            "session-stopped",
            "session-closed"
          ],
          "description": "Event type read and projected into session observations."
        },
        "ts": {
          "type": "string",
          "description": "Timestamp of the event line."
        },
        "payload": {
          "type": "object",
          "description": "Event payload fields extracted into observation attrs based on event type.",
          "properties": {
            "actorId": {
              "type": "string",
              "description": "Read on assignment-created."
            },
            "assignmentId": {
              "type": "string",
              "description": "Read on assignment-created and result-linked."
            },
            "runId": {
              "type": "string",
              "description": "Read on result-linked."
            }
          }
        }
      }
    },
    "sessionJson": {
      "type": "object",
      "description": "Fields read from session.json as fallback for terminal status when events.jsonl lacks terminal event.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "completedAt": {
          "type": "string"
        }
      }
    }
  }
}
