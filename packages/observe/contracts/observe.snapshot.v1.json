{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "observe.snapshot.v1",
  "title": "Observe Metrics Snapshot Contract v1",
  "description": "Schema for periodic entropy and scorecard snapshots appended to .fgos/observe/snapshots/<writerId>.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "ts", "entropy"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Contract version."
    },
    "type": {
      "type": "string",
      "const": "snapshot",
      "description": "Event discriminator."
    },
    "ts": {
      "type": "string",
      "description": "ISO 8601 timestamp of when snapshot was captured."
    },
    "case": {
      "type": "string",
      "description": "Currently active case name, if any."
    },
    "entropy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "components"],
      "properties": {
        "score": {
          "type": "number",
          "description": "Aggregate weighted entropy score."
        },
        "components": {
          "type": "object",
          "description": "Weighted score breakdown per entropy category.",
          "properties": {
            "missing-actual": { "type": "number" },
            "stale-doing": { "type": "number" },
            "stage-entry": { "type": "number" },
            "awaiting-human": { "type": "number" },
            "friction-unsettled": { "type": "number" }
          }
        }
      }
    }
  }
}
