{
  "contract": "observe-names.v1",
  "conventions": {
    "gen_ai": {
      "source": "OpenTelemetry GenAI semantic conventions",
      "version": "1.37.0",
      "note": "When OpenTelemetry renames a name, the old name is added to that entry's aliases; the canonical name changes only in a new registry revision."
    }
  },
  "subjectKinds": ["run", "unit", "plan", "phase", "backlog", "session", "head", "account", "provider"],
  "attrs": {
    "gen_ai.provider.name": { "type": "string", "aliases": ["gen_ai.system"] },
    "gen_ai.request.model": { "type": "string" }
  },
  "measures": {
    "gen_ai.usage.input_tokens": {
      "unit": "token",
      "aggs": ["sum", "max", "p50", "p90"],
      "aliases": ["gen_ai.usage.prompt_tokens"]
    },
    "gen_ai.usage.output_tokens": {
      "unit": "token",
      "aggs": ["sum", "max", "p50", "p90"],
      "aliases": ["gen_ai.usage.completion_tokens"]
    },
    "gen_ai.usage.cache_read.input_tokens": { "unit": "token", "aggs": ["sum", "max", "p50", "p90"] },
    "gen_ai.usage.cache_creation.input_tokens": { "unit": "token", "aggs": ["sum", "max", "p50", "p90"] }
  },
  "kinds": {}
}
