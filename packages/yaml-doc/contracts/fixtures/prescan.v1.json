{
  "version": 1,
  "cases": [
    {
      "id": "bytes-at-limit-strict",
      "why": "spec section 8: input exactly 1 MiB passes the size check under strict-config",
      "profiles": [
        "strict-config"
      ],
      "input": {
        "generate": {
          "unit": "#",
          "count": 1048576,
          "size": "at-input-limit"
        }
      },
      "expect": {
        "ok": true
      }
    },
    {
      "id": "bytes-over-limit-strict",
      "why": "spec section 8: input one byte past 1 MiB is refused before anything else",
      "profiles": [
        "strict-config"
      ],
      "input": {
        "generate": {
          "unit": "#",
          "count": 1048577,
          "size": "over-input-limit"
        }
      },
      "expect": {
        "refusal": {
          "rule": "input-too-large"
        }
      }
    },
    {
      "id": "bytes-at-limit-tool",
      "why": "spec section 8: input exactly 8 MiB passes the size check under tool",
      "profiles": [
        "tool"
      ],
      "input": {
        "generate": {
          "unit": "#",
          "count": 8388608,
          "size": "at-input-limit"
        }
      },
      "expect": {
        "ok": true
      }
    },
    {
      "id": "bytes-over-limit-tool",
      "why": "spec section 8: input one byte past 8 MiB is refused under tool",
      "profiles": [
        "tool"
      ],
      "input": {
        "generate": {
          "unit": "#",
          "count": 8388609,
          "size": "over-input-limit"
        }
      },
      "expect": {
        "refusal": {
          "rule": "input-too-large"
        }
      }
    },
    {
      "id": "size-before-utf8",
      "why": "refusal order: byte size is judged before UTF-8",
      "profiles": [
        "strict-config"
      ],
      "input": {
        "parts": [
          {
            "generate": {
              "unit": "#",
              "count": 1048576
            }
          },
          {
            "hex": "ff"
          }
        ]
      },
      "expect": {
        "refusal": {
          "rule": "input-too-large"
        }
      }
    },
    {
      "id": "invalid-utf8",
      "why": "a byte that is not UTF-8 is refused at its position (here the fourth column of line 1)",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "hex": "6b 3a 20 ff"
      },
      "expect": {
        "refusal": {
          "rule": "invalid-utf8",
          "line": 1,
          "column": 4
        }
      }
    },
    {
      "id": "invalid-utf8-line-3",
      "why": "the position of an invalid byte counts lines, CRLF as one break",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "hex": "61 3a 20 31 0d 0a 62 3a 20 32 0a c3 28"
      },
      "expect": {
        "refusal": {
          "rule": "invalid-utf8",
          "line": 3,
          "column": 1
        }
      }
    },
    {
      "id": "bom-accepted",
