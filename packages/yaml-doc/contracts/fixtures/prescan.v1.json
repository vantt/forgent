      ],
      "input": {
        "generate": {
          "prefix": "k: ",
          "unit": "!!seq [",
          "count": 40
        }
      },
      "expect": {
        "refusal": {
          "rule": "depth-exceeded",
          "line": 1,
          "column": 227
