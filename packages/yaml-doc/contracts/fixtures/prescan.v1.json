    {
      "id": "flow-after-anchor",
      "why": "an anchor before a bracket does not hide the collection from the count (the mapping of the key is level 1, so the 32nd bracket is level 33)",
      "profiles": [
        "strict-config"
      ],
      "input": {
        "generate": {
          "prefix": "k: ",
          "unit": "&a [",
          "count": 40
        }
      },
      "expect": {
        "refusal": {
          "rule": "depth-exceeded",
          "line": 1,
          "column": 131
        }
      }
    },
    {
      "id": "flow-after-tag",
