    {
      "id": "merge-key-ordinary",
      "why": "old test: << is an ordinary key under tool, never a merge",
      "profiles": [
        "tool"
      ],
      "input": {
        "lines": [
          "base: &b {x: 1}",
          "d:",
          "  <<: *b",
          "  y: 2"
        ]
      },
      "expect": {
        "value": {
          "base": {
            "x": 1
          },
          "d": {
            "<<": {
              "x": 1
            },
            "y": 2
          }
        }
      },
      "old": true
    },
