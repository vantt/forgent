{
  "version": 1,
  "cases": [
    {
      "id": "plain-values",
      "why": "old test: mappings, sequences and scalars parse to plain values",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1",
          "b: [x, y]",
          "c:",
          "  - d: true",
          "  - null",
          "e: 1.5",
          "f: \"q\""
        ]
      },
      "expect": {
        "value": {
          "a": 1,
          "b": [
            "x",
            "y"
          ],
          "c": [
            {
              "d": true
            },
            null
          ],
          "e": 1.5,
          "f": "q"
        }
      },
      "old": true
    },
    {
      "id": "plain-scalar-root",
      "why": "old test: a plain scalar document is its string",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "text": "plain text"
      },
      "expect": {
        "value": "plain text"
      },
      "old": true
    },
    {
      "id": "integer-root",
