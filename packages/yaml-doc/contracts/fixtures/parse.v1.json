    {
      "id": "core-yes-no-on-off",
      "why": "old test: yes/no/on/off are strings, only true and false are booleans",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: yes",
          "b: no",
          "c: on",
          "d: off",
          "e: true",
          "f: false"
