      "id": "inline-refuses-nel",
      "why": "U+0085 is refused in an inline comment",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "kind": "inline",
      "input": {
        "text": "ab"
      },
      "expect": {
        "refusal": {
          "rule": "inline-comment-multiline",
          "line": 1,
          "column": 2
        }
      }
    },
    {
      "id": "inline-refuses-line-separator",
      "why": "U+2028 is refused in an inline comment",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "kind": "inline",
      "input": {
        "text": "a b"
      },
      "expect": {
        "refusal": {
          "rule": "inline-comment-multiline",
          "line": 1,
          "column": 2
        }
      }
    },
    {
      "id": "inline-refuses-bidi",
