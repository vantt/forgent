    {
      "id": "set-scalar-keeps-inline-comment",
      "why": "set replaces only the scalar bytes; the inline comment and neighbours stay",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1  # keep",
          "b: 2"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "a",
          "value": 5
        }
      ],
      "expect": {
        "output": "a: 5  # keep\nb: 2\n"
      }
    },
    {
      "id": "set-string-keeps-quote-style",
      "why": "a replaced scalar keeps the quoting style of the node it replaces",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "name: 'old'",
          "other: \"x\""
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "name",
          "value": "new"
        }
      ],
      "expect": {
        "output": "name: 'new'\nother: \"x\"\n"
      }
    },
    {
      "id": "set-nested-path",
      "why": "set reaches a nested key and leaves siblings and comments alone",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a:",
          "  # why",
          "  b: 1",
          "  c: 2"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "a.b",
          "value": 9
        }
      ],
      "expect": {
        "output": "a:\n  # why\n  b: 9\n  c: 2\n"
      }
    },
    {
      "id": "set-creates-missing-parents",
      "why": "spec section 5: set creates missing parents as block mappings",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "b.c.d",
          "value": 7
        }
      ],
      "expect": {
        "output": "a: 1\nb:\n  c:\n    d: 7\n"
      }
    },
    {
      "id": "set-subtree-replaces-mapping",
      "why": "set on a subtree replaces the whole node",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a:",
          "  x: 1",
          "  y: 2",
          "b: 3"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "a",
          "value": {
            "z": 9
          }
        }
      ],
      "expect": {
        "output": "a:\n  z: 9\nb: 3\n"
      }
    },
    {
      "id": "set-sequence-item",
      "why": "set addresses a sequence item by index",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "l:",
          "  - a",
          "  - b"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "l[1]",
          "value": "z"
        }
      ],
      "expect": {
        "output": "l:\n  - a\n  - z\n"
      }
    },
    {
      "id": "set-key-with-colon",
