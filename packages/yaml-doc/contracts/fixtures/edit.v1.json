    {
      "id": "ops-apply-in-order",
      "why": "operations run in order, each on the result of the one before",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1",
          "b: 2"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "a",
          "value": 5
        },
        {
          "op": "remove",
          "path": "b"
        },
        {
          "op": "set",
          "path": "c",
          "value": "x"
        }
      ],
      "expect": {
        "output": "a: 5\nc: x\n"
      }
    },
