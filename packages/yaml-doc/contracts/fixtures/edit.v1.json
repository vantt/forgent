{
  "version": 1,
  "cases": [
    {
      "id": "roundtrip-comments-blank-lines",
      "why": "spec section 5: comments, blank lines and inline comments survive untouched",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "# top",
          "",
          "a: 1  # one",
          "",
          "# above b",
          "b:",
          "  - x   # item",
          "  - y",
          "",
          "c: \"q\""
        ]
      },
      "ops": [],
      "expect": {
        "unchanged": true
      }
    },
    {
      "id": "roundtrip-quoting-styles",
      "why": "spec section 5: plain, single and double quoting stay as written",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 'single'",
          "b: \"double\"",
          "c: plain",
          "d: \"esc \\n\""
        ]
      },
      "ops": [],
      "expect": {
        "unchanged": true
      }
    },
    {
      "id": "roundtrip-block-scalars",
      "why": "spec section 5: literal and folded block scalars keep their bytes",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "lit: |",
          "  one",
          "",
          "  two",
          "fold: >-",
          "  a",
          "  b",
          "keep: |+",
          "  x",
          "",
          "next: 1"
        ]
      },
      "ops": [],
      "expect": {
        "unchanged": true
      }
    },
    {
      "id": "roundtrip-flow-collections",
