      "id": "remove-last-item-leaves-empty-sequence",
      "why": "removing the last item of a sequence leaves []",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "l:",
          "  - x"
        ]
      },
      "ops": [
        {
          "op": "remove",
          "path": "l[0]"
        }
      ],
      "expect": {
        "output": "l: []\n"
      }
    },
    {
      "id": "remove-last-line-without-newline",
      "why": "removing a last line with no line break leaves the file ending as it did",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "text": "a: 1\nb: 2"
      },
      "ops": [
        {
          "op": "remove",
          "path": "b"
        }
      ],
      "expect": {
        "output": "a: 1"
      }
    },
    {
      "id": "remove-keeps-crlf",
      "why": "removing a line in a CRLF document keeps the other breaks",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "text": "a: 1\r\nb: 2\r\nc: 3\r\n"
      },
      "ops": [
        {
          "op": "remove",
          "path": "b"
        }
      ],
      "expect": {
        "output": "a: 1\r\nc: 3\r\n"
      }
    },
    {
      "id": "remove-leaves-comment-of-next-sibling",
      "why": "a comment directly above the next sibling belongs to it and stays without any acknowledgement",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1",
          "# about b",
          "b: 2"
        ]
      },
      "ops": [
        {
          "op": "remove",
          "path": "a"
        }
      ],
      "expect": {
        "output": "# about b\nb: 2\n"
      }
    },
    {
      "id": "remove-leaves-comment-separated-by-blank-lines",
      "why": "a comment separated from the node by a blank line is not the node's: the removal needs no acknowledgement",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1",
          "",
          "# about b",
          "",
          "b: 2"
        ]
      },
      "ops": [
        {
          "op": "remove",
          "path": "b"
        }
      ],
      "expect": {
        "output": "a: 1\n\n# about b\n\n"
      }
    },
    {
      "id": "remove-nested-comment-refused",
      "why": "a comment on a line inside the removed subtree makes the removal refuse",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a:",
          "  b: 1  # note",
          "c: 2"
        ]
      },
      "ops": [
        {
          "op": "remove",
          "path": "a"
        }
      ],
      "expect": {
        "refusal": {
          "rule": "comment-would-be-lost"
        }
      }
    },
    {
      "id": "remove-nested-comment-acknowledged",
      "why": "with the acknowledgement the subtree and its notes go",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a:",
          "  b: 1  # note",
          "c: 2"
        ]
      },
      "ops": [
        {
          "op": "remove",
          "path": "a",
          "acknowledge": true
        }
      ],
      "expect": {
        "output": "c: 2\n"
      }
    },
    {
      "id": "comment-block-delete",
      "why": "no lines delete the comment block above the node",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "# old",
          "# older",
          "a: 1",
          "b: 2"
        ]
      },
      "ops": [
        {
          "op": "setCommentBlock",
          "path": "a",
          "lines": []
        }
      ],
      "expect": {
        "output": "a: 1\nb: 2\n"
      }
    },
    {
      "id": "comment-block-above-sequence-item",
      "why": "a block above a sequence item goes at the dash's indentation",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "l:",
          "  - a",
          "  - b"
        ]
      },
      "ops": [
        {
          "op": "setCommentBlock",
          "path": "l[1]",
          "lines": [
            "why b"
          ]
        }
      ],
      "expect": {
        "output": "l:\n  - a\n  # why b\n  - b\n"
      }
    },
    {
      "id": "set-flow-with-inner-comment-acknowledged",
      "why": "with the acknowledgement the flow collection is rewritten and its note goes",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "x: [1, # inner",
          "  2]"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "x",
          "value": [
            1,
            2,
            3
          ],
          "acknowledge": true
        }
      ],
      "expect": {
        "output": "x:\n  - 1\n  - 2\n  - 3\n"
      }
    },
    {
      "id": "set-subtree-with-comment-acknowledged",
      "why": "with the acknowledgement a subtree replacement may drop the note inside it",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a:",
          "  # keep",
          "  b: 1"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "a",
          "value": {
            "z": 1
          },
          "acknowledge": true
        }
      ],
      "expect": {
        "output": "a:\n  z: 1\n"
      }
    },
    {
      "id": "set-new-key-into-flow-with-inner-comment-refused",
      "why": "a new key in a flow mapping rewrites it; a note inside is not dropped without the acknowledgement",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "x: {a: 1, # inner",
          "  b: 2}"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "x.c",
          "value": 3
        }
      ],
      "expect": {
        "refusal": {
          "rule": "comment-would-be-lost"
        }
      }
    },
    {
      "id": "set-new-key-into-flow-with-inner-comment-acknowledged",
      "why": "with the acknowledgement a new key rewrites the flow mapping and the note goes",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "x: {a: 1, # inner",
          "  b: 2}"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "x.c",
          "value": 3,
          "acknowledge": true
        }
      ],
      "expect": {
        "output": "x:\n  a: 1\n  b: 2\n  c: 3\n"
      }
    }
  ]
}
