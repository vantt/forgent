      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "lit: |",
          "  one",
          "",
          "  two",
          "fold: >-",
          "  a",
          "  b",
          "keep: |+",
          "  x",
          "",
          "next: 1"
        ]
      },
      "ops": [],
      "expect": {
        "unchanged": true
      }
    },
    {
