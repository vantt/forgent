    {
      "id": "roundtrip-937-lines",
      "why": "spec section 5: a 937-line config-shaped document (the size of the real config as YAML) round-trips",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "generate": {
          "prefix": "# config\nversion: 1\n",
          "unit": "# section {i}\nkey{i}:\n  a: {i}  # inline note\n  b: \"q{i}\"\n\n",
          "count": 187
        }
      },
      "ops": [],
      "expect": {
        "unchanged": true
