    {
      "id": "set-scalar-keeps-inline-comment",
      "why": "set replaces only the scalar bytes; the inline comment and neighbours stay",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "a: 1  # keep",
          "b: 2"
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "a",
          "value": 5
        }
      ],
      "expect": {
        "output": "a: 5  # keep\nb: 2\n"
      }
    },
    {
      "id": "set-string-keeps-quote-style",
      "why": "a replaced scalar keeps the quoting style of the node it replaces",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
          "name: 'old'",
          "other: \"x\""
        ]
      },
      "ops": [
        {
          "op": "set",
          "path": "name",
          "value": "new"
        }
      ],
      "expect": {
        "output": "name: 'new'\nother: \"x\"\n"
      }
    },
    {
      "id": "set-nested-path",
      "why": "set reaches a nested key and leaves siblings and comments alone",
      "profiles": [
        "strict-config",
        "tool"
      ],
      "input": {
        "lines": [
