{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "backlog-item.schema.v1.json",
  "title": "BacklogItemFrontmatter",
  "type": "object",
  "required": ["id", "title", "status", "priority", "area", "created"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^p-[a-z2-7]{10}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "parked", "in-flight", "done", "dropped"]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
