    "4": "Run Supervisor",
    "5": "Execution: Dispatch, Execution Core, Seat Binding",
    "6": "Workflow",
    "7": "Work lifecycle",
    "8": "Skill and Domain (no file today)",
    "9": "host and surface: entry, CLI, verbs, setup, reports"
