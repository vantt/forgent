[package]
name = "mdview-desktop"
version = "0.1.0"
edition = "2021"
license = "MIT"
authors = ["Van Tran"]
description = "Native desktop shell for mdview (Tauri v2) — a window onto the local daemon"

# Standalone (not part of the root workspace) so the verified core/CLI build never
# depends on Tauri's system libraries. See README.md for build prerequisites.
[workspace]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
mdview-core = { path = "../mdview-core" }
tauri = { version = "2", features = ["tray-icon"] }
tauri-plugin-single-instance = "2"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[features]
# Reserved for a custom protocol build later.
default = []
[workspace]
resolver = "2"
members = ["crates/mdview-core", "crates/mdview"]
# Desktop shell (Tauri) is excluded from the default workspace build because it
# requires system libraries (webkit2gtk/gtk3 on Linux) not present everywhere.
# Build it explicitly from its own directory — see crates/mdview-desktop/README.md.
exclude = ["crates/mdview-desktop"]

[workspace.package]
version = "0.7.6"
edition = "2021"
license = "MIT"
authors = ["Van Tran"]
repository = "https://github.com/vantt/mdview"

[workspace.dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
toml = "0.8"
toml_edit = "0.22"
thiserror = "1"
anyhow = "1"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
dirs = "5"
time = { version = "0.3", features = ["formatting", "parsing", "serde"] }

# rendering
comrak = "0.29"
syntect = "5"
ammonia = "4"

# storage / indexing
rusqlite = { version = "0.32", features = ["bundled"] }
ignore = "0.4"
notify = "6"
notify-debouncer-full = "0.3"
nucleo-matcher = "0.3"

# server / cli
axum = { version = "0.7", features = ["ws"] }
tokio = { version = "1", features = ["full"] }
tower = "0.5"
tower-http = { version = "0.6", features = ["cors", "trace"] }
clap = { version = "4", features = ["derive"] }
minijinja = { version = "2", features = ["loader"] }

# auth (token + Cloudflare Access)
jsonwebtoken = "9"
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
async-trait = "0.1"
rand = "0.8"
base64 = "0.22"

# platform
libc = "0.2"

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
panic = "abort"
strip = true

