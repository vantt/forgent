   391	    #[test]
   392	    fn bind_fallback_prefers_the_lock_port_over_the_config_port() {
   393	        let mut cfg = Config::default();
   394	        cfg.server.port = 7700;
   395	        cfg.server.host = "127.0.0.1".into();
