     1	//! Shared runtime helpers: build the engine, and spawn/await the daemon.
     2	//! Lock + health live in `mdview_core::daemon` (shared with the desktop shell).
     3	
     4	use anyhow::Result;
     5	use mdview_core::config::{self, Config};
     6	use mdview_core::daemon;
     7	use mdview_core::{Engine, SqliteStore};
     8	use std::time::Duration;
     9	
    10	pub use mdview_core::daemon::{read_lock, remove_lock, running_daemon, write_lock, DaemonInfo};
    11	
    12	/// Open the shared registry DB + config and build an Engine.
    13	pub fn build_engine() -> Result<Engine> {
    14	    let config = Config::load();
    15	    let store = SqliteStore::open(&config::registry_db_path())?;
    16	    Ok(Engine::new(store, config))
    17	}
    18	
    19	/// How long a spawn-gate lock may sit before its owner is presumed dead and the
    20	/// gate is stolen — comfortably longer than the readiness poll below.
    21	const SPAWN_GATE_STALE: Duration = Duration::from_secs(15);
    22	
    23	/// The spawn-gate lock path: a sibling of the daemon lock. Its existence means
    24	/// "some invocation is currently spawning the daemon".
    25	fn spawn_gate_path() -> std::path::PathBuf {
    26	    daemon::lock_path().with_extension("spawning")
    27	}
    28	
    29	/// Outcome of trying to become the daemon spawner.
    30	enum Gate {
    31	    /// We own the gate and must do the spawn. The guard is held only for its
    32	    /// `Drop` (which removes the gate file), never read — hence `dead_code`.
    33	    Acquired(#[allow(dead_code)] SpawnGate),
    34	    /// Another live invocation holds the gate — wait for the daemon, don't spawn.
    35	    Held,
    36	    /// The gate file could not be used at all — caller should spawn unguarded.
    37	    Unavailable,
    38	}
    39	
    40	/// RAII guard that removes the spawn-gate file when the spawner is done.
    41	struct SpawnGate {
    42	    path: std::path::PathBuf,
    43	}
    44	
    45	impl Drop for SpawnGate {
    46	    fn drop(&mut self) {
    47	        let _ = std::fs::remove_file(&self.path);
    48	    }
    49	}
    50	
    51	/// Atomically claim the spawn gate at `path` via `create_new` (O_EXCL), so
    52	/// exactly one racer wins. An existing gate older than `stale_after` is assumed
    53	/// abandoned (its owner died mid-spawn) and stolen.
    54	fn acquire_spawn_gate_at(path: &std::path::Path, stale_after: Duration) -> Gate {
    55	    let claim = |p: &std::path::Path| {
    56	        std::fs::OpenOptions::new()
    57	            .write(true)
    58	            .create_new(true)
    59	            .open(p)
    60	    };
    61	    match claim(path) {
    62	        Ok(_) => Gate::Acquired(SpawnGate {
    63	            path: path.to_path_buf(),
    64	        }),
    65	        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
    66	            let stale = std::fs::metadata(path)
    67	                .and_then(|m| m.modified())
    68	                .ok()
    69	                .and_then(|t| t.elapsed().ok())
    70	                .map(|age| age > stale_after)
    71	                .unwrap_or(true); // unreadable/future mtime → treat as stale
    72	            if !stale {
    73	                return Gate::Held;
    74	            }
    75	            let _ = std::fs::remove_file(path);
    76	            match claim(path) {
    77	                Ok(_) => Gate::Acquired(SpawnGate {
    78	                    path: path.to_path_buf(),
    79	                }),
    80	                Err(_) => Gate::Held, // lost the steal race to another invocation
    81	            }
    82	        }
    83	        // Directory missing/unwritable etc. — the gate is unusable here.
    84	        Err(_) => Gate::Unavailable,
    85	    }
    86	}
    87	
    88	/// Ensure a daemon is running and resolve its real bind `(host, port)` — the
    89	/// connectivity values, spawning a daemon if none is up. This is the shared
    90	/// basis for the *display* URL builders below; it never mutates connectivity.
    91	fn ensure_bind() -> (String, u16) {
    92	    if let Some(info) = daemon::running_daemon() {
    93	        return (info.host, info.port);
    94	    }
    95	    // Serialize the cold-start spawn: parallel `open`/`view_file` invocations
    96	    // must not each launch a daemon (two daemons fight over the port and the
    97	    // SQLite registry, and the loser becomes an unkillable orphan). Only the
    98	    // gate holder spawns; if the gate is unusable we degrade to the old
    99	    // unguarded spawn — never worse than before. `_gate` is held across the
   100	    // whole readiness wait so no second invocation spawns during the window.
   101	    let _gate = acquire_spawn_gate_at(&spawn_gate_path(), SPAWN_GATE_STALE);
   102	    match &_gate {
   103	        Gate::Acquired(_) => {
   104	            // Re-check under the gate: another spawner may have just finished.
   105	            if let Some(info) = daemon::running_daemon() {
   106	                return (info.host, info.port);
   107	            }
   108	            if let Err(e) = spawn_daemon_detached() {
   109	                eprintln!("mdview: failed to auto-spawn daemon: {e}");
   110	            }
   111	        }
   112	        Gate::Held => {} // another invocation is spawning; just wait below.
   113	        Gate::Unavailable => {
   114	            if let Err(e) = spawn_daemon_detached() {
   115	                eprintln!("mdview: failed to auto-spawn daemon: {e}");
   116	            }
   117	        }
   118	    }
   119	    for _ in 0..20 {
   120	        std::thread::sleep(Duration::from_millis(100));
   121	        if let Some(info) = daemon::running_daemon() {
   122	            return (info.host, info.port);
   123	        }
   124	    }
   125	    // Daemon never answered: surface it rather than silently handing back a
   126	    // config-default URL that looks live. The URL is still returned for the
   127	    // caller to print, but the operator now sees why it may not respond.
   128	    eprintln!("mdview: daemon did not become ready in time; the viewer URL may not respond yet.");
   129	    let cfg = Config::load();
   130	    bind_fallback(daemon::read_lock(), &cfg)
   131	}
   132	
   133	/// Pure fallback decision for `ensure_bind()`'s timeout branch (unit-tested,
   134	/// no I/O). `serve()` writes the daemon lock with the real bound `(host,
   135	/// port)` immediately after `bind_with_retry` succeeds — before the daemon
   136	/// answers its own health check — so a lock found here holds the real bound
   137	/// port even though `running_daemon()`'s poll timed out. Only the configured
   138	/// port is used when no lock exists at all (the daemon was never spawned).
   139	fn bind_fallback(lock: Option<DaemonInfo>, cfg: &Config) -> (String, u16) {
   140	    match lock {
   141	        Some(info) => (info.host, info.port),
   142	        None => (cfg.server.host.clone(), cfg.server.port),
   143	    }
   144	}
   145	
   146	/// Ensure a daemon is running and return every viewable base URL (spawns one
   147	/// if needed). When the daemon binds a wildcard host (`0.0.0.0` / `::`) and
   148	/// no `hostname` override is set, this is one URL per reachable machine IP so
   149	/// a caller (e.g. a remote agent) can pick an address that routes to it.
   150	/// Otherwise it is a single URL. Display values only — connectivity
   151	/// (`DaemonInfo.host`, health) is never derived from this.
   152	pub fn ensure_daemon_bases() -> Vec<String> {
   153	    let (host, port) = ensure_bind();
   154	    display_urls_for(&host, port)
   155	}
   156	
   157	/// Every viewable base URL for an already-bound `(bind_host, port)` — the
   158	/// display side of `ensure_daemon_bases` without the spawn/readiness wait, so a
   159	/// process that has *already* bound its listener (e.g. `serve()`) can print the
   160	/// same multi-IP list. Applies the `hostname` override and wildcard→machine-IP
   161	/// expansion via `build_display_urls`. Display values only.
   162	pub fn display_urls_for(bind_host: &str, port: u16) -> Vec<String> {
   163	    let cfg = Config::load();
   164	    build_display_urls(
   165	        cfg.server.hostname.as_deref(),
   166	        bind_host,
   167	        port,
   168	        &machine_ipv4s(),
   169	    )
   170	}
   171	
   172	/// True if `host` is a wildcard "any interface" bind address, whose literal
   173	/// form is useless as a link — the case that warrants listing real IPs.
   174	fn is_wildcard(host: &str) -> bool {
   175	    matches!(host, "0.0.0.0" | "::" | "[::]")
   176	}
   177	
   178	/// The machine's externally-usable IPv4 addresses (loopback and link-local
   179	/// excluded), sorted and deduped. Empty when only loopback/link-local exist.
   180	fn machine_ipv4s() -> Vec<String> {
   181	    let mut out: Vec<String> = if_addrs::get_if_addrs()
   182	        .into_iter()
   183	        .flatten()
   184	        .filter(|i| !i.is_loopback())
   185	        .filter_map(|i| match i.ip() {
   186	            std::net::IpAddr::V4(v4) if !v4.is_link_local() => Some(v4.to_string()),
   187	            _ => None,
   188	        })
   189	        .collect();
   190	    out.sort();
   191	    out.dedup();
   192	    out
   193	}
   194	
   195	/// Pure display-URL builder (unit-tested; no I/O). Precedence:
   196	/// 1. a non-empty `host_name` override → that single URL;
   197	/// 2. a wildcard `bind_host` with machine IPs → one URL per IP;
   198	/// 3. a wildcard `bind_host` with no external IP → single `127.0.0.1` URL;
   199	/// 4. any other `bind_host` → that single URL.
   200	fn build_display_urls(
   201	    host_name: Option<&str>,
   202	    bind_host: &str,
   203	    port: u16,
   204	    machine_ips: &[String],
   205	) -> Vec<String> {
   206	    let url = |h: &str| format!("http://{h}:{port}");
   207	    if let Some(name) = host_name.map(str::trim).filter(|h| !h.is_empty()) {
   208	        return vec![url(name)];
   209	    }
   210	    if is_wildcard(bind_host) {
   211	        if machine_ips.is_empty() {
   212	            return vec![url("127.0.0.1")];
   213	        }
   214	        return machine_ips.iter().map(|ip| url(ip)).collect();
   215	    }
   216	    vec![url(bind_host)]
   217	}
   218	
   219	/// Spawn `mdview serve` fully detached, so MCP/CLI can guarantee a viewer is up
   220	/// and the daemon outlives whatever process spawned it. Without the detach the
   221	/// daemon shares its spawner's session/process-group and dies with it (SIGHUP
   222	/// when the terminal/session closes, or a process-group-directed SIGTERM).
   223	/// The detach logic itself lives in `mdview_core::process` (shared with the
   224	/// desktop shell's own spawn path) — re-exported here so existing call sites
   225	/// and the existing unit test keep working unchanged.
   226	pub(crate) use mdview_core::process::apply_detach;
   227	
   228	pub fn spawn_daemon_detached() -> Result<()> {
   229	    let exe = std::env::current_exe()?;
   230	    let mut cmd = std::process::Command::new(exe);
   231	    cmd.arg("serve")
   232	        .stdin(std::process::Stdio::null())
   233	        .stdout(std::process::Stdio::null())
   234	        .stderr(std::process::Stdio::null());
   235	    apply_detach(&mut cmd);
   236	    cmd.spawn()?;
   237	    Ok(())
   238	}
   239	
   240	/// Spawn `mdview refresh <project_id>` fully detached, so a newly-registered
   241	/// project's full recursive scan happens off the calling process — `register`/
   242	/// `open`/the MCP tool return as soon as the project row exists (and, for
   243	/// `open`, the one requested file is viewable) instead of blocking on the
   244	/// whole repo. Safe to run alongside an already-running daemon: CLI commands
   245	/// and the daemon already share the same SQLite registry concurrently.
   246	pub fn spawn_refresh_detached(project_id: &str) -> Result<()> {
   247	    let exe = std::env::current_exe()?;
   248	    let mut cmd = std::process::Command::new(exe);
   249	    cmd.arg("refresh")
   250	        .arg(project_id)
   251	        .stdin(std::process::Stdio::null())
   252	        .stdout(std::process::Stdio::null())
   253	        .stderr(std::process::Stdio::null());
   254	    apply_detach(&mut cmd);
   255	    cmd.spawn()?;
   256	    Ok(())
   257	}
   258	
   259	#[cfg(test)]
   260	mod tests {
   261	    use super::{
   262	        acquire_spawn_gate_at, bind_fallback, build_display_urls, is_wildcard, DaemonInfo, Gate,
   263	    };
   264	    use mdview_core::config::Config;
   265	    use std::time::Duration;
   266	
   267	    fn gate_tmp(label: &str) -> std::path::PathBuf {
   268	        let dir = std::env::temp_dir().join(format!(
   269	            "mdview-gate-{label}-{}-{}",
   270	            std::process::id(),
   271	            std::time::SystemTime::now()
   272	                .duration_since(std::time::UNIX_EPOCH)
   273	                .unwrap()
   274	                .as_nanos()
   275	        ));
   276	        std::fs::create_dir_all(&dir).unwrap();
   277	        dir.join("daemon.spawning")
   278	    }
   279	
   280	    #[test]
   281	    fn spawn_gate_grants_one_holder_then_blocks_until_released() {
   282	        let path = gate_tmp("excl");
   283	        let g1 = acquire_spawn_gate_at(&path, Duration::from_secs(15));
   284	        assert!(matches!(g1, Gate::Acquired(_)));
   285	        assert!(path.exists());
   286	        // A second racer, while the gate is held and fresh, must be blocked.
   287	        assert!(matches!(
   288	            acquire_spawn_gate_at(&path, Duration::from_secs(15)),
   289	            Gate::Held
   290	        ));
   291	        // Dropping the guard releases the gate file...
   292	        drop(g1);
   293	        assert!(!path.exists());
   294	        // ...and it can be claimed again.
   295	        assert!(matches!(
   296	            acquire_spawn_gate_at(&path, Duration::from_secs(15)),
   297	            Gate::Acquired(_)
   298	        ));
   299	        std::fs::remove_dir_all(path.parent().unwrap()).ok();
   300	    }
   301	
   302	    #[test]
   303	    fn spawn_gate_steals_a_stale_lock() {
   304	        let path = gate_tmp("stale");
   305	        std::fs::write(&path, b"").unwrap();
   306	        // stale_after = 0 → an existing gate is immediately abandoned and stolen.
   307	        assert!(matches!(
   308	            acquire_spawn_gate_at(&path, Duration::from_secs(0)),
   309	            Gate::Acquired(_)
   310	        ));
   311	        std::fs::remove_dir_all(path.parent().unwrap()).ok();
   312	    }
   313	
   314	    // The daemon-detach behavior (setsid) had no automated guard — the function
   315	    // was once "detached" in name only. This exercises the real `apply_detach`
   316	    // on a throwaway child and asserts it lands in its own session.
   317	    #[cfg(unix)]
   318	    #[test]
   319	    fn apply_detach_puts_child_in_its_own_session() {
   320	        use std::process::{Command, Stdio};
   321	        let mut cmd = Command::new("sleep");
   322	        cmd.arg("0.4")
   323	            .stdin(Stdio::null())
   324	            .stdout(Stdio::null())
   325	            .stderr(Stdio::null());
   326	        super::apply_detach(&mut cmd);
   327	        let mut child = cmd.spawn().expect("spawn sleep");
   328	        let pid = child.id() as i32;
   329	        // pre_exec runs setsid before exec; give the child a moment to get there.
   330	        std::thread::sleep(Duration::from_millis(80));
   331	        let child_sid = unsafe { libc::getsid(pid) };
   332	        let my_sid = unsafe { libc::getsid(0) };
   333	        // Reap the child before asserting so a failed assert can't leak a process.
   334	        child.kill().ok();
   335	        child.wait().ok();
   336	        // A detached child leads its own session: getsid(child) == child pid, and
   337	        // it differs from the test process's session.
   338	        assert_eq!(child_sid, pid, "detached child must lead its own session");
   339	        assert_ne!(
   340	            child_sid, my_sid,
   341	            "detached child must not share our session"
   342	        );
   343	    }
   344	
   345	    fn ips(v: &[&str]) -> Vec<String> {
   346	        v.iter().map(|s| s.to_string()).collect()
   347	    }
   348	
   349	    #[test]
   350	    fn host_name_override_wins_even_over_wildcard() {
   351	        let urls = build_display_urls(Some("my.local"), "0.0.0.0", 7700, &ips(&["192.168.1.5"]));
