"""asset_specs_intraday.py — Medallion asset registry for the intraday pipeline.

INTRADAY_ASSET_SPECS dependency graph:

    canon.bars_intraday_ingest
            |
    feat.intraday
            |
    mart.money_flow_intraday
            |
    sig.signals_intraday
            |
    sig.outcomes_intraday   <-- guarded; never blocks pipeline
            |
    sig.alerts_intraday

All keys carry the _intraday suffix so they are distinct from EOD assets and
cannot interfere with EOD_ASSET_SPECS state or progress tracking.

AssetRunner is reused unchanged — it accepts any list of AssetSpecs.
"""
from __future__ import annotations

from .asset_runner import AssetSpec, AssetContext
from .ingest_intraday_bars import ingest_intraday_bars
from .features.intraday_features import compute_intraday_features
from .marts.money_flow_intraday import compute_money_flow_intraday
from .signals.signal_engine_intraday import compute_signals_intraday
from .signals.alert_dispatch_intraday import run_intraday_alert_dispatch
from .backtest.outcomes import label_outcomes_intraday_window


def _sig_outcomes_intraday_fn(ctx: AssetContext) -> dict:
    """Label forward daily-bar returns for intraday signals in trailing 30-day window.

    Guarded: any labeling failure is logged and returns rows_out=0.
    Intraday signal → daily-bar outcome (Validation S1#3, KISS).
    Writes to backtest/outcomes_intraday (separate from EOD outcomes).
    """
    import logging
    from datetime import date as _date
    log = logging.getLogger(__name__)
    try:
        run_date = _date.fromisoformat(ctx.run_date)
        result = label_outcomes_intraday_window(
            signal_repo=ctx.ports["signal_repo"],
            bar_repo=ctx.ports["bar_repo"],
            backtest_repo=ctx.ports["backtest_repo"],
            end=run_date,
        )
        rows_out = result.get("outcomes_written", 0)
        log.info(
            "sig.outcomes_intraday: %d written (%d examined, %d skipped)",
            rows_out, result.get("signals_examined", 0), result.get("skipped", 0),
        )
        return {"rows_out": rows_out}
    except Exception as exc:
        log.warning("sig.outcomes_intraday: labeling failed (non-fatal) — %s", exc)
        return {"rows_out": 0}


INTRADAY_ASSET_SPECS: list[AssetSpec] = [
    # 1. Ingest raw 5-minute bars from provider → canon/bars_intraday
    AssetSpec(
        key="canon.bars_intraday_ingest",
        deps=(),
        fn=ingest_intraday_bars,
    ),
    # 2. Compute per-symbol VWAP, RVOL, MFI, CMF, OBV → feat/intraday
    AssetSpec(
        key="feat.intraday",
        deps=("canon.bars_intraday_ingest",),
        fn=compute_intraday_features,
    ),
    # 3. Score money-flow per symbol + market aggregate → mart/money_flow_intraday
    AssetSpec(
        key="mart.money_flow_intraday",
        deps=("feat.intraday",),
        fn=compute_money_flow_intraday,
    ),
    # 4. Evaluate buy/watch gate → sig/signals_intraday (separate dataset from EOD)
    AssetSpec(
        key="sig.signals_intraday",
        deps=("mart.money_flow_intraday",),
        fn=compute_signals_intraday,
    ),
    # 5. Guarded trailing-window intraday outcome labeler (daily-bar forward returns).
    #    Never blocks the pipeline; writes to backtest/outcomes_intraday.
    AssetSpec(
        key="sig.outcomes_intraday",
        deps=("sig.signals_intraday",),
        fn=_sig_outcomes_intraday_fn,
    ),
    # 6. Dispatch intraday alerts via Telegram (daily cap enforced across poll runs)
    AssetSpec(
        key="sig.alerts_intraday",
        deps=("sig.signals_intraday",),
        fn=run_intraday_alert_dispatch,
    ),
]

