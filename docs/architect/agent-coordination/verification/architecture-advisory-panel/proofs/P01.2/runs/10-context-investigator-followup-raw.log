   425	            Redirect::to(&format!("/p/{project_id}/{rel_path}")).into_response()
   426	        }
   427	        Ok(None) => not_found("no file for that short link"),
   428	        Err(e) => internal_error(&e.to_string()),
   429	    }
   430	}
