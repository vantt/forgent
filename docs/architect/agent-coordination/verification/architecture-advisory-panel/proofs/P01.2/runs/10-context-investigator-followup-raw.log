   205	fn cmd_serve(port: Option<u16>, host: Option<String>) -> Result<()> {
   206	    // Apply overrides by persisting to config before the daemon reads it.
   207	    if port.is_some() || host.is_some() {
   208	        let mut cfg = mdview_core::Config::load();
   209	        if let Some(p) = port {
   210	            cfg.server.port = p;
   211	        }
   212	        if let Some(h) = host {
   213	            cfg.server.host = h;
   214	        }
   215	        cfg.save().ok();
   216	    }
   217	    if runtime::running_daemon().is_some() {
   218	        println!("A mdview daemon is already running.");
   219	        return Ok(());
   220	    }
   221	    let rt = tokio::runtime::Runtime::new()?;
   222	    rt.block_on(crate::server::serve())
   223	}
