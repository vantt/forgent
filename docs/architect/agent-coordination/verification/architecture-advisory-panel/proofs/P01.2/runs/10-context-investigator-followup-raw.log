   103	/// Attach to a running daemon, or spawn `mdview serve` and wait for it.
   104	fn ensure_daemon() -> String {
   105	    if let Some(info) = daemon::running_daemon() {
   106	        return info.base_url();
   107	    }
   108	    let _ = spawn_mdview_serve();
   109	    for _ in 0..30 {
   110	        std::thread::sleep(Duration::from_millis(150));
   111	        if let Some(info) = daemon::running_daemon() {
   112	            return info.base_url();
   113	        }
   114	    }
   115	    let cfg = mdview_core::Config::load();
   116	    format!("http://{}:{}", cfg.server.host, cfg.server.port)
   117	}
   118	
   119	fn spawn_mdview_serve() -> std::io::Result<()> {
   120	    let mut cmd = std::process::Command::new(find_mdview());
   121	    cmd.arg("serve")
   122	        .stdin(Stdio::null())
   123	        .stdout(Stdio::null())
   124	        .stderr(Stdio::null());
   125	    mdview_core::process::apply_detach(&mut cmd);
   126	    cmd.spawn().map(|_| ())
   127	}
   128	
   129	/// Prefer a `mdview` binary next to this executable; else rely on PATH.
   130	fn find_mdview() -> PathBuf {
   131	    if let Ok(exe) = std::env::current_exe() {
   132	        if let Some(dir) = exe.parent() {
   133	            let sibling = dir.join(if cfg!(windows) {
   134	                "mdview.exe"
   135	            } else {
   136	                "mdview"
   137	            });
   138	            if sibling.exists() {
   139	                return sibling;
   140	            }
   141	        }
   142	    }
   143	    PathBuf::from("mdview")
   144	}
     1	//! Single-daemon coordination: the `~/.mdview/daemon.lock` (pid + port) and a
     2	//! health probe. Shared by the CLI/daemon and the desktop shell so every
     3	//! launcher agrees on one server (PRD §7.1/§7.5).
     4	
     5	use crate::config::{self, write_atomic};
     6	use crate::error::Result;
     7	use serde::{Deserialize, Serialize};
     8	use std::io::{Read, Write};
     9	use std::net::TcpStream;
    10	use std::path::PathBuf;
    11	use std::time::Duration;
    12	
    13	#[derive(Debug, Clone, Serialize, Deserialize)]
    14	pub struct DaemonInfo {
    15	    pub pid: u32,
    16	    pub host: String,
    17	    pub port: u16,
    18	    pub started_at: String,
    19	    /// Version of the binary that started this daemon.
    20	    ///
    21	    /// Optional because lock files written by builds before this field existed
    22	    /// have to keep parsing — a daemon that predates it reads as `None`, which is
    23	    /// itself the signal that it is older than the current binary.
    24	    #[serde(default)]
    25	    pub version: Option<String>,
    26	}
    27	
    28	impl DaemonInfo {
    29	    pub fn base_url(&self) -> String {
    30	        format!("http://{}:{}", self.host, self.port)
    31	    }
    32	}
    33	
    34	pub fn lock_path() -> PathBuf {
    35	    config::daemon_lock_path()
    36	}
    37	
    38	pub fn write_lock(info: &DaemonInfo) -> Result<()> {
    39	    let bytes =
    40	        serde_json::to_vec_pretty(info).map_err(|e| crate::error::Error::Other(e.to_string()))?;
    41	    write_atomic(&lock_path(), &bytes)
    42	}
    43	
    44	pub fn read_lock() -> Option<DaemonInfo> {
    45	    let text = std::fs::read_to_string(lock_path()).ok()?;
    46	    serde_json::from_str(&text).ok()
    47	}
    48	
    49	pub fn remove_lock() {
    50	    let _ = std::fs::remove_file(lock_path());
    51	}
    52	
    53	/// The daemon in the lock, but only if it actually answers on its port.
    54	/// A stale lock (process gone) reads as not-running.
    55	pub fn running_daemon() -> Option<DaemonInfo> {
    56	    let info = read_lock()?;
    57	    if health_check(&info.host, info.port) {
    58	        Some(info)
    59	    } else {
    60	        None
    61	    }
    62	}
    63	
    64	/// True if `host` is a wildcard bind address (`0.0.0.0` / `::` / `[::]`).
    65	/// Duplicated from `mdview`'s `runtime.rs::is_wildcard` rather than shared:
    66	/// `mdview-core` cannot depend on the binary crate (wrong dependency
    67	/// direction), and this is a 2-line pure predicate with no drift risk.
    68	fn is_wildcard(host: &str) -> bool {
    69	    matches!(host, "0.0.0.0" | "::" | "[::]")
    70	}
    71	
    72	/// The version the *running* daemon reports on `/health`, not the version in the
    73	/// lock file.
    74	///
    75	/// Upgrading the binary does not restart a daemon that is already serving, so the
    76	/// live process can be older than the CLI that just wrote to the database. That
    77	/// mismatch is invisible until a short link 404s, because the old process has no
    78	/// `/s/` route. `None` means the daemon did not answer, or answered without a
    79	/// version — both of which mean "older than this build" for a caller's purposes.
    80	pub fn daemon_version(host: &str, port: u16) -> Option<String> {
    81	    let body = health_body(host, port)?;
    82	    let key = "\"version\"";
    83	    let start = body.find(key)? + key.len();
    84	    let rest = &body[start..];
    85	    let open = rest.find('"')? + 1;
    86	    let close = rest[open..].find('"')? + open;
    87	    Some(rest[open..close].to_string())
    88	}
    89	
    90	/// Minimal blocking HTTP GET /health; true if it looks like mdview.
    91	pub fn health_check(host: &str, port: u16) -> bool {
    92	    match health_body(host, port) {
    93	        Some(buf) => buf.contains("\"mdview\"") || buf.contains("200 OK"),
    94	        None => false,
    95	    }
    96	}
    97	
    98	/// Raw `GET /health` response text, or `None` if the daemon did not answer.
    99	fn health_body(host: &str, port: u16) -> Option<String> {
   100	    // A wildcard-bound daemon can't be dialed back on its own bind address on
   101	    // every platform (e.g. WSAEADDRNOTAVAIL on macOS/Windows), so connect to
   102	    // loopback instead. Only the connect target changes -- the `Host:` header
   103	    // below keeps using the original, unsubstituted `host`.
   104	    let connect_host = if is_wildcard(host) {
   105	        if host == "0.0.0.0" {
   106	            "127.0.0.1"
   107	        } else {
   108	            "::1"
   109	        }
   110	    } else {
   111	        host
   112	    };
   113	    let mut stream = TcpStream::connect(format!("{connect_host}:{port}")).ok()?;
   114	    stream
   115	        .set_read_timeout(Some(Duration::from_millis(500)))
   116	        .ok();
   117	    stream
   118	        .set_write_timeout(Some(Duration::from_millis(500)))
   119	        .ok();
   120	    let req = format!("GET /health HTTP/1.1\r\nHost: {host}\r\nConnection: close\r\n\r\n");
   121	    stream.write_all(req.as_bytes()).ok()?;
   122	    let mut buf = String::new();
   123	    let _ = stream.take(4096).read_to_string(&mut buf);
   124	    Some(buf)
   125	}
   126	
   127	#[cfg(test)]
   128	mod tests {
   129	    use super::*;
   130	
   131	    #[test]
   132	    fn daemon_info_serde_roundtrip() {
   133	        let info = DaemonInfo {
   134	            pid: 42,
   135	            host: "127.0.0.1".into(),
   136	            port: 7700,
   137	            started_at: "2026-07-15T00:00:00Z".into(),
   138	            version: Some("0.5.2".into()),
   139	        };
   140	        let s = serde_json::to_string(&info).unwrap();
   141	        let back: DaemonInfo = serde_json::from_str(&s).unwrap();
   142	        assert_eq!(back.pid, 42);
   143	        assert_eq!(back.base_url(), "http://127.0.0.1:7700");
   144	        assert_eq!(back.version.as_deref(), Some("0.5.2"));
   145	    }
   146	
   147	    /// A lock file written before `version` existed must still parse — a daemon
   148	    /// from an older build is exactly the case this field exists to detect, so
   149	    /// failing to read its lock would defeat the purpose.
   150	    #[test]
   151	    fn a_lock_file_without_version_still_parses() {
   152	        let legacy =
   153	            r#"{"pid":42,"host":"127.0.0.1","port":7700,"started_at":"2026-07-15T00:00:00Z"}"#;
   154	        let info: DaemonInfo = serde_json::from_str(legacy).unwrap();
   155	        assert_eq!(info.pid, 42);
   156	        assert_eq!(info.version, None);
   157	    }
   158	
   159	    #[test]
   160	    fn daemon_version_is_none_when_nothing_answers() {
   161	        assert_eq!(daemon_version("127.0.0.1", 59_998), None);
   162	    }
   163	
   164	    #[test]
   165	    fn health_check_false_on_dead_port() {
   166	        // Nothing listening on this port → false, no panic.
   167	        assert!(!health_check("127.0.0.1", 59_999));
   168	    }
   169	
   170	    #[test]
   171	    fn health_check_dials_loopback_for_wildcard_host() {
   172	        // A daemon bound to a wildcard host ("0.0.0.0") can't be dialed back
   173	        // on that address on every platform (macOS/Windows reject it), so
   174	        // health_check must substitute loopback at the connect call site.
   175	        // This test proves that substitution by listening on 127.0.0.1 only
   176	        // and calling health_check with "0.0.0.0".
   177	        use std::net::TcpListener;
   178	
   179	        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
   180	        let port = listener.local_addr().unwrap().port();
   181	
   182	        let handle = std::thread::spawn(move || {
   183	            if let Ok((mut stream, _)) = listener.accept() {
   184	                // Drain the request so the client's write doesn't block/hang.
   185	                let mut buf = [0u8; 512];
   186	                let _ = stream.read(&mut buf);
   187	                let _ = stream.write_all(b"HTTP/1.1 200 OK\r\n\r\n");
   188	            }
   189	        });
   190	
   191	        assert!(health_check("0.0.0.0", port));
   192	
   193	        handle.join().unwrap();
   194	    }
   195	}
     1	//! Cross-platform process-spawn helpers shared by every crate that launches
     2	//! a detached daemon (`mdview` binary today, `mdview-desktop` next).
     3	
     4	/// Apply the platform detach settings to `cmd` so a spawned child outlives its
     5	/// spawner: a new session on Unix (`setsid`), a detached console + new process
     6	/// group on Windows. Extracted from `spawn_daemon_detached` so the detach itself
     7	/// is testable without launching the full daemon.
     8	pub fn apply_detach(cmd: &mut std::process::Command) {
     9	    #[cfg(unix)]
    10	    {
    11	        use std::os::unix::process::CommandExt;
    12	        // SAFETY: setsid() is async-signal-safe and is the only call made in the
    13	        // forked child before exec. It puts the child in its own new session (as
    14	        // session leader), detaching it from the spawner's controlling terminal
    15	        // and process group so neither a SIGHUP on session close nor a
    16	        // process-group-directed signal can reach it.
    17	        unsafe {
    18	            cmd.pre_exec(|| {
    19	                if libc::setsid() == -1 {
    20	                    return Err(std::io::Error::last_os_error());
    21	                }
    22	                Ok(())
    23	            });
    24	        }
    25	    }
    26	
    27	    #[cfg(windows)]
    28	    {
    29	        use std::os::windows::process::CommandExt;
    30	        // DETACHED_PROCESS: no inherited console. CREATE_NEW_PROCESS_GROUP: the
    31	        // daemon does not receive Ctrl+C/Ctrl+Break sent to the spawner's group.
    32	        const DETACHED_PROCESS: u32 = 0x0000_0008;
    33	        const CREATE_NEW_PROCESS_GROUP: u32 = 0x0000_0200;
    34	        cmd.creation_flags(DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP);
    35	    }
    36	}
