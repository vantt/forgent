   514	    State(st): State<AppState>,
   515	    Path((id, path)): Path<(String, String)>,
   516	) -> Response {
   517	    // Markdown file in the index → render it. A miss gets one on-demand
   518	    // index attempt (`ensure_indexed`) before falling to the asset lookup and
   519	    // then 404 — closes the race where the file exists on disk but the
   520	    // watcher hasn't caught up yet.
   521	    if let Ok(Some(project)) = st.engine.get_project(&id) {
   522	        if st.engine.ensure_indexed(&project, &path).unwrap_or(false) {
   523	            return match st.engine.render_file(&id, &path) {
   524	                Ok(page) => {
   525	                    let file = st.engine.store.get_file(&id, &path).unwrap().unwrap();
   526	                    let files = st.engine.list_files(&id).unwrap_or_default();
   527	                    let backlinks = st.engine.backlinks(&id, &path).unwrap_or_default();
   528	                    Html(views::file_page(&project, &file, &page, &files, &backlinks))
   529	                        .into_response()
   530	                }
   531	                Err(e) => internal_error(&e.to_string()),
   532	            };
   533	        }
   534	        // Otherwise serve as a static asset (image, etc.) with traversal guard.
   535	        if let Ok(abs) = st.engine.asset_path(&id, &path) {
   536	            if let Ok(bytes) = std::fs::read(&abs) {
   537	                return asset_response(&abs, bytes);
   538	            }
   539	        }
   540	        // Neither a file nor an asset — if it names a folder with a README
   541	        // (or index) among its direct children, redirect there instead of
   542	        // 404ing, the same landing-page convention project_home uses at the
   543	        // project root.
   544	        let files = st.engine.list_files(&id).unwrap_or_default();
   545	        if let Some(entry) = pick_folder_landing(&files, path.trim_end_matches('/')) {
   546	            return Redirect::to(&format!("/p/{id}/{}", entry.rel_path)).into_response();
   547	        }
   548	    }
   549	    not_found("file not found")
   550	}
