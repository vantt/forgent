     1	//! mdview desktop shell (Tauri v2). A thin native window onto the local mdview
     2	//! daemon (PRD §7.1/§7.5): ensure the daemon is up (spawn `mdview serve` if
     3	//! not), open a window pointing at its URL, keep it alive in the tray, and
     4	//! coordinate a single instance.
     5	//!
     6	//! NOTE: not compiled in the default workspace build — Tauri needs system libs
     7	//! (webkit2gtk/gtk3 on Linux). See README.md for prerequisites.
     8	
     9	#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]
    10	
    11	use mdview_core::daemon;
    12	use std::path::PathBuf;
    13	use std::process::Stdio;
    14	use std::time::Duration;
    15	use tauri::menu::{Menu, MenuItem};
    16	use tauri::tray::{TrayIconBuilder, TrayIconEvent};
    17	use tauri::{Manager, WebviewUrl, WebviewWindowBuilder, WindowEvent};
    18	
    19	fn main() {
    20	    // Single daemon owns the registry; the window is just a client.
    21	    let base = ensure_daemon();
    22	
    23	    // A native window needs a graphical display. Over a plain SSH session there
    24	    // is none, and GTK init would panic with a cryptic error. Detect that and
    25	    // point the user at the web UI (the daemon is already running) instead.
    26	    #[cfg(target_os = "linux")]
    27	    if std::env::var_os("DISPLAY").is_none() && std::env::var_os("WAYLAND_DISPLAY").is_none() {
    28	        eprintln!("mdview-desktop needs a graphical display, but none was found");
    29	        eprintln!("(DISPLAY / WAYLAND_DISPLAY unset — e.g. a plain SSH session).\n");
    30	        eprintln!("The mdview server is running — just open it in a browser:");
    31	        eprintln!("    {base}\n");
    32	        eprintln!("To get the native window, run this on a desktop session, or over");
    33	        eprintln!("SSH with X forwarding: ssh -X <host>");
    34	        std::process::exit(0);
    35	    }
    36	
    37	    tauri::Builder::default()
    38	        .plugin(tauri_plugin_single_instance::init(|app, _argv, _cwd| {
    39	            // Second launch → focus the existing window instead of opening another.
    40	            if let Some(w) = app.get_webview_window("main") {
    41	                let _ = w.show();
    42	                let _ = w.set_focus();
    43	            }
    44	        }))
    45	        .setup(move |app| {
    46	            let url = tauri::Url::parse(&base).expect("valid daemon url");
    47	            let window = WebviewWindowBuilder::new(app, "main", WebviewUrl::External(url))
    48	                .title("mdview")
    49	                .inner_size(1200.0, 800.0)
    50	                .min_inner_size(600.0, 400.0)
    51	                .build()?;
    52	
    53	            // Close-to-tray: hide instead of quitting, so the daemon keeps
    54	            // serving the agent workflow (PRD §7.5).
    55	            let hide_target = window.clone();
    56	            window.on_window_event(move |event| {
    57	                if let WindowEvent::CloseRequested { api, .. } = event {
    58	                    api.prevent_close();
    59	                    let _ = hide_target.hide();
    60	                }
    61	            });
    62	
    63	            build_tray(app.handle())?;
    64	            Ok(())
    65	        })
    66	        .run(tauri::generate_context!())
    67	        .expect("error while running mdview desktop");
    68	}
    69	
    70	fn build_tray(app: &tauri::AppHandle) -> tauri::Result<()> {
    71	    let show = MenuItem::with_id(app, "show", "Show mdview", true, None::<&str>)?;
    72	    let quit = MenuItem::with_id(app, "quit", "Quit", true, None::<&str>)?;
    73	    let menu = Menu::with_items(app, &[&show, &quit])?;
    74	
    75	    let mut builder = TrayIconBuilder::new()
    76	        .tooltip("mdview")
    77	        .menu(&menu)
    78	        .on_menu_event(|app, event| match event.id.as_ref() {
    79	            "show" => show_main(app),
    80	            "quit" => app.exit(0),
    81	            _ => {}
    82	        })
    83	        .on_tray_icon_event(|tray, event| {
    84	            if let TrayIconEvent::Click { .. } = event {
    85	                show_main(tray.app_handle());
    86	            }
    87	        });
    88	
    89	    if let Some(icon) = app.default_window_icon().cloned() {
    90	        builder = builder.icon(icon);
    91	    }
    92	    builder.build(app)?;
    93	    Ok(())
    94	}
    95	
    96	fn show_main(app: &tauri::AppHandle) {
    97	    if let Some(w) = app.get_webview_window("main") {
    98	        let _ = w.show();
    99	        let _ = w.set_focus();
   100	    }
   101	}
