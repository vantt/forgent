    19	/// How long a spawn-gate lock may sit before its owner is presumed dead and the
    20	/// gate is stolen — comfortably longer than the readiness poll below.
    21	const SPAWN_GATE_STALE: Duration = Duration::from_secs(15);
    22	
    23	/// The spawn-gate lock path: a sibling of the daemon lock. Its existence means
    24	/// "some invocation is currently spawning the daemon".
    25	fn spawn_gate_path() -> std::path::PathBuf {
    26	    daemon::lock_path().with_extension("spawning")
    27	}
    28	
    29	/// Outcome of trying to become the daemon spawner.
    30	enum Gate {
    31	    /// We own the gate and must do the spawn. The guard is held only for its
    32	    /// `Drop` (which removes the gate file), never read — hence `dead_code`.
    33	    Acquired(#[allow(dead_code)] SpawnGate),
    34	    /// Another live invocation holds the gate — wait for the daemon, don't spawn.
    35	    Held,
    36	    /// The gate file could not be used at all — caller should spawn unguarded.
    37	    Unavailable,
    38	}
    39	
    40	/// RAII guard that removes the spawn-gate file when the spawner is done.
    41	struct SpawnGate {
    42	    path: std::path::PathBuf,
    43	}
    44	
    45	impl Drop for SpawnGate {
    46	    fn drop(&mut self) {
    47	        let _ = std::fs::remove_file(&self.path);
    48	    }
    49	}
    50	
    51	/// Atomically claim the spawn gate at `path` via `create_new` (O_EXCL), so
    52	/// exactly one racer wins. An existing gate older than `stale_after` is assumed
    53	/// abandoned (its owner died mid-spawn) and stolen.
    54	fn acquire_spawn_gate_at(path: &std::path::Path, stale_after: Duration) -> Gate {
    55	    let claim = |p: &std::path::Path| {
    56	        std::fs::OpenOptions::new()
    57	            .write(true)
    58	            .create_new(true)
    59	            .open(p)
    60	    };
    61	    match claim(path) {
    62	        Ok(_) => Gate::Acquired(SpawnGate {
    63	            path: path.to_path_buf(),
    64	        }),
    65	        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
    66	            let stale = std::fs::metadata(path)
    67	                .and_then(|m| m.modified())
    68	                .ok()
    69	                .and_then(|t| t.elapsed().ok())
    70	                .map(|age| age > stale_after)
    71	                .unwrap_or(true); // unreadable/future mtime → treat as stale
    72	            if !stale {
    73	                return Gate::Held;
    74	            }
    75	            let _ = std::fs::remove_file(path);
    76	            match claim(path) {
    77	                Ok(_) => Gate::Acquired(SpawnGate {
    78	                    path: path.to_path_buf(),
    79	                }),
    80	                Err(_) => Gate::Held, // lost the steal race to another invocation
    81	            }
    82	        }
    83	        // Directory missing/unwritable etc. — the gate is unusable here.
    84	        Err(_) => Gate::Unavailable,
    85	    }
    86	}
