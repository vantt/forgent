"""Asset runner — declarative DAG with topo-sort, staleness, selective rebuild.

AssetSpec describes one asset (key, deps, fn, freshness, checks).
AssetRunner topo-sorts, decides what to materialize, runs each fn, records results.
"""
from __future__ import annotations

import logging
import time
from collections import defaultdict
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from typing import Any, Callable, Literal

from . import eod_progress as _default_progress

logger = logging.getLogger(__name__)


@dataclass(frozen=True)
class CheckResult:
    name: str
    severity: Literal["info", "warn", "error"]
    status: Literal["pass", "fail"]
    details: dict | None = None


@dataclass(frozen=True)
class AssetRunResult:
    key: str
    status: Literal["ok", "skipped_fresh", "blocked_dq", "failed"]
    started_at: datetime
    ended_at: datetime
    duration_s: float
    rows_in: int | None = None
    rows_out: int | None = None
    src_version: str | None = None
    out_version: str | None = None
    check_results: list[CheckResult] = field(default_factory=list)
    error: str | None = None


@dataclass
class AssetContext:
    """Passed to each asset fn — carries ports and run metadata."""
    run_date: str
    ports: dict[str, Any]
    upstream_results: dict[str, AssetRunResult]


@dataclass(frozen=True)
class AssetSpec:
    key: str
    deps: tuple[str, ...] = ()
    fn: Callable[[AssetContext], dict] | None = None
    checks: tuple[Callable, ...] = ()
    freshness: timedelta | None = None


class AssetRunner:
    """Topo-sorts assets, runs them, collects results.

    The ``progress`` parameter selects the progress registry module that
    receives per-step callbacks.  When None the default EOD registry is used,
    preserving the existing EOD behaviour byte-for-byte.  Pass
    ``intraday_progress`` to route intraday runs to their own registry so they
    never pollute the EOD banner on S01.
    """

    def __init__(
        self,
        specs: list[AssetSpec],
        ports: dict[str, Any],
        progress=None,
    ):
        self.specs = {s.key: s for s in specs}
        self.ports = ports
        # None → fall back to the EOD progress module (backward-compatible default).
        self._progress = progress if progress is not None else _default_progress

    def run(
        self,
        run_date: str,
        select: list[str] | None = None,
        force: bool = False,
    ) -> list[AssetRunResult]:
        ordered = self._topo_sort()
        if select:
            ordered = self._filter_select(ordered, select)

        results: dict[str, AssetRunResult] = {}
        blocked: set[str] = set()
        total = len(ordered)

        for idx, key in enumerate(ordered):
            spec = self.specs[key]

            # Report the live step into the injected progress registry so the
            # appropriate banner can show the real in-flight asset.  Guarded —
            # a registry error must never break a real pipeline run.
            self._safe_progress(run_date, key, idx, total)

            # Skip if any dep failed or was blocked
            if any(d in blocked for d in spec.deps):
                blocked.add(key)
                results[key] = self._make_result(key, "blocked_dq", datetime.now(timezone.utc), error="upstream blocked")
                continue

            ctx = AssetContext(
                run_date=run_date,
                ports=self.ports,
                upstream_results={d: results[d] for d in spec.deps if d in results},
            )
            results[key] = self._materialize(spec, ctx, force)
            if results[key].status in ("failed", "blocked_dq"):
                blocked.add(key)

        return list(results.values())

    def _safe_progress(self, run_date: str, key: str, idx: int, total: int) -> None:
        """Report the current step to the injected progress registry, swallowing
        any error so registry problems never abort a real pipeline run."""
        try:
            self._progress.step(run_date, key, idx)
        except Exception:  # pragma: no cover - defensive guard
            logger.debug("progress.step failed for %s", key, exc_info=True)

    def _materialize(
        self, spec: AssetSpec, ctx: AssetContext, force: bool
    ) -> AssetRunResult:
        started = datetime.now(timezone.utc)
        if spec.fn is None:
            return self._make_result(spec.key, "skipped_fresh", started)

        try:
            t0 = time.monotonic()
            fn_result = spec.fn(ctx)
            check_results = self._run_checks(spec, ctx, fn_result)
            duration = time.monotonic() - t0
            ended = datetime.now(timezone.utc)

            has_error_check = any(
                c.severity == "error" and c.status == "fail" for c in check_results
            )
            status = "blocked_dq" if has_error_check else "ok"

            return AssetRunResult(
                key=spec.key,
                status=status,
                started_at=started,
                ended_at=ended,
                duration_s=duration,
                rows_out=fn_result.get("rows_out"),
                check_results=check_results,
            )
        except Exception as e:
            logger.exception("Asset %s failed: %s", spec.key, e)
            ended = datetime.now(timezone.utc)
            return AssetRunResult(
                key=spec.key,
                status="failed",
                started_at=started,
                ended_at=ended,
                duration_s=(ended - started).total_seconds(),
                error=str(e),
            )

    def _run_checks(
        self, spec: AssetSpec, ctx: AssetContext, fn_result: dict
    ) -> list[CheckResult]:
        results = []
        for check_fn in spec.checks:
            try:
                result = check_fn(ctx, fn_result)
                if isinstance(result, CheckResult):
                    results.append(result)
            except Exception as e:
                results.append(CheckResult(
                    name=getattr(check_fn, "__name__", "unknown"),
                    severity="warn", status="fail",
                    details={"error": str(e)},
                ))
        return results

    def _topo_sort(self) -> list[str]:
        """Kahn's algorithm."""
        in_degree: dict[str, int] = defaultdict(int)
        adj: dict[str, list[str]] = defaultdict(list)
        for key, spec in self.specs.items():
            in_degree.setdefault(key, 0)
            for dep in spec.deps:
                adj[dep].append(key)
                in_degree[key] += 1
        queue = [k for k, d in in_degree.items() if d == 0]
        order = []
        while queue:
            n = queue.pop(0)
            order.append(n)
            for m in adj[n]:
                in_degree[m] -= 1
                if in_degree[m] == 0:
                    queue.append(m)
        if len(order) != len(self.specs):
            raise ValueError("Asset dependency cycle detected")
        return order

    def _filter_select(self, ordered: list[str], select: list[str]) -> list[str]:
        selected = set(select)
        # Include all downstream assets of selected
        adj: dict[str, list[str]] = defaultdict(list)
        for key, spec in self.specs.items():
            for dep in spec.deps:
                adj[dep].append(key)
        queue = list(selected)
        while queue:
            n = queue.pop()
            for m in adj[n]:
                if m not in selected:
                    selected.add(m)
                    queue.append(m)
        return [k for k in ordered if k in selected]

    @staticmethod
    def _make_result(
        key: str, status: str, started: datetime, error: str | None = None
    ) -> AssetRunResult:
        now = datetime.now(timezone.utc)
        return AssetRunResult(
            key=key, status=status,
            started_at=started, ended_at=now,
            duration_s=(now - started).total_seconds(),
            error=error,
        )
"""asset_specs_intraday.py — Medallion asset registry for the intraday pipeline.

INTRADAY_ASSET_SPECS dependency graph:

    canon.bars_intraday_ingest
            |
    feat.intraday
            |
    mart.money_flow_intraday
            |
    sig.signals_intraday
            |
    sig.outcomes_intraday   <-- guarded; never blocks pipeline
            |
    sig.alerts_intraday

All keys carry the _intraday suffix so they are distinct from EOD assets and
cannot interfere with EOD_ASSET_SPECS state or progress tracking.

AssetRunner is reused unchanged — it accepts any list of AssetSpecs.
"""
from __future__ import annotations

from .asset_runner import AssetSpec, AssetContext
from .ingest_intraday_bars import ingest_intraday_bars
from .features.intraday_features import compute_intraday_features
from .marts.money_flow_intraday import compute_money_flow_intraday
from .signals.signal_engine_intraday import compute_signals_intraday
from .signals.alert_dispatch_intraday import run_intraday_alert_dispatch
from .backtest.outcomes import label_outcomes_intraday_window


def _sig_outcomes_intraday_fn(ctx: AssetContext) -> dict:
    """Label forward daily-bar returns for intraday signals in trailing 30-day window.

    Guarded: any labeling failure is logged and returns rows_out=0.
    Intraday signal → daily-bar outcome (Validation S1#3, KISS).
    Writes to backtest/outcomes_intraday (separate from EOD outcomes).
    """
    import logging
    from datetime import date as _date
    log = logging.getLogger(__name__)
    try:
        run_date = _date.fromisoformat(ctx.run_date)
        result = label_outcomes_intraday_window(
            signal_repo=ctx.ports["signal_repo"],
            bar_repo=ctx.ports["bar_repo"],
            backtest_repo=ctx.ports["backtest_repo"],
            end=run_date,
        )
        rows_out = result.get("outcomes_written", 0)
        log.info(
            "sig.outcomes_intraday: %d written (%d examined, %d skipped)",
            rows_out, result.get("signals_examined", 0), result.get("skipped", 0),
        )
        return {"rows_out": rows_out}
    except Exception as exc:
        log.warning("sig.outcomes_intraday: labeling failed (non-fatal) — %s", exc)
        return {"rows_out": 0}


INTRADAY_ASSET_SPECS: list[AssetSpec] = [
    # 1. Ingest raw 5-minute bars from provider → canon/bars_intraday
    AssetSpec(
        key="canon.bars_intraday_ingest",
        deps=(),
        fn=ingest_intraday_bars,
    ),
    # 2. Compute per-symbol VWAP, RVOL, MFI, CMF, OBV → feat/intraday
    AssetSpec(
        key="feat.intraday",
        deps=("canon.bars_intraday_ingest",),
        fn=compute_intraday_features,
    ),
    # 3. Score money-flow per symbol + market aggregate → mart/money_flow_intraday
    AssetSpec(
        key="mart.money_flow_intraday",
        deps=("feat.intraday",),
        fn=compute_money_flow_intraday,
    ),
    # 4. Evaluate buy/watch gate → sig/signals_intraday (separate dataset from EOD)
    AssetSpec(
        key="sig.signals_intraday",
        deps=("mart.money_flow_intraday",),
        fn=compute_signals_intraday,
    ),
    # 5. Guarded trailing-window intraday outcome labeler (daily-bar forward returns).
    #    Never blocks the pipeline; writes to backtest/outcomes_intraday.
    AssetSpec(
        key="sig.outcomes_intraday",
        deps=("sig.signals_intraday",),
        fn=_sig_outcomes_intraday_fn,
    ),
    # 6. Dispatch intraday alerts via Telegram (daily cap enforced across poll runs)
    AssetSpec(
        key="sig.alerts_intraday",
        deps=("sig.signals_intraday",),
        fn=run_intraday_alert_dispatch,
    ),
]
"""signal_engine_intraday.py — orchestration for sig.signals_intraday asset.

Reads:
  mart/market_regime_daily   (latest EOD regime — gate: bearish ⇒ no buy)
  mart/sector_rotation_daily (latest EOD sector state)
  mart/money_flow_intraday   (intraday flow_status + money_flow_score per symbol)
  feat/intraday              (intraday vwap, rvol for entry context)

Emits SignalRecord with strategy_version suffix "-intraday" to the SEPARATE
dataset sig/signals_intraday (S1#1 — must not pollute EOD sig/signals).

Data loaders extracted to signal_engine_intraday_loaders.py (200-LOC rule).
No look-ahead. No vnstock imports. No Polars outside data loaders.
"""
from __future__ import annotations

import logging
import pathlib
import uuid
from datetime import date, datetime, timezone
from typing import TYPE_CHECKING

import yaml

from ...domain.analytics.signal_rules import evaluate_buy_gate
from ...domain.contracts.dto import SignalRecord
from ...domain.contracts.enums import SignalAction
from .signal_engine_intraday_loaders import (
    load_latest_eod_regime,
    load_latest_eod_sector_states,
)

if TYPE_CHECKING:
    from ..asset_runner import AssetContext

logger = logging.getLogger(__name__)


def compute_signals_intraday(ctx: "AssetContext") -> dict:
    """Asset fn for sig.signals_intraday.

    Returns {"rows_out": int, "buy_count": int, "watch_count": int, "warnings": list}.
    """
    feature_repo = ctx.ports["feature_repo"]   # ParquetLake
    strategy_repo = ctx.ports["strategy_repo"]
    bar_repo = ctx.ports["bar_repo"]            # for lake path access
    run_date = date.fromisoformat(ctx.run_date)
    now_utc = datetime.now(timezone.utc).replace(tzinfo=None)

    cfg = _load_strategy_config()
    buy_cfg = cfg.get("buy_signal", {})

    from ...application.strategy_version import resolve_strategy_version  # noqa: PLC0415
    sv = resolve_strategy_version(strategy_repo)
    # Intraday signals carry a distinct strategy_version suffix so they are
    # never confused with same-day EOD signals in downstream queries.
    strategy_version = sv.strategy_version + "-intraday"

    lake_path: pathlib.Path = bar_repo.lake

    # --- Load EOD regime + sector (gate inputs; not recomputed intraday — KISS) ---
    market_regime, market_score = load_latest_eod_regime(lake_path, run_date)
    sector_map = load_latest_eod_sector_states(lake_path, run_date)

    logger.info(
        "sig.signals_intraday: regime=%s market_score=%s date=%s strategy=%s",
        market_regime, market_score, run_date, strategy_version,
    )

    # Gate config
    allowed_regimes = buy_cfg.get("allowed_regimes", ["bullish", "improving", "neutral"])
    require_inflow = buy_cfg.get("require_market_inflow", True)
    flow_gate = buy_cfg.get("flow_gate", "require_inflow" if require_inflow else "not_outflow")
    min_rr = float(buy_cfg.get("min_risk_reward", 2.0))
    min_score = float(buy_cfg.get("min_score", 60.0))
    score_weights = buy_cfg.get("score_weights", {})

    # --- Load intraday mart + features ---
    flow_map = feature_repo.get_money_flow_intraday(run_date)
    feat_map = feature_repo.get_intraday_features([], run_date)

    if not flow_map and not feat_map:
        logger.warning("sig.signals_intraday: no intraday data for %s", run_date)
        return {"rows_out": 0, "buy_count": 0, "watch_count": 0, "warnings": ["no intraday data"]}

    market_flow_row = flow_map.get("VNINDEX", {})
    market_flow = market_flow_row.get("flow_status") if market_flow_row else None
    market_flow_score = _safe_float(market_flow_row.get("money_flow_score")) if market_flow_row else None

    symbols = list(feat_map.keys()) or list(flow_map.keys())

    signals: list[SignalRecord] = []
    buy_count = watch_count = 0
    warnings: list[str] = []

    for sym in symbols:
        try:
            # Idempotency: skip if already emitted for this strategy_version today
            if feature_repo.exists_intraday(sym, run_date, strategy_version):
                logger.debug("sig.signals_intraday: %s already exists — skipping", sym)
                continue

            feat = feat_map.get(sym, {})
            sym_flow = flow_map.get(sym, {})
            sym_flow_score = _safe_float(sym_flow.get("money_flow_score"))

            # Sector context from latest EOD sector rotation
            sector_key = sector_map.get("sym_to_sector", {}).get(sym)
            sector_score = None
            in_leading_sector = False
            if sector_key:
                sec_row = sector_map.get("sectors", {}).get(sector_key, {})
                sector_score = _safe_float(sec_row.get("sector_score"))
                sector_state = sec_row.get("sector_state", "")
                in_leading_sector = sector_state in ("leading", "improving")

            # Stock score: blend intraday flow score + RVOL signal
            rvol = _safe_float(feat.get("rvol"))
            stock_score = _derive_stock_score(sym_flow_score, rvol)
            vwap = _safe_float(feat.get("vwap"))

            gate = evaluate_buy_gate(
                market_regime=market_regime,
                market_score=market_score,
                market_flow=market_flow,
                market_flow_score=market_flow_score,
                sector_score=sector_score,
                in_leading_sector=in_leading_sector,
                stock_score=stock_score,
                liquidity_pass=True,   # intraday: already trading, no liquidity filter needed
                tradable=True,
                risk_reward=None,      # no ATR-based entry plan computed intraday
                allowed_regimes=allowed_regimes,
                require_market_inflow=require_inflow,
                flow_gate=flow_gate,
                min_risk_reward=min_rr,
                min_score=min_score,
                score_weights=score_weights,
            )

            reasons = gate.reasons[:]
            if rvol is not None:
                reasons.append(f"rvol_intraday={rvol:.2f}")
            if vwap is not None:
                reasons.append(f"vwap={vwap:.0f}")
            if sym_flow_score is not None:
                reasons.append(f"intraday_flow_score={sym_flow_score:.1f}")

            if gate.action == SignalAction.BUY:
                buy_count += 1
            elif gate.action == SignalAction.WATCH:
                watch_count += 1

            signals.append(SignalRecord(
                signal_id=uuid.uuid4().hex,
                symbol=sym,
                trade_date=run_date,
                action=gate.action.value,
                strategy_version=strategy_version,
                score=gate.score,
                score_breakdown=gate.score_breakdown,
                reasons=reasons,
                entry_low=None,
                entry_high=None,
                stop_loss=None,
                target=None,
                risk_reward=None,
                position_size_pct=None,
                setup_type=None,
                created_at=now_utc,
                alerted=False,
            ))

        except Exception as exc:
            logger.warning("sig.signals_intraday: %s failed — %s", sym, exc)
            warnings.append(f"{sym}: {exc}")

    result = feature_repo.upsert_signals_intraday(signals)
    logger.info(
        "sig.signals_intraday: %d written (buy=%d watch=%d), %d warnings",
        result.rows_written, buy_count, watch_count, len(warnings),
    )
    return {
        "rows_out": result.rows_written,
        "buy_count": buy_count,
        "watch_count": watch_count,
        "warnings": warnings,
        "strategy_version": strategy_version,
    }


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _derive_stock_score(flow_score: float | None, rvol: float | None) -> float | None:
    """Blend intraday flow score + RVOL into a 0-100 stock momentum proxy.

    70% flow score + 30% RVOL signal (high RVOL ≥ 1.5 → 100, otherwise → 50).
    Returns None when both inputs are absent.
    """
    if flow_score is None and rvol is None:
        return None
    fs = flow_score if flow_score is not None else 50.0
    rvol_signal = 100.0 if (rvol is not None and rvol >= 1.5) else 50.0
    return round(0.70 * fs + 0.30 * rvol_signal, 2)


def _load_strategy_config() -> dict:
    cfg_path = pathlib.Path(__file__).parents[4] / "config" / "strategy.yaml"
    return yaml.safe_load(cfg_path.read_text(encoding="utf-8"))


def _safe_float(v) -> float | None:
    try:
        return float(v) if v is not None else None
    except (TypeError, ValueError):
        return None

