"""eod_progress.py — process-local EOD pipeline progress registry.

A tiny thread-safe singleton that lets a running EOD ingest self-report which
asset (pipeline step) it is currently processing, so the S01 "EOD ingest
running… last step: X" banner can show the REAL in-flight step instead of a
generic placeholder.

Scope / limitation:
  - PROCESS-LOCAL only. The registry is a module-level dict guarded by a Lock; it
    is shared across threads in ONE worker process. Under multiple Uvicorn/
    Gunicorn workers each worker has its own registry, so the live step only
    surfaces when the run and the polling request land on the same worker
    (single-worker deploy). The S01 banner already degrades to "processing".
  - No persistence: state is lost on restart — acceptable, the durable run
    record lands in app_state regardless.

The AssetRunner self-reports into this registry (guarded so a registry error
never breaks a real pipeline run); MarketOverviewQuery reads current() to
surface the active step. Mirrors backtest/progress.py conventions, kept as a
parallel small module (KISS) rather than generalizing the backtest one.
"""
from __future__ import annotations

import threading
import time
from dataclasses import dataclass, field
from typing import Optional

# Status values for an EOD run record.
STATUS_RUNNING = "running"
STATUS_DONE = "done"
STATUS_FAILED = "failed"

_ACTIVE_STATUSES = frozenset({STATUS_RUNNING})


@dataclass
class EodProgress:
    """Mutable progress record for a single EOD run, keyed by run_date."""

    run_date: str
    status: str = STATUS_RUNNING
    step: str = ""          # current asset key, e.g. "canon.bars_daily"
    pct: int = 0
    index: int = 0          # 0-based index of the current step
    total: int = 0          # total number of steps (assets) to process
    error: str = ""
    started_at: float = field(default_factory=time.monotonic)
    updated_at: float = field(default_factory=time.monotonic)


class _EodProgressRegistry:
    """Thread-safe in-memory store of run_date -> EodProgress."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._runs: dict[str, EodProgress] = {}

    def start(self, run_date: str, total: int = 0) -> None:
        """Create (or reset) a run record in the RUNNING state."""
        with self._lock:
            self._runs[run_date] = EodProgress(run_date=run_date, total=int(total))

    def step(self, run_date: str, key: str, index: int) -> None:
        """Record the current step (asset key) and derived percent.

        pct = index / total (0..100). Autocreates the record if missing so a
        stray step call never raises.
        """
        with self._lock:
            rec = self._runs.get(run_date)
            if rec is None:
                rec = EodProgress(run_date=run_date)
                self._runs[run_date] = rec
            rec.step = key or ""
            rec.index = int(index)
            if rec.total > 0:
                rec.pct = max(0, min(100, int(index * 100 / rec.total)))
            rec.updated_at = time.monotonic()

    def done(self, run_date: str) -> None:
        with self._lock:
            rec = self._runs.get(run_date)
            if rec is not None:
                rec.status = STATUS_DONE
                rec.pct = 100
                rec.updated_at = time.monotonic()

    def fail(self, run_date: str, err: str = "") -> None:
        with self._lock:
            rec = self._runs.get(run_date)
            if rec is not None:
                rec.status = STATUS_FAILED
                rec.error = err or ""
                rec.updated_at = time.monotonic()

    def get(self, run_date: str) -> Optional[EodProgress]:
        with self._lock:
            return self._runs.get(run_date)

    def current(self) -> Optional[EodProgress]:
        """Most recently started ACTIVE (running) run, or None.

        Used by MarketOverviewQuery to surface the live pipeline step on S01.
        """
        with self._lock:
            active = [r for r in self._runs.values() if r.status in _ACTIVE_STATUSES]
            if not active:
                return None
            return max(active, key=lambda r: r.started_at)

    def clear(self, run_date: str | None = None) -> None:
        """Drop one run record, or all records when run_date is None."""
        with self._lock:
            if run_date is None:
                self._runs.clear()
            else:
                self._runs.pop(run_date, None)


# Module-level singleton + thin functional facade (the public API).
_REGISTRY = _EodProgressRegistry()


def start(run_date: str, total: int = 0) -> None:
    _REGISTRY.start(run_date, total)


def step(run_date: str, key: str, index: int) -> None:
    _REGISTRY.step(run_date, key, index)


def done(run_date: str) -> None:
    _REGISTRY.done(run_date)


def fail(run_date: str, err: str = "") -> None:
    _REGISTRY.fail(run_date, err)


def get(run_date: str) -> Optional[EodProgress]:
    return _REGISTRY.get(run_date)


def current() -> Optional[EodProgress]:
    return _REGISTRY.current()


def clear(run_date: str | None = None) -> None:
    _REGISTRY.clear(run_date)
"""intraday_progress.py — process-local INTRADAY pipeline progress registry.

A tiny thread-safe singleton that lets a running intraday ingest self-report
which asset (pipeline step) it is currently processing. Mirrors eod_progress.py
exactly but owns an independent registry so intraday runs NEVER pollute the EOD
progress banner on S01.

Scope / limitation:
  - PROCESS-LOCAL only. The registry is a module-level dict guarded by a Lock;
    it is shared across threads in ONE worker process. Under multiple Uvicorn/
    Gunicorn workers each worker has its own registry (single-worker deploy).
  - No persistence: state is lost on restart — acceptable, the durable run
    record lands in app_state regardless.

Exposed via intraday_progress.current() for future dashboard surfaces (S01
intraday banner, etc.). The registry is fully independent from eod_progress:
after an intraday run, eod_progress.current() remains unaffected.
"""
from __future__ import annotations

import threading
import time
from dataclasses import dataclass, field
from typing import Optional

# Status values for an intraday run record.
STATUS_RUNNING = "running"
STATUS_DONE = "done"
STATUS_FAILED = "failed"

_ACTIVE_STATUSES = frozenset({STATUS_RUNNING})


@dataclass
class IntradayProgress:
    """Mutable progress record for a single intraday run, keyed by run_date."""

    run_date: str
    status: str = STATUS_RUNNING
    step: str = ""          # current asset key, e.g. "canon.bars_intraday_ingest"
    pct: int = 0
    index: int = 0          # 0-based index of the current step
    total: int = 0          # total number of steps (assets) to process
    error: str = ""
    started_at: float = field(default_factory=time.monotonic)
    updated_at: float = field(default_factory=time.monotonic)


class _IntradayProgressRegistry:
    """Thread-safe in-memory store of run_date -> IntradayProgress."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._runs: dict[str, IntradayProgress] = {}

    def start(self, run_date: str, total: int = 0) -> None:
        """Create (or reset) a run record in the RUNNING state."""
        with self._lock:
            self._runs[run_date] = IntradayProgress(run_date=run_date, total=int(total))

    def step(self, run_date: str, key: str, index: int) -> None:
        """Record the current step (asset key) and derived percent.

        pct = index / total (0..100). Autocreates the record if missing so a
        stray step call never raises.
        """
        with self._lock:
            rec = self._runs.get(run_date)
            if rec is None:
                rec = IntradayProgress(run_date=run_date)
                self._runs[run_date] = rec
            rec.step = key or ""
            rec.index = int(index)
            if rec.total > 0:
                rec.pct = max(0, min(100, int(index * 100 / rec.total)))
            rec.updated_at = time.monotonic()

    def done(self, run_date: str) -> None:
        with self._lock:
            rec = self._runs.get(run_date)
            if rec is not None:
                rec.status = STATUS_DONE
                rec.pct = 100
                rec.updated_at = time.monotonic()

    def fail(self, run_date: str, err: str = "") -> None:
        with self._lock:
            rec = self._runs.get(run_date)
            if rec is not None:
                rec.status = STATUS_FAILED
                rec.error = err or ""
                rec.updated_at = time.monotonic()

    def get(self, run_date: str) -> Optional[IntradayProgress]:
        with self._lock:
            return self._runs.get(run_date)

    def current(self) -> Optional[IntradayProgress]:
        """Most recently started ACTIVE (running) run, or None.

        Available for future intraday dashboard surfaces.
        """
        with self._lock:
            active = [r for r in self._runs.values() if r.status in _ACTIVE_STATUSES]
            if not active:
                return None
            return max(active, key=lambda r: r.started_at)

    def clear(self, run_date: str | None = None) -> None:
        """Drop one run record, or all records when run_date is None."""
        with self._lock:
            if run_date is None:
                self._runs.clear()
            else:
                self._runs.pop(run_date, None)


# Module-level singleton + thin functional facade (the public API).
_REGISTRY = _IntradayProgressRegistry()


def start(run_date: str, total: int = 0) -> None:
    _REGISTRY.start(run_date, total)


def step(run_date: str, key: str, index: int) -> None:
    _REGISTRY.step(run_date, key, index)


def done(run_date: str) -> None:
    _REGISTRY.done(run_date)


def fail(run_date: str, err: str = "") -> None:
    _REGISTRY.fail(run_date, err)


def get(run_date: str) -> Optional[IntradayProgress]:
    return _REGISTRY.get(run_date)


def current() -> Optional[IntradayProgress]:
    return _REGISTRY.current()


def clear(run_date: str | None = None) -> None:
    _REGISTRY.clear(run_date)

