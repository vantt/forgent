"""alert_dispatch_intraday.py — dispatch intraday alerts to Telegram with daily cap.

Sources signals from sig/signals_intraday (separate from EOD sig/signals).
Daily cap is enforced across all poll runs by counting already-sent alerts
for today in alert_repo before starting each dispatch batch.

Anti-spam guarantees:
  - Actionable-only: intraday alert_actions = [buy, exit, risk_warning] (no 'watch'
    noise), from config alerts.intraday.alert_actions.
  - Cooldown: per-symbol cooldown in MINUTES (alerts.intraday.cooldown_minutes, default
    60) instead of the EOD days-based cooldown.
  - Dedupe: dispatch_alerts uses dedupe_key = symbol|trade_date|action|strategy_version.
    Intraday strategy_version carries "-intraday" suffix so it never collides with EOD.
  - Daily cap: max_alerts_per_day counted across all intraday poll runs via alert_repo.
  - Never raises — all errors are caught (inherited from dispatch_alerts contract).

Known constraint (shared alerts dataset): alert_repo stores EOD and intraday alerts
in the same dataset with no kind discriminator, so the daily-cap count includes any
EOD alerts already SENT on the same calendar date. In normal operation EOD runs after
market close (16:30) while intraday polling stops at 15:00, so they never overlap and
the cap counts intraday-only. The only contamination path is a manual/backfill EOD
alert run DURING the session — rare, and it fails safe (suppresses extra alerts, never
sends more). Revisit with an AlertRecord kind column if EOD alerts ever run intraday.
"""
from __future__ import annotations

import logging
from datetime import date as _date
from typing import TYPE_CHECKING

from .alert_dispatch import _load_alert_cfg, dispatch_alerts
from ...domain.analytics.alert_format import render_intraday

if TYPE_CHECKING:
    from ..asset_runner import AssetContext

logger = logging.getLogger(__name__)


def run_intraday_alert_dispatch(ctx: "AssetContext") -> dict:
    """Asset fn for sig.alerts_intraday.

    Loads intraday signals for run_date from sig/signals_intraday, then
    dispatches via dispatch_alerts with:
      - notifier from ctx.ports (may be None — results in status=pending)
      - daily_cap = max_alerts_per_day (counts across all poll runs today)
      - render_fn = render_intraday (prepends [INTRADAY HH:MM] prefix line)

    Returns counts dict with rows_out.
    """
    alert_repo = ctx.ports["alert_repo"]
    signal_repo = ctx.ports["signal_repo"]
    app_state = ctx.ports["app_state"]
    notifier = ctx.ports.get("notifier")  # TelegramNotifier | None

    run_date = _date.fromisoformat(ctx.run_date)

    # Load intraday signals for today (separate dataset — no overlap with EOD)
    try:
        signals = signal_repo.get_signals_intraday([], run_date)
    except Exception as exc:
        logger.error("sig.alerts_intraday: failed to load signals for %s: %s", run_date, exc)
        return {"rows_out": 0, "sent": 0, "failed": 0, "error": str(exc)}

    if not signals:
        logger.info("sig.alerts_intraday: no intraday signals for %s", run_date)
        return {"rows_out": 0, "sent": 0, "failed": 0}

    logger.info("sig.alerts_intraday: %d signals to dispatch for %s", len(signals), run_date)

    cfg = _load_alert_cfg()
    daily_cap: int = int(cfg.get("max_alerts_per_day", 20))

    # Intraday overrides (config/strategy.yaml alerts.intraday): actionable-only
    # alert_actions (no 'watch' noise) + minutes-based cooldown instead of days.
    intraday_cfg = cfg.get("intraday", {}) or {}
    cooldown_minutes: int = int(intraday_cfg.get("cooldown_minutes", 60))
    eff_cfg = dict(cfg)
    if intraday_cfg.get("alert_actions"):
        eff_cfg["alert_actions"] = intraday_cfg["alert_actions"]

    counts = dispatch_alerts(
        signals=signals,
        alert_repo=alert_repo,
        app_state=app_state,
        notifier=notifier,
        run_date=run_date,
        cfg=eff_cfg,
        daily_cap=daily_cap,
        render_fn=render_intraday,
        cooldown_minutes=cooldown_minutes,
    )

    result = counts.as_dict()
    result["rows_out"] = counts.total()
    logger.info(
        "sig.alerts_intraday: complete -- sent=%d failed=%d dedup=%d cap=%d pending=%d",
        counts.sent, counts.failed, counts.skipped_dedupe, counts.skipped_cap, counts.pending,
    )
    return result
"""signal_engine_intraday_loaders.py — lake data loaders for signal_engine_intraday.

Extracted to keep signal_engine_intraday.py under 200 LOC.
All functions are read-only: no writes, no network calls.
"""
from __future__ import annotations

import logging
import pathlib
from datetime import date, timedelta

import polars as pl

logger = logging.getLogger(__name__)

_LOOKBACK_DAYS = 7   # days to scan for latest EOD mart values


def load_latest_eod_regime(
    lake_path: pathlib.Path, run_date: date
) -> tuple[str | None, float | None]:
    """Read the latest market_regime_daily row for VNINDEX within _LOOKBACK_DAYS.

    Looks back so weekends/holidays don't block intraday signals.
    Returns (market_regime, market_score) or (None, None) when unavailable.
    """
    base = lake_path / "mart" / "market_regime_daily"
    if not base.exists():
        return None, None
    try:
        files = list(base.rglob("*.parquet"))
        if not files:
            return None, None
        cutoff = run_date - timedelta(days=_LOOKBACK_DAYS)
        df = pl.read_parquet(files).filter(
            (pl.col("index_code") == "VNINDEX")
            & (pl.col("trade_date") >= cutoff)
            & (pl.col("trade_date") <= run_date)
        ).sort("trade_date", descending=True)
        if df.height == 0:
            return None, None
        row = df.row(0, named=True)
        return row.get("market_regime"), _safe_float(row.get("market_score"))
    except Exception as exc:
        logger.warning("sig.signals_intraday: cannot load market_regime — %s", exc)
        return None, None


def load_latest_eod_sector_states(lake_path: pathlib.Path, run_date: date) -> dict:
    """Return {"sym_to_sector": {symbol: sector_key}, "sectors": {sector_key: row_dict}}.

    Reads the most recent sector_rotation_daily rows and the ref/sector_map.
    Looks back _LOOKBACK_DAYS days so weekends don't block data.
    """
    result: dict = {"sym_to_sector": {}, "sectors": {}}
    cutoff = run_date - timedelta(days=_LOOKBACK_DAYS)

    # Sector rotation: one latest row per sector_key
    base_rotation = lake_path / "mart" / "sector_rotation_daily"
    if base_rotation.exists():
        try:
            files = list(base_rotation.rglob("*.parquet"))
            if files:
                df = (
                    pl.read_parquet(files)
                    .filter(
                        (pl.col("trade_date") >= cutoff)
                        & (pl.col("trade_date") <= run_date)
                    )
                    .sort("trade_date", descending=True)
                )
                df_latest = df.group_by("sector_key").agg(pl.first("*"))
                result["sectors"] = {r["sector_key"]: r for r in df_latest.to_dicts()}
        except Exception as exc:
            logger.warning("sig.signals_intraday: cannot load sector_rotation — %s", exc)

    # Symbol → sector_key from ref/sector_map (latest effective_date per symbol)
    sector_map_path = lake_path / "ref" / "sector_map"
    if sector_map_path.exists():
        try:
            files = list(sector_map_path.rglob("*.parquet"))
            if files:
                df = pl.read_parquet(files).sort("effective_date", descending=True)
                df_latest = df.group_by("symbol").agg(pl.first("sector_key"))
                result["sym_to_sector"] = {
                    r["symbol"]: r["sector_key"] for r in df_latest.to_dicts()
                }
        except Exception as exc:
            logger.warning("sig.signals_intraday: cannot load sector_map — %s", exc)

    return result


def _safe_float(v) -> float | None:
    try:
        return float(v) if v is not None else None
    except (TypeError, ValueError):
        return None
        if self.telegram_token and self.telegram_chat_id:
            if self._notifier is None:
                self._notifier = TelegramNotifier(
                    token=self.telegram_token,
                    chat_id=self.telegram_chat_id,
                )
            return self._notifier
        return None

    def _ports(self) -> dict:
        return {
            "provider": self.provider,
            "bar_repo": self.lake,
            "ref_repo": self.lake,
            "ff_repo": self.lake,
            "fund_repo": self.lake,
            "dq_repo": self.lake,
            "feature_repo": self.lake,    # implements FeatureRepositoryPort (Phase 03)
            "mart_repo": self.lake,       # implements MartRepositoryPort (Phase 04)
            "signal_repo": self.lake,     # implements SignalRepositoryPort (Phase 06)
            "strategy_repo": self.lake,   # implements StrategyVersionRepositoryPort (Phase 06)
            "alert_repo": self.lake,      # implements AlertRepositoryPort (Phase 07)
            "backtest_repo": self.lake,       # implements BacktestRepositoryPort (Phase 08)
            "bar_intraday_repo": self.intraday_repo,  # implements IntradayBarRepositoryPort
            "notifier": self.notifier,        # NotifierPort | None (Phase 07)
            "app_state": self.app_state,
        }

    def eod_pipeline(self) -> RunEodIngest:
        return RunEodIngest(
            ports=self._ports(),
            notifier=self.notifier,
        )

    def backfill_pipeline(self) -> RunEodIngest:
        """Full EOD pipeline with notifier=None — used by web backfill (no Telegram alerts)."""
        ports = {**self._ports(), "notifier": None}
        return RunEodIngest(ports=ports, notifier=None)

    def intraday_pipeline(self) -> RunIntradayIngest:
        """Intraday pipeline — separate job id, reuses same ports + notifier as EOD."""
        return RunIntradayIngest(
            ports=self._ports(),
            notifier=self.notifier,
        )

    def build_reference(self) -> BuildReference:
        return BuildReference(
            provider=self.provider,
            ref_repo=self.lake,
        )
