"""RunEodIngest use-case — orchestrates asset runner for an EOD session."""
from __future__ import annotations

import logging
from datetime import date, datetime, timedelta, timezone

from . import eod_progress
from .asset_runner import AssetRunner
from .asset_specs import EOD_ASSET_SPECS
from .backfill import run_backfill, trading_sessions_in_window
from .health_digest import build_health_digest
from .ops_notify import OpsAlertContext, OpsNotifyStore, context_from_digest, send_ops_alert, store_path_for

logger = logging.getLogger(__name__)

_JOB_ID = "eod_pipeline"

# Auto catch-up: how many trailing trading sessions to scan for missing
# mart.market_regime_daily / signal.signals before processing the current run.
# Bounded on purpose — each missing session costs a feat->mart->sig backfill
# pass, so this must never grow unbounded (see phase risk note: "kéo dài run").
_CATCHUP_LOOKBACK_N = 5


def _safe(fn, *args) -> None:
    """Run an eod_progress registry call, swallowing any error so a registry
    problem never breaks a real pipeline run."""
    try:
        fn(*args)
    except Exception:  # pragma: no cover - defensive guard
        logger.debug("eod_progress call failed", exc_info=True)


def _last_n_sessions_before(run_date: date, n: int) -> list[date]:
    """Return up to the last n VN trading sessions strictly before run_date."""
    lookback_days = n * 4 + 10  # generous padding for weekends/holidays
    sessions = trading_sessions_in_window(run_date - timedelta(days=lookback_days), run_date - timedelta(days=1))
    return sessions[-n:] if len(sessions) > n else sessions


def _find_missing_sessions(ports: dict, sessions: list[date]) -> list[date]:
    """Return the subset of sessions missing mart.market_regime_daily or signal.signals."""
    mart_repo = ports.get("mart_repo")
    signal_repo = ports.get("signal_repo")
    missing: list[date] = []
    for d in sessions:
        has_regime = bool(mart_repo.get_market_regime(["VNINDEX"], d, d)) if mart_repo else True
        has_signals = bool(signal_repo.get_signals([], d, d)) if signal_repo else True
        if not has_regime or not has_signals:
            missing.append(d)
    return missing


class RunEodIngest:
    """Use-case: run the full EOD pipeline for a given date."""

    def __init__(self, ports: dict, notifier=None, monitoring_store=None):
        self.ports = ports
        self.notifier = notifier
        self.monitoring_store = monitoring_store
        app_state = self.ports.get("app_state")
        self._ops_store = OpsNotifyStore(store_path_for(app_state)) if app_state else None

    def execute(
        self,
        run_date: str,
        select: list[str] | None = None,
        force: bool = False,
    ) -> list:
        """Run the pipeline. Returns list of AssetRunResult."""
        started = datetime.now(timezone.utc)
        app_state = self.ports.get("app_state")

        # Real (non-backfill) runs only: catch up on any missing trailing
        # sessions first, then check whether the PREVIOUS run ever finished.
        # notifier is None during backfill (see backfill.py / container._ports
        # convention) — skip both to avoid recursive/duplicate work.
        if self.notifier:
            self._check_previous_run_crash(app_state)
            self._auto_catchup(run_date)

        if app_state:
            app_state.set_job_running(_JOB_ID, run_date)
            app_state.beat(_JOB_ID)

        _safe(eod_progress.start, run_date, len(EOD_ASSET_SPECS))

        runner = AssetRunner(EOD_ASSET_SPECS, self.ports)

        try:
            results = runner.run(run_date=run_date, select=select, force=force)
        except Exception as e:
            logger.exception("Pipeline error: %s", e)
            _safe(eod_progress.fail, run_date, str(e))
            if app_state:
                app_state.set_job_failed(_JOB_ID, run_date, str(e))
            self._notify_failure(OpsAlertContext(
                job_name=_JOB_ID, run_date=run_date, error_summary=str(e),
            ))
            raise

        ended = datetime.now(timezone.utc)
        digest = build_health_digest(run_date, started, ended, results)

        if self.monitoring_store:
            self.monitoring_store.record_run(results)

        if digest.success:
            _safe(eod_progress.done, run_date)
        else:
            _safe(eod_progress.fail, run_date,
                  f"failed={digest.failed}, dq_blocked={digest.blocked_dq}")

        if app_state:
            if digest.success:
                app_state.set_job_done(_JOB_ID, run_date)
            else:
                app_state.set_job_failed(
                    _JOB_ID, run_date,
                    f"failed={digest.failed}, dq_blocked={digest.blocked_dq}"
                )
            app_state.beat(_JOB_ID)

        if not digest.success:
            self._notify_failure(context_from_digest(_JOB_ID, digest))

        logger.info("EOD pipeline done - %s", digest.render_telegram())
        return results

    def _notify_failure(self, ctx: OpsAlertContext) -> None:
        """Send a throttled [OPS] Telegram alert (max 1/job/day). Never raises."""
        if not self.notifier or not self._ops_store:
            return
        try:
            send_ops_alert(self.notifier, self._ops_store, ctx)
        except Exception as exc:  # pragma: no cover - defensive guard
            logger.warning("ops_notify: unexpected failure: %s", exc)

    def _check_previous_run_crash(self, app_state) -> None:
        """Detect a previous eod_pipeline run that never finished (status still
        'running' — e.g. the process was killed / container restarted) and fire
        one ops alert about it. Read-only against app_state: the next
        set_job_running() call below naturally overwrites the stale row, this
        method never mutates job_runs itself."""
        if not app_state:
            return
        try:
            runs = app_state.get_job_runs(limit=5)
        except Exception:  # pragma: no cover - defensive guard
            logger.debug("stale-run check: could not read job_runs", exc_info=True)
            return
        for r in runs:
            if r.job_name == _JOB_ID and r.status == "running":
                logger.warning(
                    "EOD dead-man-switch: previous run for %s never finished (status=running)",
                    r.run_date,
                )
                self._notify_failure(OpsAlertContext(
                    job_name=_JOB_ID,
                    run_date=r.run_date,
                    error_summary="previous run never finished (process killed / container restart?)",
                ))
                break

    def _auto_catchup(self, run_date: str) -> None:
        """Backfill any of the last N trailing sessions missing mart/signal data.

        Runs BEFORE the current session so downstream marts/signals it depends
        on (e.g. sector rotation trend) see a complete recent history. Uses
        notifier=None so it can never fire a trade alert or an ops alert for
        historical sessions — only the current run's own outcome is reported.
        Any failure here is logged and swallowed; it must never block the
        real run for run_date.
        """
        try:
            target = date.fromisoformat(run_date)
        except ValueError:
            return
        try:
            sessions = _last_n_sessions_before(target, _CATCHUP_LOOKBACK_N)
            missing = _find_missing_sessions(self.ports, sessions)
            if not missing:
                return
            logger.info("EOD auto-catchup: %d missing session(s): %s", len(missing), missing)
            catchup_ports = {**self.ports, "notifier": None}
            for d in missing:
                try:
                    run_backfill(ports=catchup_ports, from_date=d, to_date=d)
                except Exception as exc:  # noqa: BLE001 - one bad session must not block others
                    logger.warning("EOD auto-catchup: backfill failed for %s: %s", d, exc)
        except Exception:  # pragma: no cover - defensive guard
            logger.exception("EOD auto-catchup: scan failed (non-fatal)")
"""ingest_intraday.py — RunIntradayIngest use-case.

Mirrors RunEodIngest (ingest_eod.py) but:
  - Uses job id "intraday_pipeline" in app_state so it NEVER overwrites EOD
    job status visible on S01/S09.
  - Uses INTRADAY_ASSET_SPECS (not EOD_ASSET_SPECS).
  - After a successful pass, publishes SSE event "snapshot.refreshed" so the
    dashboard auto-refreshes intraday panels without a full page reload.
  - Notifier fires a throttled [OPS] Telegram alert after
    _CONSECUTIVE_FAIL_THRESHOLD consecutive failing passes (see ops_notify.py) —
    a single blip must not spam the ops channel.
"""
from __future__ import annotations

import logging
from datetime import datetime, timezone

from . import intraday_progress
from .asset_runner import AssetRunner
from .asset_specs_intraday import INTRADAY_ASSET_SPECS
from .health_digest import build_health_digest
from .ops_notify import OpsNotifyStore, context_from_digest, send_ops_alert, store_path_for

logger = logging.getLogger(__name__)

_JOB_ID = "intraday_pipeline"   # distinct from "eod_pipeline" — never collide in app_state

# Intraday runs many passes per trading day (every ~5min) — a single blip must
# not spam Telegram. Only alert once we see this many CONSECUTIVE failing
# passes (tracked in OpsNotifyStore, not job_runs — job_runs is keyed by
# (job_name, run_date) so it only ever keeps the LATEST pass for the day).
_CONSECUTIVE_FAIL_THRESHOLD = 3


def _safe(fn, *args) -> None:
    """Call fn(*args), swallowing any exception so a side-effect failure never
    aborts the pipeline run."""
    try:
        fn(*args)
    except Exception:  # pragma: no cover - defensive guard
        logger.debug("_safe call failed", exc_info=True)


class RunIntradayIngest:
    """Use-case: run one intraday pipeline pass for a given date.

    Instantiated by container.intraday_pipeline() with wired ports + notifier.
    Designed for a single-pass execution model: called by 'vnflow run-intraday',
    which exits after execute() returns.  Repetition is handled externally by
    Windows Task Scheduler (every 5 minutes within the trading session).
    """

    def __init__(self, ports: dict, notifier=None):
        self.ports = ports
        self.notifier = notifier
        app_state = self.ports.get("app_state")
        self._ops_store = OpsNotifyStore(store_path_for(app_state)) if app_state else None

    def execute(self, run_date: str) -> list:
        """Run the full intraday DAG for run_date.  Returns list[AssetRunResult]."""
        started = datetime.now(timezone.utc)
        app_state = self.ports.get("app_state")

        if app_state:
            app_state.set_job_running(_JOB_ID, run_date)
            app_state.beat(_JOB_ID)

        # Register the intraday run in its OWN progress registry — never touches
        # eod_progress, so the S01 EOD banner is unaffected.
        _safe(intraday_progress.start, run_date, len(INTRADAY_ASSET_SPECS))

        # Inject intraday_progress so AssetRunner routes step() calls here, not
        # to the default eod_progress registry.
        runner = AssetRunner(INTRADAY_ASSET_SPECS, self.ports, progress=intraday_progress)

        try:
            results = runner.run(run_date=run_date)
        except Exception as exc:
            logger.exception("Intraday pipeline error: %s", exc)
            _safe(intraday_progress.fail, run_date, str(exc))
            if app_state:
                app_state.set_job_failed(_JOB_ID, run_date, str(exc))
            raise

        ended = datetime.now(timezone.utc)
        digest = build_health_digest(run_date, started, ended, results)

        if digest.success:
            _safe(intraday_progress.done, run_date)
        else:
            _safe(intraday_progress.fail, run_date,
                  f"failed={digest.failed}, dq_blocked={digest.blocked_dq}")

        if app_state:
            if digest.success:
                app_state.set_job_done(_JOB_ID, run_date)
            else:
                app_state.set_job_failed(
                    _JOB_ID, run_date,
                    f"failed={digest.failed}, dq_blocked={digest.blocked_dq}",
                )
            app_state.beat(_JOB_ID)

        self._notify_if_consecutive_fail(digest)

        # Publish SSE so dashboard panels refresh without polling delay
        if digest.success:
            _safe(_publish_sse_refresh, run_date)

        logger.info(
            "Intraday pipeline done [%s] — ok=%d failed=%d blocked=%d rows=%d wall=%.0fs",
            run_date, digest.ok, digest.failed, digest.blocked_dq,
            digest.total_rows_out, digest.wall_time_s,
        )
        return results

    def _notify_if_consecutive_fail(self, digest) -> None:
        """Track consecutive failing passes; alert (throttled 1/day) once the
        threshold is hit. Never raises — a notify failure must never affect
        the pipeline result."""
        if not self._ops_store:
            return
        try:
            consecutive_fails = self._ops_store.record_pass(_JOB_ID, success=digest.success)
            if not digest.success and consecutive_fails >= _CONSECUTIVE_FAIL_THRESHOLD and self.notifier:
                ctx = context_from_digest(
                    _JOB_ID, digest,
                    error_summary=f"{consecutive_fails} consecutive failing intraday passes",
                )
                send_ops_alert(self.notifier, self._ops_store, ctx)
        except Exception as exc:  # pragma: no cover - defensive guard
            logger.warning("ops_notify: unexpected failure: %s", exc)


def _publish_sse_refresh(run_date: str) -> None:
    """Publish snapshot.refreshed SSE event to connected dashboard clients.

    Import is deferred and guarded so that CLI runs without a running web
    server never crash — the event_bus publish() is a no-op when no
    subscribers are connected.
    """
    from ..interface.web.sse import event_bus
    event_bus.publish("snapshot.refreshed", {"date": run_date, "source": "intraday"})
    logger.debug("SSE snapshot.refreshed published for %s", run_date)

