"""Windows Task Scheduler integration helper.

Run `vnflow scheduler-xml` to print the EOD XML template.
Run `vnflow scheduler-xml-intraday` to print the intraday polling XML template.

Both templates can be imported into Windows Task Scheduler (taskschd.msc).
"""
from __future__ import annotations

import sys

# ---------------------------------------------------------------------------
# EOD pipeline — once daily at 16:30 ICT (Mon-Fri)
# ---------------------------------------------------------------------------

TASK_XML = """<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <CalendarTrigger>
      <!-- 16:30 ICT = 09:30 UTC. Adjust to your market close + buffer. -->
      <StartBoundary>2026-01-01T16:30:00</StartBoundary>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Monday/><Tuesday/><Wednesday/><Thursday/><Friday/>
        </DaysOfWeek>
      </ScheduleByWeek>
      <Enabled>true</Enabled>
    </CalendarTrigger>
  </Triggers>
  <Actions>
    <Exec>
      <Command>vnflow</Command>
      <Arguments>run-eod</Arguments>
      <WorkingDirectory>REPLACE_WITH_PROJECT_ROOT</WorkingDirectory>
    </Exec>
  </Actions>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
</Task>
"""

# ---------------------------------------------------------------------------
# Intraday pipeline — every 5 minutes during VN trading sessions (Mon-Fri)
#
# Design:
#   StartBoundary  = 09:00 ICT (02:00 UTC) — first fire of the day
#   Repetition/Interval = PT5M — re-fires every 5 minutes
#   Repetition/Duration = PT6H30M — covers 09:00–15:30 (morning + lunch + afternoon + buffer)
#   StopAtDurationEnd  = true — no stray process after 15:30
#   MultipleInstancesPolicy = IgnoreNew — if a run is still active when the
#       next trigger fires, the new invocation is silently dropped (no pile-up).
#   ExecutionTimeLimit = PT4M — a single pass must complete in under 4 minutes;
#       kill the process if it hangs (watchlist of ~50 syms should finish in ~3 min).
#
# The 'run-intraday' command itself also guards on trading hours and holidays,
# so Task Scheduler fires are harmless on weekends or public holidays.
# ---------------------------------------------------------------------------

INTRADAY_TASK_XML = """<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <CalendarTrigger>
      <!-- 09:00 ICT = 02:00 UTC. First fire of the intraday polling cycle. -->
      <StartBoundary>2026-01-01T09:00:00</StartBoundary>
      <Repetition>
        <!-- Fire every 5 minutes for 6h30m (covers 09:00-15:30 ICT with buffer) -->
        <Interval>PT5M</Interval>
        <Duration>PT6H30M</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Monday/><Tuesday/><Wednesday/><Thursday/><Friday/>
        </DaysOfWeek>
      </ScheduleByWeek>
      <Enabled>true</Enabled>
    </CalendarTrigger>
  </Triggers>
  <Actions>
    <Exec>
      <Command>vnflow</Command>
      <Arguments>run-intraday</Arguments>
      <WorkingDirectory>REPLACE_WITH_PROJECT_ROOT</WorkingDirectory>
    </Exec>
  </Actions>
  <Settings>
    <!-- Drop the new invocation if a previous run is still active (no pile-up) -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- Kill a hung process after 4 minutes — well within the 5-minute interval -->
