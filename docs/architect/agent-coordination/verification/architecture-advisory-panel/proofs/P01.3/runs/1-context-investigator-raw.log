"""money_flow_intraday.py — orchestration for mart.money_flow_intraday asset.

Thin wrapper mirroring marts/money_flow.py but sourced from feat/intraday.
Calls domain/analytics/money_flow.score_money_flow (DRY — no indicator reimpl).
Writes mart/money_flow_intraday (separate dataset; EOD mart/money_flow_daily untouched).
"""
from __future__ import annotations

import logging
import pathlib
from datetime import date, datetime, timezone
from typing import TYPE_CHECKING

import yaml

from ...domain.analytics.money_flow import score_money_flow
from ...domain.contracts.dto import MoneyFlowRow

if TYPE_CHECKING:
    from ..asset_runner import AssetContext

logger = logging.getLogger(__name__)

_PROV_SOURCE = "vnflow:mart"
_PROV_VERSION = "mart-intraday-1.0.0"


def compute_money_flow_intraday(ctx: "AssetContext") -> dict:
    """Asset fn for mart.money_flow_intraday.

    Reads feat/intraday for run_date, scores per-symbol money flow using the
    same domain scorer as EOD, and writes mart/money_flow_intraday.

    Returns {"rows_out": int, "warnings": list[str]}.
    """
    feature_repo = ctx.ports["feature_repo"]   # ParquetLake — has get/upsert_intraday_features
    run_date = date.fromisoformat(ctx.run_date)
    now_utc = datetime.now(timezone.utc).replace(tzinfo=None)
    prov = dict(source=_PROV_SOURCE, data_version=_PROV_VERSION, ingested_at=now_utc)

    cfg = _load_strategy_config()
    flow_cfg = cfg.get("flow", {})
    weights = flow_cfg.get("weights", {})

    # Load intraday features for run_date
    feat_map = feature_repo.get_intraday_features([], run_date)
    if not feat_map:
        logger.warning("mart.money_flow_intraday: no feat.intraday rows for %s", run_date)
        return {"rows_out": 0, "warnings": ["no intraday features"]}

    score_kwargs = dict(
        mfi_bull=float(flow_cfg.get("mfi_bull", 55.0)),
        mfi_bear=float(flow_cfg.get("mfi_bear", 45.0)),
        cmf_bull=float(flow_cfg.get("cmf_bull", 0.05)),
        cmf_bear=float(flow_cfg.get("cmf_bear", -0.05)),
        rvol_high=float(flow_cfg.get("rvol_high", 1.5)),
        z_high=float(flow_cfg.get("z_high", 1.0)),
        z_low=float(flow_cfg.get("z_low", -1.0)),
        w_mfi=float(weights.get("mfi", 0.25)),
        w_cmf=float(weights.get("cmf", 0.25)),
        w_rvol=float(weights.get("rvol", 0.15)),
        w_tz=float(weights.get("turnover_z", 0.15)),
        w_obv=float(weights.get("obv", 0.10)),
        w_foreign=float(weights.get("foreign", 0.10)),
    )
    inflow_threshold = float(flow_cfg.get("inflow_threshold", 60.0))
    outflow_threshold = float(flow_cfg.get("outflow_threshold", 40.0))

    rows: list[MoneyFlowRow] = []
    warnings: list[str] = []
    flow_scores: list[float] = []

    for sym, feat in feat_map.items():
        try:
            result = score_money_flow(
                mfi14=_safe_float(feat.get("mfi14")),
                cmf20=_safe_float(feat.get("cmf20")),
                rvol20=_safe_float(feat.get("rvol")),        # intraday field is "rvol"
                turnover_z20=_safe_float(feat.get("turnover_z")),
                obv=_safe_float(feat.get("obv")),
                obv_prev=None,   # no prior-bar OBV in intraday single-day feature
                foreign_net_value=None,  # foreign net not available intraday (price board is EOD)
                **score_kwargs,
            )
            score = max(0.0, min(100.0, result.money_flow_score))

            rows.append(MoneyFlowRow(
                level="stock",
                key=sym,
                trade_date=run_date,
                money_flow_score=score,
                flow_status=result.flow_status.value,
                flow_source="indirect",
                notes=result.notes,
                **prov,
            ))
            flow_scores.append(score)

        except Exception as exc:
            logger.warning("mart.money_flow_intraday: %s failed — %s", sym, exc)
