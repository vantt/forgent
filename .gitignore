# Upstream source clones — cursors tracked in docs/distillery/, re-clone as needed
/upstreams/

# forgent state layer — events.jsonl is truth (committed); state.json is a derived view
.fgos/state.json
# worker dispatch logs — local observability, never committed (worker-dispatch-log D4)
.fgos/logs/
node_modules/

# test-leak artifacts — belt against auto-commit clobber (backlog STR74/STR65)
output.txt
*-output.txt
.fgos/sessions.json

# main-checkout activity lock + sibling lock files (STR65) — process state, never committed
.fgos/*.lock

# malformed-invocation records — local forensics only. The records carry the
# raw argv of the bad call, so committing them would push whatever flag values
# it happened to contain.
.fgos/invocation-faults.jsonl

# tool registry local status overlay — a fact about THIS machine (what `tool
# check` last observed), never a team decision, so it never goes through
# events.jsonl (tsk-1dj, tool-registry-capability port)
.fgos/tool-status.local.json

# untracked local secret environment variables (tsk-gb3)
.fgos/secrets.local.env

# events.jsonl truncation-guard mark — a high-water-mark that must live
# OUTSIDE git tracking to work at all: a git operation reverting the
# tracked events.jsonl must never also revert this (tsk-cgg,
# docs/history/events-jsonl-git-tracked-truncation/)
.fgos/events-jsonl.truncation-guard.json

# BEE:START
.bee/state.json
.bee/reservations.json
.bee/workers/
.bee/logs/
.bee/capture-queue.jsonl
.bee/feedback-digest.json
.bee/.inject-cache.json
.bee/HANDOFF.json
.bee/spikes/
.bee/manifest-hash.json
# BEE:END

# Workshop tree — untracked in the product repo (repo divorce)
/.bee/
/.claude/*
!/.claude/skills/
!/.claude/settings.json
!/.claude/agents/
/.claude/skills/*
!/.claude/skills/fgos-*/
!/.claude/skills/distill/
!/.claude/skills/_shared/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/fgos-*/
!/.agents/skills/distill/
!/.agents/skills/_shared/
/.codex/
/upstreams/

# Rust build output
/herdr-plugin/target/
# tsk-48w: herdr-plugin/web's bundled output, embedded into the binary at
# compile time (RustEmbed) -- never committed, herdr-plugin/build.rs
# guarantees this directory exists even when npm run bundle hasn't run.
/herdr-plugin/static/
