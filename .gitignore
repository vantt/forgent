# Upstream source clones — cursors tracked in docs/distillery/, re-clone as needed
/upstreams/

# forgent state layer — events.jsonl is truth (committed); state.json is a derived view
.fgos/state.json
# worker dispatch logs — local observability, never committed (worker-dispatch-log D4)
.fgos/logs/
node_modules/

# test-leak artifacts — belt against auto-commit clobber (backlog STR74/STR65)
output.txt
*-output.txt
.fgos/sessions.json

# main-checkout activity lock + sibling lock files (STR65) — process state, never committed
.fgos/*.lock

# malformed-invocation records — local forensics only. The records carry the
# raw argv of the bad call, so committing them would push whatever flag values
# it happened to contain.
.fgos/invocation-faults.jsonl

# tool registry local status overlay — a fact about THIS machine (what `tool
# check` last observed), never a team decision, so it never goes through
# events.jsonl (tsk-1dj, tool-registry-capability port)
.fgos/tool-status.local.json

