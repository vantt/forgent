  "gateBypass": {
    "level": "standard"
  },
  "cleanup": {
    "ttlDays": 5,
    "leafTtlDays": 0
  },
  "invariantChecks": {
    "commands": [
      "node --test test/architecture.test.mjs"
    ]
  },
  "workerSlots": {
    "ceiling": null
  },
  "ironLaw": {
    "level": "ask"
  },
  "gateway": {
    "port": 4170,
    "token": null
  },
  "herdrWebDashboard": {
    "staticServing": true
  },
  "checkpoint": {
    "fallbackIntervalSec": 3600
  },
  "docRegistry": {
    "enforce": true
  },
  "worktreeSetup": {
    "commands": [
      "for d in .claude/skills .agents/skills .omp/skills .pi/skills .grok/skills; do [ -d \"$FGOS_REPO_ROOT/$d\" ] || continue; mkdir -p \"$d\"; for s in \"$FGOS_REPO_ROOT/$d\"/ak-*; do [ -d \"$s\" ] && cp -R \"$s\" \"$d/\"; done; done; true"
    ]
  },
  "lock": {
    "predecessorKillWaitMs": 2000
  },
  "terminal": {
    "allocationGraceMs": 60000,
    "retainFailedPaneMs": null,
    "layout": {
      "policy": "measured-split",
      "minCols": 80,
      "minRows": 20,
      "maxPanesPerTab": 8
    }
  },
  "eventStore": {
    "remote": "origin"
  }
