{
  "herdrOrchestrator": {
    "autoDiscover": true,
    "autoMerge": false,
    "autoRetro": false,
    "autoCleanup": false
  },
  "runner": {
    "executor": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(git add:*),Bash(git commit:*),Bash(rtk git add:*),Bash(rtk git commit:*)"
      ]
    },
    "capabilities": {
      "impact-analysis": {
        "description": "Code-graph blast radius",
        "aliases": [
          "impact_analysis",
          "Impact Analysis"
        ],
        "prefer": "gitnexus"
      },
      "pane-labeling": {
        "description": "Write a session/task id onto the current terminal pane's label, for a human watching a screen"
      },
      "advise": {
        "description": "Async product-decision consult -- value comes from disagreement and never changes project state.",
        "prefer": [
          {
            "executor": "claude",
            "invocation": "cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        }
      },
      "execute": {
        "description": "Compliance-driven work -- value comes from following the plan, changes files, and must pass verification.",
        "prefer": "claude"
      },
      "fgos-coding-implement": {
        "description": "code-implement work for the coding domain's executing stage -- pinned to gemini-3.6-flash-medium via this capability's own providerModel/rigorOverrides (agy/gemini, lightweight policy tier; see modelPolicies.gemini.lightweight for the literal model string).\n\nFlipped to executors.agy-herdr on 2026-09-07, which is the condition the previous description set: \"do not flip prefer back to agy-herdr until this is fixed and re-verified live\". Both halves of the old failure are gone, and gone structurally rather than by tuning.\n\nThe prompt no longer travels on a command line at all -- it is written to brief-<round>.md and only a one-line pointer is submitted -- so the multi-line corruption that used to destroy every real implement prompt has nowhere left to happen. Completion is now the worker's own outbox/result-<round>.json appearing; agent_status is never read as completion, which is what produced the silent false successes (idle before the agent had started; an idle-looking gap mid-turn).\n\nEvidence: 10/10 settled with ack and result (P1, 2026-09-07), plus 2/2 again driven from this very config entry after the -i flag was removed from its args -- that flag made agy take the NEXT flag as its prompt value and never reach ready. Logs: docs/architect/agent-coordination/verification/visibility-herdr/proofs/2026-09-07-v0/.\n\nBounded honestly: every one of those rounds ran a trivial task with a six-line prompt. What is proven is contract conformance -- agy reads the pointer, finds the brief, writes ack/report/result -- not that agy does hard implementation work well. The first real fgos-coding-implement dispatch is the real test.\n\nReverting is one field: set prefer back to \"agy-cli\". A failure now leaves a named outcome (agent_not_ready, agent_prompt_stalled, agent_blocked, died, timed-out-idle, timed-out-ceiling, paused-limit), an open pane with the reason still on screen, and a run.json that says settled/died/unknown instead of sitting at running forever -- so a bad flip is visible within one dispatch rather than silently burning a timeout window.",
        "prefer": [
          {
            "executor": "agy",
            "invocation": "herdr"
          }
        ],
        "overrides": {
          "providerModel": "gemini",
          "rigorOverrides": {
            "light": "standard",
            "standard": "standard",
            "heavy": "standard"
          }
        }
      },
      "code:implement": {
        "description": "Canonical coding implementation capability -- compliance-driven coding execution before implementation (D1/D2, docs/history/capability-aware-dispatch-activation/CONTEXT.md)",
        "prefer": [
          {
            "executor": "agy",
            "invocation": "cli"
          }
        ]
      },
      "code:review": {
        "description": "Canonical coding review capability -- independent read-only review of a coding implementation unit before merge (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": [
          {
            "executor": "codex",
            "invocation": "cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        }
      },
      "code:test": {
        "description": "Canonical coding test capability -- author or run tests for a coding implementation unit (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": "claude"
      },
      "code:debug": {
        "description": "Canonical coding debug capability -- read-only root-cause investigation of a coding defect (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": [
          {
            "executor": "codex",
            "invocation": "cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        }
      },
      "code:refactor": {
        "description": "Canonical coding refactor capability -- behavior-preserving structural change to existing code (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": "claude"
      }
    },
    "placementPolicy": {
      "readOnlyRedirects": {
        "claude": {
          "default": [
            {
              "executor": "codex",
              "invocation": "cli-bwrap"
            }
          ],
          "operations": {
            "review-candidate": [
              {
                "executor": "codex",
                "invocation": "cli-bwrap"
              }
            ],
            "red-team-candidate": [
              {
                "executor": "codex",
                "invocation": "cli-bwrap"
              }
            ]
          }
        }
      }
    },
    "executors": {
      "claude": {
        "kind": "agent",
        "description": "Claude Code CLI -- consolidated executor (executor-id-consolidation Step 2): cli/cli-readonly/herdr-readonly/cli-bwrap invocations, replacing the former separate claude-reviewer/claude-reviewer-herdr/claude-bwrap ids.",
        "identity": {
          "principalRef": "principal://claude",
          "runtimeBackendRef": "backend://claude-cli",
          "trustDomain": "local-operator",
          "egressClass": "unrestricted"
        },
        "supports": {
          "providerFamilies": [
            "claude"
          ],
          "reasoningEffort": [
            "low",
            "medium",
            "high"
          ],
          "systemPrompt": false,
          "toolGating": "allowedTools"
        },
        "invocations": [
          {
            "id": "cli",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(git add:*),Bash(git commit:*),Bash(rtk git add:*),Bash(rtk git commit:*)"
            ]
          },
          {
            "id": "cli-readonly",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}",
              "--effort",
              "high",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(git diff:*),Bash(rtk git diff:*),Bash(git log:*),Bash(rtk git log:*),Bash(git show:*),Bash(rtk git show:*),Bash(git status:*),Bash(rtk git status:*),Bash(node --test:*),Bash(rtk node --test:*),Bash(npm test:*),Bash(rtk npm test:*)"
            ]
          },
          {
            "id": "herdr-readonly",
            "via": "cli",
            "adapter": "herdr-spawn",
            "command": "claude",
            "args": [
              "{prompt}",
              "--model",
              "{model}",
              "--effort",
              "high",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(git diff:*),Bash(rtk git diff:*),Bash(git log:*),Bash(rtk git log:*),Bash(git show:*),Bash(rtk git show:*),Bash(git status:*),Bash(rtk git status:*),Bash(node --test:*),Bash(rtk node --test:*),Bash(npm test:*),Bash(rtk npm test:*),Bash(cargo test:*),Bash(rtk cargo test:*),Bash(cargo clippy:*),Bash(rtk cargo clippy:*),Bash(cargo fmt:*),Bash(rtk cargo fmt:*),Bash(cargo build:*),Bash(rtk cargo build:*)"
            ],
            "liveOutput": {
              "streamFlags": [
                "--output-format",
                "stream-json",
                "--verbose",
                "--include-partial-messages"
              ],
              "renderer": "src/runner/dispatch/live-renderers/claude-stream-json.mjs"
            },
            "interactiveMode": {
              "exitCommand": "/exit",
              "kind": "claude",
              "trustStore": {
                "kind": "claude-json"
              }
            }
          },
          {
            "id": "cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            }
          }
        ],
        "for": [
          "advise"
        ]
      },
      "codex": {
        "kind": "agent",
        "description": "OpenAI Codex CLI -- consolidated executor (executor-id-consolidation Step 2): cli-bypass/cli-bwrap/cli-readonly/herdr invocations, replacing the former separate codex-cli/codex-bwrap/codex-readonly/codex-herdr ids. \"cli-readonly\" stays RETIRED FOR DISPATCH -- \"-s read-only\" has no writable-exception mechanism, so a dispatched agent can never write its own agent-result.json; kept only so existing references resolve. Use \"cli-bwrap\" for confined dispatch instead. \"herdr\" stays unconfined by decision until the confinement track lands for herdr-spawn.",
        "providerModel": "openai-codex",
        "allowCrossProvider": true,
        "for": [
          "code:review",
          "code:debug"
        ],
        "invocations": [
          {
            "id": "cli-bypass",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "--dangerously-bypass-approvals-and-sandbox",
              "--model",
              "{model}",
              "{prompt}"
            ],
            "env": {
              "CODEX_HOME": "${HOME}/.codex-fgovn"
            }
          },
          {
            "id": "cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "--skip-git-repo-check",
              "-s",
              "danger-full-access",
              "--model",
              "{model}",
              "{prompt}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "resourceBindings": [
              {
                "resource": "private-home",
                "target": {
                  "kind": "env",
                  "name": "CODEX_HOME"
                }
              }
            ]
          },
          {
            "id": "cli-readonly",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "-s",
              "read-only",
              "--model",
              "{model}",
              "{prompt}"
            ],
            "env": {
              "CODEX_HOME": "${HOME}/.codex-fgovn"
            }
          },
          {
            "id": "herdr",
            "via": "cli",
            "adapter": "herdr-spawn",
            "command": "codex",
            "args": [
              "--dangerously-bypass-approvals-and-sandbox",
              "--model",
              "{model}",
              "{prompt}"
            ],
            "env": {
              "CODEX_HOME": "${HOME}/.codex-fgovn"
            },
            "interactiveMode": {
              "exitCommand": "/quit",
              "kind": "codex",
              "trustStore": {
                "kind": "codex-toml"
              }
            }
          }
        ]
      },
      "agy": {
        "kind": "agent",
        "description": "Antigravity CLI -- consolidated executor (executor-id-consolidation Step 2): cli/herdr/cli-bwrap invocations, replacing the former separate agy-cli/agy-herdr/agy-bwrap ids.",
        "allowCrossProvider": true,
        "providerModel": "gemini",
        "for": [
          "advise"
        ],
        "invocations": [
          {
            "id": "cli",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "agy",
            "args": [
              "-p",
              "{prompt}",
              "--mode",
              "accept-edits",
              "--new-project",
              "--print-timeout",
              "30m",
              "--model",
              "{model}"
            ],
            "env": {
              "HOME": "${HOME}/.agy-homes/mucdong"
            }
          },
          {
            "id": "herdr",
            "via": "cli",
            "adapter": "herdr-spawn",
            "command": "agy",
            "args": [
              "{prompt}",
              "--mode",
              "accept-edits",
              "--new-project",
              "--model",
              "{model}"
            ],
            "interactiveMode": {
              "exitCommand": "/exit",
              "kind": "agy"
            },
            "env": {
              "HOME": "${HOME}/.agy-homes/mucdong"
            }
          },
          {
            "id": "cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "agy",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "env": {
              "HOME": "${HOME}/.agy-homes/mucdong"
            }
          },
          {
            "id": "cli-tetnu",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "agy",
            "args": [
              "-p",
              "{prompt}",
              "--mode",
              "accept-edits",
              "--new-project",
              "--print-timeout",
              "30m",
              "--model",
              "{model}"
            ],
            "env": {
              "HOME": "${HOME}/.agy-homes/tetnu"
            }
          }
        ],
        "rigorOverrides": {
          "light": "nano",
          "standard": "standard",
          "heavy": "advanced"
        }
      },
      "codex-pi": {
        "kind": "agent",
        "description": "pi coding agent (openai-codex/gpt-5.5) -- reference runtime for the coding-worker-contract, D4 proof-test GREEN (tsk-47r)",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--provider",
              "openai-codex",
              "--model",
              "{model}",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ]
          }
        ],
        "providerModel": "openai-codex",
        "rigorOverrides": {
          "light": "nano",
          "standard": "nano",
          "heavy": "nano"
        }
      },
      "glm-cli": {
        "kind": "agent",
        "description": "Claude Code CLI routed to OpenRouter's GLM 5.2 model (z-ai/glm-5.2), not real Anthropic -- ANTHROPIC_BASE_URL/AUTH_TOKEN/MODEL overridden via this invocation's own env block (dispatch/transport.mjs's ${VAR} substitution against process.env, never a shell). Real key lives in .fgos/secrets.local.env (untracked, gitignored) as GLM_OPENROUTER_API_KEY -- never committed here. See docs/history/glm-openrouter-executor/plan.md (tsk-gb3).",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(git add:*),Bash(git commit:*),Bash(rtk git add:*),Bash(rtk git commit:*)"
            ],
            "env": {
              "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
              "ANTHROPIC_AUTH_TOKEN": "${GLM_OPENROUTER_API_KEY}",
              "ANTHROPIC_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_API_KEY": "",
              "ANTHROPIC_DEFAULT_HAIKU_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_DEFAULT_SONNET_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_DEFAULT_OPUS_MODEL": "z-ai/glm-5.2"
            }
          }
        ],
        "providerModel": "z-ai",
        "rigorOverrides": {
          "light": "nano",
          "standard": "nano",
          "heavy": "nano"
        }
      },
      "gitnexus": {
        "kind": "tool",
        "description": "Code-graph blast radius",
        "for": [
          "impact-analysis"
        ],
        "scanTarget": ".gitnexus",
        "responsibility": "Verification",
        "invocations": [
          {
            "via": "mcp",
            "command": "mcp:gitnexus",
            "tools": {
              "impact-analysis": "mcp__gitnexus__impact"
            }
          }
        ]
      },
      "herdr": {
        "kind": "tool",
        "for": [
          "pane-labeling"
        ],
        "responsibility": "Chrome",
        "description": "herdr pane label writer (herdr pane rename) for /fgOS:terminal",
        "invocations": [
          {
            "via": "cli",
            "command": "herdr",
            "args": []
          }
        ]
      },
      "pi": {
        "kind": "agent",
        "description": "pi coding agent (openai-codex/gpt-5.5) -- reference runtime for the coding-worker-contract, D4 proof-test GREEN (tsk-47r)",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--provider",
              "openai-codex",
              "--model",
              "{model}",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "id": "default"
          },
          {
            "id": "codex-tetnu",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--provider",
              "openai-codex",
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/tetnu"
            }
          },
          {
            "id": "codex-fgovn",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--provider",
              "openai-codex",
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/fgovn"
            }
          }
        ],
        "providerModel": "openai-codex",
        "rigorOverrides": {
          "light": "nano",
          "standard": "nano",
          "heavy": "nano"
        }
      },
      "pi-grok": {
        "kind": "agent",
        "description": "pi coding agent (xai/grok) -- grok-vantt account, sibling of the pi/openai-codex executor (separate executor because providerModel is executor-scoped, not per-invocation)",
        "allowCrossProvider": true,
        "providerModel": "xai",
        "invocations": [
          {
            "id": "grok-vantt",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--provider",
              "xai",
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/grok-vantt"
            }
          },
          {
            "id": "grok-vantt-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--provider",
              "xai",
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/grok-vantt"
            }
          }
        ]
      }
    },
    "timeoutMs": 2100000,
    "parallel": {
      "maxRoots": 4,
      "maxLeavesPerRoot": 4
    },
    "modelPolicies": {
      "claude": {
        "nano": "haiku",
        "standard": "sonnet",
        "advanced": "sonnet",
        "flagship": "opus",
        "frontier": "opus"
      },
      "gemini": {
        "nano": "gemini-3.8-flash-low",
        "standard": "gemini-3.8-flash-medium",
        "advanced": "gemini-3.8-flash-high",
        "flagship": "gemini-3.1-pro-low",
        "frontier": "gemini-3.1-pro-high"
      },
      "openai-codex": {
        "nano": "gpt-5.6-luna",
        "standard": "gpt-5.6-terra",
        "advanced": "gpt-5.6-terra",
        "flagship": "gpt-5.6-terra",
        "frontier": "gpt-5.6-sol"
      },
      "z-ai": {
        "nano": "z-ai/glm-5.2",
        "standard": "z-ai/glm-5.2",
        "advanced": "z-ai/glm-5.2",
        "flagship": "z-ai/glm-5.2",
        "frontier": "z-ai/glm-5.2"
      },
      "xai": {
        "standard": "grok-4.3",
        "advanced": "grok-4.5",
        "flagship": "grok-4.6",
        "frontier": "grok-4.6"
      }
    },
    "models": {
      "light": "haiku",
      "standard": "sonnet",
      "heavy": "opus"
    },
    "confinement": {
      "strict": false
    }
  },
  "gateBypass": {
    "level": "standard"
  },
  "cleanup": {
    "ttlDays": 5,
    "leafTtlDays": 0
  },
  "invariantChecks": {
    "commands": [
      "node --test test/architecture.test.mjs"
    ]
  },
  "workerSlots": {
    "ceiling": null
  },
  "ironLaw": {
    "level": "ask"
  },
  "gateway": {
    "port": 4170,
    "token": null
  },
  "herdrWebDashboard": {
    "staticServing": true
  },
  "checkpoint": {
    "fallbackIntervalSec": 3600
  },
  "docRegistry": {
    "enforce": true
  }
}
