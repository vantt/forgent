{
  "herdrOrchestrator": {
    "autoDiscover": true,
    "autoMerge": false,
    "autoRetro": false,
    "autoCleanup": false
  },
  "runner": {
    "executor": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(cargo build:*),Bash(cargo check:*),Bash(cargo test:*),Bash(cargo clippy:*),Bash(cargo fmt:*),Bash(node --test:*),Bash(rtk cargo:*),Bash(rtk node:*),Bash(rtk proxy cargo:*),Bash(rtk proxy node:*),Skill"
      ]
    },
    "capabilities": {
      "impact-analysis": {
        "description": "Code-graph blast radius",
        "aliases": [
          "impact_analysis",
          "Impact Analysis"
        ],
        "prefer": "gitnexus"
      },
      "pane-labeling": {
        "description": "Write a session/task id onto the current terminal pane's label, for a human watching a screen"
      },
      "advise": {
        "description": "Async product-decision consult -- value comes from disagreement and never changes project state.",
        "prefer": [
          {
            "executor": "claude",
            "invocation": "claude-cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        },
        "serves": {
          "outputKind": "decision",
          "mutates": false
        }
      },
      "execute": {
        "description": "Compliance-driven work -- value comes from following the plan, changes files, and must pass verification.",
        "prefer": [
          {
            "executor": "gemini"
          },
          {
            "executor": "deepseek"
          },
          {
            "executor": "glm"
          },
          "claude"
        ],
        "serves": {
          "outputKind": "change",
          "mutates": true
        }
      },
      "review": {
        "description": "Independent read-only review of a non-code artifact (docs, design, spec, config) before merge/decision -- distinct from code:review (I19, core/skills/_shared/capability-catalog.md).",
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        },
        "serves": {
          "outputKind": "finding",
          "mutates": false
        }
      },
      "fgos-coding-implement": {
        "description": "code-implement work for the coding domain executing stage -- preferred executor gemini through omp (omp-gemini-tetcu72), claude as fallback.",
        "prefer": [
          {
            "executor": "gemini",
            "invocation": "omp-herdr"
          },
          {
            "executor": "deepseek"
          },
          {
            "executor": "glm"
          },
          "claude"
        ]
      },
      "code:implement": {
        "description": "Canonical coding implementation capability -- compliance-driven coding execution before implementation (D1/D2, docs/history/capability-aware-dispatch-activation/CONTEXT.md)",
        "prefer": [
          {
            "executor": "gemini",
            "invocation": "omp-herdr"
          },
          {
            "executor": "deepseek"
          },
          {
            "executor": "glm"
          },
          "claude"
        ],
        "serves": {
          "outputKind": "change",
          "domain": "code",
          "mutates": true
        }
      },
      "code:review": {
        "description": "Canonical coding review capability -- independent read-only review of a coding implementation unit before merge (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": [
          {
            "executor": "openai",
            "invocation": "codex-cli-bwrap"
