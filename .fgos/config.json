    "executors": {
      "claude": {
        "kind": "agent",
        "description": "Claude Code CLI -- consolidated executor (executor-id-consolidation Step 2): cli/cli-bwrap invocations, replacing the former separate claude-reviewer/claude-reviewer-herdr/claude-bwrap ids.",
        "identity": {
          "principalRef": "principal://claude",
          "runtimeBackendRef": "backend://claude-cli",
          "trustDomain": "local-operator",
          "egressClass": "unrestricted"
        },
        "supports": {
          "providerFamilies": [
            "claude"
          ],
          "reasoningEffort": [
            "low",
            "medium",
            "high"
          ],
          "systemPrompt": false,
          "toolGating": "allowedTools"
        },
        "invocations": [
          {
            "id": "claude-cli",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(git add:*),Bash(git commit:*),Bash(rtk git add:*),Bash(rtk git commit:*)"
            ]
          },
          {
            "id": "claude-cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            }
          }
        ],
        "for": [
          "advise"
        ]
      },
      "glm": {
        "kind": "agent",
        "description": "Claude Code CLI routed to OpenRouter's GLM 5.2 model (z-ai/glm-5.2), not real Anthropic -- ANTHROPIC_BASE_URL/AUTH_TOKEN/MODEL overridden via this invocation's own env block (dispatch/transport.mjs's ${VAR} substitution against process.env, never a shell). Real key lives in .fgos/secrets.local.env (untracked, gitignored) as GLM_OPENROUTER_API_KEY -- never committed here. See docs/history/glm-openrouter-executor/plan.md (tsk-gb3).",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(git add:*),Bash(git commit:*),Bash(rtk git add:*),Bash(rtk git commit:*)"
            ],
            "env": {
              "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
              "ANTHROPIC_AUTH_TOKEN": "${GLM_OPENROUTER_API_KEY}",
              "ANTHROPIC_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_API_KEY": "",
              "ANTHROPIC_DEFAULT_HAIKU_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_DEFAULT_SONNET_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_DEFAULT_OPUS_MODEL": "z-ai/glm-5.2"
            }
          }
        ],
        "providerModel": "z-ai",
        "for": [
          "execute"
        ]
      },
      "gitnexus": {
        "kind": "tool",
        "description": "Code-graph blast radius",
        "for": [
          "impact-analysis"
        ],
        "scanTarget": ".gitnexus",
        "responsibility": "Verification",
        "invocations": [
          {
            "via": "mcp",
            "command": "mcp:gitnexus",
            "tools": {
              "impact-analysis": "mcp__gitnexus__impact"
            }
          }
        ]
      },
      "herdr": {
        "kind": "tool",
        "for": [
          "pane-labeling"
        ],
        "responsibility": "Chrome",
        "description": "herdr pane label writer (herdr pane rename) for /fgOS:terminal",
        "invocations": [
          {
            "via": "cli",
            "command": "herdr",
            "args": []
          }
        ]
      },
      "openai": {
        "kind": "agent",
        "description": "OpenAI provider, 2 bins merged into one executor (2026-09-17 provider-naming pass): codex CLI (native OpenAI Codex CLI) + pi CLI (multi-provider agent, --provider omitted -- each ~/.pi/accounts/<name> dir carries exactly one provider's credentials, confirmed via real invocation test). Invocation id = <bin>-<mode>-<account>, self-descriptive regardless of which bin actually runs. Both bins now use modelPolicies like every other executor.",
        "providerModel": "openai",
        "allowCrossProvider": true,
        "for": [
          "code:review",
          "code:debug"
        ],
        "invocations": [
          {
            "id": "codex-cli-bypass-fgovn",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "--dangerously-bypass-approvals-and-sandbox",
              "--model",
              "{model}",
              "{prompt}"
            ],
            "env": {
              "CODEX_HOME": "${HOME}/.codex-fgovn"
            }
          },
          {
            "id": "codex-cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "--skip-git-repo-check",
              "-s",
              "danger-full-access",
              "--model",
              "{model}",
              "{prompt}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "resourceBindings": [
              {
                "resource": "private-home",
                "target": {
                  "kind": "env",
                  "name": "CODEX_HOME"
                }
              }
            ]
          },
          {
            "id": "codex-herdr-fgovn",
            "via": "cli",
            "adapter": "herdr-spawn",
            "confinement": {
              "backend": "bwrap"
            },
            "command": "codex",
            "args": [
              "-s",
              "danger-full-access",
              "-a",
              "never",
              "--model",
              "{model}"
            ],
            "interactiveMode": {
              "exitCommand": "/quit",
              "kind": "codex",
              "trustStore": {
                "kind": "codex-toml"
              }
            },
            "resourceBindings": [
              {
                "resource": "private-home",
                "target": {
                  "kind": "env",
                  "name": "CODEX_HOME"
                }
              }
            ],
            "env": {
              "CODEX_HOME": "${HOME}/.codex-fgovn"
            }
          },
          {
            "id": "pi-cli-tetnu",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/openai-tetnu"
            }
          },
          {
