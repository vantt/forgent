{
  "herdrOrchestrator": {
    "autoDiscover": true,
    "autoMerge": false,
    "autoRetro": false,
    "autoCleanup": false
  },
  "runner": {
    "executor": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(git add:*),Bash(git commit:*)"
      ]
    },
    "capacities": {
      "agy": {
        "kind": "cli",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "agy",
            "args": [
              "-p",
              "{prompt}",
              "--dangerously-skip-permissions",
              "--model",
              "{model}"
            ]
          }
        ],
        "providerModel": "gemini",
        "rigorOverrides": {
          "light": "lightweight",
          "standard": "lightweight",
          "heavy": "lightweight"
        }
      }
    },
    "timeoutMs": 900000,
    "parallel": {
      "maxRoots": 4,
      "maxLeavesPerRoot": 4
    },
    "modelPolicies": {
      "claude": {
        "lightweight": "haiku",
        "standard": "sonnet",
        "creative": "sonnet",
        "analytical": "sonnet",
        "critical": "opus"
      },
      "gemini": {
        "lightweight": "gemini-3.6-flash-medium"
      }
    }
  },
  "gateBypass": {
    "level": "standard"
  },
  "cleanup": {
    "ttlDays": 7,
    "leafTtlDays": 0
  },
  "invariantChecks": {
    "commands": [
      "node --test test/architecture.test.mjs"
    ]
  },
  "workerSlots": {
    "ceiling": null
  }
}
