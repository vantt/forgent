              "--mode",
              "accept-edits",
              "--new-project",
              "--print-timeout",
              "30m",
              "--model",
              "{model}"
            ],
            "env": {
              "HOME": "${HOME}/.agy-homes/tetnu"
            }
          }
        ]
      },
      "xai": {
        "kind": "agent",
        "description": "xai (Grok) provider via pi CLI (2026-09-17 provider-naming pass, was executor id \"pi-grok\"). --provider omitted -- confirmed via real invocation that pi infers it from the single-provider account dir. grok-vantt account only.",
        "allowCrossProvider": true,
        "providerModel": "xai",
        "invocations": [
          {
            "id": "pi-cli-vantt",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/grok-vantt"
            }
          },
          {
            "id": "pi-cli-bwrap-vantt",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/grok-vantt"
            }
          },
          {
            "id": "pi-herdr-vantt",
            "via": "cli",
            "adapter": "herdr-spawn",
            "confinement": {
              "backend": "bwrap"
            },
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--approve"
            ],
            "interactiveMode": {
              "exitCommand": "/quit",
              "kind": "pi"
            },
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/grok-vantt"
            },
            "resourceBindings": [
              {
                "resource": "private-home",
                "target": {
                  "kind": "env",
                  "name": "PI_CODING_AGENT_DIR"
                }
              }
            ]
          }
        ],
        "for": [
          "review",
          "code:review"
        ]
      },
      "deepseek": {
        "kind": "agent",
        "description": "DeepSeek provider via pi CLI, OpenRouter gateway account. --provider omitted -- account dir has a single provider (openrouter). Same account dir also serves other OpenRouter-hosted models (e.g. glm-cli's z-ai route uses a different account/mechanism); --model alone selects deepseek/* here.",
        "allowCrossProvider": true,
        "providerModel": "deepseek",
        "invocations": [
          {
            "id": "pi-cli-openrouter",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/openrouter"
            }
          },
          {
            "id": "pi-cli-bwrap-openrouter",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "env": {
              "PI_CODING_AGENT_DIR": "${HOME}/.pi/accounts/openrouter"
            }
          }
        ],
        "for": [
          "execute"
        ]
      },
      "claude-herdr": {
        "kind": "agent",
        "description": "Claude Code REPL in a herdr pane under the bwrap posture, same provider family as `claude`. Separate id because `claude` is merged with the global default executor, which drops its own invocations.",
        "allowCrossProvider": true,
        "providerModel": "claude",
        "invocations": [
          {
            "id": "claude-herdr-bwrap",
            "via": "cli",
            "adapter": "herdr-spawn",
            "command": "claude",
            "args": [
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "interactiveMode": {
              "exitCommand": "/exit",
              "kind": "claude",
              "trustStore": {
                "kind": "claude-json"
              }
            }
          }
        ]
      },
      "glm-herdr": {
        "kind": "agent",
        "description": "Claude Code REPL routed to OpenRouter GLM (z-ai) in a herdr pane under the bwrap posture. CLAUDE_CODE_AUTO_MODE_SERVER=0 keeps claude from raising its blocking auto-mode billing notice, which a gateway session always gets and nobody is there to answer. The key is substituted from the environment at launch (GLM_OPENROUTER_API_KEY), never stored here.",
        "allowCrossProvider": true,
        "providerModel": "z-ai",
        "invocations": [
          {
            "id": "glm-herdr-bwrap",
            "via": "cli",
            "adapter": "herdr-spawn",
            "command": "claude",
            "args": [
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "interactiveMode": {
              "exitCommand": "/exit",
              "kind": "claude",
              "trustStore": {
                "kind": "claude-json"
              }
            },
            "env": {
              "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
              "ANTHROPIC_AUTH_TOKEN": "${GLM_OPENROUTER_API_KEY}",
              "ANTHROPIC_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_API_KEY": "",
              "ANTHROPIC_DEFAULT_HAIKU_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_DEFAULT_SONNET_MODEL": "z-ai/glm-5.2",
              "ANTHROPIC_DEFAULT_OPUS_MODEL": "z-ai/glm-5.2",
              "CLAUDE_CODE_AUTO_MODE_SERVER": "0"
            }
          }
        ]
      }
    },
    "timeoutMs": 2100000,
    "parallel": {
      "maxRoots": 4,
      "maxLeavesPerRoot": 4
    },
    "modelPolicies": {
      "claude": {
        "nano": "haiku",
        "standard": "sonnet",
        "advanced": "sonnet",
        "flagship": "opus",
        "frontier": "fable"
      },
      "gemini": {
        "nano": "gemini-3.8-flash-low",
        "standard": "gemini-3.8-flash-medium",
        "advanced": "gemini-3.8-flash-high",
        "flagship": "gemini-3.1-pro-low",
        "frontier": "gemini-3.1-pro-high"
      },
      "openai": {
        "nano": "gpt-5.6-luna",
        "standard": "gpt-5.6-terra",
        "advanced": "gpt-5.6-terra",
        "flagship": "gpt-5.6-terra",
        "frontier": "gpt-6-astra"
      },
      "z-ai": {
        "nano": "z-ai/glm-5.2",
        "standard": "z-ai/glm-5.2",
        "advanced": "z-ai/glm-5.2",
        "flagship": "z-ai/glm-5.2",
        "frontier": "z-ai/glm-5.2"
      },
      "xai": {
        "standard": "grok-4.3",
        "advanced": "grok-4.5",
        "flagship": "grok-4.6",
        "frontier": "grok-4.6"
      },
      "deepseek": {
        "nano": "deepseek/deepseek-v4-flash",
        "standard": "deepseek/deepseek-v4-flash",
        "advanced": "deepseek/deepseek-v4-pro",
        "flagship": "deepseek/deepseek-v4-pro",
        "frontier": "deepseek/deepseek-v4-pro"
      }
    },
    "rigorToTier": {
      "low": "nano",
      "standard": "standard",
      "high": "flagship",
      "critical": "frontier"
    },
    "confinement": {
      "strict": false
    },
    "coordination": {
      "orgPolicy": {
        "dischargeOn": [
          "accepted"
        ]
      }
    },
    "patterns": {
      "defaultRule": {
        "mutatingMinRigor": "standard"
      },
      "reviewed": {
        "maxRounds": 2,
        "checkersByRigor": {
          "standard": [
            "reviewer"
          ],
          "high": [
            "reviewer",
            "red-team"
          ],
          "critical": [
            "reviewer",
            "red-team",
            "tester"
          ]
        }
      }
    }
  },
  "gateBypass": {
    "level": "standard"
  },
  "cleanup": {
    "ttlDays": 5,
    "leafTtlDays": 0
  },
  "invariantChecks": {
    "commands": [
      "node --test test/architecture.test.mjs"
    ]
  },
  "workerSlots": {
    "ceiling": null
  },
  "ironLaw": {
    "level": "ask"
  },
  "gateway": {
    "port": 4170,
    "token": null
  },
  "herdrWebDashboard": {
    "staticServing": true
  },
  "checkpoint": {
    "fallbackIntervalSec": 3600
  },
  "docRegistry": {
    "enforce": true
  },
  "worktreeSetup": {
    "commands": [
      "cargo build --release --workspace"
    ]
  }
}
