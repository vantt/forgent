{
  "herdrOrchestrator": {
    "autoDiscover": true,
    "autoMerge": false,
    "autoRetro": false,
    "autoCleanup": false
  },
  "runner": {
    "executor": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(git add:*),Bash(git commit:*)"
      ]
    },
    "capabilities": {
      "impact-analysis": {
        "description": "Code-graph blast radius",
        "aliases": [
          "impact_analysis",
          "Impact Analysis"
        ],
        "prefer": "gitnexus"
      },
      "pane-labeling": {
        "description": "Write a session/task id onto the current terminal pane's label, for a human watching a screen"
      }
    },
    "executors": {
      "agy": {
        "kind": "agent",
        "description": "Antigravity Cli",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "agy",
            "args": [
              "-p",
              "{prompt}",
              "--mode",
              "accept-edits",
              "--new-project",
              "--print-timeout",
              "10m",
              "--model",
              "{model}"
            ]
          }
        ],
        "providerModel": "gemini",
        "rigorOverrides": {
          "light": "lightweight",
          "standard": "lightweight",
          "heavy": "lightweight"
        }
      },
      "codex": {
        "kind": "agent",
        "description": "OpenAI Codex CLI (bypass-all -- no sandbox boundary, see docs/history/codex-bypass-executor/)",
        "allowCrossProvider": true,
        "invocations": [
          {
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "--dangerously-bypass-approvals-and-sandbox",
              "{prompt}"
            ]
          }
        ]
      },
      "gitnexus": {
        "kind": "tool",
        "description": "Code-graph blast radius",
        "for": [
          "impact-analysis"
        ],
        "scanTarget": ".gitnexus",
        "responsibility": "Verification",
        "invocations": [
          {
            "via": "mcp",
            "command": "mcp:gitnexus",
            "tools": {
              "impact-analysis": "mcp__gitnexus__impact"
            }
          }
        ]
      },
      "herdr": {
        "kind": "tool",
        "for": [
          "pane-labeling"
        ],
        "responsibility": "Chrome",
        "description": "herdr pane label writer (herdr pane rename) for /fgOS:terminal",
        "invocations": [
          {
            "via": "cli",
            "command": "herdr",
            "args": []
          }
        ]
      }
    },
    "timeoutMs": 900000,
    "parallel": {
      "maxRoots": 4,
      "maxLeavesPerRoot": 4
    },
    "modelPolicies": {
      "claude": {
        "lightweight": "haiku",
        "standard": "sonnet",
        "creative": "sonnet",
        "analytical": "sonnet",
        "critical": "opus"
      },
      "gemini": {
        "lightweight": "gemini-3.6-flash-medium"
      }
    }
  },
  "gateBypass": {
    "level": "standard"
  },
  "cleanup": {
    "ttlDays": 7,
    "leafTtlDays": 0
  },
  "invariantChecks": {
    "commands": [
      "node --test test/architecture.test.mjs"
    ]
  },
  "workerSlots": {
    "ceiling": null
  },
  "ironLaw": {
    "level": "ask"
  },
  "gateway": {
    "port": 4170,
    "token": null
  },
  "herdrWebDashboard": {
    "staticServing": true
  }
}
