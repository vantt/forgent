    "executors": {
      "claude": {
        "kind": "agent",
        "providerModel": "claude",
        "description": "Claude Code CLI, the one executor of the claude family: claude-cli and claude-cli-bwrap run headless, claude-herdr-bwrap runs a claude REPL in a herdr pane under the bwrap posture. bind() picks the pane invocation inside herdr and a cli one outside, so a capability gets claude in both places.",
        "identity": {
          "principalRef": "principal://claude",
          "runtimeBackendRef": "backend://claude-cli",
          "trustDomain": "local-operator",
          "egressClass": "unrestricted"
        },
        "supports": {
          "providerFamilies": [
            "claude"
          ],
          "reasoningEffort": [
            "low",
            "medium",
            "high"
          ],
          "skills": [
            "ak:cook"
          ],
          "systemPrompt": false,
          "toolGating": "allowedTools"
        },
        "invocations": [
          {
            "id": "claude-cli",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}",
              "--permission-mode",
              "acceptEdits"
            ]
          },
          {
            "id": "claude-cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "claude",
            "args": [
              "-p",
              "{prompt}",
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            }
          },
          {
            "id": "claude-herdr-bwrap",
            "via": "cli",
            "adapter": "herdr-spawn",
            "command": "claude",
            "args": [
              "--model",
              "{model}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "interactiveMode": {
              "exitCommand": "/exit",
              "kind": "claude",
              "trustStore": {
                "kind": "claude-json"
              }
            }
          }
        ]
      },
      "glm": {
        "kind": "agent",
        "description": "GLM 5.3 (z-ai/glm-5.3) through the pi CLI and OpenRouter, headless. Replaces the claude-CLI-through-gateway route.",
        "allowCrossProvider": true,
        "invocations": [
          {
            "id": "pi-cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "pi",
            "args": [
              "--model",
              "{model}",
              "--thinking",
              "medium",
              "--tools",
              "read,write,edit,bash,grep,find,ls",
              "--mode",
              "json",
              "--approve",
              "-p",
              "{prompt}"
            ],
            "confinement": {
              "backend": "bwrap"
            },
            "credentialStore": {
              "use": "pi",
              "homeEnv": "PI_CODING_AGENT_DIR",
              "files": [
                "auth.json",
                "models-store.json",
                "settings.json",
                "trust.json",
                "bin/fd",
                "models.json"
              ]
            }
          }
        ],
        "providerModel": "z-ai",
        "supports": {
          "skills": [
            "ak:cook"
          ]
        }
      },
      "gitnexus": {
        "kind": "tool",
        "description": "Code-graph blast radius",
        "for": [
          "impact-analysis"
        ],
        "scanTarget": ".gitnexus",
        "responsibility": "Verification",
        "invocations": [
          {
            "via": "mcp",
            "command": "mcp:gitnexus",
            "tools": {
              "impact-analysis": "mcp__gitnexus__impact"
            }
          }
        ]
      },
      "herdr": {
        "kind": "tool",
        "for": [
          "pane-labeling"
        ],
        "responsibility": "Chrome",
        "description": "herdr pane label writer (herdr pane rename) for /fgOS:terminal",
        "invocations": [
          {
            "via": "cli",
            "command": "herdr",
            "args": []
          }
        ]
      },
      "openai": {
        "kind": "agent",
        "description": "OpenAI provider, 2 bins merged into one executor (2026-09-17 provider-naming pass): codex CLI (native OpenAI Codex CLI) + pi CLI (multi-provider agent, --provider omitted -- each ~/.pi/accounts/<name> dir carries exactly one provider's credentials, confirmed via real invocation test). Invocation id = <bin>-<mode>-<account>, self-descriptive regardless of which bin actually runs. Both bins now use modelPolicies like every other executor.",
        "providerModel": "openai",
        "allowCrossProvider": true,
        "invocations": [
          {
            "id": "codex-cli-bwrap",
            "via": "cli",
            "adapter": "cli-spawn",
            "command": "codex",
            "args": [
              "exec",
              "--skip-git-repo-check",
