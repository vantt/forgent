{
  "herdrOrchestrator": {
    "autoDiscover": true,
    "autoMerge": false,
    "autoRetro": false,
    "autoCleanup": false
  },
  "runner": {
    "executor": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(git add:*),Bash(git commit:*),Bash(rtk git add:*),Bash(rtk git commit:*)"
      ]
    },
    "capabilities": {
      "impact-analysis": {
        "description": "Code-graph blast radius",
        "aliases": [
          "impact_analysis",
          "Impact Analysis"
        ],
        "prefer": "gitnexus"
      },
      "pane-labeling": {
        "description": "Write a session/task id onto the current terminal pane's label, for a human watching a screen"
      },
      "advise": {
        "description": "Async product-decision consult -- value comes from disagreement and never changes project state.",
        "prefer": [
          {
            "executor": "claude",
            "invocation": "claude-cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        },
        "serves": {
          "outputKind": "decision",
          "mutates": false
        }
      },
      "execute": {
        "description": "Compliance-driven work -- value comes from following the plan, changes files, and must pass verification.",
        "prefer": "claude",
        "serves": {
          "outputKind": "change",
          "mutates": true
        }
      },
      "review": {
        "description": "Independent read-only review of a non-code artifact (docs, design, spec, config) before merge/decision -- distinct from code:review (I19, core/skills/_shared/capability-catalog.md).",
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        },
        "serves": {
          "outputKind": "finding",
          "mutates": false
        }
      },
      "fgos-coding-implement": {
        "description": "code-implement work for the coding domain's executing stage -- preferred executor gemini (agy-herdr-mucdong).",
        "prefer": [
          {
            "executor": "gemini",
            "invocation": "agy-herdr-mucdong"
          }
        ]
      },
      "code:implement": {
        "description": "Canonical coding implementation capability -- compliance-driven coding execution before implementation (D1/D2, docs/history/capability-aware-dispatch-activation/CONTEXT.md)",
        "prefer": [
          {
            "executor": "gemini",
            "invocation": "agy-cli-mucdong"
          }
        ],
        "serves": {
          "outputKind": "change",
          "domain": "code",
          "mutates": true
        }
      },
      "code:review": {
        "description": "Canonical coding review capability -- independent read-only review of a coding implementation unit before merge (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": [
          {
            "executor": "openai",
            "invocation": "codex-cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        },
        "serves": {
          "outputKind": "finding",
          "domain": "code",
          "mutates": false
        }
      },
      "code:test": {
        "description": "Canonical coding test capability -- author or run tests for a coding implementation unit (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": "claude",
        "serves": {
          "outputKind": "verification",
          "domain": "code"
        }
      },
      "code:debug": {
        "description": "Canonical coding debug capability -- read-only root-cause investigation of a coding defect (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": [
          {
            "executor": "openai",
            "invocation": "codex-cli-bwrap"
          }
        ],
        "confinement": {
          "mode": "required",
          "policy": "host-write-denied"
        },
        "serves": {
          "outputKind": "finding",
          "domain": "code"
        }
      },
      "code:refactor": {
        "description": "Canonical coding refactor capability -- behavior-preserving structural change to existing code (P2-runtime, docs/history/agent-coordination-foundation/plan.md).",
        "prefer": "claude",
        "serves": {
          "outputKind": "change",
          "domain": "code",
          "mutates": true,
          "behaviorPreserving": true
        }
      },
