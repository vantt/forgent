# tsk-2xg: append-only diagnostic logs written by fgos tools. Git's default
# line-based 3-way merge causes fgos-write-rejected deadlocks when worker
# branches catch up with main and revert .fgos/* per pre-commit hook rules.
# `union` keeps lines from both sides and prevents false staged diffs.
.fgos/approve-post-success-faults.jsonl merge=union
.fgos/invocation-faults.jsonl merge=union
.fgos/main-checkout-guard-warnings.jsonl merge=union
.fgos/changelog-nag-history.jsonl merge=union
.fgos/entropy-history.jsonl merge=union

# tsk-1wk: tsk-3ve's per-writer sharded event log (.fgos/events/<writer-id>-
# <openTs>.jsonl) is append-only exactly like the old single-file
# .fgos/events.jsonl above, but wasn't covered by that same union-merge
# rule — every session's own live shard hit the identical append-conflict
# problem tsk-3wq/tsk-2xg already solved for the old layout.
.fgos/events/*.jsonl merge=union

